#!/usr/bin/bash
set -u
export LC_ALL=C LANG=C

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
missing=0
family=unknown
if [[ -r /etc/os-release ]]; then
	. /etc/os-release
	case " ${ID:-} ${ID_LIKE:-} " in
		*' arch '*) family=arch ;;
		*' debian '*|*' ubuntu '*) family=debian ;;
		*' fedora '*|*' rhel '*) family=fedora ;;
	esac
fi

package_name()
{
	case "$family:$1" in
		arch:build|arch:compiler|arch:binutils) printf base-devel ;;
		debian:build|debian:compiler) printf build-essential ;;
		debian:libelf) printf libelf-dev ;;
		debian:static-libc) printf libc6-dev ;;
		fedora:build) printf make ;;
		fedora:compiler) printf gcc ;;
		fedora:libelf) printf elfutils-libelf-devel ;;
		fedora:static-libc) printf glibc-static ;;
		*:binutils) printf binutils ;;
		debian:busybox) printf busybox-static ;;
		fedora:qemu) printf qemu-system-x86-core ;;
		*:qemu) printf qemu-system-x86 ;;
		*:python) printf python3 ;;
		*) printf '%s' "$1" ;;
	esac
}

check_command()
{
	local command=$1 package
	package=$(package_name "$2")
	if command -v "$command" >/dev/null; then
		printf '[+] %-22s %s\n' "$command" "$(command -v "$command")"
	else
		printf '[x] %-22s missing (package: %s)\n' "$command" "$package"
		missing=$((missing + 1))
	fi
}

printf '[*] Host\n'
printf '[+] %-22s %s\n' distribution "${PRETTY_NAME:-unknown}"
if [[ $(uname -m) == x86_64 ]]; then
	printf '[+] %-22s supported\n' architecture
else
	printf '[x] %-22s unsupported; the course currently targets x86-64\n' "$(uname -m)"
	missing=$((missing + 1))
fi
printf '[+] %-22s irrelevant (%s)\n' 'host kernel' "$(uname -r)"

printf '\n[*] Build and verification tools\n'
check_command bash bash
check_command make build
check_command gcc compiler
for command in ld as ar nm objcopy objdump readelf; do check_command "$command" binutils; done
check_command bison bison
check_command flex flex
check_command perl perl
check_command openssl openssl
check_command file file
check_command modinfo kmod
check_command gdb gdb
check_command python3 python
check_command busybox busybox
check_command cpio cpio
check_command gzip gzip
check_command qemu-system-x86_64 qemu
check_command timeout coreutils

if command -v python3 >/dev/null; then
	if python3 - <<'PY'
import sys, tarfile
raise SystemExit(not (sys.version_info >= (3, 11) and hasattr(tarfile, "data_filter")))
PY
	then
		printf '[+] %-22s maintained 3.11+ with safe tar filters\n' Python
	else
		printf '[x] %-22s requires maintained Python 3.11+ with tar extraction filters\n' Python
		missing=$((missing + 1))
	fi
fi

if command -v gcc >/dev/null; then
	if printf '#include <libelf.h>\n#include <gelf.h>\nint main(void) { return elf_version(EV_CURRENT) == EV_NONE; }\n' | gcc -x c -o /dev/null - -lelf >/dev/null 2>&1; then
		printf '[+] %-22s available\n' 'libelf development'
	else
		printf '[x] %-22s missing (package: %s)\n' 'libelf development' "$(package_name libelf)"
		missing=$((missing + 1))
	fi
	probe=$(mktemp "${TMPDIR:-/tmp}/rootkitlings-cc.XXXXXX")
	if printf 'int main(void) { return 0; }\n' | gcc -static -x c -o "$probe" - >/dev/null 2>&1; then
		printf '[+] %-22s available\n' 'static C linking'
	else
		printf '[x] %-22s unavailable (package: %s)\n' 'static C linking' "$(package_name static-libc)"
		missing=$((missing + 1))
	fi
	rm -f -- "$probe"
fi

if command -v busybox >/dev/null; then
	if file "$(command -v busybox)" | grep -q 'statically linked'; then
		printf '[+] %-22s statically linked\n' BusyBox
	else
		printf '[x] %-22s must be statically linked (package: %s)\n' BusyBox "$(package_name busybox)"
		missing=$((missing + 1))
	fi
	busybox_applets=$(busybox --list)
	missing_applets=
	for applet in bc cat chmod cmp cut dd diff dmesg echo find grep head hexdump id \
		ifconfig insmod kill ls lsmod mkdir modinfo mount nc ping poweroff printf ps \
		reboot rm rmdir rmmod sed setsid sh sha256sum sleep sort stat tail test touch tr \
		uname unshare wc xxd od; do
		grep -qx "$applet" <<< "$busybox_applets" || missing_applets+=" $applet"
	done
	if [[ -z $missing_applets ]]; then
		printf '[+] %-22s complete\n' 'BusyBox applets'
	else
		printf '[x] %-22s missing:%s\n' 'BusyBox applets' "$missing_applets"
		missing=$((missing + 1))
	fi
fi

if command -v qemu-system-x86_64 >/dev/null; then
	if qemu-system-x86_64 -netdev help 2>&1 | grep -q '^user$'; then
		printf '[+] %-22s optional capability available\n' 'QEMU user network'
	else
		printf '[-] %-22s optional capability unavailable\n' 'QEMU user network'
	fi
fi

printf '\n[*] Capacity\n'
memory_kib=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
if (( memory_kib >= 2 * 1024 * 1024 )); then
	printf '[+] %-22s %.1f GiB (4 GiB recommended)\n' memory "$(awk -v value="$memory_kib" 'BEGIN { print value / 1048576 }')"
else
	printf '[x] %-22s %.1f GiB; at least 2 GiB is required\n' memory "$(awk -v value="$memory_kib" 'BEGIN { print value / 1048576 }')"
	missing=$((missing + 1))
fi
free_kib=$(df -Pk "$ROOT_DIR" | awk 'NR == 2 { print $4 }')
if (( free_kib >= 4 * 1024 * 1024 )); then
	printf '[+] %-22s %.1f GiB free (6 GiB recommended)\n' storage "$(awk -v value="$free_kib" 'BEGIN { print value / 1048576 }')"
else
	printf '[x] %-22s %.1f GiB free; at least 4 GiB is required\n' storage "$(awk -v value="$free_kib" 'BEGIN { print value / 1048576 }')"
	missing=$((missing + 1))
fi
cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf 1)
printf '[+] %-22s %s logical (4 recommended)\n' processors "$cpus"

printf '\n[*] Course kernel\n'
if "$ROOT_DIR/scripts/kernel" status; then
	printf '[+] %-22s ready\n' 'pinned kernel'
else
	printf '[-] %-22s setup will build it from the pinned source\n' 'pinned kernel'
fi

printf '\n[*] Acceleration\n'
if [[ -r /dev/kvm && -w /dev/kvm ]]; then
	printf '[+] %-22s available\n' KVM
else
	printf '[-] %-22s unavailable; tests use slower TCG emulation\n' KVM
fi
if command -v pwndbg >/dev/null; then
	printf '[+] %-22s %s\n' pwndbg "$(command -v pwndbg)"
else
	printf '[-] %-22s optional enhanced GDB interface\n' pwndbg
fi

printf '\n'
if (( missing == 0 )); then
	printf '[+] Host ready for the pinned x86-64 course kernel\n'
else
	printf '[x] Not ready: %d required item(s) missing\n' "$missing"
	exit 1
fi
