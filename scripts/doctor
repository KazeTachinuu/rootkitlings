#!/usr/bin/env bash
# shellcheck disable=SC1091 # /etc/os-release is a runtime host file.
set -u
export LC_ALL=C LANG=C

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=scripts/lib/ui.sh
source "$ROOT_DIR/scripts/lib/ui.sh"
# shellcheck source=scripts/lib/host.sh
source "$ROOT_DIR/scripts/lib/host.sh"
missing=0
missing_packages=""

record_missing()
{
	local pkg=$1
	case " $missing_packages " in
		*" $pkg "*) ;;
		*) missing_packages="$missing_packages $pkg" ;;
	esac
}

ui_heading 'Host'
host_system=$(uname -s)
if [[ $host_system != Linux ]]; then
	ui_item fail 'operating system' "$host_system is unsupported; use an x86-64 Linux host"
	ui_item note macOS 'use an x86-64 Linux VM or remote Linux host'
	exit 1
fi

kernel_release=$(uname -r)
wsl_version=0
if [[ -n ${WSL_INTEROP:-}${WSL_DISTRO_NAME:-} || $kernel_release == *Microsoft* || $kernel_release == *microsoft* ]]; then
	case $kernel_release in
		*WSL2*|*wsl2*) wsl_version=2 ;;
		*) wsl_version=1 ;;
	esac
fi

case $ROOT_DIR in
	*[!A-Za-z0-9._+/-]*)
		ui_item fail 'repository path' 'use only ASCII letters, digits, /, ., _, +, and -'
		missing=$((missing + 1))
		;;
	*) ui_item pass 'repository path' "$ROOT_DIR" ;;
esac
if (( wsl_version == 1 )); then
	ui_item fail environment 'WSL1 is unsupported; convert the distribution to WSL2'
	exit 1
elif (( wsl_version == 2 )); then
	ui_item pass environment 'WSL2'
	case $ROOT_DIR in
		/mnt/[A-Za-z]|/mnt/[A-Za-z]/*)
			ui_item fail 'repository location' 'clone inside the WSL filesystem, for example ~/rklings'
			missing=$((missing + 1))
			;;
	esac
fi

family=unknown
if [[ -r /etc/os-release ]]; then
	. /etc/os-release
	case "${ID:-}" in
		arch) family=arch ;;
		debian|ubuntu) family=debian ;;
		fedora) family=fedora ;;
		rhel|centos|rocky|almalinux) family=unknown ;;
		*)
			case " ${ID_LIKE:-} " in
				*' arch '*) family=arch ;;
				*' debian '*|*' ubuntu '*) family=debian ;;
				*' fedora '*) family=fedora ;;
			esac
			;;
	esac
fi

check_optional_command()
{
	local command=$1 package=$2 purpose=$3
	if command -v "$command" >/dev/null; then
		ui_item pass "$command" "$(command -v "$command")"
	else
		ui_item note "$command" "$purpose (optional package: $(package_name "$package"))"
	fi
}

check_command()
{
	local command=$1 package
	package=$(package_name "$2")
	if command -v "$command" >/dev/null; then
		ui_item pass "$command" "$(command -v "$command")"
	else
		ui_item fail "$command" "missing (package: $package)"
		record_missing "$package"
		missing=$((missing + 1))
	fi
}

ui_item pass distribution "${PRETTY_NAME:-unknown}"
if [[ $(uname -m) == x86_64 ]]; then
	ui_item pass architecture supported
else
	ui_item fail architecture "$(uname -m) is unsupported; the course targets x86-64"
	missing=$((missing + 1))
fi
ui_item note 'host kernel' "irrelevant ($(uname -r))"

printf '\n'
ui_heading 'Build and verification tools'
check_command bash bash
check_command ldd glibc
check_command make build
check_command gcc compiler
check_command clang clang
for command in ld as ar nm objcopy objdump readelf; do check_command "$command" binutils; done
check_command bison bison
check_command flex flex
check_command perl perl
check_command modinfo kmod
check_command python3 python
check_command busybox busybox
check_command cpio cpio
check_command gzip gzip
check_command qemu-system-x86_64 qemu
check_command timeout coreutils

if command -v python3 >/dev/null; then
	if python3 - 2>/dev/null <<'PY'
import sys, tarfile
import lzma, ssl
raise SystemExit(not (sys.version_info >= (3, 11) and hasattr(tarfile, "data_filter")))
PY
	then
		ui_item pass Python '3.11+ with safe tar, XZ, and TLS support'
	else
		ui_item fail Python 'requires 3.11+ with safe tar, XZ, and TLS support'
		missing=$((missing + 1))
	fi
fi

if command -v gcc >/dev/null; then
	if printf '#include <libelf.h>\n#include <gelf.h>\nint main(void) { return elf_version(EV_CURRENT) == EV_NONE; }\n' | gcc -x c -o /dev/null - -lelf >/dev/null 2>&1; then
		ui_item pass 'libelf development' available
	else
		ui_item fail 'libelf development' "missing (package: $(package_name libelf))"
		record_missing "$(package_name libelf)"
		missing=$((missing + 1))
	fi
	if printf '#include <openssl/evp.h>\nint main(void) { return EVP_aes_256_gcm() == 0; }\n' | gcc -x c -o /dev/null - -lcrypto >/dev/null 2>&1; then
		ui_item pass 'OpenSSL development' available
	else
		ui_item fail 'OpenSSL development' "missing (package: $(package_name libcrypto))"
		record_missing "$(package_name libcrypto)"
		missing=$((missing + 1))
	fi
	probe=$(mktemp "${TMPDIR:-/tmp}/rklings-cc.XXXXXX") || {
		ui_item fail 'static C linking' 'could not create a temporary probe'
		missing=$((missing + 1))
		probe=
	}
	trap 'test -z "${probe:-}" || rm -f -- "$probe"' EXIT
	if [[ -n $probe ]]; then
		if printf 'int main(void) { return 0; }\n' | gcc -static -x c -o "$probe" - >/dev/null 2>&1; then
			ui_item pass 'static C linking' available
		else
			ui_item fail 'static C linking' "unavailable (package: $(package_name static-libc))"
			record_missing "$(package_name static-libc)"
			missing=$((missing + 1))
		fi
	fi
	[[ -z $probe ]] || rm -f -- "$probe"
	probe=
fi

if command -v clang >/dev/null; then
	if printf 'int main(void) { return 0; }\n' | clang -fsanitize=address -x c -o /dev/null - >/dev/null 2>&1; then
		ui_item pass 'Clang ASan runtime' available
	else
		ui_item fail 'Clang ASan runtime' "missing (package: $(package_name compiler-rt))"
		record_missing "$(package_name compiler-rt)"
		missing=$((missing + 1))
	fi
fi

if command -v busybox >/dev/null; then
	if command -v file >/dev/null; then
		if file "$(command -v busybox)" | grep -q 'statically linked'; then
			ui_item pass BusyBox 'statically linked'
		else
			ui_item fail BusyBox "must be statically linked (package: $(package_name busybox))"
			record_missing "$(package_name busybox)"
			missing=$((missing + 1))
		fi
	else
		ui_item note BusyBox 'install file to verify static linkage'
	fi
	busybox_applets=$(busybox --list)
	missing_applets=
	for applet in bc cat chmod cmp cut dd diff dmesg echo find grep head hexdump id \
		ifconfig insmod kill ls lsmod mkdir modinfo mount nc ping poweroff printf ps \
		reboot rm rmdir rmmod sed setsid sh sha256sum sleep sort stat stty tail \
		test touch tr tty uname unshare wc xargs xxd od; do
		grep -qx "$applet" <<< "$busybox_applets" || missing_applets+=" $applet"
	done
	if [[ -z $missing_applets ]]; then
		ui_item pass 'BusyBox applets' complete
	else
		ui_item fail 'BusyBox applets' "missing:$missing_applets"
		missing=$((missing + 1))
	fi
fi

if command -v script >/dev/null; then
	if script --version 2>&1 | grep -qi 'util-linux'; then
		ui_item pass script 'util-linux PTY relay'
	else
		ui_item fail script "requires util-linux (package: $(package_name script))"
		record_missing "$(package_name script)"
		missing=$((missing + 1))
	fi
else
	ui_item fail script "missing (package: $(package_name script))"
	record_missing "$(package_name script)"
	missing=$((missing + 1))
fi

if command -v qemu-system-x86_64 >/dev/null; then
	if qemu-system-x86_64 -netdev help 2>&1 | grep -q '^user$'; then
		ui_item pass 'QEMU user network' 'optional capability available'
	else
		ui_item note 'QEMU user network' 'optional capability unavailable'
	fi
fi

printf '\n'
ui_heading 'Optional developer tools'
check_optional_command bear bear 'needed only by make compile-db'
check_optional_command clangd clangd 'uses compile_commands.json for editor diagnostics'
check_optional_command openssl openssl 'handy for key generation and debugging'
check_optional_command file file 'used by doctor to verify busybox linkage'
check_optional_command shellcheck shellcheck 'adds shell diagnostics to make validate'
check_optional_command gdb gdb 'needed only for ./rklings gdb'

printf '\n'
ui_heading 'Capacity'
memory_kib=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
if (( memory_kib >= 2 * 1024 * 1024 )); then
	ui_item pass memory "$(awk -v value="$memory_kib" 'BEGIN { printf "%.1f GiB (4 GiB recommended)", value / 1048576 }')"
else
	ui_item fail memory "$(awk -v value="$memory_kib" 'BEGIN { printf "%.1f GiB; at least 2 GiB is required", value / 1048576 }')"
	missing=$((missing + 1))
fi
free_kib=$(df -Pk "$ROOT_DIR" | awk 'NR == 2 { print $4 }')
if (( free_kib >= 4 * 1024 * 1024 )); then
	ui_item pass storage "$(awk -v value="$free_kib" 'BEGIN { printf "%.1f GiB free (6 GiB recommended)", value / 1048576 }')"
else
	ui_item fail storage "$(awk -v value="$free_kib" 'BEGIN { printf "%.1f GiB free; at least 4 GiB is required", value / 1048576 }')"
	missing=$((missing + 1))
fi
cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf 1)
ui_item pass processors "$cpus logical (4 recommended)"

printf '\n'
ui_heading 'Course kernel'
if ! command -v python3 >/dev/null; then
	ui_item note 'pinned kernel' 'status unavailable until Python is installed'
elif "$ROOT_DIR/scripts/kernel" status >/dev/null; then
	ui_item pass 'pinned kernel' ready
else
	ui_item note 'pinned kernel' 'setup will build it from the pinned source'
fi

printf '\n'
ui_heading 'Acceleration'
if host_kvm_available; then
	ui_item pass KVM available
else
	ui_item note KVM 'unavailable; tests use slower TCG emulation'
fi
if command -v pwndbg >/dev/null; then
	ui_item pass pwndbg "$(command -v pwndbg)"
else
	ui_item note pwndbg 'optional enhanced GDB interface'
fi

printf '\n'
if (( missing == 0 )); then
	ui_success 'Host ready for the pinned x86-64 course kernel'
else
	ui_error "Not ready: $missing required item(s) missing"
	if [[ -n ${missing_packages// } ]]; then
		printf '\n'
		case $family in
			arch)   printf '  sudo pacman -S%s\n' "$missing_packages" ;;
			debian) printf '  sudo apt install%s\n' "$missing_packages" ;;
			fedora) printf '  sudo dnf install%s\n' "$missing_packages" ;;
			*)      printf '  Install:%s\n' "$missing_packages" ;;
		esac
	fi
	exit 1
fi
