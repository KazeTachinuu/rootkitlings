#!/usr/bin/bash
set -Eeuo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-tests.XXXXXX")
trap 'rm -rf -- "$work"' EXIT

cd "$ROOT_DIR"
make --quiet tools

matches_filter()
{
	local entry=$1 name=${1##*/} filter requested actual

	(( $# == 1 )) && return 0
	shift
	for filter; do
		[[ $filter == "$name" ]] && return 0
		if [[ $filter == capstone-* && $entry == capstones/* ]]; then
			[[ ${filter#capstone-} == "${name%%-*}" ]] && return 0
		elif [[ $filter =~ ^[0-9]+$ && $entry == lings/* ]]; then
			requested=$filter
			actual=${name%%-*}
			while [[ $requested == 0* && ${#requested} -gt 1 ]]; do
				requested=${requested#0}
			done
			while [[ $actual == 0* && ${#actual} -gt 1 ]]; do
				actual=${actual#0}
			done
			[[ $requested == "$actual" ]] && return 0
		fi
	done
	return 1
}

passed=0
failed=0
while IFS= read -r entry; do
	[[ -z $entry || $entry == \#* ]] && continue
	matches_filter "$entry" "$@" || continue

	name=${entry##*/}
	build=$work/$name
	mkdir -p "$build"
	if [[ -d .solutions/$name ]]; then
		cp -a ".solutions/$name/." "$build/"
	else
		cp ".solutions/$name.c" "$build/hello.c"
		printf 'obj-m += hello.o\n' > "$build/Kbuild"
	fi

	printf '\n[*] %s\n' "$name"
	output=
	if make --quiet MODULE_DIR="$build" &&
		{ [[ ! -x $entry/host-check ]] || "$entry/host-check" "$build"; } &&
		output=$(timeout --foreground "${ROOTKITLINGS_CHECK_TIMEOUT:-60}" \
			vm/boot --check "$entry/check" "$build/hello.ko" \
			</dev/null 2>&1) &&
		[[ $output == *"[+] PASSED"* ]]; then
		printf '%s\n' "$output"
		printf '[+] %s passed\n' "$name"
		(( ++passed ))
	else
		printf '%s\n' "${output:-build failed}" >&2
		printf '[x] %s failed\n' "$name" >&2
		(( ++failed ))
	fi
done < .order

printf '\n[*] reference tests: %d passed, %d failed\n' "$passed" "$failed"
(( failed == 0 ))
