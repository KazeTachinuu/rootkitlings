#!/usr/bin/env python3
"""Validate repository-local Markdown links and rootkitlings command examples."""

from pathlib import Path
import re
import sys

sys.path.insert(0, str(Path.cwd()))
from engine.catalog import Catalog


catalog = Catalog(Path.cwd())
serial_by_readme = {Path(item.resources.readme): item.serial for item in catalog.exercises}
roots = [Path("README.md"), Path("vm/README.md"), Path("capstones/README.md")]
documents = list(dict.fromkeys(roots + sorted(serial_by_readme)))
failures: list[str] = []

for document in documents:
    text = document.read_text()
    for target in re.findall(r"\[[^]]+\]\(([^)]+)\)", text):
        if "://" in target or target.startswith("#"):
            continue
        relative = target.split("#", 1)[0]
        if relative and not (document.parent / relative).exists():
            failures.append(f"{document}: missing link target: {target}")

    if re.search(r"\./rootkitlings\s+(?:debug|prerequisites|prereqs|peek|readme)\b", text):
        failures.append(f"{document}: uses a removed rootkitlings command")
    if re.search(r"\bcapstone-[0-9]+\b", text):
        failures.append(f"{document}: uses a removed capstone selector")
    if re.search(
        r"\./rootkitlings\s+(?:read|start|check|hint|solution|run|gdb|prereq)\s+[0-9]+\b",
        text,
    ):
        failures.append(f"{document}: uses a removed numeric exercise selector")

    serial = serial_by_readme.get(document)
    if not serial:
        continue
    examples = re.findall(
        r"\./rootkitlings\s+(read|start|check|hint|solution|run|gdb|prereq)\s+(\S+)",
        text,
    )
    for command, selector in examples:
        selector = selector.rstrip("`.,;:")
        if selector != serial:
            failures.append(
                f"{document}: {command} example targets {selector}, expected {serial}"
            )
    if ("check", serial) not in examples:
        failures.append(f"{document}: missing canonical './rootkitlings check {serial}'")

if failures:
    raise SystemExit("\n".join(failures))
