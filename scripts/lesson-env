#!/usr/bin/bash
# shellcheck disable=SC2317 # This file may be sourced or executed.

RKLINGS_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || {
	printf '[x] Could not locate the Rklings repository\n' >&2
	return 1 2>/dev/null || exit 1
}
# shellcheck source=scripts/lib/ui.sh
source "$RKLINGS_ROOT/scripts/lib/ui.sh"

KDIR=$("$RKLINGS_ROOT/scripts/kernel" build-dir) || {
	ui_error 'course kernel is not ready; run: ./rklings setup'
	return 1 2>/dev/null || exit 1
}
if [[ ! -d $KDIR || -L $KDIR ]]; then
	ui_error "kernel build directory is unsafe or missing: $KDIR"
	return 1 2>/dev/null || exit 1
fi

KERNEL_RELEASE=$("$RKLINGS_ROOT/scripts/kernel" release) || {
	ui_error 'cannot read the pinned course-kernel release'
	return 1 2>/dev/null || exit 1
}

export KDIR KERNEL_RELEASE RKLINGS_ROOT
export LC_ALL=C LANG=C TZ=UTC ARCH=x86_64 CC=gcc HOSTCC=gcc
unset CROSS_COMPILE KCONFIG_CONFIG LOCALVERSION KCFLAGS KCPPFLAGS KAFLAGS \
	HOSTCFLAGS HOSTLDFLAGS LLVM LLVM_IAS MAKEFLAGS MFLAGS
