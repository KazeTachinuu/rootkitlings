#!/usr/bin/python3
"""Query and validate rootkitlings exercise metadata."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "lib"))

from catalog import Catalog, CatalogError, QUERY_FIELDS  # noqa: E402

CATALOG_QUERY_FIELDS = QUERY_FIELDS | {"module_artifact"}


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser()
    commands = result.add_subparsers(dest="command", required=True)
    commands.add_parser("validate")
    assumptions = commands.add_parser("assumptions")
    assumptions.add_argument("concept", nargs="?")
    concept_label = commands.add_parser("concept-label")
    concept_label.add_argument("concept")
    resolve = commands.add_parser("resolve")
    resolve.add_argument("selector", help="stable ID or serial alias (L00, M00, or C00)")
    query = commands.add_parser("query")
    query.add_argument("selector", help="stable ID or serial alias (L00, M00, or C00)")
    query.add_argument("field", choices=sorted(CATALOG_QUERY_FIELDS))
    prerequisite_closure = commands.add_parser("prerequisite-closure")
    prerequisite_closure.add_argument("selector", help="stable ID or serial alias")
    concept_closure = commands.add_parser("concept-closure")
    concept_closure.add_argument("selector", help="stable ID or serial alias")
    concept_closure.add_argument("--details", action="store_true")
    listing = commands.add_parser("list")
    listing.add_argument("--difficulty")
    listing.add_argument("--concept")
    commands.add_parser("export")
    return result


def emit(value: object) -> None:
    if isinstance(value, tuple):
        for item in value:
            print(item)
    elif isinstance(value, bool):
        print("true" if value else "false")
    else:
        print(value)


def main() -> int:
    args = parser().parse_args()
    try:
        catalog = Catalog(ROOT)
        if args.command == "validate":
            print(f"[+] catalog: {len(catalog.exercises)} exercises")
        elif args.command == "resolve":
            print(catalog.resolve(args.selector).path)
        elif args.command == "query":
            item = catalog.resolve(args.selector)
            emit(
                catalog.module_artifact(item)
                if args.field == "module_artifact"
                else item.value(args.field)
            )
        elif args.command == "prerequisite-closure":
            item = catalog.resolve(args.selector)
            emit(tuple(value.serial for value in catalog.prerequisite_exercises(item)))
        elif args.command == "concept-closure":
            concept_ids = catalog.all_concepts(catalog.resolve(args.selector))
            for value in sorted(concept_ids):
                assumption = catalog.assumption(value)
                if args.details:
                    print(f"{catalog.concept_label(value)}\t{assumption.competency if assumption else '-'}")
                else:
                    print(catalog.concept_label(value))
        elif args.command == "assumptions":
            matches = [item for item in catalog.assumptions if not args.concept or item.concept == args.concept]
            if args.concept and not matches:
                raise CatalogError(f"unknown course assumption: {args.concept}")
            for assumption in matches:
                print(f"{assumption.concept}\t{catalog.concept_label(assumption.concept)}\t{assumption.competency}")
        elif args.command == "concept-label":
            print(catalog.concept_label(args.concept))
        elif args.command == "list":
            for item in catalog.ordered():
                if args.difficulty and item.difficulty != args.difficulty:
                    continue
                if args.concept and args.concept not in item.teaches and args.concept not in item.requires:
                    continue
                print(f"{item.serial}\t{item.path}\t{item.title}")
        elif args.command == "export":
            records = []
            for item in catalog.ordered():
                records.append({
                    "id": item.id, "serial": item.serial, "sequence": item.sequence,
                    "path": item.path.as_posix(), "title": item.title,
                    "stage": item.stage, "kind": item.kind, "status": item.status,
                    "tradecraft": list(item.tradecraft), "difficulty": item.difficulty,
                    "prerequisites": list(item.prerequisites),
                    "teaches": list(item.teaches), "requires": list(item.requires),
                    "workspace": {
                        "mode": item.workspace.mode, "source": item.workspace.source or None,
                        "files": list(item.workspace.files),
                        "editable": list(item.workspace.editable), "build": item.workspace.build,
                        "baseline": item.workspace.baseline,
                        "parent": item.workspace.parent or None,
                        "additions": item.workspace.additions or None,
                        "module_artifact": catalog.module_artifact(item),
                        "module_artifact_override": item.workspace.module_artifact or None,
                    },
                    "resources": {
                        "readme": item.resources.readme, "check": item.resources.check,
                        "host_check": item.resources.host_check or None,
                        "hint": item.resources.hint, "solution": item.resources.solution,
                    },
                    "verification": {
                        "timeout_seconds": item.verification.timeout_seconds,
                        "capabilities": list(item.verification.capabilities),
                        "tools": list(item.verification.tools),
                        "cleanup_required": item.verification.cleanup_required,
                        "cases": [
                            {
                                "id": case.id,
                                "label": case.label,
                                "build_variables": dict(case.build_variables),
                                "expect_build": case.expect_build,
                                "check": case.check,
                                "build_output_contains": case.build_output_contains,
                            }
                            for case in catalog.verification_cases(item)
                        ],
                    },
                })
            print(json.dumps({
                "revision": catalog.revision,
                "default_module_artifact": catalog.default_module_artifact,
                "exercises": records,
            }, indent=2))
    except CatalogError as exc:
        print(f"[x] {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
