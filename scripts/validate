#!/usr/bin/bash
set -Eeuo pipefail
export LC_ALL=C LANG=C TZ=UTC ARCH=x86_64 CC=gcc HOSTCC=gcc
unset CROSS_COMPILE KCONFIG_CONFIG LOCALVERSION KCFLAGS KCPPFLAGS KAFLAGS \
    HOSTCFLAGS HOSTLDFLAGS LLVM LLVM_IAS MAKEFLAGS MFLAGS

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
BUILD_ASSETS=1
if [[ ${1:-} == --quick ]]; then BUILD_ASSETS=0; shift; fi
(( $# == 0 )) || { printf 'usage: %s [--quick]\n' "$0" >&2; exit 2; }
cd "$ROOT_DIR"
fail() { printf '[x] %s\n' "$*" >&2; exit 1; }

catalog_rows()
{
    python3 - <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd()))
from engine.catalog import Catalog
catalog = Catalog(Path.cwd())
for item in catalog.display_order():
    print("\x1f".join((item.id, item.workspace.baseline, item.workspace.build)))
PY
}

check_catalog_assets()
{
    scripts/catalog validate || fail 'exercise metadata validation failed'
    python3 - <<'PY'
from pathlib import Path
import stat
import subprocess, sys
sys.path.insert(0, str(Path.cwd()))
from engine.catalog import Catalog
from engine.solutions import full_solution_tree, overlay_solution_tree

root = Path.cwd()
catalog = Catalog(root)
failures = []
required_root = root / "curriculum/required"
manifests = set(required_root.glob("*/exercise.toml"))
bundle_directories = set()
for path in required_root.iterdir():
    if path.is_symlink() or not path.is_dir():
        failures.append(
            f"required curriculum entry is not a real bundle directory: "
            f"{path.relative_to(root)}"
        )
    else:
        bundle_directories.add(path)
manifest_directories = {path.parent for path in manifests}
for path in sorted(bundle_directories - manifest_directories):
    failures.append(f"bundle has no exercise manifest: {path.relative_to(root)}")
declared_manifests = {root / item.path / "exercise.toml" for item in catalog.exercises}
for path in sorted(manifests - declared_manifests):
    failures.append(f"orphaned exercise manifest: {path.relative_to(root)}")
for path in sorted(declared_manifests - manifests):
    failures.append(f"missing required exercise manifest: {path.relative_to(root)}")

def regular(path, mode, label):
    if path.is_symlink() or not path.is_file():
        failures.append(f"{label} is not a regular file: {path.relative_to(root)}")
        return
    actual = stat.S_IMODE(path.stat().st_mode)
    if actual != mode:
        failures.append(
            f"{label} has mode {actual:04o}, expected {mode:04o}: "
            f"{path.relative_to(root)}"
        )

solution_cache = {}
for item in catalog.exercises:
    bundle = root / item.path
    expected_bundle = required_root / item.id
    if bundle != expected_bundle:
        failures.append(f"{item.id}: bundle path must be curriculum/required/{item.id}")
        continue
    if bundle.is_symlink() or not bundle.is_dir():
        failures.append(f"{item.id}: bundle must be a real directory")
        continue

    expected_paths = {
        "exercise.toml", "README.md", "hint", "checks", "solution",
    }
    starter_declared = item.workspace.source or item.workspace.additions
    if starter_declared:
        expected_paths.add("starter")
        if Path(starter_declared) != item.path / "starter":
            failures.append(f"{item.id}: starter must be owned by its bundle")
    if (bundle / "fixtures").exists():
        expected_paths.add("fixtures")
    actual_paths = {path.name for path in bundle.iterdir()}
    if actual_paths != expected_paths:
        failures.append(
            f"{item.id}: bundle entries mismatch "
            f"(missing={sorted(expected_paths-actual_paths)}, "
            f"unknown={sorted(actual_paths-expected_paths)})"
        )

    resources = item.resources
    expected_readme = item.path / "README.md"
    expected_hint = item.path / "hint"
    expected_solution = item.path / "solution"
    if Path(resources.readme) != expected_readme:
        failures.append(f"{item.id}: README must be owned by its bundle")
    if Path(resources.hint) != expected_hint:
        failures.append(f"{item.id}: hint must be owned by its bundle")
    if Path(resources.solution) != expected_solution:
        failures.append(f"{item.id}: solution must be owned by its bundle")
    regular(bundle / "exercise.toml", 0o644, f"{item.id} manifest")
    regular(bundle / "README.md", 0o644, f"{item.id} README")
    regular(bundle / "hint", 0o644, f"{item.id} hint")

    for directory_name in ("checks", "solution"):
        directory = bundle / directory_name
        if directory.is_symlink() or not directory.is_dir():
            failures.append(f"{item.id}: {directory_name} must be a real directory")
    for optional in ("starter", "fixtures"):
        directory = bundle / optional
        if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
            failures.append(f"{item.id}: {optional} must be a real directory")

    checks = bundle / "checks"
    owned_checks = [] if not checks.is_dir() else sorted(checks.rglob("*"))
    if not any(path.is_file() for path in owned_checks):
        failures.append(f"{item.id}: checks directory is empty")
    for path in owned_checks:
        if path.is_dir() and not path.is_symlink():
            continue
        regular(path, 0o755, f"{item.id} check")

    for path in sorted(bundle.rglob("*")):
        if path.is_symlink():
            failures.append(f"{item.id}: bundle contains symlink: {path.relative_to(root)}")
        elif not path.is_dir() and not path.is_file():
            failures.append(f"{item.id}: bundle contains special file: {path.relative_to(root)}")
        elif path.is_file() and checks not in path.parents:
            regular(path, 0o644, f"{item.id} asset")

    referenced_checks = [resources.check, resources.host_check]
    referenced_checks.extend(case.check for case in catalog.verification_cases(item))
    for value in filter(None, referenced_checks):
        path = root / value
        try:
            relative = path.relative_to(required_root)
        except ValueError:
            failures.append(f"{item.id}: check is outside curriculum/required: {value}")
            continue
        if len(relative.parts) < 3 or relative.parts[1] != "checks":
            failures.append(f"{item.id}: check is outside a bundle checks directory: {value}")
        regular(path, 0o755, f"{item.id} referenced check")

    try:
        solution = catalog.solution_tree(item, solution_cache)
        if set(solution) != set(item.workspace.files):
            failures.append(f"{item.id}: composed solution paths differ from workspace files")
        if any(value.mode != 0o644 for value in solution.values()):
            failures.append(f"{item.id}: composed solution contains executable source")

        if item.workspace.baseline == "template":
            starter = full_solution_tree(
                root / item.workspace.source, item.workspace.files
            )
        elif item.workspace.baseline == "scaffold":
            starter = catalog.starter_tree(item, solution_cache)
        else:
            provider = catalog.baseline_provider(item)
            assert provider is not None
            starter = catalog.solution_tree(provider, solution_cache)
            if item.workspace.additions:
                starter = overlay_solution_tree(
                    starter,
                    root / item.workspace.additions,
                    provider.workspace.files,
                    item.workspace.files,
                )
        if set(starter) != set(item.workspace.files):
            failures.append(f"{item.id}: composed starter paths differ from workspace files")
        if any(value.mode != 0o644 for value in starter.values()):
            failures.append(f"{item.id}: composed starter contains executable source")
    except Exception as error:
        failures.append(f"{item.id}: tree composition failed: {error}")

tracked = subprocess.run(["git", "ls-files", "--", ".rootkitlings"], check=True, text=True, stdout=subprocess.PIPE).stdout.splitlines()
for path in tracked:
    if (root / path).is_file(): failures.append(f"shipped file remains under .rootkitlings: {path}")
if failures: raise SystemExit("\n".join(failures))
print(f"[+] catalog assets: {len(catalog.exercises)} manifest-owned bundles")
PY
}

check_scripts()
{
    local check interpreter
    bash -n vm/boot scripts/doctor scripts/lesson-env scripts/toolbox/bc scripts/validate
    sh -n vm/init vm/checks/containment vm/checks/lib.sh
    python3 -m py_compile rootkitlings engine/*.py scripts/catalog scripts/check-doc-links \
        scripts/expand-compile-db scripts/kernel scripts/test-solutions
    while IFS= read -r -d '' check; do
        IFS= read -r interpreter < "$check" || true
        case $interpreter in
            '#!/bin/sh') sh -n "$check" ;;
            '#!/usr/bin/bash') bash -n "$check" ;;
            *) fail "bundle check has unsupported interpreter: $check" ;;
        esac
    done < <(find curriculum/required -path '*/checks/*' -type f -print0 | sort -z)
    python3 scripts/format-docs --check
    python3 scripts/check-doc-links
    if command -v shellcheck >/dev/null; then
        shellcheck -S warning vm/boot vm/init scripts/doctor scripts/lesson-env scripts/toolbox/bc scripts/validate
        shellcheck -S warning -s busybox vm/checks/lib.sh vm/checks/containment
        while IFS= read -r -d '' check; do
            IFS= read -r interpreter < "$check" || true
            case $interpreter in
                '#!/bin/sh') shellcheck -S warning -x -s sh "$check" ;;
                '#!/usr/bin/bash') shellcheck -S warning -x -s bash "$check" ;;
            esac
        done < <(find curriculum/required -path '*/checks/*' -type f -print0 | sort -z)
    fi
    printf '[+] scripts\n'
}

build_assets()
{
    local id baseline declared_build build_path work tree log
    local templates=0 derived=0 solutions=0
    KDIR=$(scripts/kernel build-dir) || fail 'course kernel is not ready; run scripts/kernel ensure'
    [[ -d $KDIR ]] || fail "kernel build directory not found: $KDIR"
    work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-validate.XXXXXX")
    trap 'rm -rf -- "$work"' RETURN
    mkdir -p "$work/starters" "$work/solutions"
    python3 - "$work/starters" "$work/solutions" <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd()))
from engine.catalog import Catalog
from engine.solutions import (
    full_solution_tree,
    materialize_solution_tree,
)
catalog = Catalog(Path.cwd())
starter_root = Path(sys.argv[1])
solution_root = Path(sys.argv[2])
for item in catalog.exercises:
    if item.workspace.baseline == "template":
        starter = full_solution_tree(
            catalog.root / item.workspace.source, item.workspace.files
        )
        materialize_solution_tree(starter, starter_root, item.id)
    catalog.materialize_solution(item, solution_root, item.id)
PY
    while IFS=$'\x1f' read -r id baseline declared_build; do
        if [[ $baseline == template ]]; then
            tree=$work/starters/$id
            log=$work/starter-$id.log
            build_path=$declared_build
            [[ $build_path == . ]] && build_path=$tree || build_path=$tree/$build_path
            if ! make -s -C "$KDIR" M="$build_path" W=1 modules >"$log" 2>&1 || grep -q 'warning:' "$log"; then cat "$log" >&2; fail "template starter does not build warning-free: $id"; fi
            (( ++templates ))
        else
            (( ++derived ))
        fi
        tree=$work/solutions/$id
        log=$work/solution-$id.log
        build_path=$declared_build
        [[ $build_path == . ]] && build_path=$tree || build_path=$tree/$build_path
        if ! make -s -C "$KDIR" M="$build_path" W=1 modules >"$log" 2>&1 || grep -q 'warning:' "$log"; then cat "$log" >&2; fail "solution does not build warning-free: $id"; fi
        (( ++solutions ))
    done < <(catalog_rows)
    printf '[+] template starters: %d warning-free builds, %d derived starters structurally validated\n' "$templates" "$derived"
    printf '[+] solutions: %d warning-free builds\n' "$solutions"
}

check_catalog_assets
check_scripts
python3 -m unittest discover -s tests
if (( BUILD_ASSETS )); then build_assets; fi
printf '[+] validation passed\n'
