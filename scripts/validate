#!/usr/bin/bash
set -Eeuo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
KDIR=${KDIR:-/lib/modules/$(uname -r)/build}
BUILD_ASSETS=1
if [[ ${1:-} == --quick ]]; then BUILD_ASSETS=0; shift; fi
(( $# == 0 )) || { printf 'usage: %s [--quick]\n' "$0" >&2; exit 2; }
cd "$ROOT_DIR"
fail() { printf '[x] %s\n' "$*" >&2; exit 1; }

catalog_rows()
{
    python3 - <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / "lib"))
from catalog import Catalog
catalog = Catalog(Path.cwd())
for item in sorted(catalog.exercises, key=lambda value: (value.sequence < 0, value.sequence, value.id)):
    print("\x1f".join((item.id, item.workspace.baseline, item.workspace.source,
          ",".join(item.workspace.files), item.workspace.build)))
PY
}

check_catalog_assets()
{
    scripts/catalog validate || fail 'exercise metadata validation failed'
    python3 - <<'PY'
from pathlib import Path
import subprocess, sys
sys.path.insert(0, str(Path.cwd() / "lib"))
from catalog import Catalog
root = Path.cwd(); catalog = Catalog(root); failures = []
templates, solutions, support = set(), set(), set()
def executable(path):
    return path.is_file() and not path.is_symlink() and bool(path.stat().st_mode & 0o111)
for item in catalog.exercises:
    r = item.resources
    expected_support = Path("curriculum/support") / item.id
    expected_solution = Path("curriculum/solutions") / item.id
    support.add(expected_support); solutions.add(expected_solution)
    if Path(r.check) != expected_support / "check": failures.append(f"{item.id}: nonuniform check path: {r.check}")
    if Path(r.hint) != expected_support / "hint": failures.append(f"{item.id}: nonuniform hint path: {r.hint}")
    if r.host_check and Path(r.host_check) != expected_support / "host-check": failures.append(f"{item.id}: nonuniform host-check path: {r.host_check}")
    if Path(r.solution) != expected_solution: failures.append(f"{item.id}: nonuniform solution path: {r.solution}")
    if not executable(root / r.check): failures.append(f"{item.id}: check is not executable: {r.check}")
    hint = root / r.hint
    if not hint.is_file() or hint.is_symlink() or hint.stat().st_mode & 0o111: failures.append(f"{item.id}: hint is not a non-executable regular file: {r.hint}")
    if r.host_check and not executable(root / r.host_check): failures.append(f"{item.id}: host-check is not executable: {r.host_check}")
    try:
        composed = catalog.solution_tree(item)
    except Exception as error:
        failures.append(f"{item.id}: solution composition failed: {error}")
    else:
        if set(composed) != set(item.workspace.files): failures.append(f"{item.id}: composed solution paths differ from workspace files")
    if item.workspace.baseline == "template":
        expected = Path("curriculum/templates") / item.id; templates.add(expected)
        if Path(item.workspace.source) != expected: failures.append(f"{item.id}: nonuniform template path: {item.workspace.source}")
def directories(path): return {entry.relative_to(root) for entry in path.iterdir() if entry.is_dir()}
for label, actual, declared in (("template", directories(root/"curriculum/templates"), templates), ("solution", directories(root/"curriculum/solutions"), solutions), ("support", directories(root/"curriculum/support"), support)):
    for path in sorted(actual-declared): failures.append(f"orphaned {label} directory: {path}")
    for path in sorted(declared-actual): failures.append(f"missing {label} directory: {path}")
for exercise_root in catalog.exercise_roots:
    base = root / exercise_root
    for path in base.rglob("*"):
        if path.is_file() and (path.name == "Kbuild" or path.suffix in {".c", ".h"}): failures.append(f"scaffold source remains in documentation directory: {path.relative_to(root)}")
tracked = subprocess.run(["git", "ls-files", "--", ".rootkitlings"], check=True, text=True, stdout=subprocess.PIPE).stdout.splitlines()
for path in tracked:
    if (root / path).is_file(): failures.append(f"shipped file remains under .rootkitlings: {path}")
if failures: raise SystemExit("\n".join(failures))
print(f"[+] catalog assets: {len(catalog.exercises)} exercises")
PY
}

check_scripts()
{
    bash -n vm/boot scripts/doctor scripts/validate scripts/test-solutions
    sh -n vm/init vm/checks/containment lib/check.sh
    python3 -m py_compile rootkitlings lib/catalog.py lib/setup_gate.py scripts/catalog scripts/check-doc-links
    while IFS= read -r check; do bash -n "$check"; done < <(find curriculum/support -name check -o -name host-check)
    python3 scripts/format-docs --check
    python3 scripts/check-doc-links
    if command -v shellcheck >/dev/null; then
        shellcheck -S warning vm/boot vm/init scripts/validate scripts/test-solutions
        shellcheck -S warning -s busybox lib/check.sh vm/checks/containment
        while IFS= read -r host_check; do shellcheck -S warning "$host_check"; done < <(find curriculum/support -name host-check -type f -print)
    fi
    printf '[+] scripts\n'
}

build_assets()
{
    local id baseline source files build_path work tree log relative
    local templates=0 completions=0 solutions=0
    [[ -d $KDIR ]] || fail "kernel build directory not found: $KDIR"
    work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-validate.XXXXXX")
    trap 'rm -rf -- "$work"' RETURN
    mkdir -p "$work/solutions"
    python3 - "$work/solutions" <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / "lib"))
from catalog import Catalog
catalog = Catalog(Path.cwd())
destination = Path(sys.argv[1])
for item in catalog.exercises:
    catalog.materialize_solution(item, destination, item.id)
PY
    while IFS=$'\x1f' read -r id baseline source files build_path; do
        if [[ $baseline == template ]]; then
            tree=$work/templates/$id; mkdir -p "$tree"
            while IFS= read -r relative; do
                [[ -n $relative ]] || continue
                mkdir -p "$tree/$(dirname "$relative")"; cp -p "$source/$relative" "$tree/$relative"
            done < <(tr ',' '\n' <<< "$files")
            log=$work/template-$id.log
            [[ $build_path == . ]] && build_path=$tree || build_path=$tree/$build_path
            if ! make -s -C "$KDIR" M="$build_path" W=1 modules >"$log" 2>&1 || grep -q 'warning:' "$log"; then cat "$log" >&2; fail "template does not build warning-free: $id"; fi
            (( ++templates ))
        else
            (( ++completions ))
        fi
        tree=$work/solutions/$id
        log=$work/solution-$id.log
        if ! make -s -C "$KDIR" M="$tree" W=1 modules >"$log" 2>&1 || grep -q 'warning:' "$log"; then cat "$log" >&2; fail "solution does not build warning-free: $id"; fi
        (( ++solutions ))
    done < <(catalog_rows)
    printf '[+] templates: %d warning-free builds, %d completion baselines skipped\n' "$templates" "$completions"
    printf '[+] solutions: %d warning-free builds\n' "$solutions"
}

check_catalog_assets
check_scripts
python3 -m unittest discover -s tests
if (( BUILD_ASSETS )); then build_assets; fi
printf '[+] validation passed\n'
