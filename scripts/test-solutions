#!/usr/bin/python3
"""Build and run reference solutions through the learner verification path."""

from __future__ import annotations

from pathlib import Path
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT))

from engine.catalog import Catalog, CatalogError  # noqa: E402
from engine.console import Console  # noqa: E402
from engine.process import ProcessError, ProcessTimeout, run_process  # noqa: E402
from engine.verification import (  # noqa: E402
    VerificationError,
    build_verification_cases,
)


class SolutionCheckError(RuntimeError):
    pass


UI = Console("rootkitlings.solution-tests")


def run(command: list[str], timeout: int | None = None):
    try:
        return run_process(
            command,
            cwd=ROOT,
            timeout=timeout,
            capture=True,
            discard_stdin=True,
        )
    except (ProcessError, ProcessTimeout) as error:
        raise SolutionCheckError(str(error)) from error


def boot_arguments(catalog: Catalog, item, timeout: int) -> list[str]:
    binaries = {tool.id: tool.binary for tool in catalog.tools}
    arguments: list[str] = []
    for capability in item.verification.capabilities:
        arguments += ["--cap", capability]
    for tool_id in item.verification.tools:
        binary = binaries[tool_id]
        arguments += ["--tool", binary]
    return arguments


def verify_item(
    catalog: Catalog, item, solution_root: Path, kernel_build_dir: Path
) -> None:
    source = catalog.materialize_solution(item, solution_root, item.id)
    timeout = item.verification.timeout_seconds
    arguments = boot_arguments(catalog, item, timeout)
    with build_verification_cases(
        ROOT,
        source,
        item.workspace.files,
        item.workspace.build,
        catalog.module_artifact(item),
        catalog.verification_cases(item),
        timeout,
        kernel_build_dir=kernel_build_dir,
    ) as verification:
        outcomes = verification.outcomes
        host_check_pending = bool(item.resources.host_check)
        for index, outcome in enumerate(outcomes, 1):
            UI.progress(f"Case {index} of {len(outcomes)}  {outcome.case.label}")
            if outcome.artifact is None:
                UI.success("Build rejected as required")
                continue
            if host_check_pending:
                host = run([
                    str(ROOT / item.resources.host_check),
                    str(outcome.build_root),
                    str(outcome.artifact),
                ], timeout)
                if host.stdout:
                    UI.raw_block(host.stdout, error=bool(host.returncode))
                if host.returncode:
                    raise SolutionCheckError("source and artifact check failed")
                host_check_pending = False
            guest = run([
                str(ROOT / "vm/boot"),
                *arguments,
                "--check",
                str(ROOT / outcome.case.check),
                *(
                    value
                    for argument in getattr(
                        outcome.case, "check_arguments", ()
                    )
                    for value in ("--check-arg", argument)
                ),
                str(outcome.artifact),
            ], timeout)
            if guest.stdout:
                UI.raw_block(guest.stdout, error=bool(guest.returncode))
            if guest.returncode:
                raise SolutionCheckError(
                    f"guest check failed: {outcome.case.label}"
                )
        if host_check_pending:
            raise SolutionCheckError("no successful artifact was available for host checks")


def main(arguments: list[str]) -> int:
    try:
        catalog = Catalog(ROOT)
        requested = {catalog.resolve(value).id for value in arguments}
    except CatalogError as error:
        UI.error(str(error))
        return 2
    items = sorted(
        catalog.exercises,
        key=lambda item: (item.sequence < 0, item.sequence, item.id),
    )
    if requested:
        items = [item for item in items if item.id in requested]
    passed = 0
    failed = 0
    located = run([str(ROOT / "scripts/kernel"), "build-dir"], 10)
    kernel_build_dir = Path((located.stdout or "").strip())
    if located.returncode or not kernel_build_dir.is_dir() or kernel_build_dir.is_symlink():
        UI.error("course kernel is not ready; run: scripts/kernel ensure")
        return 1
    with tempfile.TemporaryDirectory(prefix="rootkitlings-solutions-") as temporary:
        solution_root = Path(temporary)
        for item in items:
            shown = item.serial or item.id
            UI.section(f"{shown}  {item.title}")
            try:
                verify_item(catalog, item, solution_root, kernel_build_dir)
            except (OSError, SolutionCheckError, VerificationError) as error:
                UI.error(f"{item.id} failed: {error}")
                failed += 1
            else:
                UI.success(f"{item.id} passed")
                passed += 1
    UI.section("Solution tests")
    UI.field("Passed", str(passed), value_style="success")
    UI.field("Failed", str(failed), value_style="error" if failed else None)
    return int(failed != 0)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
