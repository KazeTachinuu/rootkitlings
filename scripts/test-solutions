#!/usr/bin/bash
set -Eeuo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-tests.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
cd "$ROOT_DIR"

declare -A requested=()
for filter; do
    id=$(scripts/catalog query "$filter" id)
    requested[$id]=1
done

runtime_rows()
{
    python3 - <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / "lib"))
from catalog import Catalog
catalog = Catalog(Path.cwd()); tools = {tool.id: tool.binary for tool in catalog.tools}
for item in sorted(catalog.exercises, key=lambda value: (value.sequence < 0, value.sequence, value.id)):
    r, v = item.resources, item.verification
    print("\x1f".join((item.id, item.serial, r.solution, r.check, r.host_check,
          str(v.timeout_seconds), ",".join(v.capabilities),
          ",".join(tools[value] for value in v.tools))))
PY
}

passed=0 failed=0 matched=0
while IFS=$'\x1f' read -r id serial solution check host_check timeout_seconds capabilities tools; do
    (( $# == 0 )) || [[ -n ${requested[$id]:-} ]] || continue
    (( ++matched ))
    build=$work/$id; cp -a "$solution" "$build"
    printf '\n[*] %s (%s)\n' "$serial" "$id"
    output=; boot_args=()
    while IFS= read -r capability; do [[ -n $capability ]] && boot_args+=(--cap "$capability"); done < <(tr ',' '\n' <<< "$capabilities")
    while IFS= read -r tool; do
        [[ -n $tool ]] || continue
        make --quiet "$tool"; boot_args+=(--tool "$tool")
    done < <(tr ',' '\n' <<< "$tools")
    if make --quiet module MODULE_DIR="$build" &&
        { [[ -z $host_check ]] || "$host_check" "$build"; } &&
        output=$(timeout --foreground "$timeout_seconds" vm/boot "${boot_args[@]}" --check "$check" "$build/hello.ko" </dev/null 2>&1) &&
        [[ $output == *"[+] PASSED"* ]]; then
        printf '%s\n[+] %s passed\n' "$output" "$id"; (( ++passed ))
    else
        printf '%s\n[x] %s failed\n' "${output:-build or host check failed}" "$id" >&2; (( ++failed ))
    fi
done < <(runtime_rows)

(( $# == 0 || matched == ${#requested[@]} )) || { printf '[x] one or more requested exercises were not found\n' >&2; exit 1; }
printf '\n[*] solution tests: %d passed, %d failed\n' "$passed" "$failed"
(( failed == 0 ))
