#!/usr/bin/env python3
"""Build and run reference solutions through the learner verification path."""

from __future__ import annotations

from pathlib import Path
import re
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT))

from engine.catalog import Catalog, CatalogError  # noqa: E402
from engine.console import Console  # noqa: E402
from engine.process import (  # noqa: E402
    ProcessError,
    ProcessTimeout,
    run_process,
)
from engine.verification import (  # noqa: E402
    VerificationError,
    build_verification_cases,
)


class SolutionCheckError(RuntimeError):
    pass


UI = Console("rklings.solution-tests")


def require_compiled_sources(source: Path, build_relative: str) -> None:
    build = source if build_relative == "." else source / build_relative
    kbuild = build / "Kbuild"
    try:
        lines = kbuild.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        raise SolutionCheckError(f"cannot read {kbuild}: {error}") from error
    logical_lines: list[str] = []
    current = ""
    for line in lines:
        content = line.split("#", 1)[0].rstrip()
        if content.endswith("\\"):
            current += content[:-1] + " "
            continue
        logical_lines.append(current + content)
        current = ""
    if current:
        logical_lines.append(current)
    objects: set[str] = set()
    assignment = re.compile(
        r"^\s*rklings-(?:y|objs)\s*(?::=|\+=|=)\s*(.*)$"
    )
    object_token = re.compile(r"^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\.o$")
    for line in logical_lines:
        match = assignment.match(line)
        if not match:
            continue
        objects.update(
            token for token in match.group(1).split()
            if object_token.fullmatch(token)
        )
    missing = []
    for candidate in sorted(build.rglob("*.c")):
        relative = candidate.relative_to(build).as_posix()
        if f"{relative[:-2]}.o" not in objects:
            missing.append(relative)
    if missing:
        joined = ", ".join(missing)
        raise SolutionCheckError(f"Kbuild omits declared C source: {joined}")


def run(command: list[str], timeout: int | None = None):
    try:
        return run_process(
            command,
            cwd=ROOT,
            timeout=timeout,
            capture=True,
            discard_stdin=True,
        )
    except (ProcessError, ProcessTimeout) as error:
        raise SolutionCheckError(str(error)) from error


def boot_arguments(catalog: Catalog, item) -> list[str]:
    binaries = {tool.id: tool.binary for tool in catalog.tools}
    arguments: list[str] = []
    for tool_id in item.verification.tools:
        binary = binaries[tool_id]
        arguments += ["--tool", binary]
    return arguments


def verify_item(
    catalog: Catalog, item, solution_root: Path, kernel_build_dir: Path
) -> None:
    source = catalog.materialize_solution(item, solution_root, item.id)
    require_compiled_sources(source, item.workspace.build)
    timeout = item.verification.timeout_seconds
    arguments = boot_arguments(catalog, item)
    with build_verification_cases(
        ROOT,
        source,
        item.workspace.files,
        item.workspace.build,
        catalog.module_artifact(item),
        item.verification.cases,
        timeout,
        kernel_build_dir=kernel_build_dir,
    ) as verification:
        outcomes = verification.outcomes
        host_check_pending = bool(item.resources.host_check)
        for index, outcome in enumerate(outcomes, 1):
            UI.progress(
                f"Case {index} of {len(outcomes)}  {outcome.case.label}"
            )
            if outcome.artifact is None:
                UI.success("Build rejected as required")
                continue
            if host_check_pending:
                host = run([
                    str(ROOT / item.resources.host_check),
                    str(outcome.build_root),
                    str(outcome.artifact),
                ], timeout)
                if host.stdout:
                    UI.raw_block(host.stdout, error=bool(host.returncode))
                if host.returncode:
                    raise SolutionCheckError("source and artifact check failed")
                host_check_pending = False
            guest = run([
                str(ROOT / "vm/boot"),
                *arguments,
                "--check",
                str(ROOT / outcome.case.check),
                *(
                    value
                    for argument in outcome.case.check_arguments
                    for value in ("--check-arg", argument)
                ),
                str(outcome.artifact),
            ], timeout)
            if guest.stdout:
                UI.raw_block(guest.stdout, error=bool(guest.returncode))
            if guest.returncode:
                raise SolutionCheckError(
                    f"guest check failed: {outcome.case.label}"
                )
        if host_check_pending:
            raise SolutionCheckError(
                "no successful artifact was available for host checks"
            )


def main(arguments: list[str]) -> int:
    try:
        catalog = Catalog(ROOT)
        requested = {catalog.resolve(value).id for value in arguments}
    except CatalogError as error:
        UI.error(str(error))
        return 2
    items = sorted(
        catalog.exercises,
        key=lambda item: (item.sequence < 0, item.sequence, item.id),
    )
    if requested:
        items = [item for item in items if item.id in requested]
    passed = 0
    failed = 0
    located = run([str(ROOT / "scripts/kernel"), "build-dir"], 10)
    kernel_build_dir = Path((located.stdout or "").strip())
    if (
        located.returncode
        or not kernel_build_dir.is_dir()
        or kernel_build_dir.is_symlink()
    ):
        UI.error("course kernel is not ready; run: scripts/kernel ensure")
        return 1
    with tempfile.TemporaryDirectory(
        prefix="rklings-solutions-"
    ) as temporary:
        solution_root = Path(temporary)
        for item in items:
            shown = item.serial or item.id
            UI.section(f"{shown}  {item.title}")
            try:
                verify_item(catalog, item, solution_root, kernel_build_dir)
            except (OSError, SolutionCheckError, VerificationError) as error:
                UI.error(f"{item.id} failed: {error}")
                failed += 1
            else:
                UI.success(f"{item.id} passed")
                passed += 1
    UI.section("Solution tests")
    UI.field("Passed", str(passed), value_style="success")
    UI.field("Failed", str(failed), value_style="error" if failed else None)
    return int(failed != 0)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
