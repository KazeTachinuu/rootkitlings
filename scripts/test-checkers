#!/usr/bin/env python3
"""Run each exercise checker's regression suite."""

from __future__ import annotations

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT))

from engine.catalog import Catalog, CatalogError  # noqa: E402
from engine.console import Console  # noqa: E402
from engine.process import ProcessError, run_process  # noqa: E402


UI = Console("rklings.checker-tests")
CHECKER_TIMEOUT_SECONDS = 30 * 60


def main(arguments: list[str]) -> int:
    try:
        catalog = Catalog(ROOT)
        requested = {catalog.resolve(value).id for value in arguments}
    except CatalogError as error:
        UI.error(str(error))
        return 2

    items = catalog.required()
    if requested:
        items = tuple(item for item in items if item.id in requested)

    runnable = [
        item for item in items
        if (ROOT / item.path / "checks/test").is_file()
    ]
    skipped = len(items) - len(runnable)
    total = len(runnable)

    passed = 0
    failures: list[tuple[str, str]] = []
    width = len(str(total))

    for index, item in enumerate(runnable, 1):
        label = item.serial or item.id
        check = ROOT / item.path / "checks/test"
        UI.progress(f"  {label:<6} {index:>{width}}/{total}")
        try:
            result = run_process(
                [check],
                cwd=ROOT,
                timeout=CHECKER_TIMEOUT_SECONDS,
                discard_stdin=True,
                capture=True,
            )
        except ProcessError as error:
            failures.append((label, str(error)))
        else:
            if result.returncode:
                output = (result.stdout or "") + (result.stderr or "")
                failures.append((label, output))
            else:
                passed += 1

    if failures:
        for label, output in failures:
            UI.error(f"FAIL: {label}")
            if output:
                UI.raw(output[-500:], error=True)
                if not output.endswith("\n"):
                    UI.raw("\n", error=True)

    UI.success(f"Checkers: {passed}/{total} passed")
    if skipped:
        UI.progress(f"  {skipped} without local checker (VM-only)")
    if failures:
        UI.error(f"  {len(failures)} failed: {', '.join(l for l, _ in failures)}")
    return int(bool(failures))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
