#!/usr/bin/env python3
"""Run each exercise checker's regression suite."""

from __future__ import annotations

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT))

from engine.catalog import Catalog, CatalogError  # noqa: E402
from engine.console import Console  # noqa: E402
from engine.process import ProcessError, run_process  # noqa: E402


UI = Console("rklings.checker-tests")
CHECKER_TIMEOUT_SECONDS = 30 * 60


def main(arguments: list[str]) -> int:
    try:
        catalog = Catalog(ROOT)
        requested = {catalog.resolve(value).id for value in arguments}
    except CatalogError as error:
        UI.error(str(error))
        return 2

    items = catalog.required()
    if requested:
        items = tuple(item for item in items if item.id in requested)

    passed = 0
    failed = 0
    skipped = 0
    for item in items:
        label = item.serial or item.id
        check = ROOT / item.path / "checks/test"
        if not check.is_file():
            skipped += 1
            continue
        UI.section(f"{label}  {item.title}")
        UI.transcript([check.relative_to(ROOT)])
        try:
            result = run_process(
                [check],
                cwd=ROOT,
                timeout=CHECKER_TIMEOUT_SECONDS,
                discard_stdin=True,
            )
        except ProcessError as error:
            UI.error(str(error))
            failed += 1
        else:
            if result.returncode:
                UI.error(f"{label} checker failed (exit {result.returncode})")
                failed += 1
            else:
                UI.success(f"{label} checker passed")
                passed += 1

    UI.section("Checker tests")
    UI.field("Passed", str(passed), value_style="success")
    UI.field("Failed", str(failed), value_style="error" if failed else None)
    if skipped:
        UI.field("Skipped", f"{skipped} (no local checker)", value_style="dim")
    return int(failed != 0)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
