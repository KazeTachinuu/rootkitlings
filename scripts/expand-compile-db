#!/usr/bin/env python3
"""Expand compile_commands.json across shipped templates and solutions."""

from __future__ import annotations

import json
from pathlib import Path
import shlex
import sys


ROOT = Path(__file__).resolve().parent.parent


def source_argument(arguments: list[str], original: str) -> int:
    for index, argument in enumerate(arguments):
        if argument == original:
            return index
    for index in range(len(arguments) - 1, -1, -1):
        if arguments[index].endswith('.c'):
            return index
    raise ValueError('base compile command contains no C source argument')


def expanded_entry(base: dict[str, object], source: Path) -> dict[str, object]:
    original = str(Path(str(base['file'])).resolve())
    replacement = str(source.resolve())
    entry: dict[str, object] = {
        'directory': base['directory'],
        'file': replacement,
    }
    if 'arguments' in base:
        arguments = list(base['arguments'])
        arguments[source_argument(arguments, original)] = replacement
        entry['arguments'] = arguments
    elif 'command' in base:
        arguments = shlex.split(str(base['command']))
        arguments[source_argument(arguments, original)] = replacement
        entry['command'] = shlex.join(arguments)
    else:
        raise ValueError('base compile command has neither arguments nor command')
    return entry


def main() -> int:
    database_path = Path(sys.argv[1] if len(sys.argv) > 1 else 'compile_commands.json')
    with database_path.open(encoding='utf-8') as stream:
        database = json.load(stream)
    if not database:
        raise ValueError('compile database is empty')

    base = database[0]
    existing = {str(Path(entry['file']).resolve()) for entry in database}
    sources = set((ROOT / 'curriculum/templates').glob('**/*.c'))
    sources.update((ROOT / 'curriculum/solutions').glob('**/*.c'))

    for source in sorted(sources):
        absolute = str(source.resolve())
        if absolute not in existing:
            database.append(expanded_entry(base, source))
            existing.add(absolute)

    with database_path.open('w', encoding='utf-8') as stream:
        json.dump(database, stream, indent=2)
        stream.write('\n')
    print(f'compile_commands.json: {len(database)} entries')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
