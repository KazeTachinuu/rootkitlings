#!/usr/bin/env python3
"""Expand compile_commands.json to cover .solutions/*.c files."""
import json, glob, os, sys

db_path = sys.argv[1] if len(sys.argv) > 1 else "compile_commands.json"
db = json.load(open(db_path))
base = db[0]

existing = {e["file"] for e in db}

for f in sorted(glob.glob(".solutions/*.c") + glob.glob(".solutions/**/*.c")):
    abspath = os.path.abspath(f)
    if abspath in existing:
        continue
    entry = {
        "directory": base["directory"],
        "file": abspath,
    }
    if "arguments" in base:
        args = list(base["arguments"])
        args[-1] = abspath
        entry["arguments"] = args
    elif "command" in base:
        entry["command"] = base["command"].replace("hello.c", abspath)
    db.append(entry)

json.dump(db, open(db_path, "w"), indent=2)
print(f"compile_commands.json: {len(db)} entries")
