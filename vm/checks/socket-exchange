#!/bin/sh
# Check: module connects and sends framed data to a local listener.
# The module may fail to load fully (e.g., recv timeout), but that's
# expected when there's no protocol peer. We verify data was sent.
# Usage: socket-exchange <port> [insmod-args...]
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Socket exchange"

PORT=${1:?usage: socket-exchange <port> [insmod-args...]}
shift

ifconfig lo 127.0.0.1 up 2>/dev/null

RECV=/tmp/rklings-recv
: > "$RECV"

nc -l -p "$PORT" -w 2 > "$RECV" 2>/dev/null &
NC_PID=$!
sleep 0.2

_show_command insmod /rklings/rklings.ko "$@"
insmod /rklings/rklings.ko "$@" 2>/dev/null
# Module may return error after sending (no peer response); expected

sleep 1
kill "$NC_PID" 2>/dev/null
wait "$NC_PID" 2>/dev/null

if [ -s "$RECV" ]; then
    _ok "sent framed data"
else
    _fail "no data sent"
fi

# Clean up if loaded
if [ -d /sys/module/rklings ]; then
    unload rklings
fi
assert_absent /sys/module/rklings

summary
