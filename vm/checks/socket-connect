#!/bin/sh
# Check: module connects to a local TCP listener and sends data.
# Starts nc on 127.0.0.1:<port>, loads the module with caller-supplied
# insmod arguments, verifies data arrived, then unloads.
# Usage: socket-connect <port> [insmod-args...]
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Socket connect"

PORT=${1:?usage: socket-connect <port> [insmod-args...]}
shift

ip link set lo up 2>/dev/null

RECV=/tmp/rklings-recv
: > "$RECV"

# Start listener; -w 1 closes 1s after connection drops
{ nc -l -p "$PORT" -w 1 > "$RECV" 2>/dev/null; } &
NC_PID=$!
sleep 0.2

load rklings.ko "$@"

# Wait for data to arrive
sleep 1
kill "$NC_PID" 2>/dev/null
wait "$NC_PID" 2>/dev/null

if [ -s "$RECV" ]; then
    _ok "received data from kernel socket"
else
    _fail "no data received"
fi

assert_loaded rklings
unload rklings
assert_absent /sys/module/rklings

summary
