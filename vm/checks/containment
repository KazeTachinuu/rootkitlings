#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "Disposable guest containment"

assert_not_contains()
{
	path=$1
	unexpected=$2
	case $(cat "$path") in
		*"$unexpected"*) _fail "$path contains prohibited text: $unexpected" ;;
		*) _ok "$path does not contain: $unexpected" ;;
	esac
}

assert_loopback_only()
{
	for interface in /sys/class/net/*; do
		name=${interface##*/}
		if [ "$name" != lo ]; then
			_fail "unexpected guest network interface: $name"
			return
		fi
	done
	_ok "loopback is the only guest network interface"
}

assert_no_host_disk()
{
	for device in /dev/sd? /dev/vd? /dev/nvme?n?; do
		if [ -e "$device" ]; then
			_fail "unexpected guest disk device: $device"
			return
		fi
	done
	_ok "no host-style disk device is exposed"
}

assert_no_host_mount()
{
	while read -r _source _target filesystem _options _dump _fsck_pass; do
		case $filesystem in
			9p|virtiofs|nfs|nfs4)
				_fail "unexpected host-capable mount type: $filesystem"
				return
				;;
		esac
	done < /proc/mounts
	_ok "no 9p, virtiofs, or NFS mount is present"
}

assert_exists /proc/1/status
assert_exists /proc/mounts
assert_exists /sys/kernel
assert_exists /sys/class/net/lo
assert_contains /proc/cmdline "rootkitlings=check"
assert_not_contains /proc/cmdline "rootkitlings=network"
assert_loopback_only
assert_no_host_disk
assert_no_host_mount

summary
