#!/bin/sh

export PATH=/bin
export LC_ALL=C
export PS1='(rootkitlings) \w # '
# shellcheck source=scripts/lib/ui.sh
. /vm/ui.sh

show()
{
	ui_transcript "$*"
}

run()
{
	show "$@"
	"$@"
}

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t debugfs debugfs /sys/kernel/debug
mount -t tracefs tracefs /sys/kernel/tracing

read -r _cmdline < /proc/cmdline
for _word in $_cmdline; do
	case "$_word" in
		rootkitlings=check) _check=1 ;;
		rootkitlings=network) _network=1 ;;
		rootkitlings=play) _play=1 ;;
		rootkitlings=color) _color=1 ;;
	esac
done

if [ "${_color:-}" != 1 ]; then
	export NO_COLOR=1
fi

if [ "${_network:-}" = 1 ]; then
	run ifconfig eth0 10.0.2.15 up
fi

if [ "${_check:-}" = 1 ]; then
	export NO_COLOR=1
	printf '\nROOTKITLINGS_CHECK_BEGIN\n'
	if [ -f /check.args ]; then
		xargs -0 /check < /check.args
	else
		/check
	fi
	_rc=$?
	if [ "$_rc" -eq 0 ]; then
		printf 'ROOTKITLINGS_RESULT=pass\n'
	else
		printf 'ROOTKITLINGS_RESULT=fail:%s\n' "$_rc"
	fi
	reboot -f
	while :; do sleep 1; done
fi

if [ "${_play:-}" = 1 ]; then
	{
		read -r _play_profile
		read -r _play_key
		read -r _play_peer
		read -r _play_control_port
		read -r _play_shell_port
	} < /play.args
	_play_command="/play $_play_profile <control-key> $_play_peer"
	_play_command="$_play_command $_play_control_port $_play_shell_port"
	show "$_play_command"
	/play "$_play_profile" "$_play_key" "$_play_peer" \
		"$_play_control_port" "$_play_shell_port"
	_play_status=$?
	if [ "$_play_status" -eq 0 ]; then
		ui_success 'Play setup complete; waiting for the host operator'
		case $_play_profile in
			complete-rootkit)
				printf 'ROOTKITLINGS_PLAY_ENABLE_DONE\n' ;;
			*) printf 'ROOTKITLINGS_PLAY_READY\n' ;;
		esac
	else
		ui_error "Play setup failed with exit $_play_status"
	fi
	while :; do sleep 1; done
fi

ui_success "/init is PID $$"
ui_success 'BusyBox shell ready on ttyS0'
ui_progress 'The root filesystem lives in RAM; exit powers off the VM'
cd /rootkitlings || exit 1
ui_success 'Working directory: /rootkitlings'

show 'setsid -c sh -i </dev/ttyS0 >/dev/ttyS0 2>&1'
setsid -c sh -i </dev/ttyS0 >/dev/ttyS0 2>&1

show 'reboot -f'
reboot -f
ui_error 'reboot failed'
while :; do
	sleep 1
done
