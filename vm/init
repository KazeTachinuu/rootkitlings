#!/bin/sh

set -eu

export PATH=/bin
export TERM=xterm-256color
export LC_ALL=C
export PS1='(rootkitlings) \w # '
# shellcheck source=scripts/lib/ui.sh
. /vm/ui.sh

show()
{
	ui_transcript "$*"
}

run()
{
	show "$@"
	"$@"
}

mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t debugfs debugfs /sys/kernel/debug
mount -t tracefs tracefs /sys/kernel/tracing
chown 1000:1000 /home/student

read -r _cmdline < /proc/cmdline
for _word in $_cmdline; do
	case "$_word" in
		rootkitlings=check) _check=1 ;;
		rootkitlings=network) _network=1 ;;
		rootkitlings=runtime) _runtime=1 ;;
		rootkitlings=bare) _bare=1 ;;
		rootkitlings=color) _color=1 ;;
	esac
done

if [ "${_color:-}" != 1 ]; then
	export NO_COLOR=1
fi

if [ "${_network:-}" = 1 ]; then
	run ifconfig eth0 10.0.2.15 up
fi

if [ "${_check:-}" = 1 ]; then
	export NO_COLOR=1
	printf '\nROOTKITLINGS_CHECK_BEGIN\n'
	if [ -f /check.args ]; then
		xargs -0 /check < /check.args && _rc=0 || _rc=$?
	else
		/check && _rc=0 || _rc=$?
	fi
	if [ "$_rc" -eq 0 ]; then
		printf 'ROOTKITLINGS_RESULT=pass\n'
	else
		printf 'ROOTKITLINGS_RESULT=fail:%s\n' "$_rc"
	fi
	reboot -f
	while :; do sleep 1; done
fi

if [ "${_runtime:-}" = 1 ]; then
	{
		read -r _control_key
		read -r _callback_peer
		read -r _control_port
		read -r _shell_port
	} < /runtime.args
	_setup_command="/runtime-setup <control-key> $_callback_peer"
	_setup_command="$_setup_command $_control_port $_shell_port"
	show "$_setup_command"
	/runtime-setup "$_control_key" "$_callback_peer" \
		"$_control_port" "$_shell_port" \
		&& _setup_status=0 || _setup_status=$?
	if [ "$_setup_status" -eq 0 ]; then
		ui_success 'Target ready; the rootkit is waiting for its operator'
	else
		ui_error "Target setup failed with exit $_setup_status"
		reboot -f
	fi
	ui_progress 'Use this console to inspect the target; exit powers it off'
	cd /rootkitlings || exit 1
	show 'setsid -c /bin/bash --noprofile --rcfile /etc/rootkitlings.bashrc -i'
	setsid -c /bin/bash --noprofile \
		--rcfile /etc/rootkitlings.bashrc -i \
		</dev/ttyS0 >/dev/ttyS0 2>&1
	/bin/poweroff
fi

# -- interactive boot --

ui_success "/init is PID $$"

# Mount persistent disk (survives reboots)
if [ -b /dev/vda ]; then
	mkdir -p /mnt/persist
	mount -t ext4 /dev/vda /mnt/persist 2>/dev/null
	mkdir -p /mnt/persist/modules-load.d /mnt/persist/home/student
	chown 1000:1000 /mnt/persist/home/student
	mount --bind /mnt/persist/modules-load.d /etc/modules-load.d
	mount --bind /mnt/persist/home/student /home/student
fi
# Ensure the persistence target exists (transaction validates mode 0600)
[ -f /etc/modules-load.d/rootkitlings.conf ] || \
	install -m 0600 /dev/null /etc/modules-load.d/rootkitlings.conf

# Load persisted modules from modules-load.d
for _conf in /etc/modules-load.d/*.conf; do
	[ -f "$_conf" ] || continue
	while read -r _modname; do
		[ -n "$_modname" ] || continue
		_ko="/rootkitlings/${_modname}.ko"
		if [ -f "$_ko" ]; then
			insmod "$_ko" && ui_success "Persisted module loaded: $_modname" \
				|| ui_error "Persisted module failed: $_modname"
		fi
	done < "$_conf"
done

_module=$(ls /rootkitlings/*.ko 2>/dev/null | head -1)
cd /rootkitlings || exit 1

if [ "${_bare:-}" = 1 ]; then
	ui_success 'Bare mode: root shell, no module loaded'
	ui_progress 'Load the module yourself with insmod'
	export ENV=/etc/profile
	setsid -c sh -i </dev/ttyS0 >/dev/ttyS0 2>&1 || true
else
	if grep -q rootkitlings /proc/modules 2>/dev/null; then
		ui_success 'Module already loaded (persisted)'
	elif [ -n "$_module" ]; then
		show "insmod $_module"
		insmod "$_module" && ui_success 'Module loaded' \
			|| ui_error 'Module failed to load'
	fi
	ui_success 'Logged in as student (unprivileged)'
	ui_progress 'Type reboot to restart the VM; exit to shut down'
	setsid -c su -l student </dev/ttyS0 >/dev/ttyS0 2>&1 || true
fi

/bin/poweroff
