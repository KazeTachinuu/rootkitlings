#!/usr/bin/bash
set -Eeuo pipefail
export LC_ALL=C

VM_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$VM_DIR/.." && pwd)
# shellcheck source=scripts/lib/ui.sh
source "$ROOT_DIR/scripts/lib/ui.sh"
# shellcheck source=scripts/lib/host.sh
source "$ROOT_DIR/scripts/lib/host.sh"

# -- arguments --

MODULE=
CHECK=
GDB=
BARE=
NETWORK=
GUEST_COLOR=
ACCEL=auto
RUNTIME_SETUP=
CONTROL_KEY=
CONTROL_KEY_FILE=
CONTROL_PORT=
SHELL_PORT=
declare -a TOOLS=() TOOL_PATHS=() CHECK_ARGS=()
while (( $# )); do
    case $1 in
        --check) CHECK=${2:?--check requires an argument}; shift 2 ;;
        --check-arg) CHECK_ARGS+=("${2:?--check-arg requires an argument}"); shift 2 ;;
        --bare)  BARE=1; shift ;;
        --gdb)   GDB=1; shift ;;
        --runtime-setup)
            RUNTIME_SETUP=${2:?--runtime-setup requires an argument}
            shift 2
            ;;
        --control-key-file)
            CONTROL_KEY_FILE=${2:?--control-key-file requires an argument}
            shift 2
            ;;
        --control-port)
            CONTROL_PORT=${2:?--control-port requires an argument}
            shift 2
            ;;
        --shell-port)
            SHELL_PORT=${2:?--shell-port requires an argument}
            shift 2
            ;;
        --tool)  TOOLS+=("${2:?--tool requires an argument}"); shift 2 ;;
        --accel)
            ACCEL=${2:?--accel requires an argument}
            case $ACCEL in auto|kvm|tcg) ;; *) ui_die "Unknown VM accelerator: $ACCEL" ;; esac
            shift 2
            ;;
        --cap)
            case ${2:?--cap requires an argument} in
                network) NETWORK=1 ;;
                *) ui_die "Unknown VM capability: $2" ;;
            esac
            shift 2
            ;;
        -*)      ui_die "Unknown option: $1" ;;
        *)
            [[ -z $MODULE ]] || ui_die "Unexpected argument: $1"
            MODULE=$1
            shift
            ;;
    esac
done
if (( ${#CHECK_ARGS[@]} )) && [[ -z $CHECK ]]; then
	ui_die "--check-arg requires --check"
fi
if [[ -n $RUNTIME_SETUP ]]; then
    [[ -z $CHECK && -z $GDB && -n $MODULE ]] ||
        ui_die "--runtime-setup needs one module and forbids checks and GDB"
    [[ -f $CONTROL_KEY_FILE && ! -L $CONTROL_KEY_FILE ]] ||
        ui_die "--control-key-file must name a regular file"
    [[ $(wc -c < "$CONTROL_KEY_FILE") -eq 65 ]] ||
        ui_die "control key must contain 64 hexadecimal digits and a newline"
    IFS= read -r CONTROL_KEY < "$CONTROL_KEY_FILE" ||
        ui_die "could not read the control key"
    [[ $CONTROL_KEY =~ ^[0-9a-f]{64}$ ]] ||
        ui_die "control key must contain 64 lowercase hexadecimal digits"
    for port in "$CONTROL_PORT" "$SHELL_PORT"; do
        if [[ ! $port =~ ^[0-9]+$ ]] ||
            (( port < 1 || port > 65535 )); then
            ui_die "callback ports must be from 1 through 65535"
        fi
    done
elif [[ -n $CONTROL_KEY_FILE || -n $CONTROL_PORT || -n $SHELL_PORT ]]; then
    ui_die "runtime options require --runtime-setup"
fi
if [[ -n $GDB ]] && ! command -v pwndbg >/dev/null && ! command -v gdb >/dev/null; then
	ui_die "GDB not found; install gdb or run make doctor for the package name"
fi
if [[ -n $CHECK ]]; then
	export RKLINGS_QUIET=1
fi
if [[ -t 1 && ${NO_COLOR+x} != x && ${TERM:-} != dumb ]]; then
	GUEST_COLOR=1
fi

# -- self-cleaning temp --

WORK=$(mktemp -d) || ui_die "Could not create temporary directory"
trap 'rm -rf -- "$WORK"' EXIT
trap 'exit 130' INT TERM

ROOTFS="$WORK/rootfs"
INITRAMFS="$WORK/initramfs.gz"
RELEASE=$("$ROOT_DIR/scripts/kernel" release) || ui_die "Course kernel manifest is invalid"
KERNEL=$("$ROOT_DIR/scripts/kernel" image) || ui_die "Course kernel is not ready; run: ./rklings setup"
VMLINUX=$("$ROOT_DIR/scripts/kernel" vmlinux) || ui_die "Course kernel is not ready; run: ./rklings setup"
BUSYBOX=$(command -v busybox || true)
BASH=$(command -v bash || true)
SCRIPT=$(command -v script || true)

readonly VM_DIR ROOT_DIR RELEASE KERNEL VMLINUX BUSYBOX BASH SCRIPT WORK ROOTFS
readonly INITRAMFS
readonly MODULE CHECK GDB BARE NETWORK GUEST_COLOR ACCEL RUNTIME_SETUP
readonly CONTROL_KEY CONTROL_KEY_FILE CONTROL_PORT SHELL_PORT

resolve_tools()
{
	local requested relative component candidate resolved source_root tools_root
	local -a relatives=() targets=()

	if (( ${#TOOLS[@]} == 0 )); then
		return 0
	fi
	source_root=$(realpath -e -- "$ROOT_DIR/vm/tools") || ui_die "Tools directory not found"
	for requested in "${TOOLS[@]}"; do
        [[ $requested != /* ]] || ui_die "Tool path must be relative to the repository: $requested"
        case $requested in
            vm/tools/*) relative=${requested#vm/tools/} ;;
            */*) ui_die "Tool path must be under vm/tools/: $requested" ;;
            *) relative=$requested ;;
        esac
        [[ -n $relative ]] || ui_die "Tool path is empty"
        IFS=/ read -r -a components <<< "$relative"
		candidate=$source_root
		for component in "${components[@]}"; do
			[[ $component =~ ^[A-Za-z0-9._-]+$ && $component != . && $component != .. ]] ||
				ui_die "Invalid tool path: $requested"
			candidate+=/$component
			[[ ! -L $candidate ]] || ui_die "Tool path may not contain symlinks: $requested"
		done
		relatives+=("$relative")
		targets+=("$WORK/tool-build/$relative")
	done
	env -i PATH="$PATH" LC_ALL=C LANG=C TZ=UTC CC=gcc HOSTCC=gcc \
		make -C "$ROOT_DIR" --quiet TOOL_OUT="$WORK/tool-build" "${targets[@]}" ||
		ui_die "Could not build the requested guest tools"
	tools_root=$(realpath -e -- "$WORK/tool-build") || ui_die "Tool build directory not found"
	for relative in "${relatives[@]}"; do
		candidate=$tools_root/$relative
		resolved=$(realpath -e -- "$candidate" 2>/dev/null) || ui_die "Unknown tool: $relative"
		[[ $resolved == "$tools_root"/* && -f $resolved && -x $resolved && ! -L $candidate ]] ||
			ui_die "Tool is not a regular executable built from vm/tools/: $relative"
		TOOL_PATHS+=("$resolved")
	done
}

# -- prerequisites --

check_prerequisites()
{
    resolve_tools
    [[ -n $BUSYBOX ]] || ui_die "BusyBox not found; run make doctor for the package name"
	[[ -n $BASH ]] || ui_die "Bash not found; run make doctor for the package name"
	[[ -n $SCRIPT ]] || ui_die "util-linux script not found; run make doctor"
	"$SCRIPT" --version 2>&1 | grep -qi 'util-linux' ||
		ui_die "script must come from util-linux; run make doctor"
    file "$BUSYBOX" | grep -q 'statically linked' ||
        ui_die "BusyBox is not statically linked: $BUSYBOX"
    command -v cpio >/dev/null || ui_die "cpio not found"
    command -v qemu-system-x86_64 >/dev/null || ui_die "QEMU not found"
    command -v python3 >/dev/null || ui_die "python3 not found"
    if [[ -n $NETWORK || -n $RUNTIME_SETUP ]] &&
        ! qemu-system-x86_64 -netdev help 2>&1 | grep -q '^user$'; then
        ui_die "QEMU user networking was requested but SLIRP support is unavailable"
    fi
    if [[ -n $GDB ]] && ! python3 - 2>/dev/null <<'PY'
import socket

with socket.socket() as listener:
    listener.bind(("127.0.0.1", 1234))
PY
    then
        ui_die "GDB port 1234 is already in use; connect to the running VM or stop it first"
    fi
    [[ -z $MODULE || -f $MODULE ]] || ui_die "Module not found: $MODULE"
    [[ -z $CHECK  || -f $CHECK  ]] || ui_die "Check script not found: $CHECK"
    [[ -z $RUNTIME_SETUP || -f $RUNTIME_SETUP ]] ||
        ui_die "Runtime setup not found: $RUNTIME_SETUP"
    ui_success "Prerequisites verified for Linux $RELEASE"
}

# -- rootfs --

build_rootfs()
{
    local applet candidate library terminfo

    ui_heading "Building the BusyBox root filesystem"
    mkdir -p "$ROOTFS"/{bin,dev,etc,lib,proc,rklings,sys,tmp,vm/checks} \
        "$ROOTFS/etc/modules-load.d" \
        "$ROOTFS/lib/modules/$RELEASE"
    : > "$ROOTFS/lib/modules/$RELEASE/modules.dep"
	printf 'root:x:0:0:root:/rklings:/bin/bash\nstudent:x:1000:1000:student:/home/student:/bin/bash\n' > "$ROOTFS/etc/passwd"
	printf 'root:!:0:::::\nstudent:!:0:::::\n' > "$ROOTFS/etc/shadow"
	mkdir -p "$ROOTFS/home/student"
	chmod 1777 "$ROOTFS/tmp"
	chown 1000:1000 "$ROOTFS/home/student"
    cp "$BUSYBOX" "$ROOTFS/bin/busybox"
    for applet in adduser cat chmod clear cmp cp cut dd df diff dmesg echo env \
		find grep head hexdump id \
		ifconfig insmod kill less ln ls lsmod mkdir modinfo mount mv nc \
		netstat ping printf ps rm rmdir rmmod sed setsid sh \
		sha256sum sleep sort stat stty su tail test touch tr tty \
		umount uname vi wc whoami xargs xxd od; do
        ln -s busybox "$ROOTFS/bin/$applet"
    done
	install -D -m 0755 -- "$BASH" "$ROOTFS/bin/bash"
	install -D -m 0755 -- "$SCRIPT" "$ROOTFS/bin/script"
	while IFS= read -r library; do
		install -D -m 0755 -- "$library" "$ROOTFS$library"
	done < <(ldd "$BASH" "$SCRIPT" | awk '
		$2 == "=>" && $3 ~ /^\// { print $3 }
		$1 ~ /^\// && $1 !~ /:$/ { print $1 }
	' | sort -u)
	terminfo=
	for candidate in /usr/share/terminfo/x/xterm-256color \
		/lib/terminfo/x/xterm-256color; do
		if [[ -f $candidate ]]; then
			terminfo=$candidate
			break
		fi
	done
	[[ -n $terminfo ]] || ui_die "xterm-256color terminfo entry not found"
	install -D -m 0644 -- "$terminfo" \
		"$ROOTFS/usr/share/terminfo/x/xterm-256color"
	printf '%s\n' \
		"PS1='root@\\h:\\w# '" \
		"unset HISTFILE" \
		"bind 'set enable-bracketed-paste off' 2>/dev/null || true" \
		> "$ROOTFS/etc/rklings.bashrc"
	cat > "$ROOTFS/etc/profile" <<'PROFILE'
if [ "$(id -u)" = 0 ]; then
	export PS1='root@target:\w# '
	cd /rklings 2>/dev/null
else
	export PS1='student@target:\w$ '
fi
PROFILE
    cp "$VM_DIR/init" "$ROOTFS/init"
    cp "$ROOT_DIR/scripts/lib/ui.sh" "$ROOTFS/vm/ui.sh"
    chmod 755 "$ROOTFS/init"

    rm -f "$ROOTFS/bin/reboot" "$ROOTFS/bin/poweroff"
    gcc -static -o "$ROOTFS/bin/cat" "$VM_DIR/tools/cat.c"
    gcc -o "$ROOTFS/bin/reboot" "$VM_DIR/reboot.c"
    chmod 4755 "$ROOTFS/bin/reboot"
    ln "$ROOTFS/bin/reboot" "$ROOTFS/bin/poweroff"
    if [[ -n $MODULE ]]; then
        cp "$MODULE" "$ROOTFS/rklings/$(basename "$MODULE")"
        ui_success "Module copied to /rklings/$(basename "$MODULE")"
    fi
    if [[ -n $CHECK ]]; then
        cp "$ROOT_DIR/vm/checks/lib.sh" "$ROOTFS/vm/checks/lib.sh"
        cp "$CHECK" "$ROOTFS/check"
        chmod 755 "$ROOTFS/check"
        if (( ${#CHECK_ARGS[@]} )); then
            printf '%s\0' "${CHECK_ARGS[@]}" > "$ROOTFS/check.args"
        fi
        ui_success "Check script copied to /check"
    fi
    if [[ -n $RUNTIME_SETUP ]]; then
        cp "$RUNTIME_SETUP" "$ROOTFS/runtime-setup"
        chmod 755 "$ROOTFS/runtime-setup"
        printf '%s\n' "$CONTROL_KEY" 10.0.2.2 "$CONTROL_PORT" "$SHELL_PORT" \
            > "$ROOTFS/runtime.args"
        chmod 0600 "$ROOTFS/runtime.args"
        ui_success "Target runtime setup copied to /runtime-setup"
    fi
    for tool in "${TOOL_PATHS[@]}"; do
		install -m 0755 -- "$tool" "$ROOTFS/bin/$(basename "$tool")"
        ui_success "Tool copied to /bin/$(basename "$tool")"
    done
    ui_success "Root filesystem ready"
}

# -- initramfs --

pack_initramfs()
{
    ui_heading "Packing the compressed CPIO archive"
    (
        cd "$ROOTFS"
        find . -print0 | cpio --null -o --format=newc --owner=0:0 --quiet
    ) | gzip -1 > "$INITRAMFS"
    ui_success "Initramfs ready: $(du -h "$INITRAMFS" | cut -f1)"
}

# -- qemu --

run_vm()
{
	local -a qemu_args
	local cmdline='console=ttyS0 rdinit=/init panic=1 loglevel=4'
	local debugger debugger_prompt protocol_error protocol_status qemu_status serial_log

    case $ACCEL in
        kvm)
            host_kvm_available || ui_die "KVM was requested but is unavailable"
            qemu_args=(-accel kvm -cpu host)
            ui_success "KVM acceleration selected"
            ;;
        tcg)
            qemu_args=(-accel tcg -cpu max)
            ui_success "TCG emulation selected"
            ;;
        auto)
            if host_kvm_available; then
                qemu_args=(-accel kvm -cpu host)
                ui_success "KVM acceleration available"
            else
                qemu_args=(-accel tcg -cpu max)
                ui_warning "KVM unavailable; falling back to TCG"
            fi
            ;;
    esac

    if [[ -n $CHECK ]]; then
        cmdline+=' rklings=check'
    fi
    if [[ -n $BARE ]]; then
        cmdline+=' rklings=bare'
    fi
    if [[ -n $NETWORK || -n $RUNTIME_SETUP ]]; then
        cmdline+=' rklings=network'
    fi
    if [[ -n $RUNTIME_SETUP ]]; then
        cmdline+=' rklings=runtime'
    fi
    if [[ -n $GUEST_COLOR ]]; then
        cmdline+=' rklings=color'
    fi
    if [[ -n $GDB ]]; then
        cmdline+=' nokaslr'
        qemu_args+=(-gdb 'tcp:127.0.0.1:1234' -S)
        ui_success "GDB server on localhost:1234, VM paused waiting for debugger"
        ui_success "The debugger socket is bound to 127.0.0.1 only"
        ui_success "KASLR disabled for stable symbol addresses"
        if command -v pwndbg >/dev/null; then
            debugger=pwndbg
            debugger_prompt='pwndbg>'
        else
            debugger=gdb
            debugger_prompt='(gdb)'
        fi
        ui_heading "Connect from another terminal"
        printf '    $ %s %q\n' "$debugger" "$VMLINUX"
        printf '    %s target remote :1234\n' "$debugger_prompt"
        printf '    %s continue\n' "$debugger_prompt"
    fi

    # Persistent disk for /etc/modules-load.d (survives reboots)
    local persist_disk="$WORK/persist.img"
    dd if=/dev/zero of="$persist_disk" bs=4M count=1 status=none
    mkfs.ext4 -q -F "$persist_disk"

    qemu_args+=(
        -m 256M
        -smp 2
        -kernel "$KERNEL"
        -initrd "$INITRAMFS"
        -append "$cmdline"
        -drive "file=$persist_disk,format=raw,if=virtio"
        -nographic
    )
    if [[ -n $CHECK ]]; then
        qemu_args+=(-no-reboot)
    fi

    if [[ -n $RUNTIME_SETUP ]]; then
        qemu_args+=(-nic 'user,model=virtio-net-pci')
    elif [[ -n $NETWORK ]]; then
        qemu_args+=(-nic 'user,model=virtio-net-pci')
    else
        qemu_args+=(-nic none)
    fi

    if [[ -z $CHECK ]]; then
        ui_heading "Booting a separate guest kernel"
        printf '    $ qemu-system-x86_64'
        printf ' %q' "${qemu_args[@]}"
        printf '\n'
    fi

	serial_log=$WORK/serial.log
	if [[ -z $CHECK ]]; then
		set +e
		qemu-system-x86_64 "${qemu_args[@]}" 2>&1 | tee "$serial_log"
		qemu_status=${PIPESTATUS[0]}
		set -e
		if (( qemu_status != 0 )); then
			return "$qemu_status"
		fi
		return 0
	fi

	# Check mode: retry QEMU when the guest reboots mid-check (exit 3).
	# The persist disk survives across boots so checks can test persistence.
	local _boot _max_boots=3
	for (( _boot = 1; _boot <= _max_boots; _boot++ )); do
		set +e
		qemu-system-x86_64 "${qemu_args[@]}" >"$serial_log" 2>&1
		qemu_status=$?
		set -e
		if (( qemu_status != 0 )); then
			cat "$serial_log" >&2
			return "$qemu_status"
		fi
		protocol_error=$WORK/protocol.error
		set +e
		python3 "$ROOT_DIR/engine/guest_protocol.py" "$serial_log" 2>"$protocol_error"
		protocol_status=$?
		set -e
		case $protocol_status in
			0) return 0 ;;
			1)
				cat "$protocol_error" >&2
				return 1
				;;
			3)
				continue
				;;
			*)
				cat "$serial_log" >&2
				ui_error "Guest check protocol invalid: $(<"$protocol_error")"
				return 1
				;;
		esac
	done
	ui_error "Check exhausted $_max_boots boots without a result"
	return 1
}

# -- main --

main()
{
    check_prerequisites
    build_rootfs
    pack_initramfs
    run_vm
}

main
