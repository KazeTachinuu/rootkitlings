#!/usr/bin/bash
set -Eeuo pipefail
export LC_ALL=C

VM_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$VM_DIR/.." && pwd)
RELEASE=$(uname -r)

# -- marker output --

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
    B='\033[1;34m' G='\033[1;32m' Y='\033[1;33m' R='\033[31m' D='\033[2m' N='\033[0m'
else
    B= G= Y= R= D= N=
fi
hdr()  { printf "${B}[*]${N} %s\n" "$1"; }
ok()   { printf "${G}[+]${N} %s\n" "$1"; }
skip() { printf "${D}[=] %s${N}\n" "$1"; }
warn() { printf "${Y}[-]${N} %s\n" "$1" >&2; }
die()  { printf "${R}[x]${N} %s\n" "$1" >&2; exit 1; }

# -- kernel detection --

find_kernel()
{
    local k="/usr/lib/modules/$RELEASE/vmlinuz"
    if [[ -f $k ]]; then
        printf '%s' "$k"
        return
    fi
    k="/boot/vmlinuz-$RELEASE"
    if [[ -f $k ]]; then
        printf '%s' "$k"
        return
    fi
    die "Kernel image not found for $RELEASE"
}

# -- arguments --

MODULE=
CHECK=
GDB=
while (( $# )); do
    case $1 in
        --check) CHECK=${2:?--check requires an argument}; shift 2 ;;
        --gdb)   GDB=1; shift ;;
        -*)      die "Unknown option: $1" ;;
        *)       MODULE=$1; shift ;;
    esac
done

# -- self-cleaning temp --

WORK=$(mktemp -d) && trap 'rm -rf "$WORK"' EXIT
trap 'exit 130' INT TERM

ROOTFS="$WORK/rootfs"
INITRAMFS="$WORK/initramfs.gz"
KERNEL=$(find_kernel)
BUSYBOX=$(command -v busybox || true)

readonly VM_DIR ROOT_DIR RELEASE KERNEL BUSYBOX WORK ROOTFS INITRAMFS MODULE CHECK GDB

# -- prerequisites --

check_prerequisites()
{
    [[ -n $BUSYBOX ]] || die "BusyBox not found (Arch package: busybox)"
    file "$BUSYBOX" | grep -q 'statically linked' ||
        die "BusyBox is not statically linked: $BUSYBOX"
    command -v cpio >/dev/null || die "cpio not found"
    command -v qemu-system-x86_64 >/dev/null || die "QEMU not found"
    [[ -z $MODULE || -f $MODULE ]] || die "Module not found: $MODULE"
    [[ -z $CHECK  || -f $CHECK  ]] || die "Check script not found: $CHECK"
    ok "Prerequisites verified for Linux $RELEASE"
}

# -- rootfs --

build_rootfs()
{
    local applet

    hdr "Building the BusyBox root filesystem"
    mkdir -p "$ROOTFS"/{bin,dev,lib,proc,root,sys,tmp}
    cp "$BUSYBOX" "$ROOTFS/bin/busybox"
    for applet in cat chmod cmp dd dmesg echo find grep head id \
        ifconfig insmod kill ls lsmod mkdir mount nc ping \
        poweroff printf rmmod sed setsid sh sleep sort stat \
        tail test tr uname wc; do
        ln -s busybox "$ROOTFS/bin/$applet"
    done
    cp "$VM_DIR/init" "$ROOTFS/init"
    chmod 755 "$ROOTFS/init"
    if [[ -n $MODULE ]]; then
        cp "$MODULE" "$ROOTFS/root/$(basename "$MODULE")"
        ok "Module copied to /root/$(basename "$MODULE")"
    fi
    if [[ -n $CHECK ]]; then
        cp "$ROOT_DIR/lib/check.sh" "$ROOTFS/lib/check.sh"
        cp "$CHECK" "$ROOTFS/check"
        chmod 755 "$ROOTFS/check"
        ok "Check script copied to /check"
    fi
    # Include any compiled tools
    if [[ -d $ROOT_DIR/tools ]]; then
        for tool in "$ROOT_DIR"/tools/*; do
            [[ -x $tool && ! -d $tool && $tool != *.c ]] || continue
            cp "$tool" "$ROOTFS/bin/$(basename "$tool")"
            ok "Tool copied to /bin/$(basename "$tool")"
        done
    fi
    ok "Root filesystem ready"
}

# -- initramfs --

pack_initramfs()
{
    hdr "Packing the compressed CPIO archive"
    (
        cd "$ROOTFS"
        find . -print0 | cpio --null -o --format=newc --owner=0:0 --quiet
    ) | gzip -1 > "$INITRAMFS"
    ok "Initramfs ready: $(du -h "$INITRAMFS" | cut -f1)"
}

# -- qemu --

run_vm()
{
    local -a qemu_args
    local cmdline='console=ttyS0 rdinit=/init panic=0 loglevel=4'

    if [[ -r /dev/kvm && -w /dev/kvm ]]; then
        qemu_args=(-accel kvm -cpu host)
        ok "KVM acceleration available"
    else
        qemu_args=(-accel tcg -cpu max)
        warn "KVM unavailable; falling back to TCG"
    fi

    if [[ -n $CHECK ]]; then
        cmdline+=' rootkitlings=check'
    fi

    if [[ -n $GDB ]]; then
        cmdline+=' nokaslr'
        qemu_args+=(-s -S)
        ok "GDB server on localhost:1234, VM paused waiting for debugger"
        ok "KASLR disabled for stable symbol addresses"
    fi

    qemu_args+=(
        -m 256M
        -smp 1
        -kernel "$KERNEL"
        -initrd "$INITRAMFS"
        -append "$cmdline"
        -nic none
        -no-reboot
        -nographic
    )

    hdr "Booting a separate guest kernel"
    printf '%s    $ qemu-system-x86_64' "$D"
    printf ' %q' "${qemu_args[@]}"
    printf '%s\n' "$N"

    qemu-system-x86_64 "${qemu_args[@]}"
}

# -- main --

main()
{
    check_prerequisites
    build_rootfs
    pack_initramfs
    run_vm
}

main
