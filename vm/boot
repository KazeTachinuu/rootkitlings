#!/usr/bin/bash
set -Eeuo pipefail
export LC_ALL=C

VM_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$VM_DIR/.." && pwd)

# -- marker output --

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
    B='\033[1;34m' G='\033[1;32m' Y='\033[1;33m' R='\033[31m' D='\033[2m' N='\033[0m'
else
    B='' G='' Y='' R='' D='' N=''
fi
hdr()  { printf "${B}[*]${N} %s\n" "$1"; }
ok()   { printf "${G}[+]${N} %s\n" "$1"; }
skip() { printf "${D}[=] %s${N}\n" "$1"; }
warn() { printf "${Y}[-]${N} %s\n" "$1" >&2; }
die()  { printf "${R}[x]${N} %s\n" "$1" >&2; exit 1; }

# -- arguments --

MODULE=
CHECK=
GDB=
NETWORK=
ACCEL=auto
declare -a TOOLS=() TOOL_PATHS=() CHECK_ARGS=()
while (( $# )); do
    case $1 in
        --check) CHECK=${2:?--check requires an argument}; shift 2 ;;
        --check-arg) CHECK_ARGS+=("${2:?--check-arg requires an argument}"); shift 2 ;;
        --gdb)   GDB=1; shift ;;
        --tool)  TOOLS+=("${2:?--tool requires an argument}"); shift 2 ;;
        --accel)
            ACCEL=${2:?--accel requires an argument}
            case $ACCEL in auto|kvm|tcg) ;; *) die "Unknown VM accelerator: $ACCEL" ;; esac
            shift 2
            ;;
        --cap)
            case ${2:?--cap requires an argument} in
                network) NETWORK=1 ;;
                *) die "Unknown VM capability: $2" ;;
            esac
            shift 2
            ;;
        -*)      die "Unknown option: $1" ;;
        *)
            [[ -z $MODULE ]] || die "Unexpected argument: $1"
            MODULE=$1
            shift
            ;;
    esac
done
if (( ${#CHECK_ARGS[@]} )) && [[ -z $CHECK ]]; then
    die "--check-arg requires --check"
fi

# -- self-cleaning temp --

WORK=$(mktemp -d) || die "Could not create temporary directory"
trap 'rm -rf -- "$WORK"' EXIT
trap 'exit 130' INT TERM

ROOTFS="$WORK/rootfs"
INITRAMFS="$WORK/initramfs.gz"
RELEASE=$("$ROOT_DIR/scripts/kernel" release) || die "Course kernel manifest is invalid"
KERNEL=$("$ROOT_DIR/scripts/kernel" image) || die "Course kernel is not ready; run: ./rootkitlings setup"
VMLINUX=$("$ROOT_DIR/scripts/kernel" vmlinux) || die "Course kernel is not ready; run: ./rootkitlings setup"
BUSYBOX=$(command -v busybox || true)

readonly VM_DIR ROOT_DIR RELEASE KERNEL VMLINUX BUSYBOX WORK ROOTFS INITRAMFS MODULE CHECK GDB NETWORK ACCEL

resolve_tools()
{
	local requested relative component candidate resolved source_root tools_root
	local -a relatives=() targets=()

	if (( ${#TOOLS[@]} == 0 )); then
		return 0
	fi
	source_root=$(realpath -e -- "$ROOT_DIR/tools") || die "Tools directory not found"
	for requested in "${TOOLS[@]}"; do
        [[ $requested != /* ]] || die "Tool path must be relative to the repository: $requested"
        case $requested in
            tools/*) relative=${requested#tools/} ;;
            */*) die "Tool path must be under tools/: $requested" ;;
            *) relative=$requested ;;
        esac
        [[ -n $relative ]] || die "Tool path is empty"
        IFS=/ read -r -a components <<< "$relative"
		candidate=$source_root
		for component in "${components[@]}"; do
			[[ $component =~ ^[A-Za-z0-9._-]+$ && $component != . && $component != .. ]] ||
				die "Invalid tool path: $requested"
			candidate+=/$component
			[[ ! -L $candidate ]] || die "Tool path may not contain symlinks: $requested"
		done
		relatives+=("$relative")
		targets+=("$WORK/tools/$relative")
	done
	env -i PATH="$PATH" LC_ALL=C LANG=C TZ=UTC CC=gcc HOSTCC=gcc \
		make -C "$ROOT_DIR" --quiet TOOL_OUT="$WORK/tools" "${targets[@]}" ||
		die "Could not build the requested guest tools"
	tools_root=$(realpath -e -- "$WORK/tools") || die "Tool build directory not found"
	for relative in "${relatives[@]}"; do
		candidate=$tools_root/$relative
		resolved=$(realpath -e -- "$candidate" 2>/dev/null) || die "Unknown tool: $relative"
		[[ $resolved == "$tools_root"/* && -f $resolved && -x $resolved && ! -L $candidate ]] ||
			die "Tool is not a regular executable under tools/: $relative"
		TOOL_PATHS+=("$resolved")
	done
}

# -- prerequisites --

check_prerequisites()
{
    resolve_tools
    [[ -n $BUSYBOX ]] || die "BusyBox not found; run make doctor for the package name"
    file "$BUSYBOX" | grep -q 'statically linked' ||
        die "BusyBox is not statically linked: $BUSYBOX"
    command -v cpio >/dev/null || die "cpio not found"
    command -v qemu-system-x86_64 >/dev/null || die "QEMU not found"
    command -v python3 >/dev/null || die "python3 not found"
    if [[ -n $NETWORK ]] && ! qemu-system-x86_64 -netdev help 2>&1 | grep -q '^user$'; then
        die "QEMU user networking was requested but SLIRP support is unavailable"
    fi
    if [[ -n $GDB ]] && ! python3 - 2>/dev/null <<'PY'
import socket

with socket.socket() as listener:
    listener.bind(("127.0.0.1", 1234))
PY
    then
        die "GDB port 1234 is already in use; connect to the running VM or stop it first"
    fi
    [[ -z $MODULE || -f $MODULE ]] || die "Module not found: $MODULE"
    [[ -z $CHECK  || -f $CHECK  ]] || die "Check script not found: $CHECK"
    ok "Prerequisites verified for Linux $RELEASE"
}

# -- rootfs --

build_rootfs()
{
    local applet

    hdr "Building the BusyBox root filesystem"
    mkdir -p "$ROOTFS"/{bin,dev,etc,lib,proc,rootkitlings,sys,tmp} \
        "$ROOTFS/lib/modules/$RELEASE"
    : > "$ROOTFS/lib/modules/$RELEASE/modules.dep"
    printf 'root:x:0:0:root:/rootkitlings:/bin/sh\n' > "$ROOTFS/etc/passwd"
    printf 'root:!:0:::::\n' > "$ROOTFS/etc/shadow"
    cp "$BUSYBOX" "$ROOTFS/bin/busybox"
    for applet in cat chmod cmp cut dd diff dmesg echo find grep head \
		hexdump id \
		ifconfig insmod kill ls lsmod mkdir modinfo mount nc ping poweroff \
		printf ps reboot rm rmdir rmmod sed setsid sh sha256sum sleep sort stat \
		tail test touch tr uname wc xargs xxd od; do
        ln -s busybox "$ROOTFS/bin/$applet"
    done
    cp "$VM_DIR/init" "$ROOTFS/init"
    chmod 755 "$ROOTFS/init"
    if [[ -n $MODULE ]]; then
        cp "$MODULE" "$ROOTFS/rootkitlings/$(basename "$MODULE")"
        ok "Module copied to /rootkitlings/$(basename "$MODULE")"
    fi
    if [[ -n $CHECK ]]; then
        cp "$ROOT_DIR/lib/check.sh" "$ROOTFS/lib/check.sh"
        cp "$CHECK" "$ROOTFS/check"
        chmod 755 "$ROOTFS/check"
        if (( ${#CHECK_ARGS[@]} )); then
            printf '%s\0' "${CHECK_ARGS[@]}" > "$ROOTFS/check.args"
        fi
        ok "Check script copied to /check"
    fi
    for tool in "${TOOL_PATHS[@]}"; do
		install -m 0755 -- "$tool" "$ROOTFS/bin/$(basename "$tool")"
        ok "Tool copied to /bin/$(basename "$tool")"
    done
    ok "Root filesystem ready"
}

# -- initramfs --

pack_initramfs()
{
    hdr "Packing the compressed CPIO archive"
    (
        cd "$ROOTFS"
        find . -print0 | cpio --null -o --format=newc --owner=0:0 --quiet
    ) | gzip -1 > "$INITRAMFS"
    ok "Initramfs ready: $(du -h "$INITRAMFS" | cut -f1)"
}

# -- qemu --

run_vm()
{
	local -a qemu_args
	local cmdline='console=ttyS0 rdinit=/init panic=1 loglevel=4'
	local debugger debugger_prompt qemu_status serial_log

    case $ACCEL in
        kvm)
            [[ -r /dev/kvm && -w /dev/kvm ]] || die "KVM was requested but /dev/kvm is unavailable"
            qemu_args=(-accel kvm -cpu host)
            ok "KVM acceleration selected"
            ;;
        tcg)
            qemu_args=(-accel tcg -cpu max)
            ok "TCG emulation selected"
            ;;
        auto)
            if [[ -r /dev/kvm && -w /dev/kvm ]]; then
                qemu_args=(-accel kvm -cpu host)
                ok "KVM acceleration available"
            else
                qemu_args=(-accel tcg -cpu max)
                warn "KVM unavailable; falling back to TCG"
            fi
            ;;
    esac

    if [[ -n $CHECK ]]; then
        cmdline+=' rootkitlings=check'
    fi
    if [[ -n $NETWORK ]]; then
        cmdline+=' rootkitlings=network'
    fi
    if [[ -n $GDB ]]; then
        cmdline+=' nokaslr'
        qemu_args+=(-gdb 'tcp:127.0.0.1:1234' -S)
        ok "GDB server on localhost:1234, VM paused waiting for debugger"
        ok "The debugger socket is bound to 127.0.0.1 only"
        ok "KASLR disabled for stable symbol addresses"
        if command -v pwndbg >/dev/null; then
            debugger=pwndbg
            debugger_prompt='pwndbg>'
        else
            debugger=gdb
            debugger_prompt='(gdb)'
        fi
        hdr "Connect from another terminal"
        printf '    $ %s %q\n' "$debugger" "$VMLINUX"
        printf '    %s target remote :1234\n' "$debugger_prompt"
        printf '    %s continue\n' "$debugger_prompt"
    fi

    qemu_args+=(
        -m 256M
        -smp 2
        -kernel "$KERNEL"
        -initrd "$INITRAMFS"
        -append "$cmdline"
        -no-reboot
        -nographic
    )

    if [[ -n $NETWORK ]]; then
        qemu_args+=(-nic 'user,model=virtio-net-pci')
    else
        qemu_args+=(-nic none)
    fi

    hdr "Booting a separate guest kernel"
    printf '%b    $ qemu-system-x86_64' "$D"
    printf ' %q' "${qemu_args[@]}"
    printf '%b\n' "$N"

	serial_log=$WORK/serial.log
	set +e
	qemu-system-x86_64 "${qemu_args[@]}" 2>&1 | tee "$serial_log"
	qemu_status=${PIPESTATUS[0]}
	set -e
	if (( qemu_status != 0 )); then
		return "$qemu_status"
	fi
	if [[ -n $CHECK ]]; then
		grep -Fq '[+] PASSED' "$serial_log" &&
			! grep -Fq '[x] FAILED' "$serial_log"
	fi
}

# -- main --

main()
{
    check_prerequisites
    build_rootfs
    pack_initramfs
    run_vm
}

main
