#!/usr/bin/bash
set -Eeuo pipefail
export LC_ALL=C

VM_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$VM_DIR/.." && pwd)
# shellcheck source=scripts/lib/ui.sh
source "$ROOT_DIR/scripts/lib/ui.sh"

# -- arguments --

MODULE=
CHECK=
GDB=
NETWORK=
GUEST_COLOR=
ACCEL=auto
declare -a TOOLS=() TOOL_PATHS=() CHECK_ARGS=()
while (( $# )); do
    case $1 in
        --check) CHECK=${2:?--check requires an argument}; shift 2 ;;
        --check-arg) CHECK_ARGS+=("${2:?--check-arg requires an argument}"); shift 2 ;;
        --gdb)   GDB=1; shift ;;
        --tool)  TOOLS+=("${2:?--tool requires an argument}"); shift 2 ;;
        --accel)
            ACCEL=${2:?--accel requires an argument}
            case $ACCEL in auto|kvm|tcg) ;; *) ui_die "Unknown VM accelerator: $ACCEL" ;; esac
            shift 2
            ;;
        --cap)
            case ${2:?--cap requires an argument} in
                network) NETWORK=1 ;;
                *) ui_die "Unknown VM capability: $2" ;;
            esac
            shift 2
            ;;
        -*)      ui_die "Unknown option: $1" ;;
        *)
            [[ -z $MODULE ]] || ui_die "Unexpected argument: $1"
            MODULE=$1
            shift
            ;;
    esac
done
if (( ${#CHECK_ARGS[@]} )) && [[ -z $CHECK ]]; then
	ui_die "--check-arg requires --check"
fi
if [[ -n $GDB ]] && ! command -v pwndbg >/dev/null && ! command -v gdb >/dev/null; then
	ui_die "GDB not found; install gdb or run make doctor for the package name"
fi
if [[ -n $CHECK ]]; then
	export ROOTKITLINGS_QUIET=1
fi
if [[ -t 1 && ${NO_COLOR+x} != x && ${TERM:-} != dumb ]]; then
	GUEST_COLOR=1
fi

# -- self-cleaning temp --

WORK=$(mktemp -d) || ui_die "Could not create temporary directory"
trap 'rm -rf -- "$WORK"' EXIT
trap 'exit 130' INT TERM

ROOTFS="$WORK/rootfs"
INITRAMFS="$WORK/initramfs.gz"
RELEASE=$("$ROOT_DIR/scripts/kernel" release) || ui_die "Course kernel manifest is invalid"
KERNEL=$("$ROOT_DIR/scripts/kernel" image) || ui_die "Course kernel is not ready; run: ./rootkitlings setup"
VMLINUX=$("$ROOT_DIR/scripts/kernel" vmlinux) || ui_die "Course kernel is not ready; run: ./rootkitlings setup"
BUSYBOX=$(command -v busybox || true)

readonly VM_DIR ROOT_DIR RELEASE KERNEL VMLINUX BUSYBOX WORK ROOTFS INITRAMFS MODULE CHECK GDB NETWORK GUEST_COLOR ACCEL

resolve_tools()
{
	local requested relative component candidate resolved source_root tools_root
	local -a relatives=() targets=()

	if (( ${#TOOLS[@]} == 0 )); then
		return 0
	fi
	source_root=$(realpath -e -- "$ROOT_DIR/vm/tools") || ui_die "Tools directory not found"
	for requested in "${TOOLS[@]}"; do
        [[ $requested != /* ]] || ui_die "Tool path must be relative to the repository: $requested"
        case $requested in
            vm/tools/*) relative=${requested#vm/tools/} ;;
            */*) ui_die "Tool path must be under vm/tools/: $requested" ;;
            *) relative=$requested ;;
        esac
        [[ -n $relative ]] || ui_die "Tool path is empty"
        IFS=/ read -r -a components <<< "$relative"
		candidate=$source_root
		for component in "${components[@]}"; do
			[[ $component =~ ^[A-Za-z0-9._-]+$ && $component != . && $component != .. ]] ||
				ui_die "Invalid tool path: $requested"
			candidate+=/$component
			[[ ! -L $candidate ]] || ui_die "Tool path may not contain symlinks: $requested"
		done
		relatives+=("$relative")
		targets+=("$WORK/tool-build/$relative")
	done
	env -i PATH="$PATH" LC_ALL=C LANG=C TZ=UTC CC=gcc HOSTCC=gcc \
		make -C "$ROOT_DIR" --quiet TOOL_OUT="$WORK/tool-build" "${targets[@]}" ||
		ui_die "Could not build the requested guest tools"
	tools_root=$(realpath -e -- "$WORK/tool-build") || ui_die "Tool build directory not found"
	for relative in "${relatives[@]}"; do
		candidate=$tools_root/$relative
		resolved=$(realpath -e -- "$candidate" 2>/dev/null) || ui_die "Unknown tool: $relative"
		[[ $resolved == "$tools_root"/* && -f $resolved && -x $resolved && ! -L $candidate ]] ||
			ui_die "Tool is not a regular executable built from vm/tools/: $relative"
		TOOL_PATHS+=("$resolved")
	done
}

# -- prerequisites --

check_prerequisites()
{
    resolve_tools
    [[ -n $BUSYBOX ]] || ui_die "BusyBox not found; run make doctor for the package name"
    file "$BUSYBOX" | grep -q 'statically linked' ||
        ui_die "BusyBox is not statically linked: $BUSYBOX"
    command -v cpio >/dev/null || ui_die "cpio not found"
    command -v qemu-system-x86_64 >/dev/null || ui_die "QEMU not found"
    command -v python3 >/dev/null || ui_die "python3 not found"
    if [[ -n $NETWORK ]] && ! qemu-system-x86_64 -netdev help 2>&1 | grep -q '^user$'; then
        ui_die "QEMU user networking was requested but SLIRP support is unavailable"
    fi
    if [[ -n $GDB ]] && ! python3 - 2>/dev/null <<'PY'
import socket

with socket.socket() as listener:
    listener.bind(("127.0.0.1", 1234))
PY
    then
        ui_die "GDB port 1234 is already in use; connect to the running VM or stop it first"
    fi
    [[ -z $MODULE || -f $MODULE ]] || ui_die "Module not found: $MODULE"
    [[ -z $CHECK  || -f $CHECK  ]] || ui_die "Check script not found: $CHECK"
    ui_success "Prerequisites verified for Linux $RELEASE"
}

# -- rootfs --

build_rootfs()
{
    local applet

    ui_heading "Building the BusyBox root filesystem"
    mkdir -p "$ROOTFS"/{bin,dev,etc,lib,proc,rootkitlings,sys,tmp,vm/checks} \
        "$ROOTFS/lib/modules/$RELEASE"
    : > "$ROOTFS/lib/modules/$RELEASE/modules.dep"
    printf 'root:x:0:0:root:/rootkitlings:/bin/sh\n' > "$ROOTFS/etc/passwd"
    printf 'root:!:0:::::\n' > "$ROOTFS/etc/shadow"
    cp "$BUSYBOX" "$ROOTFS/bin/busybox"
    for applet in cat chmod cmp cut dd diff dmesg echo find grep head \
		hexdump id \
		ifconfig insmod kill ls lsmod mkdir modinfo mount nc ping poweroff \
		printf ps reboot rm rmdir rmmod sed setsid sh sha256sum sleep sort stat \
		tail test touch tr uname wc xargs xxd od; do
        ln -s busybox "$ROOTFS/bin/$applet"
    done
    cp "$VM_DIR/init" "$ROOTFS/init"
    cp "$ROOT_DIR/scripts/lib/ui.sh" "$ROOTFS/vm/ui.sh"
    chmod 755 "$ROOTFS/init"
    if [[ -n $MODULE ]]; then
        cp "$MODULE" "$ROOTFS/rootkitlings/$(basename "$MODULE")"
        ui_success "Module copied to /rootkitlings/$(basename "$MODULE")"
    fi
    if [[ -n $CHECK ]]; then
        cp "$ROOT_DIR/vm/checks/lib.sh" "$ROOTFS/vm/checks/lib.sh"
        cp "$CHECK" "$ROOTFS/check"
        chmod 755 "$ROOTFS/check"
        if (( ${#CHECK_ARGS[@]} )); then
            printf '%s\0' "${CHECK_ARGS[@]}" > "$ROOTFS/check.args"
        fi
        ui_success "Check script copied to /check"
    fi
    for tool in "${TOOL_PATHS[@]}"; do
		install -m 0755 -- "$tool" "$ROOTFS/bin/$(basename "$tool")"
        ui_success "Tool copied to /bin/$(basename "$tool")"
    done
    ui_success "Root filesystem ready"
}

# -- initramfs --

pack_initramfs()
{
    ui_heading "Packing the compressed CPIO archive"
    (
        cd "$ROOTFS"
        find . -print0 | cpio --null -o --format=newc --owner=0:0 --quiet
    ) | gzip -1 > "$INITRAMFS"
    ui_success "Initramfs ready: $(du -h "$INITRAMFS" | cut -f1)"
}

# -- qemu --

run_vm()
{
	local -a qemu_args
	local cmdline='console=ttyS0 rdinit=/init panic=1 loglevel=4'
	local debugger debugger_prompt protocol_error protocol_status qemu_status serial_log

    case $ACCEL in
        kvm)
            [[ -r /dev/kvm && -w /dev/kvm ]] || ui_die "KVM was requested but /dev/kvm is unavailable"
            qemu_args=(-accel kvm -cpu host)
            ui_success "KVM acceleration selected"
            ;;
        tcg)
            qemu_args=(-accel tcg -cpu max)
            ui_success "TCG emulation selected"
            ;;
        auto)
            if [[ -r /dev/kvm && -w /dev/kvm ]]; then
                qemu_args=(-accel kvm -cpu host)
                ui_success "KVM acceleration available"
            else
                qemu_args=(-accel tcg -cpu max)
                ui_warning "KVM unavailable; falling back to TCG"
            fi
            ;;
    esac

    if [[ -n $CHECK ]]; then
        cmdline+=' rootkitlings=check'
    fi
    if [[ -n $NETWORK ]]; then
        cmdline+=' rootkitlings=network'
    fi
    if [[ -n $GUEST_COLOR ]]; then
        cmdline+=' rootkitlings=color'
    fi
    if [[ -n $GDB ]]; then
        cmdline+=' nokaslr'
        qemu_args+=(-gdb 'tcp:127.0.0.1:1234' -S)
        ui_success "GDB server on localhost:1234, VM paused waiting for debugger"
        ui_success "The debugger socket is bound to 127.0.0.1 only"
        ui_success "KASLR disabled for stable symbol addresses"
        if command -v pwndbg >/dev/null; then
            debugger=pwndbg
            debugger_prompt='pwndbg>'
        else
            debugger=gdb
            debugger_prompt='(gdb)'
        fi
        ui_heading "Connect from another terminal"
        printf '    $ %s %q\n' "$debugger" "$VMLINUX"
        printf '    %s target remote :1234\n' "$debugger_prompt"
        printf '    %s continue\n' "$debugger_prompt"
    fi

    qemu_args+=(
        -m 256M
        -smp 2
        -kernel "$KERNEL"
        -initrd "$INITRAMFS"
        -append "$cmdline"
        -no-reboot
        -nographic
    )

    if [[ -n $NETWORK ]]; then
        qemu_args+=(-nic 'user,model=virtio-net-pci')
    else
        qemu_args+=(-nic none)
    fi

    if [[ -z $CHECK ]]; then
        ui_heading "Booting a separate guest kernel"
        printf '    $ qemu-system-x86_64'
        printf ' %q' "${qemu_args[@]}"
        printf '\n'
    fi

	serial_log=$WORK/serial.log
	set +e
	if [[ -n $CHECK ]]; then
		qemu-system-x86_64 "${qemu_args[@]}" >"$serial_log" 2>&1
		qemu_status=$?
	else
		qemu-system-x86_64 "${qemu_args[@]}" 2>&1 | tee "$serial_log"
		qemu_status=${PIPESTATUS[0]}
	fi
	set -e
	if (( qemu_status != 0 )); then
		[[ -z $CHECK ]] || cat "$serial_log" >&2
		return "$qemu_status"
	fi
	if [[ -n $CHECK ]]; then
		protocol_error=$WORK/protocol.error
		set +e
		python3 "$ROOT_DIR/engine/guest_protocol.py" "$serial_log" 2>"$protocol_error"
		protocol_status=$?
		set -e
		case $protocol_status in
			0) return 0 ;;
			1)
				cat "$protocol_error" >&2
				return 1
				;;
			*)
				cat "$serial_log" >&2
				ui_error "Guest check protocol invalid: $(<"$protocol_error")"
				return 1
				;;
		esac
	fi
}

# -- main --

main()
{
    check_prerequisites
    build_rootfs
    pack_initramfs
    run_vm
}

main
