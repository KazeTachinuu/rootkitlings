#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Deferred delivery via /proc/rklings read"

load rklings.ko
assert_loaded rklings
assert_exists /proc/rklings

# mkdir_escalation_test --self-target builds "PREFIX.<own-pid>" as the mkdir
# path so the kernel stores THIS process as the deferred target.
# --proc then reads /proc/rklings in the same process, triggering delivery.
uid=$(su student -c 'mkdir_escalation_test --self-target /tmp/rklings.e --proc /proc/rklings')
if [ "$uid" = "0" ]; then
    _ok "deferred delivery escalated target to uid 0"
else
    _fail "expected uid 0 after deferred delivery, got uid=$uid"
fi

_ok "/proc/rklings read completed (escalation via cred swap)"

# Cleanup
rm -rf /tmp/rklings.e.* 2>/dev/null
unload rklings

summary
