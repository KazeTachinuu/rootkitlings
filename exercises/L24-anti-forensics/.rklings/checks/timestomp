#!/bin/sh
# Check: timestomping modifies file mtime to match reference
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Timestomping"

wait_agent

# Create a target file (fresh timestamp)
touch /tmp/rk_ts_target
sleep 1

# Create a reference file with a known old timestamp
touch -t 202501150922 /tmp/rk_ts_reference

# Get target mtime before
mtime_before=$(stat -c %Y /tmp/rk_ts_target)

# Send TIMESTOMP command to agent
resp=$(send_cmd "TIMESTOMP /tmp/rk_ts_target /tmp/rk_ts_reference")
if echo "$resp" | grep -qi "ok\|done"; then
    _ok "TIMESTOMP accepted"
else
    _fail "TIMESTOMP failed: $resp"
fi

# Get target mtime after
mtime_after=$(stat -c %Y /tmp/rk_ts_target)
ref_mtime=$(stat -c %Y /tmp/rk_ts_reference)

if [ "$mtime_after" = "$ref_mtime" ]; then
    _ok "target mtime matches reference after timestomp"
else
    _fail "target mtime ($mtime_after) does not match reference ($ref_mtime)"
fi

if [ "$mtime_after" != "$mtime_before" ]; then
    _ok "target mtime changed from original"
else
    _fail "target mtime unchanged"
fi

# Cleanup
rm -f /tmp/rk_ts_target /tmp/rk_ts_reference

summary
