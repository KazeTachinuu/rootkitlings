#!/bin/sh
# Check: login records scrubbed from utmp and wtmp
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "utmp/wtmp scrubbing"

# Check that last shows no student login after cleanup
# (CLEANUP was already sent by the history-clear check, but we verify the effect)
send_cmd "CLEANUP student"
assert_response "OK"

# Verify utmp has no student entries
student_utmp=$(who | grep student | wc -l)
if [ "$student_utmp" -eq 0 ]; then
    _ok "no student entry in utmp (who shows nothing)"
else
    _fail "student still appears in who output ($student_utmp entries)"
fi

# Verify wtmp has no student entries
student_wtmp=$(last -f /var/log/wtmp | grep student | wc -l)
if [ "$student_wtmp" -eq 0 ]; then
    _ok "no student entry in wtmp (last shows nothing)"
else
    _fail "student still appears in last output ($student_wtmp entries)"
fi

summary
