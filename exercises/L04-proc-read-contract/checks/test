#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
baseline=$(mktemp -d "${TMPDIR:-/tmp}/rklings-proc-read-contract-baseline.XXXXXX")
work=$(mktemp -d "${TMPDIR:-/tmp}/rklings-proc-read-contract-work.XXXXXX")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rklings-proc-read-contract-test.XXXXXX")
trap 'rm -rf -- "$baseline" "$work" "$scratch"' EXIT

cp -a "$HERE/../../L02-owned-kernel-state/solution/." "$baseline/"
cp -a "$HERE/../../L03-proc-publication/solution/." "$baseline/"
cp -a "$baseline/." "$work/"
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../starter/"}
	mkdir -p "$work/$(dirname "$relative")"
	cp -p "$source" "$work/$relative"
done < <(find "$HERE/../starter" -type f -print0)
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../solution/"}
	mkdir -p "$work/$(dirname "$relative")"
	cp -p "$source" "$work/$relative"
done < <(find "$HERE/../solution" -type f -print0)

build_variant()
{
	local name=$1 point=$2 destination=$scratch/$1 log=$scratch/$1.log
	cp -a "$work" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		RKLINGS_FAIL_POINT="$point" modules >"$log" 2>&1; then
		cat "$log" >&2
		printf '[-] %s build failed\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[-] %s builds with warnings\n' "$name" >&2
		exit 1
	fi
}

build_variant success 0
build_variant preflight 1
build_variant allocation 2
build_variant publication 3
"$HERE/host-check" "$scratch/success" "$scratch/success/rklings.ko"

reject_host_mutant()
{
	local directory=$1 label=$2

	if "$HERE/host-check" "$directory" "$directory/rklings.ko" \
		> "$scratch/$label-host.log" 2>&1; then
		printf '[-] host checker accepted %s\n' "$label" >&2
		exit 1
	fi
}

constant_accessor=$scratch/constant-accessor
cp -a "$scratch/success" "$constant_accessor"
sed -i '/^bool rk_state_is_active/,/^}/c\
bool rk_state_is_active(const struct rk_state *state)\
{\
\t(void)state;\
\treturn true;\
}' "$constant_accessor/core/state.c"
reject_host_mutant "$constant_accessor" constant-state-accessor

constant_renderer=$scratch/constant-renderer
cp -a "$scratch/success" "$constant_renderer"
sed -i 's/seq_printf(output, "active=%u\\n", active ? 1U : 0U);/(void)active; seq_printf(output, "active=1\\n");/' \
	"$constant_renderer/interface/proc.c"
reject_host_mutant "$constant_renderer" constant-proc-renderer

cp -a "$work" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 RKLINGS_FAIL_POINT=99 \
	modules >"$scratch/unknown.log" 2>&1; then
	printf '[-] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

run_guest()
{
	local check_script=$1 module=$2 output
	shift 2
	if ! output=$("$HERE/../../../vm/boot" --check "$check_script" "$@" "$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[-] disposable guest did not complete\n' >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/../../L03-proc-publication/checks/failure-ecanceled-check" \
	"$scratch/preflight/rklings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/../../L03-proc-publication/checks/failure-enomem-check" \
	"$scratch/allocation/rklings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/../../L03-proc-publication/checks/failure-after-state-check" \
	"$scratch/publication/rklings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/success-check" "$scratch/success/rklings.ko" \
	--tool vm/tools/proc_read_test
