#!/bin/sh
# Check: file download works over mTLS
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "File transfer"

wait_for_agent 10

# Create a test file on the VM
ssh_vm "echo 'rootkitlings-transfer-test' > /tmp/rk_xfer_test"

# Download it
send_cmd "DOWNLOAD /tmp/rk_xfer_test"
size=$(read_response)
data=$(read_bytes "$size")

if echo "$data" | grep -q "rootkitlings-transfer-test"; then
    _ok "DOWNLOAD returned correct file content"
else
    _fail "DOWNLOAD content mismatch: $data"
fi

# Verify size matches
expected=27
if [ "$size" -ge "$expected" ] 2>/dev/null; then
    _ok "size header present ($size bytes)"
else
    _fail "invalid size header: $size"
fi

# Cleanup
ssh_vm "rm -f /tmp/rk_xfer_test"

summary
