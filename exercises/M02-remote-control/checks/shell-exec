#!/bin/sh
# Check: remote shell execution returns correct output
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Remote shell execution"

wait_for_agent 10

# Execute a known command
send_cmd "SHELL uname -r"
resp=$(read_until_dot)

if echo "$resp" | grep -qE "^[0-9]+\.[0-9]+"; then
    _ok "SHELL uname -r returned kernel version: $(echo "$resp" | head -1)"
else
    _fail "SHELL did not return kernel version: $resp"
fi

# Execute id to verify it runs in the agent's context
send_cmd "SHELL id"
resp=$(read_until_dot)

if echo "$resp" | grep -q "uid="; then
    _ok "SHELL id returned uid info"
else
    _fail "SHELL id failed: $resp"
fi

summary
