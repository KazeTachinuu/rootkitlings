#!/bin/sh
# Check: operator commands reach agent and return results
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Command dispatch"

wait_for_agent 10

# PING
send_cmd "PING"
assert_response "PONG"
_ok "PING/PONG works"

# STATUS
send_cmd "STATUS"
resp=$(read_response)
if echo "$resp" | grep -q "PID"; then
    _ok "STATUS returns agent info"
else
    _fail "STATUS did not return expected fields: $resp"
fi

summary
