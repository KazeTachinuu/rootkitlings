#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Second allocation failure rollback"
dmesg -C

assert_inventory_absent()
{
	assert_absent /sys/module/rklings
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings appears in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
}

attempt=1
while [ "$attempt" -le 2 ]; do
	if output=$(module_load_test "${RKLINGS_DIR:-/rklings}/rklings.ko" 12 2>&1); then
		_ok "attempt $attempt returned ENOMEM"
	else
		_fail "attempt $attempt did not return ENOMEM: $output"
	fi
	assert_inventory_absent
	attempt=$((attempt + 1))
done

released=$(dmesg | grep -c 'rklings: released channel 1')
if [ "$released" -eq 2 ]; then
	_ok "channel A was released after both rejected loads"
else
	_fail "expected 2 channel A releases, found $released"
fi

summary
