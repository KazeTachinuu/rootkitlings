#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Channel lifetime"
dmesg -C

load rklings.ko
assert_loaded rklings
unload rklings
assert_absent /sys/module/rklings

sequence=$(dmesg | sed -n 's/.*rklings: released channel \([0-9][0-9]*\).*/\1/p' | tr '\n' ' ')
if [ "$sequence" = "2 1 " ]; then
	_ok "channels were released in reverse order"
else
	_fail "channel release order was '$sequence', expected '2 1'"
fi

summary
