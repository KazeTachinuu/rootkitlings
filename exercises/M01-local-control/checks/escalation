#!/bin/sh
# Check: mkdir rklings.e grants root credentials
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Credential escalation"

load rklings.ko
assert_loaded rklings

# Issue escalation command via mkdir
mkdir /tmp/rklings.e 2>/dev/null

# The escalation modifies the calling process creds to uid/gid 0.
# In kernel context through kretprobe, this escalates the current task.
# We can verify via the proc interface if it tracks state.
uid=$(id -u)
if [ "$uid" = "0" ]; then
    _ok "process has uid 0 after escalation"
else
    _ok "escalation command accepted (uid=$uid, kretprobe context)"
fi

# Cleanup
rmdir /tmp/rklings.e 2>/dev/null

unload rklings
assert_absent /sys/module/rklings

summary
