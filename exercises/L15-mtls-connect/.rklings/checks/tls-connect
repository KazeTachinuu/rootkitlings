#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Agent connects to server with TLS 1.3"

# The rootless lesson server runs on the host at 10.0.2.2:8443.
# Run the agent and capture its output.
timeout 10 /rklings/agent > /tmp/agent_output 2>&1
ret=$?

if [ "$ret" -eq 0 ]; then
    _ok "agent exited cleanly"
else
    _fail "agent exited with code $ret"
fi

# Verify the agent received a response from the server
if [ -s /tmp/agent_output ]; then
    _ok "agent received data from server"
else
    _fail "agent produced no output, connection likely failed"
fi

# Require the exact greeting from the real validation server.
output=$(cat /tmp/agent_output)
if echo "$output" | grep -qx "WELCOME rootkitlings"; then
    _ok "received authenticated server greeting"
else
    _fail "unexpected server response: $output"
fi

# Cleanup
rm -f /tmp/agent_output

summary
