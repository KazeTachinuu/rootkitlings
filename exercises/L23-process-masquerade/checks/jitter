#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Callback interval varies between connections"

assert_loaded rklings

# Start a minimal TLS listener that logs timestamps of connections
# The agent should connect multiple times with varying intervals

timestamps=""
count=0
timeout_at=$(($(date +%s) + 90))

# Listen for 3 connections and record timestamps
while [ "$count" -lt 3 ] && [ "$(date +%s)" -lt "$timeout_at" ]; do
    # Wait for a connection (the agent auto-reconnects with jitter)
    if wait_for_connection 443 5; then
        timestamps="$timestamps $(date +%s%N)"
        count=$((count + 1))
    fi
done

if [ "$count" -lt 3 ]; then
    _fail "did not receive 3 connections within timeout"
    summary
    exit 0
fi

# Parse timestamps and check that intervals differ
t1=$(echo "$timestamps" | awk '{print $1}')
t2=$(echo "$timestamps" | awk '{print $2}')
t3=$(echo "$timestamps" | awk '{print $3}')

d1=$((t2 - t1))
d2=$((t3 - t2))

# If both intervals are identical, jitter is not working
if [ "$d1" -eq "$d2" ]; then
    _fail "intervals are identical ($d1 ns), jitter not working"
else
    _ok "intervals differ (${d1}ns vs ${d2}ns), jitter active"
fi

summary
