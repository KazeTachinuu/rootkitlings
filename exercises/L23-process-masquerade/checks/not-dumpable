#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Process is not dumpable and core dumps disabled"

assert_loaded rklings

# Start agent in background
./agent &
agent_pid=$!
sleep 2

# Check dumpable flag via /proc/pid/status
dumpable=$(grep 'Dumpable' "/proc/$agent_pid/status" 2>/dev/null | awk '{print $2}')

if [ "$dumpable" = "0" ]; then
    _ok "process is not dumpable"
else
    _fail "expected Dumpable: 0, got: $dumpable"
fi

# Check that core dump limit is zero via /proc/pid/limits
core_soft=$(grep 'Max core file size' "/proc/$agent_pid/limits" 2>/dev/null | awk '{print $5}')

if [ "$core_soft" = "0" ]; then
    _ok "core dump limit is zero"
else
    _fail "expected core limit 0, got: $core_soft"
fi

kill "$agent_pid" 2>/dev/null
wait "$agent_pid" 2>/dev/null

summary
