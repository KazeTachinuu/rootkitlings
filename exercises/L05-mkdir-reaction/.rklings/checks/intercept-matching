#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Matching mkdir triggers intercept log"

load rklings.ko

# mkdir with the rklings. prefix: the hook extracts the basename,
# sees "rklings.hello", and logs the portion after the prefix.
mkdir /tmp/rklings.hello 2>/dev/null

assert_log "rklings: intercepted mkdir: hello"

# Verify the directory was NOT actually created (handler returns -ENOENT).
if [ -d /tmp/rklings.hello ]; then
    _fail "mkdir should have been suppressed but /tmp/rklings.hello exists"
else
    _ok "mkdir was suppressed (directory not created)"
fi

# Clear dmesg, try a second trigger with a different suffix.
dmesg -c > /dev/null 2>&1
mkdir /tmp/rklings.world 2>/dev/null

assert_log "rklings: intercepted mkdir: world"

# Clean up.
rm -rf /tmp/rklings.hello /tmp/rklings.world 2>/dev/null
unload rklings

summary
