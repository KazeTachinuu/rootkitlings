#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "SHELL id returns uid=0"

wait_agent

# Send SHELL id, expect uid=0 in output
resp=$(send_cmd "SHELL id")
if echo "$resp" | grep -q "uid=0"; then
    _ok "SHELL id returned uid=0"
else
    _fail "expected uid=0 in output, got: $resp"
fi

summary
