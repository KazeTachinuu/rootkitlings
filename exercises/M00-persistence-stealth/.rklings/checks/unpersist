#!/bin/sh
# Check: mkdir rklings.unpersist clears the persistence conf file
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Unpersist via mkdir command"

assert_loaded rklings

# Now unpersist
mkdir /tmp/rklings.unpersist 2>/dev/null

# The solution truncates to empty rather than removing
if [ -f /etc/modules-load.d/rklings.conf ]; then
    content=$(cat /etc/modules-load.d/rklings.conf 2>/dev/null)
    case "$content" in
        *rklings*)
            _fail "rklings.conf still contains 'rklings' after unpersist"
            ;;
        *)
            _ok "rklings.conf cleared after unpersist"
            ;;
    esac
else
    _ok "rklings.conf removed after unpersist"
fi

unload rklings
assert_absent /sys/module/rklings
rm -f "/lib/modules/$(uname -r)/extra/rklings.ko"
depmod -a

summary
