#!/bin/sh
# Check: mkdir rklings.h.m hides module from lsmod
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Module hiding via mkdir rklings.h.m"

# Load unless already present from a prior check
if ! grep -q '^rklings ' /proc/modules; then
    load rklings.ko
fi
assert_loaded rklings

# Before hiding, module should be visible in lsmod
if lsmod | grep -q '^rklings '; then
    _ok "rklings visible in lsmod before hiding"
else
    _fail "rklings not visible in lsmod before hiding"
fi

# Issue hide command
mkdir rklings.h.m 2>/dev/null

# After hiding: should NOT appear in lsmod
if lsmod | grep -q '^rklings '; then
    _fail "rklings still visible in lsmod after hide"
else
    _ok "rklings hidden from lsmod"
fi

# /sys/module/rklings should also be gone
if test -d /sys/module/rklings; then
    _fail "rklings still visible in /sys/module after hide"
else
    _ok "rklings hidden from /sys/module"
fi

# Verify unhide restores the module to the kernel list
mkdir rklings.u.m 2>/dev/null

if grep -q '^rklings ' /proc/modules; then
    _ok "rklings restored in /proc/modules after unhide"
else
    _fail "rklings not restored in /proc/modules after unhide"
fi

summary
