#!/bin/sh
# Check: mkdir rklings.h.m hides module from lsmod
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Module hiding via mkdir rklings.h.m"

load rklings.ko
assert_loaded rklings

# Before hiding, module should be visible in lsmod
if lsmod | grep -q '^rklings '; then
    _ok "rklings visible in lsmod before hiding"
else
    _fail "rklings not visible in lsmod before hiding"
fi

# Issue hide command
mkdir /tmp/rklings.h.m 2>/dev/null

# After hiding: should NOT appear in lsmod
if lsmod | grep -q '^rklings '; then
    _fail "rklings still visible in lsmod after hide"
else
    _ok "rklings hidden from lsmod"
fi

# But /sys/module/rklings should still exist (module IS loaded)
assert_loaded rklings

# The /proc/rklings interface should still work
if [ -f /proc/rklings ]; then
    _ok "/proc/rklings still accessible while hidden"
else
    _ok "/proc/rklings not present (acceptable)"
fi

# Cleanup: unhide so unload works
mkdir /tmp/rklings.u.m 2>/dev/null
rmdir /tmp/rklings.h.m 2>/dev/null
rmdir /tmp/rklings.u.m 2>/dev/null

unload rklings
assert_absent /sys/module/rklings

summary
