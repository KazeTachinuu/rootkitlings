#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Add targets and read them back"

# Before loading: no /proc/rklings
assert_absent /proc/rklings

load rklings.ko

# Verify /proc/rklings exists with private diagnostic permissions
assert_exists /proc/rklings
mode=$(stat -c '%a' /proc/rklings)
if [ "$mode" = "600" ]; then
    _ok "/proc/rklings mode is 0600"
else
    _fail "/proc/rklings mode: expected 0600, got $mode"
fi

# Initially empty
content=$(cat /proc/rklings)
if [ -z "$content" ]; then
    _ok "target list starts empty"
else
    _fail "target list not empty on load: got '$content'"
fi

# Add first target
printf 'add secret_file' > /proc/rklings
content=$(cat /proc/rklings)
if [ "$content" = "secret_file" ]; then
    _ok "single target reads back correctly"
else
    _fail "after add secret_file: expected 'secret_file', got '$content'"
fi

# Add second target
printf 'add hidden_dir' > /proc/rklings
printf 'add hidden_dir' > /proc/rklings
content=$(cat /proc/rklings)
expected="secret_file
hidden_dir"
if [ "$content" = "$expected" ]; then
    _ok "two targets read back in order without a duplicate"
else
    _fail "after add hidden_dir: expected two lines, got '$content'"
fi

# Add a third target to verify continued appending
printf 'add another_one' > /proc/rklings
lines=$(cat /proc/rklings | wc -l)
if [ "$lines" -eq 3 ]; then
    _ok "three targets listed after three adds"
else
    _fail "expected 3 lines, got $lines"
fi

unload rklings
assert_absent /proc/rklings

summary
