#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Adding beyond RK_TARGET_MAX is rejected"

load rklings.ko

# Fill the list to capacity (32 entries)
i=0
while [ "$i" -lt 32 ]; do
    printf 'add target_%d' "$i" > /proc/rklings
    i=$(( i + 1 ))
done

lines=$(cat /proc/rklings | wc -l)
if [ "$lines" -eq 32 ]; then
    _ok "32 targets stored at capacity"
else
    _fail "expected 32 targets at capacity, got $lines"
fi

# Attempt to add one more and require ENOSPC to reach userspace.
if printf 'add overflow_entry' > /proc/rklings 2>/dev/null; then
    _fail "33rd add returned success"
else
    _ok "33rd add returned an error"
fi
lines=$(cat /proc/rklings | wc -l)
if [ "$lines" -eq 32 ]; then
    _ok "33rd add rejected, list still at 32"
else
    _fail "expected 32 after overflow attempt, got $lines"
fi

# Verify overflow_entry is not in the list
content=$(cat /proc/rklings)
case "$content" in
    *overflow_entry*) _fail "overflow_entry should not be in the list" ;;
    *) _ok "overflow_entry correctly absent" ;;
esac

# Verify first and last entries are intact
first=$(cat /proc/rklings | head -n 1)
last=$(cat /proc/rklings | tail -n 1)
if [ "$first" = "target_0" ]; then
    _ok "first entry is target_0"
else
    _fail "first entry: expected target_0, got '$first'"
fi
if [ "$last" = "target_31" ]; then
    _ok "last entry is target_31"
else
    _fail "last entry: expected target_31, got '$last'"
fi

unload rklings

summary
