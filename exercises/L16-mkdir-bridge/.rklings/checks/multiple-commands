#!/bin/sh
# shellcheck source=/dev/null
# shellcheck disable=SC2010 # ls output is the behavior under test.
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Agent processes multiple commands in sequence"

assert_loaded rklings

# Create test files
echo "file a" > /tmp/multi_a.txt
echo "file b" > /tmp/multi_b.txt

# Send two hide commands in sequence via relay
wait_agent
send_cmd "HIDE FILE multi_a.txt" > /dev/null
sleep 1
send_cmd "HIDE FILE multi_b.txt" > /dev/null
sleep 2

# Both files should be hidden from ls
hidden=0
if ! ls /tmp/ | grep -q "multi_a.txt"; then
    hidden=$((hidden + 1))
fi
if ! ls /tmp/ | grep -q "multi_b.txt"; then
    hidden=$((hidden + 1))
fi

if [ "$hidden" -eq 2 ]; then
    _ok "both files hidden after sequential commands"
elif [ "$hidden" -eq 1 ]; then
    _fail "only one file hidden, agent may not loop correctly"
else
    _fail "neither file hidden, command bridge not working"
fi

# Cleanup
rm -f /tmp/multi_a.txt /tmp/multi_b.txt

summary
