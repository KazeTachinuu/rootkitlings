#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Unhidden port reappears in /proc/net/tcp"

ip link set lo up

nc -l -p 31337 &
NC_PID=$!
sleep 1

load rklings.ko

# 31337 = 0x7A69
mkdir /tmp/rklings.h.p.31337

if grep -qi ":7A69 " /proc/net/tcp; then
  _fail "port 31337 still visible after hide (setup failed)"
else
  _ok "port 31337 is hidden (setup confirmed)"
fi

mkdir /tmp/rklings.u.p.31337

if grep -qi ":7A69 " /proc/net/tcp; then
  _ok "port 31337 reappears after unhide command"
else
  _fail "port 31337 still missing after unhide command"
fi

kill $NC_PID 2>/dev/null
wait $NC_PID 2>/dev/null
unload rklings

summary
