#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Hidden port vanishes from /proc/net/tcp"

ip link set lo up

nc -l -p 31337 &
NC_PID=$!
sleep 1

# 31337 = 0x7A69
if grep -qi ":7A69 " /proc/net/tcp; then
  _ok "port 31337 visible in /proc/net/tcp before module load"
else
  _fail "port 31337 not visible before module load (listener may have failed)"
fi

load rklings.ko

if grep -qi ":7A69 " /proc/net/tcp; then
  _ok "port 31337 still visible after module load (no hide yet)"
else
  _fail "port 31337 disappeared after module load without hide command"
fi

mkdir rklings.h.p.31337

if grep -qi ":7A69 " /proc/net/tcp; then
  _fail "port 31337 (hex 7A69) still in /proc/net/tcp after hide"
else
  _ok "port 31337 hidden from /proc/net/tcp"
fi

kill $NC_PID 2>/dev/null
wait $NC_PID 2>/dev/null
unload rklings

summary
