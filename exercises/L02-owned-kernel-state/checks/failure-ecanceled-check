#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Preflight rejection"

assert_not_loaded()
{
	assert_absent /sys/module/rklings
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings appears in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
}

assert_not_loaded
for attempt in 1 2; do
	if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko 125; then
		_ok "attempt $attempt returned numeric ECANCELED"
	else
		_fail "attempt $attempt did not return ECANCELED"
	fi
	assert_not_loaded
done

summary
