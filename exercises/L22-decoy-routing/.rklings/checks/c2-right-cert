#!/bin/sh
# shellcheck source=/dev/null
# shellcheck disable=SC2154 # _server_pid is set by start_server in lib.sh.
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Client with rklings CA cert reaches C2"

# Start the server in background
start_server ./server
wait_for_port 443

# Connect with a valid agent cert signed by rklings CA
body=$(curl -sk --cert /tmp/agent.crt --key /tmp/agent.key https://127.0.0.1:443/ 2>/dev/null)

if echo "$body" | grep -qi "c2\|command\|agent"; then
    _ok "valid agent cert reached C2 channel"
else
    _fail "expected C2 response with valid cert, got: $body"
fi

# Verify it is NOT the decoy page
if echo "$body" | grep -qi "heroic administrator"; then
    _fail "C2 response should not contain decoy content"
fi

kill "$_server_pid" 2>/dev/null
wait "$_server_pid" 2>/dev/null

summary
