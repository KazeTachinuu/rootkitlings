#!/bin/sh
# shellcheck source=/dev/null
# shellcheck disable=SC2154 # _server_pid is set by start_server in lib.sh.
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Client without cert receives decoy page"

# Start the server in background
start_server ./server
wait_for_port 443

# Connect without any client certificate
body=$(curl -sk https://127.0.0.1:443/ 2>/dev/null)

if echo "$body" | grep -qi "heroic administrator"; then
    _ok "no-cert client received decoy page"
else
    _fail "expected decoy page, got: $body"
fi

kill "$_server_pid" 2>/dev/null
wait "$_server_pid" 2>/dev/null

summary
