#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Client with wrong cert receives decoy page"

# Start the server in background
start_server ./server &
srv_pid=$!
wait_for_port 443

# Connect with a self-signed cert (not from rklings CA)
body=$(curl -sk --cert /tmp/wrong.crt --key /tmp/wrong.key https://127.0.0.1:443/ 2>/dev/null)

if echo "$body" | grep -qi "welcome\|it works\|default"; then
    _ok "wrong-cert client received decoy page"
else
    _fail "expected decoy page with wrong cert, got: $body"
fi

kill "$srv_pid" 2>/dev/null
wait "$srv_pid" 2>/dev/null

summary
