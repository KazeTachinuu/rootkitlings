#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Ping and escalation commands still work"

load rklings.ko
assert_loaded rklings

# Ping should still dispatch
mkdir rklings.ping 2>/dev/null
assert_log "pong"

# Escalation should still work
uid=$(su student -c 'mkdir rklings.e 2>/dev/null; id -u')
if [ "$uid" = "0" ]; then
    _ok "mkdir rklings.e escalated student to uid 0"
else
    _fail "expected uid 0 after mkdir rklings.e, got $uid"
fi

# Cleanup
rm -rf rklings.ping rklings.e 2>/dev/null
unload rklings

summary
