#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[-] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR ARTIFACT_PATH"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"

[[ -d $build_dir && ! -L $build_dir ]] || die "build directory must be a real directory"
[[ -f $artifact && ! -L $artifact ]] || die "artifact must be a regular file"
[[ $artifact == "$build_dir/rklings.ko" ]] ||
	die "expected artifact at: $build_dir/rklings.ko"
[[ -f $build_dir/rklings.mod && ! -L $build_dir/rklings.mod ]] ||
	die "build output is missing rklings.mod"
mapfile -t module_objects < <(sed '/^[[:space:]]*$/d' "$build_dir/rklings.mod")
(( ${#module_objects[@]} == 1 )) ||
	die "rklings.ko must contain only core/main.o"
module_object=${module_objects[0]}
[[ $module_object == /* ]] || module_object=$build_dir/$module_object
[[ $(realpath -m -- "$module_object") == "$build_dir/core/main.o" ]] ||
	die "rklings.ko must contain only core/main.o"

command -v modinfo >/dev/null || die "modinfo is required"
[[ $(modinfo -F license "$artifact") == GPL ]] || die "module license must be GPL"
[[ $(modinfo -F description "$artifact") == 'Rklings kernel module' ]] ||
	die "module description must be: Rklings kernel module"

printf '[+] module artifact and metadata verified\n'
