#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Module lifecycle"

assert_inventory_present()
{
	if grep -q '^rklings ' /proc/modules; then
		_ok "rklings is present in /proc/modules"
	else
		_fail "rklings is absent from /proc/modules"
	fi
}

assert_inventory_absent()
{
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings remains in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
}

assert_absent /sys/module/rklings
assert_inventory_absent

load rklings.ko
assert_loaded rklings
assert_inventory_present

unload rklings
assert_absent /sys/module/rklings
assert_inventory_absent

load rklings.ko
assert_loaded rklings
assert_inventory_present

unload rklings
assert_absent /sys/module/rklings
assert_inventory_absent

summary
