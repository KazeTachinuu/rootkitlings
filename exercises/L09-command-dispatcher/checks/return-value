#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Intercepted mkdir returns 0, not ENOENT"

load rklings.ko
assert_loaded rklings

# The kretprobe should override the return value to 0 for recognized commands.
# An intercepted mkdir should succeed (exit code 0), not fail with ENOENT.
mkdir /tmp/rklings.ping 2>/dev/null
ret=$?
if [ "$ret" -eq 0 ]; then
    _ok "mkdir rklings.ping returned 0 (success)"
else
    _fail "mkdir rklings.ping returned $ret, expected 0"
fi

# Verify the directory was not actually created (pathname was nullified)
if [ ! -d "/tmp/rklings.ping" ]; then
    _ok "no real directory created for intercepted mkdir"
else
    _ok "directory may exist due to nullified path handling"
    rm -rf /tmp/rklings.ping 2>/dev/null
fi

# Unknown commands should not crash the system
mkdir /tmp/rklings.nonexistent 2>/dev/null
_ok "unknown command did not crash"

# Cleanup
rm -rf /tmp/rklings.ping /tmp/rklings.nonexistent 2>/dev/null
unload rklings

summary
