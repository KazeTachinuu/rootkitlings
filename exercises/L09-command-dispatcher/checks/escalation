#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Escalation command via mkdir rklings.e"

load rklings.ko
assert_loaded rklings

# As non-root student, mkdir rklings.e should escalate to uid 0
uid=$(su student -c 'mkdir_escalation_test /tmp/rklings.e')
if [ "$uid" = "0" ]; then
    _ok "mkdir rklings.e escalated student to uid 0"
else
    _fail "expected uid 0 after mkdir rklings.e, got $uid"
fi

# Cleanup
rm -rf /tmp/rklings.e 2>/dev/null
unload rklings

summary
