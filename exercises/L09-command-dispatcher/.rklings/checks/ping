#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Ping command via mkdir rklings.ping"

load rklings.ko
assert_loaded rklings

# Issue the ping command
mkdir /tmp/rklings.ping 2>/dev/null

# Verify dmesg contains the dispatch log
assert_log "dispatch: cmd=ping"

# Cleanup
rm -rf /tmp/rklings.ping 2>/dev/null
unload rklings

summary
