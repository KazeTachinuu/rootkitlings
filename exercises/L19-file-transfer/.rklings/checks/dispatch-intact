#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "PING and SHELL still work alongside file transfer"

wait_agent

# Verify PING
resp=$(send_cmd "PING")
if echo "$resp" | grep -q "PONG"; then
    _ok "PING returned PONG"
else
    _fail "expected PONG, got: $resp"
fi

# Verify SHELL
resp=$(send_cmd "SHELL echo works")
if echo "$resp" | grep -q "works"; then
    _ok "SHELL echo works returned output"
else
    _fail "expected 'works' in output, got: $resp"
fi

summary
