#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Procfs state read"

expected=/tmp/rklings-expected
printf 'active=1\n' > "$expected"

assert_not_loaded()
{
	assert_absent /sys/module/rklings
	assert_absent /proc/rklings
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings appears in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
}

check_loaded()
{
	assert_loaded rklings
	assert_exists /proc/rklings
	mode=$(stat -c '%a' /proc/rklings)
	if [ "$mode" = "644" ]; then
		_ok "/proc/rklings mode is 0644 (read-write)"
	else
		_fail "/proc/rklings mode: expected 0644, got $mode"
	fi
	if grep -q '^rklings ' /proc/modules; then
		_ok "rklings appears in /proc/modules"
	else
		_fail "rklings is absent from /proc/modules"
	fi
}

check_control()
{
	printf '0abcdefghijklmnopqrstuvwxyz\n' > /proc/rklings
	assert_read /proc/rklings 'active=0'
	printf '1\n' > /proc/rklings
	assert_read /proc/rklings 'active=1'
	if printf 'x\n' > /proc/rklings 2>/dev/null; then
		_fail "invalid control value was accepted"
	else
		_ok "invalid control value returns an error"
	fi
	assert_read /proc/rklings 'active=1'
}

assert_not_loaded
for attempt in 1 2; do
	load rklings.ko
	check_loaded
	check_control
	if proc_read_test /proc/rklings "$expected" rklings fault-write; then
		_ok "attempt $attempt passed read, fault, and open-unload contracts"
	else
		_fail "attempt $attempt failed the read or open-unload contract"
	fi
	assert_not_loaded
done

summary
