#!/bin/sh
# Check: unhiding a content pattern restores filtered lines.
# Uses split-variable construction to avoid the filter breaking
# the script source during ksys_read interception.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Unhidden string reappears in output"

TESTFILE="/tmp/rk_unhide_test"

_A="hidde"
_B="n_marker"
TOKEN="${_A}${_B}"

printf "visible line\n%s data\nanother visible line\n" "$TOKEN" > "$TESTFILE"

load rklings.ko

mkdir "/tmp/rklings.h.c.${TOKEN}"

output=$(cat "$TESTFILE")
if echo "$output" | grep -q "$TOKEN"; then
  _fail "target still visible after hide command"
else
  _ok "target is filtered after hide command"
fi

mkdir "/tmp/rklings.u.c.${TOKEN}"

output=$(cat "$TESTFILE")
if echo "$output" | grep -q "$TOKEN"; then
  _ok "target reappears after unhide command"
else
  _fail "target still missing after unhide command"
fi

if echo "$output" | grep -q "visible line"; then
  _ok "other lines remain intact throughout"
else
  _fail "other lines were corrupted"
fi

unload rklings
rm -f "$TESTFILE"

summary
