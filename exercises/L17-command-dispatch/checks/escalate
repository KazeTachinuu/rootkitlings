#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "ESCALATE command triggers privilege escalation"

wait_agent

# Send ESCALATE
resp=$(send_cmd "ESCALATE")
if echo "$resp" | grep -q "OK"; then
    _ok "ESCALATE returned OK"
else
    _fail "expected OK, got: $resp"
fi

# Agent issues mkdir rklings.e which triggers credential escalation.
# M01+ has no pr_info for escalation (OPSEC), so verify the agent
# responded correctly and the module is still stable.
_ok "escalate command dispatched via mkdir"

summary
