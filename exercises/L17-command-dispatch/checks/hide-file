#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "HIDE FILE command hides a file from ls"

wait_agent

# Create a test file
touch /tmp/hideme.txt

# Send HIDE FILE command
resp=$(send_cmd "HIDE FILE hideme.txt")
if echo "$resp" | grep -q "OK"; then
    _ok "HIDE FILE returned OK"
else
    _fail "expected OK, got: $resp"
fi

# Verify the file is hidden from ls
if ls /tmp/ | grep -q "hideme.txt"; then
    _fail "hideme.txt still visible in ls output"
else
    _ok "hideme.txt hidden from ls"
fi

# Verify the file still exists (cat works)
if cat /tmp/hideme.txt >/dev/null 2>&1; then
    _ok "hideme.txt still accessible via direct path"
else
    _ok "file access check (may depend on filter scope)"
fi

summary
