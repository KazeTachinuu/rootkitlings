#!/bin/sh
# Check: last shows no login record for the session
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "No login records"

wait_for_agent 10

# Check utmp (current logins)
who_entries=$(ssh_vm "who | grep student | wc -l")
if [ "${who_entries:-0}" -eq 0 ]; then
    _ok "no student entry in who (utmp clean)"
else
    _fail "student still appears in who ($who_entries entries)"
fi

# Check wtmp (login history)
last_entries=$(ssh_vm "last -f /var/log/wtmp 2>/dev/null | grep student | wc -l")
if [ "${last_entries:-0}" -eq 0 ]; then
    _ok "no student entry in last (wtmp clean)"
else
    _fail "student still appears in last ($last_entries entries)"
fi

summary
