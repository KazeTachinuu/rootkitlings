#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Other names keep their normal behavior"

load rklings.ko

for name in rklings.other rklings.e.123 ordinary-rklings.e; do
    path=/home/student/$name
    rm -rf "$path"

    uid_after=$(su student -c \
        "cd /home/student && mkdir $name 2>/dev/null && id -u")

    if [ "$uid_after" = "1000" ]; then
        _ok "calling shell remains uid 1000: $name"
    else
        _fail "calling shell uid for $name: expected 1000, got '$uid_after'"
    fi
    assert_exists "$path"
done

if dmesg | grep -Fq "rklings: escalated pid"; then
    _fail "a non-matching name produced an escalation log"
else
    _ok "non-matching names produced no escalation log"
fi

rm -rf /home/student/rklings.other /home/student/rklings.e.123 \
    /home/student/ordinary-rklings.e
unload rklings
assert_absent /sys/module/rklings
summary
