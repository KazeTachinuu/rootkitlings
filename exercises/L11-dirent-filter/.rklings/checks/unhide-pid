#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Unhidden PID reappears"

load rklings.ko

# Start a background process
sleep 3600 &
pid=$!

# Hide the PID
mkdir "/tmp/rklings.h.i.$pid" 2>/dev/null

ps_out=$(ps)
case "$ps_out" in
    *"$pid"*) _fail "PID $pid should be hidden" ;;
    *) _ok "PID $pid is hidden" ;;
esac

# Restore the same PID value that was concealed.
mkdir "/tmp/rklings.u.i.$pid" 2>/dev/null

ps_out=$(ps)
case "$ps_out" in
    *"$pid"*) _ok "PID $pid reappears after unhide" ;;
    *) _fail "PID $pid still hidden after unhide" ;;
esac

# Verify /proc listing also shows it again
proc_listing=$(ls /proc)
case "$proc_listing" in
    *"$pid"*) _ok "PID $pid directory visible in /proc again" ;;
    *) _fail "PID $pid directory still hidden from /proc" ;;
esac

# Test hide/unhide cycle a second time
mkdir "/tmp/rklings.h.i.$pid" 2>/dev/null
ps_out=$(ps)
case "$ps_out" in
    *"$pid"*) _fail "PID should be hidden on second hide" ;;
    *) _ok "PID hidden on second cycle" ;;
esac

mkdir "/tmp/rklings.u.i.$pid" 2>/dev/null
ps_out=$(ps)
case "$ps_out" in
    *"$pid"*) _ok "PID reappears on second unhide" ;;
    *) _fail "PID still hidden on second unhide" ;;
esac

# Clean up
kill "$pid" 2>/dev/null
wait "$pid" 2>/dev/null

unload rklings

summary
