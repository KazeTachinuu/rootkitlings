#!/bin/sh
. /lib/check.sh

begin "C02: dead-man watchdog"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_watchdog
assert_contains /proc/rk_watchdog "state=healthy"
assert_contains /proc/rk_watchdog "heartbeats=0"
assert_contains /proc/rk_watchdog "timeouts=0"
assert_contains /proc/rk_watchdog "timeout_ms=2000"

if printf 'unknown' > /proc/rk_watchdog 2>/dev/null; then
    _fail "unknown command was accepted"
else
    _ok "unknown command rejected"
fi

printf 'ping\n' > /proc/rk_watchdog
assert_contains /proc/rk_watchdog "state=healthy"
assert_contains /proc/rk_watchdog "heartbeats=1"

sleep 3
assert_contains /proc/rk_watchdog "state=stale"
assert_contains /proc/rk_watchdog "timeouts=1"

sleep 3
assert_contains /proc/rk_watchdog "timeouts=1"

printf 'ping' > /proc/rk_watchdog
assert_contains /proc/rk_watchdog "state=healthy"
assert_contains /proc/rk_watchdog "heartbeats=2"
assert_contains /proc/rk_watchdog "timeouts=1"

unload hello
assert_absent /proc/rk_watchdog
if ps | grep -q '[[]rk_watchdog[]]'; then
    _fail "watchdog thread survived unload"
else
    _ok "watchdog thread stopped"
fi

summary
