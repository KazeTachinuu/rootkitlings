#!/bin/sh
. /lib/check.sh

begin "C04: file tripwire"

mkdir -p /etc
printf 'root:x:0:0:root:/root:/bin/sh\n' > /etc/passwd
printf 'root:!:0:::::\n' > /etc/shadow
printf 'root:x:0:\n' > /etc/group

probe_before=$(grep -c 'do_sys_openat2' /sys/kernel/debug/kprobes/list || true)

load hello.ko
assert_loaded hello
assert_exists /proc/rk_tripwire

probe_during=$(grep -c 'do_sys_openat2' /sys/kernel/debug/kprobes/list || true)
if [ "$probe_during" -gt "$probe_before" ]; then
    _ok "do_sys_openat2 probe registered"
else
    _fail "do_sys_openat2 probe is not visible"
fi

if [ -s /proc/rk_tripwire ]; then
    _fail "event ring was not empty on load"
else
    _ok "event ring empty on load"
fi

cat /etc/group >/dev/null
if [ -s /proc/rk_tripwire ]; then
    _fail "unwatched path was recorded"
else
    _ok "unwatched path ignored"
fi

cat /etc/shadow >/dev/null
assert_contains /proc/rk_tripwire "event=1 uid=0"
assert_contains /proc/rk_tripwire "path=/etc/shadow"

cat /etc/passwd >/dev/null
assert_contains /proc/rk_tripwire "event=2 uid=0"
assert_contains /proc/rk_tripwire "path=/etc/passwd"

before=$(wc -l < /proc/rk_tripwire)
write_param hello armed 0
cat /etc/shadow >/dev/null
after=$(wc -l < /proc/rk_tripwire)
if [ "$after" -eq "$before" ]; then
    _ok "disarmed tripwire ignored access"
else
    _fail "disarmed tripwire recorded $before -> $after events"
fi

write_param hello armed 1
cat /etc/shadow >/dev/null
resumed=$(wc -l < /proc/rk_tripwire)
if [ "$resumed" -eq $((after + 1)) ]; then
    _ok "re-armed tripwire recorded access"
else
    _fail "expected one new event after re-arm"
fi

index=0
while [ "$index" -lt 20 ]; do
    cat /etc/passwd >/dev/null
    index=$((index + 1))
done
cat /etc/shadow >/dev/null

bounded=$(wc -l < /proc/rk_tripwire)
if [ "$bounded" -eq 16 ]; then
    _ok "event ring retained exactly 16 records"
else
    _fail "event ring contains $bounded records, expected 16"
fi

last=$(tail -n 1 /proc/rk_tripwire)
case "$last" in
    *"path=/etc/shadow") _ok "newest event retained" ;;
    *) _fail "newest event missing: $last" ;;
esac

unload hello
assert_absent /proc/rk_tripwire

probe_after=$(grep -c 'do_sys_openat2' /sys/kernel/debug/kprobes/list || true)
if [ "$probe_after" -eq "$probe_before" ]; then
    _ok "do_sys_openat2 probe removed"
else
    _fail "probe count did not return to baseline"
fi

summary
