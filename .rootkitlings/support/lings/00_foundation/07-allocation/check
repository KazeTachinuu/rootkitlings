#!/bin/sh
. /lib/check.sh

begin "07-allocation"

load hello.ko
assert_loaded hello

# Verify kmalloc succeeded and stored the expected value
assert_log "rk: allocated value=42"

unload hello
assert_absent /sys/module/hello

# Verify clean unload (no leak)
assert_log "rk: freed state"

begin "07-allocation reload"

load hello.ko
assert_loaded hello

unload hello
assert_absent /sys/module/hello

summary
