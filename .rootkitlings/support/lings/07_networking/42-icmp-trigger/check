#!/bin/sh
. /lib/check.sh

begin "42-icmp-trigger"

ifconfig lo 127.0.0.1 up 2>/dev/null

load hello.ko
assert_loaded hello
assert_exists /proc/rk_trigger

assert_contains /proc/rk_trigger "magic=0x1337"
before=$(sed -n 's/^triggers=//p' /proc/rk_trigger)

# A controlled non-magic echo ID must not trigger.
icmp_send 127.0.0.1 1234
sleep 1
after_plain=$(sed -n 's/^triggers=//p' /proc/rk_trigger)
if [ "$after_plain" = "$before" ]; then
    _ok "non-magic echo left the counter at $before"
else
    _fail "non-magic echo changed the counter: $before -> $after_plain"
fi

# Send ICMP echo with the magic ID 0x1337
icmp_send 127.0.0.1 1337
sleep 1

count=$(cat /proc/rk_trigger | sed -n 's/^triggers=//p')
if [ "$count" -gt "$after_plain" ] 2>/dev/null; then
    _ok "magic ICMP triggered: triggers=$count"
else
    _fail "magic ICMP did not trigger (triggers=$count)"
fi

# Send another to verify counter keeps going
icmp_send 127.0.0.1 1337
sleep 1
count2=$(cat /proc/rk_trigger | sed -n 's/^triggers=//p')
if [ "$count2" -gt "$count" ] 2>/dev/null; then
    _ok "counter increments: $count -> $count2"
else
    _fail "counter stuck: $count -> $count2"
fi

unload hello
assert_absent /proc/rk_trigger

summary
