#!/bin/sh
. /lib/check.sh

begin "14-chardev"

load hello.ko
assert_loaded hello
assert_exists /dev/rk_chardev

# Verify it registered in sysfs as a misc device
assert_exists /sys/class/misc/rk_chardev

content=$(cat /dev/rk_chardev)
if [ "$content" = "hello" ]; then
    _ok "read returned the device payload"
else
    _fail "expected 'hello', got '$content'"
fi

# Second read proves it works repeatedly
content2=$(cat /dev/rk_chardev)
if [ "$content2" = "hello" ]; then
    _ok "second open starts a fresh read"
else
    _fail "second read returned '$content2'"
fi

# Verify device node is a character device
if [ -c /dev/rk_chardev ]; then
    _ok "/dev/rk_chardev is a character device"
else
    _fail "/dev/rk_chardev is not a character device"
fi

unload hello
assert_absent /dev/rk_chardev
assert_absent /sys/class/misc/rk_chardev

summary
