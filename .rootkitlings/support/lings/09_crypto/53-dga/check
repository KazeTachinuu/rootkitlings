#!/bin/sh
. /lib/check.sh

begin "53-dga"

load hello.ko bucket=20000
first=$(sed -n 's/^domain=//p' /proc/rk_dga)
unload hello

load hello.ko bucket=20000
second=$(sed -n 's/^domain=//p' /proc/rk_dga)
unload hello

load hello.ko bucket=20001
third=$(sed -n 's/^domain=//p' /proc/rk_dga)

if [ "$first" = "$second" ] && [ "$first" != "$third" ]; then
    _ok "domain is deterministic per bucket"
else
    _fail "domain generation is not deterministic"
fi
if [ "$first" = "6f158b1adc32cad8.example" ] &&
   [ "$third" = "0e4997bd6ccb967b.example" ]; then
    _ok "domains are derived with the campaign key"
else
    _fail "domains do not match the campaign key"
fi
if printf '%s\n' "$third" | grep -Eq '^[0-9a-f]{16}\.example$'; then
    _ok "domain uses one bounded label and the reserved suffix"
else
    _fail "invalid generated domain: $third"
fi
assert_contains /proc/rk_dga "bucket=20001"

unload hello
assert_absent /proc/rk_dga
summary
