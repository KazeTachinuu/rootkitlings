#!/bin/sh
. /lib/check.sh

begin "capstone-5: red vs blue"

load hello.ko
# Module hides itself, so assert_loaded will FAIL (that's the point)

# Layer 1: module hidden from lsmod
if lsmod | grep -q hello; then
    _fail "module visible in lsmod"
else
    _ok "module hidden from lsmod"
fi

# Layer 2: module hidden from sysfs
if [ -d /sys/module/hello ]; then
    _fail "module visible in /sys/module/"
else
    _ok "module hidden from /sys/module/"
fi

# Layer 3: proc entry hidden from listing
hidden=$(ls /proc/ | grep -c "\.rk")
if [ "$hidden" -eq 0 ]; then
    _ok "proc entry hidden from ls"
else
    _fail "proc entry visible in ls /proc/"
fi

# Layer 3b: but accessible by direct path
if cat /proc/.rk > /dev/null 2>&1; then
    _ok "proc entry accessible by direct path"
else
    _fail "proc entry not accessible at /proc/.rk"
fi

assert_contains /proc/.rk "hidden=yes"
assert_contains /proc/.rk "persistence="
assert_contains /proc/.rk "escalation="

# Layer 4: rmdir trigger for credential escalation
mkdir -p /tmp/.rk-escalate
rmdir /tmp/.rk-escalate
myuid=$(id -u)
if [ "$myuid" -eq 0 ]; then
    _ok "rmdir trigger escalated to root"
else
    _fail "expected uid=0 after rmdir trigger, got $myuid"
fi

# Layer 5: boot persistence file exists
if [ -f /etc/modules-load.d/hello.conf ]; then
    content=$(cat /etc/modules-load.d/hello.conf)
    case "$content" in
        hello*)
            _ok "persistence file installed"
            ;;
        *)
            _fail "persistence file has wrong content: '$content'"
            ;;
    esac
else
    _fail "persistence file not found at /etc/modules-load.d/hello.conf"
fi

# Blue team detection: direct path works even when hidden
_hdr "blue team checks"
if stat /proc/.rk > /dev/null 2>&1; then
    _ok "stat /proc/.rk reveals metadata (detection vector)"
else
    _fail "stat /proc/.rk failed"
fi

# Unload (module is hidden, rmmod by name may fail)
if rmmod hello 2>/dev/null; then
    _ok "unloaded hello"
else
    _fail "rmmod hello failed (module hidden from kernel list)"
fi

summary
