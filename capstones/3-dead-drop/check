#!/bin/sh
. /lib/check.sh

begin "capstone-3: dead drop"

load hello.ko
assert_loaded hello

# .drop should NOT appear in /proc listing
hidden=$(ls /proc/ | grep -c "\.drop")
if [ "$hidden" -eq 0 ]; then
    _ok ".drop hidden from ls /proc/"
else
    _fail ".drop visible in ls /proc/ ($hidden matches)"
fi

# Direct access should fail (hidden state, returns -EACCES)
if cat /proc/.drop > /dev/null 2>&1; then
    _fail "should deny read while hidden"
else
    _ok "read denied while hidden"
fi

# Reveal via signal 63
kill -63 $$

# Now read/write should work
echo "asset compromised" > /proc/.drop
msg=$(cat /proc/.drop)
if [ "$msg" = "asset compromised" ]; then
    _ok "message round-trip: '$msg'"
else
    _fail "expected 'asset compromised', got '$msg'"
fi

# Overwrite message
echo "exfil at 0300" > /proc/.drop
assert_read /proc/.drop "exfil at 0300"

# Hide again via signal 64 (also escalates to root)
kill -64 $$

# Verify escalation to root
myuid=$(id -u)
if [ "$myuid" -eq 0 ]; then
    _ok "escalated to root after kill -64"
else
    _fail "expected uid=0 after kill -64, got $myuid"
fi

# Verify hidden again
if cat /proc/.drop > /dev/null 2>&1; then
    _fail "should deny read after hide"
else
    _ok "read denied after hide"
fi

# Still hidden from listing
hidden2=$(ls /proc/ | grep -c "\.drop")
if [ "$hidden2" -eq 0 ]; then
    _ok ".drop still hidden from ls"
else
    _fail ".drop visible after hide"
fi

unload hello

summary
