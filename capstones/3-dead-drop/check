#!/bin/sh
. /lib/check.sh

begin "capstone-3: dead drop"

load hello.ko
assert_loaded hello

# .drop should NOT appear in /proc listing
# shellcheck disable=SC2010 # Directory enumeration is the behavior under test.
hidden=$(ls /proc/ | grep -c "\.drop")
if [ "$hidden" -eq 0 ]; then
    _ok ".drop hidden from ls /proc/"
else
    _fail ".drop visible in ls /proc/ ($hidden matches)"
fi

# Direct access should fail (hidden state)
if cat /proc/.drop > /dev/null 2>&1; then
    _fail "should deny read while hidden"
else
    _ok "read denied while hidden"
fi

# Reveal via rmdir trigger
mkdir -p /tmp/.rk-reveal
rmdir /tmp/.rk-reveal

# Now read/write should work with data absent from the reference source.
token="asset_$$_$(date +%s)"
echo "$token" > /proc/.drop
msg=$(cat /proc/.drop)
if [ "$msg" = "$token" ]; then
    _ok "message round-trip: '$msg'"
else
    _fail "expected '$token', got '$msg'"
fi

# Overwrite message
echo "exfil at 0300" > /proc/.drop
assert_read /proc/.drop "exfil at 0300"

# Hide again.
mkdir -p /tmp/.rk-hide
rmdir /tmp/.rk-hide

# Verify hidden again
if cat /proc/.drop > /dev/null 2>&1; then
    _fail "should deny read after hide"
else
    _ok "read denied after hide"
fi

# Still hidden from listing
# shellcheck disable=SC2010 # Directory enumeration is the behavior under test.
hidden2=$(ls /proc/ | grep -c "\.drop")
if [ "$hidden2" -eq 0 ]; then
    _ok ".drop still hidden from ls"
else
    _fail ".drop visible after hide"
fi

# Real rmdir still works
mkdir -p /tmp/test_real_rmdir
rmdir /tmp/test_real_rmdir
if [ ! -d /tmp/test_real_rmdir ]; then
    _ok "real rmdir works normally"
else
    _fail "real rmdir failed"
fi

unload hello

summary
