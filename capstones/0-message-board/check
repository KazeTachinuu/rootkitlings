#!/bin/sh
. /lib/check.sh

begin "capstone-0: message board"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_board

# Default message and first read
assert_read /proc/rk_board "hello world (1 reads)"

# Counter increments
assert_read /proc/rk_board "hello world (2 reads)"

# Change name via sysfs
write_param hello name phantom
assert_read /proc/rk_board "hello phantom (3 reads)"

# Change name again
write_param hello name specter
assert_read /proc/rk_board "hello specter (4 reads)"

unload hello
assert_absent /proc/rk_board
assert_absent /sys/module/hello

summary
