#!/bin/sh
. /lib/check.sh

begin "capstone-1: beacon"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_beacon

# Default interval is 5
assert_contains /proc/rk_beacon "interval: 5"

# Status is running
assert_contains /proc/rk_beacon "status: running"

# Wait for at least 2 ticks at default interval
sleep 12
ticks=$(cat /proc/rk_beacon | sed -n 's/^ticks: *\([0-9]*\)$/\1/p')
if [ "$ticks" -ge 2 ] 2>/dev/null; then
    _ok "ticks incremented ($ticks >= 2)"
else
    _fail "expected >= 2 ticks after 12s, got '$ticks'"
fi

# Change interval via sysfs
write_param hello interval 2
assert_contains /proc/rk_beacon "interval: 2"

# Wait and verify faster tick rate
before=$(cat /proc/rk_beacon | sed -n 's/^ticks: *\([0-9]*\)$/\1/p')
sleep 5
after=$(cat /proc/rk_beacon | sed -n 's/^ticks: *\([0-9]*\)$/\1/p')
diff=$(( after - before ))
if [ "$diff" -ge 2 ] 2>/dev/null; then
    _ok "faster tick rate after interval change ($diff ticks in 5s)"
else
    _fail "expected >= 2 ticks in 5s at interval=2, got $diff"
fi

# Uptime should be non-zero
assert_contains /proc/rk_beacon "uptime:"

unload hello
assert_absent /proc/rk_beacon

summary
