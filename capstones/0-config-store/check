#!/bin/sh
. /lib/check.sh

begin "capstone-0: config store"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_cfg

# Store empty on start
empty=$(cat /proc/rk_cfg)
if [ -z "$empty" ]; then
    _ok "store empty on start"
else
    _fail "store should be empty, got '$empty'"
fi

token="cfg_$$_$(date +%s)"

# Set a dynamic value that cannot come from a fixed fixture.
echo "set:target=$token" > /proc/rk_cfg
assert_contains /proc/rk_cfg "target=$token"

# Set another key
echo "set:interval=60" > /proc/rk_cfg
assert_contains /proc/rk_cfg "interval=60"

# Both coexist
assert_contains /proc/rk_cfg "target=$token"

# Replacement must update the existing key rather than add a duplicate.
echo "set:target=${token}_new" > /proc/rk_cfg
matches=$(grep -c '^target=' /proc/rk_cfg)
if [ "$matches" -eq 1 ] && grep -q "^target=${token}_new$" /proc/rk_cfg; then
    _ok "set replaced one existing key"
else
    _fail "replacement produced $matches target entries"
fi

# Set a third key
echo "set:port=4444" > /proc/rk_cfg
output=$(cat /proc/rk_cfg)
count=$(printf '%s\n' "$output" | wc -l)
if [ "$count" -ge 3 ]; then
    _ok "multiple entries coexist ($count lines)"
else
    _fail "expected >= 3 entries, got $count"
fi

# Delete a key
echo "del:target" > /proc/rk_cfg
output=$(cat /proc/rk_cfg)
case "$output" in
    *target=*)
        _fail "target still present after del"
        ;;
    *)
        _ok "target removed by del"
        ;;
esac

# Exec a dynamic command and require its exact result.
echo "exec:printf $token" > /proc/rk_cfg
assert_contains /proc/rk_cfg "_result=$token"

# Exec: uname -r
echo "exec:uname -r" > /proc/rk_cfg
assert_contains /proc/rk_cfg "$(uname -r)"
assert_absent /tmp/.rk_out

unload hello
assert_absent /proc/rk_cfg
assert_absent /tmp/.rk_out

summary
