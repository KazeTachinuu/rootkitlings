#!/usr/bin/env python3
"""Boot a target VM, reading server state from server.json."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE
sys.path.insert(0, str(HERE.parent))
sys.path.insert(0, str(HERE / "server"))
os.chdir(HERE)

from control_console import OperatorError
from server import read_server_state

VM_BOOT = HERE.parent / "vm" / "boot"
RUNTIME = HERE.parent / "vm" / "runtime" / "complete-rootkit"
MODULE = HERE / "rootkit" / "rklings.ko"

label = sys.argv[1] if len(sys.argv) > 1 else "C00"

if not MODULE.is_file():
    sys.exit("[x] Build the rootkit first: make rootkit")

if not VM_BOOT.is_file():
    sys.exit(f"[x] vm/boot not found at {VM_BOOT}")

try:
    state = read_server_state(ROOT)
except OperatorError as error:
    sys.exit(f"[x] {error}")

key_hex = state["key_hex"]
key_file = ROOT / ".state" / "control.key"
key_file.parent.mkdir(parents=True, exist_ok=True)
key_file.write_text(key_hex)
os.chmod(key_file, 0o600)

command = [
    str(VM_BOOT),
    "--runtime-setup", str(RUNTIME),
    "--control-key-file", str(key_file),
    "--control-port", str(state["control_port"]),
    "--shell-port", str(state["shell_port"]),
    str(MODULE),
]
os.execvp(command[0], command)
