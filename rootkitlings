#!/usr/bin/bash
set -Eeuo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROGRESS="$ROOT_DIR/.progress"

# -- marker output --

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
    B='\033[1;34m' G='\033[1;32m' Y='\033[1;33m' R='\033[31m' D='\033[2m' N='\033[0m'
else
    B= G= Y= R= D= N=
fi
hdr()  { printf "${B}[*]${N} %s\n" "$1"; }
ok()   { printf "${G}[+]${N} %s\n" "$1"; }
warn() { printf "${Y}[-]${N} %s\n" "$1" >&2; }
die()  { printf "${R}[x]${N} %s\n" "$1" >&2; exit 1; }

# -- helpers --

is_capstone()
{
    [[ $1 == capstone-* ]]
}

resolve_ling()
{
    local n
    [[ $1 =~ ^[0-9]+$ ]] || die "Invalid ling number: '$1'"
    n=$(printf '%02d' "$1")
    local match
    match=$(find "$ROOT_DIR/lings" -mindepth 2 -maxdepth 2 -type d -name "${n}-*" | head -1)
    [[ -n $match ]] || die "Ling $n not found"
    # Return category/ling relative path
    local cat_dir ling_dir
    cat_dir=$(basename "$(dirname "$match")")
    ling_dir=$(basename "$match")
    printf '%s/%s' "$cat_dir" "$ling_dir"
}

resolve_capstone()
{
    local id="${1#capstone-}"
    local match
    match=$(find "$ROOT_DIR/capstones" -mindepth 1 -maxdepth 1 -type d -name "${id}-*" | head -1)
    [[ -n $match ]] || die "Capstone $id not found"
    basename "$match"
}

ling_name()
{
    # Extract just the ling directory name from category/ling path
    basename "$1"
}

show_source()
{
    if command -v bat &>/dev/null; then
        bat --style=plain --paging=never "$1"
    elif command -v batcat &>/dev/null; then
        batcat --style=plain --paging=never "$1"
    else
        cat "$1"
    fi
}

max_ling()
{
    list_lings | tail -1 | xargs basename | cut -d- -f1 | sed 's/^0//'
}

current_ling()
{
    local n=0
    if [[ -f $PROGRESS ]]; then
        n=$(cat "$PROGRESS")
    fi
    local max
    max=$(max_ling)
    if (( n > max )); then
        n=$max
    fi
    printf '%s' "$n"
}

list_lings()
{
    find "$ROOT_DIR/lings" -mindepth 2 -maxdepth 2 -type d -name '[0-9][0-9]-*' | sort
}

# -- commands --

cmd_check()
{
    local num=${1:-$(current_ling)}

    if is_capstone "$num"; then
        cmd_check_capstone "$num"
        return
    fi

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")

    local check="$ROOT_DIR/lings/$ling/check"
    [[ -f $check ]] || die "No check script for $name"

    hdr "Checking $name"
    make -C "$ROOT_DIR" --quiet

    local output
    output=$("$ROOT_DIR/vm/boot" --check "$check" "$ROOT_DIR/module/hello.ko" 2>&1) || true
    printf '%s\n' "$output"

    case "$output" in
        *"[+] PASSED"*)
            ok "$name passed"
            local cur next
            cur=$(current_ling)
            next=$(( 10#${name%%-*} + 1 ))
            if (( next > cur )); then
                printf '%s' "$next" > "$PROGRESS"
                printf "\n"
                local next_ling
                next_ling=$(resolve_ling "$next" 2>/dev/null) || true
                if [[ -n $next_ling ]]; then
                    hdr "Next: $(ling_name "$next_ling")"
                    printf "  rootkitlings readme %s\n" "$next"
                fi
            fi
            ;;
        *)
            printf "\n"
            warn "Read the contract:  rootkitlings readme $num"
            warn "Get a nudge:        rootkitlings hint $num"
            warn "See the solution:   rootkitlings peek $num"
            die "$name failed"
            ;;
    esac
}

cmd_check_capstone()
{
    local cap_name
    cap_name=$(resolve_capstone "$1")

    local check="$ROOT_DIR/capstones/$cap_name/check"
    [[ -f $check ]] || die "No check script for capstone $cap_name"

    hdr "Checking capstone: $cap_name"
    make -C "$ROOT_DIR" --quiet

    local output
    output=$("$ROOT_DIR/vm/boot" --check "$check" "$ROOT_DIR/module/hello.ko" 2>&1) || true
    printf '%s\n' "$output"

    case "$output" in
        *"[+] PASSED"*) ;;
        *) die "capstone $cap_name failed" ;;
    esac

    ok "capstone $cap_name passed"
}

cmd_peek()
{
    local num=${1:-$(current_ling)}

    if is_capstone "$num"; then
        local cap_name
        cap_name=$(resolve_capstone "$num")
        local sol_dir="$ROOT_DIR/.solutions/capstone-${cap_name}"
        if [[ -d $sol_dir ]]; then
            hdr "Reference solution: capstone $cap_name (multi-file)"
            for f in "$sol_dir"/*.h "$sol_dir"/*.c "$sol_dir"/Kbuild; do
                [[ -f $f ]] || continue
                printf "\n${D}--- %s ---${N}\n" "$(basename "$f")"
                show_source "$f"
            done
            return
        fi
        local sol="$ROOT_DIR/.solutions/capstone-${cap_name}.c"
        [[ -f $sol ]] || die "No reference for capstone $cap_name"
        hdr "Reference solution: capstone $cap_name"
        show_source "$sol"
        return
    fi

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")

    local sol="$ROOT_DIR/.solutions/$name.c"
    [[ -f $sol ]] || die "No reference for $name"

    hdr "Reference solution: $name"
    show_source "$sol"
}

cmd_reset()
{
    local num=${1:-$(current_ling)}

    if is_capstone "$num"; then
        local cap_name
        cap_name=$(resolve_capstone "$num")
        local sol="$ROOT_DIR/.solutions/capstone-${cap_name}.c"
        [[ -f $sol ]] || die "No reference for capstone $cap_name"
        cp "$sol" "$ROOT_DIR/module/hello.c"
        ok "Restored hello.c to capstone $cap_name reference"
        return
    fi

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")

    local sol="$ROOT_DIR/.solutions/$name.c"
    [[ -f $sol ]] || die "No reference for $name"

    cp "$sol" "$ROOT_DIR/module/hello.c"
    ok "Restored hello.c to $name reference"
}

cmd_run()
{
    make -C "$ROOT_DIR" --quiet
    "$ROOT_DIR/vm/boot" "$ROOT_DIR/module/hello.ko"
}

cmd_readme()
{
    local num=${1:-$(current_ling)}

    if is_capstone "$num"; then
        local cap_name
        cap_name=$(resolve_capstone "$num")
        local readme="$ROOT_DIR/capstones/$cap_name/README.md"
        [[ -f $readme ]] || die "No README for capstone $cap_name"
        cat "$readme"
        return
    fi

    local ling
    ling=$(resolve_ling "$num")
    local readme="$ROOT_DIR/lings/$ling/README.md"
    [[ -f $readme ]] || die "No README for $(ling_name "$ling")"
    cat "$readme"
}

cmd_hint()
{
    local num=${1:-$(current_ling)}

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")
    local hint="$ROOT_DIR/lings/$ling/hint"

    if [[ ! -f $hint ]]; then
        warn "No hint for this ling. Read the README: rootkitlings readme $num"
        return
    fi

    hdr "Hint: $name"
    cat "$hint"
}

cmd_status()
{
    local cur
    cur=$(current_ling)
    local total
    total=$(list_lings | wc -l)
    local ling name
    ling=$(resolve_ling "$cur")
    name=$(ling_name "$ling")

    printf "Progress: %s/%s lings completed\n" "$cur" "$total"
    printf "Current:  %s\n" "$name"
    printf "\n"
    printf "  check     Build and verify current ling\n"
    printf "  readme    Show the README for current ling\n"
    printf "  hint      Get a nudge without seeing the solution\n"
    printf "  peek      Compare your code against the reference\n"
    printf "  run       Boot an interactive VM with your module\n"
}

cmd_list()
{
    local cur
    cur=$(current_ling)
    local prev_cat=""

    while IFS= read -r path; do
        local cat_dir ling_dir num
        cat_dir=$(basename "$(dirname "$path")")
        ling_dir=$(basename "$path")
        num=$(( 10#${ling_dir%%-*} ))

        if [[ $cat_dir != "$prev_cat" ]]; then
            [[ -n $prev_cat ]] && printf '\n'
            printf "${B}%s${N}\n" "$cat_dir"
            prev_cat=$cat_dir
        fi

        local check="$path/check"
        if (( num < cur )); then
            printf "  ${G}[+]${N} %s\n" "$ling_dir"
        elif [[ -f $check ]]; then
            printf "  ${Y}[ ]${N} %s\n" "$ling_dir"
        else
            printf "  ${D}[ ] %s${N}\n" "$ling_dir"
        fi
    done < <(list_lings)
}

# -- dispatch --

usage()
{
    cat <<'EOF'
Usage: rootkitlings <command> [ling]

Commands:
  check  [N]  Build and verify ling N (default: current)
  readme [N]  Show the README for ling N
  hint   [N]  Get a nudge without seeing the solution
  peek   [N]  Show the reference solution for ling N
  reset  [N]  Restore hello.c to ling N reference
  run         Build and boot interactive VM
  list        Show all lings and progress
  status      Show current progress and next steps

Ling numbers: both 3 and 03 work.
Capstones:    rootkitlings check capstone-0

Workflow:
  1. rootkitlings readme     Read the exercise
  2. Edit module/hello.c     Write your solution
  3. rootkitlings check      Test it in a VM
  4. rootkitlings hint       Get a nudge (if stuck)
  5. rootkitlings peek       See the reference solution (last resort)
EOF
}

if (( $# == 0 )); then
    usage
    exit 0
fi

case $1 in
    list)   cmd_list         ;;
    check)  shift; cmd_check  "$@" ;;
    hint)   shift; cmd_hint   "$@" ;;
    peek)   shift; cmd_peek   "$@" ;;
    reset)  shift; cmd_reset  "$@" ;;
    readme) shift; cmd_readme "$@" ;;
    status) cmd_status       ;;
    run)    shift; cmd_run        ;;
    -h|--help) usage              ;;
    *) die "Unknown command: $1. Run 'rootkitlings --help' for usage." ;;
esac
