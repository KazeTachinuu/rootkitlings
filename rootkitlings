#!/usr/bin/bash
set -Eeuo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROGRESS="$ROOT_DIR/.progress"

# -- color support --

use_color()
{
    [ -t "$1" ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]
}

# stderr colors (for hdr/ok/warn/die)
if use_color 2; then
    B='\033[1;34m' G='\033[1;32m' Y='\033[1;33m' R='\033[1;31m'
    C='\033[1;36m' W='\033[1;37m' D='\033[2m' N='\033[0m'
else
    B= G= Y= R= C= W= D= N=
fi

# -- UI chrome (always stderr) --

hdr()  { printf "${B}[*]${N} %s\n" "$1" >&2; }
ok()   { printf "${G}[+]${N} %s\n" "$1" >&2; }
info() { printf "${D}[.]${N} %s\n" "$1" >&2; }
warn() { printf "${Y}[-]${N} %s\n" "$1" >&2; }
die()  { printf "${R}[x]${N} %s\n" "$1" >&2; exit 1; }

# -- helpers --

is_capstone()
{
    [[ $1 == capstone-* ]]
}

resolve_ling()
{
    local n
    [[ $1 =~ ^[0-9]+$ ]] || die "Invalid ling number: '$1'"
    n=$(printf '%02d' "$((10#$1))")
    local match
    match=$(find "$ROOT_DIR/lings" -mindepth 2 -maxdepth 2 -type d -name "${n}-*" | head -1)
    [[ -n $match ]] || die "Ling $n not found"
    local cat_dir ling_dir
    cat_dir=$(basename "$(dirname "$match")")
    ling_dir=$(basename "$match")
    printf '%s/%s' "$cat_dir" "$ling_dir"
}

resolve_capstone()
{
    local id="${1#capstone-}"
    local match
    match=$(find "$ROOT_DIR/capstones" -mindepth 1 -maxdepth 1 -type d -name "${id}-*" | head -1)
    [[ -n $match ]] || die "Capstone $id not found"
    basename "$match"
}

ling_name()
{
    basename "$1"
}

show_source()
{
    if command -v bat &>/dev/null; then
        bat --style=plain --paging=never "$1"
    elif command -v batcat &>/dev/null; then
        batcat --style=plain --paging=never "$1"
    else
        cat "$1"
    fi
}

show_markdown()
{
    if command -v glow &>/dev/null; then
        glow -w 80 "$1"
    elif command -v bat &>/dev/null; then
        bat --style=plain --paging=never --language=markdown "$1"
    elif command -v batcat &>/dev/null; then
        batcat --style=plain --paging=never --language=markdown "$1"
    else
        cat "$1"
    fi
}

max_ling()
{
    list_lings | tail -1 | xargs basename | cut -d- -f1 | sed 's/^0//'
}

current_ling()
{
    local n=0
    if [[ -f $PROGRESS ]]; then
        n=$(cat "$PROGRESS")
    fi
    local max
    max=$(max_ling)
    if (( n > max )); then
        n=$max
    fi
    printf '%s' "$n"
}

list_lings()
{
    find "$ROOT_DIR/lings" -mindepth 2 -maxdepth 2 -type d -name '[0-9][0-9]-*' | sort
}

# -- commands --

cmd_check()
{
    local num=${1:-$(current_ling)}
    local label check_script

    if is_capstone "$num"; then
        local cap_name
        cap_name=$(resolve_capstone "$num")
        label="capstone $cap_name"
        check_script="$ROOT_DIR/capstones/$cap_name/check"
    else
        local ling
        ling=$(resolve_ling "$num")
        label=$(ling_name "$ling")
        check_script="$ROOT_DIR/lings/$ling/check"
    fi

    [[ -f $check_script ]] || die "No check script for $label"

    hdr "Checking $label"
    make -C "$ROOT_DIR" --quiet

    local output
    output=$("$ROOT_DIR/vm/boot" --check "$check_script" "$ROOT_DIR/module/hello.ko" 2>&1) || true
    printf '%s\n' "$output"

    case "$output" in
        *"[+] PASSED"*)
            ok "$label passed"
            if ! is_capstone "$num"; then
                local cur next
                cur=$(current_ling)
                next=$(( 10#${label%%-*} + 1 ))
                if (( next > cur )); then
                    printf '%s' "$next" > "$PROGRESS"
                    local next_ling
                    next_ling=$(resolve_ling "$next" 2>/dev/null) || true
                    if [[ -n $next_ling ]]; then
                        printf '\n' >&2
                        hdr "Next: $(ling_name "$next_ling")"
                        info "rootkitlings readme $next"
                    fi
                fi
            fi
            ;;
        *)
            printf '\n' >&2
            info "rootkitlings readme $num    Read the contract"
            info "rootkitlings hint $num      Get a nudge"
            info "rootkitlings peek $num      See the solution"
            die "$label failed"
            ;;
    esac
}

cmd_peek()
{
    local num=${1:-$(current_ling)}

    if is_capstone "$num"; then
        local cap_name
        cap_name=$(resolve_capstone "$num")
        local sol_dir="$ROOT_DIR/.solutions/capstone-${cap_name}"
        if [[ -d $sol_dir ]]; then
            hdr "Reference: capstone $cap_name (multi-file)"
            for f in "$sol_dir"/*.h "$sol_dir"/*.c "$sol_dir"/Kbuild; do
                [[ -f $f ]] || continue
                printf "\n${D}--- %s ---${N}\n" "$(basename "$f")" >&2
                show_source "$f"
            done
            return
        fi
        local sol="$ROOT_DIR/.solutions/capstone-${cap_name}.c"
        [[ -f $sol ]] || die "No reference for capstone $cap_name"
        hdr "Reference: capstone $cap_name"
        show_source "$sol"
        return
    fi

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")
    local sol="$ROOT_DIR/.solutions/$name.c"
    [[ -f $sol ]] || die "No reference for $name"

    hdr "Reference: $name"
    show_source "$sol"
}

cmd_reset()
{
    local num=${1:-$(current_ling)}

    if is_capstone "$num"; then
        local cap_name
        cap_name=$(resolve_capstone "$num")
        local sol="$ROOT_DIR/.solutions/capstone-${cap_name}.c"
        [[ -f $sol ]] || die "No reference for capstone $cap_name"
        cp "$sol" "$ROOT_DIR/module/hello.c"
        ok "Restored hello.c to capstone $cap_name reference"
        return
    fi

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")
    local sol="$ROOT_DIR/.solutions/$name.c"
    [[ -f $sol ]] || die "No reference for $name"

    cp "$sol" "$ROOT_DIR/module/hello.c"
    ok "Restored hello.c to $name reference"
}

cmd_run()
{
    make -C "$ROOT_DIR" --quiet
    "$ROOT_DIR/vm/boot" "$ROOT_DIR/module/hello.ko"
}

cmd_readme()
{
    local num=${1:-$(current_ling)}

    if is_capstone "$num"; then
        local cap_name
        cap_name=$(resolve_capstone "$num")
        local readme="$ROOT_DIR/capstones/$cap_name/README.md"
        [[ -f $readme ]] || die "No README for capstone $cap_name"
        hdr "capstone $cap_name"
        show_markdown "$readme"
        return
    fi

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")
    local readme="$ROOT_DIR/lings/$ling/README.md"
    [[ -f $readme ]] || die "No README for $name"

    hdr "$name"
    show_markdown "$readme"
}

cmd_hint()
{
    local num=${1:-$(current_ling)}

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")
    local hint="$ROOT_DIR/lings/$ling/hint"

    if [[ ! -f $hint ]]; then
        warn "No hint for $name"
        info "rootkitlings readme $num"
        return
    fi

    printf "${C}[*]${N} ${C}Hint: %s${N}\n" "$name" >&2
    cat "$hint"
}

cmd_template()
{
    local num=${1:-$(current_ling)}

    local ling
    ling=$(resolve_ling "$num")
    local name
    name=$(ling_name "$ling")
    local tmpl="$ROOT_DIR/lings/$ling/template.c"

    if [[ ! -f $tmpl ]]; then
        warn "No template for $name. It builds on the previous one, keep your code."
        return
    fi

    cat "$tmpl"
    printf '\n' >&2
    hdr "Template: $name"
    info "rootkitlings template $num > module/hello.c"
}

cmd_status()
{
    local cur
    cur=$(current_ling)
    local total
    total=$(list_lings | wc -l)
    local ling name
    ling=$(resolve_ling "$cur")
    name=$(ling_name "$ling")

    local pct=$(( cur * 100 / total ))
    local bar_len=30
    local filled=$(( pct * bar_len / 100 ))
    local empty=$(( bar_len - filled ))

    # stdout colors
    local b g y c d w n
    if use_color 1; then
        b='\033[1;34m' g='\033[1;32m' y='\033[1;33m'
        c='\033[1;36m' d='\033[2m' w='\033[1;37m' n='\033[0m'
    else
        b= g= y= c= d= w= n=
    fi

    printf "\n"
    printf "${w}  rootkitlings${n}\n"
    printf "\n"
    printf "  ${g}%s${n}/${d}%s${n} lings  " "$cur" "$total"
    printf "${g}%s${d}%s${n} %d%%\n" \
        "$(printf '%*s' "$filled" '' | tr ' ' '#')" \
        "$(printf '%*s' "$empty" '' | tr ' ' '.')" \
        "$pct"
    printf "\n"
    printf "  ${c}Current${n}  %s\n" "$name"
    printf "\n"
    printf "  ${w}check${n}      Build and verify       ${d}rootkitlings check${n}\n"
    printf "  ${w}readme${n}     Read the exercise       ${d}rootkitlings readme${n}\n"
    printf "  ${w}template${n}   Scaffold to stdout      ${d}rootkitlings template > module/hello.c${n}\n"
    printf "  ${w}hint${n}       Nudge (not the answer)  ${d}rootkitlings hint${n}\n"
    printf "  ${w}peek${n}       Reference solution      ${d}rootkitlings peek${n}\n"
    printf "  ${w}run${n}        Interactive VM           ${d}rootkitlings run${n}\n"
    printf "\n"
}

cmd_list()
{
    local cur
    cur=$(current_ling)
    local prev_cat=""
    local b g y d n
    if use_color 1; then
        b='\033[1;34m' g='\033[1;32m' y='\033[1;33m' d='\033[2m' n='\033[0m'
    else
        b= g= y= d= n=
    fi

    while IFS= read -r path; do
        local cat_dir ling_dir num
        cat_dir=$(basename "$(dirname "$path")")
        ling_dir=$(basename "$path")
        num=$(( 10#${ling_dir%%-*} ))

        if [[ $cat_dir != "$prev_cat" ]]; then
            [[ -n $prev_cat ]] && printf '\n'
            printf "\n  ${b}%s${n}\n" "$cat_dir"
            prev_cat=$cat_dir
        fi

        local check="$path/check"
        if (( num < cur )); then
            printf "    ${g}+${n} %s\n" "$ling_dir"
        elif (( num == cur )); then
            printf "    ${y}>${n} %s  ${y}<< you are here${n}\n" "$ling_dir"
        elif [[ -f $check ]]; then
            printf "    ${d}.${n} %s\n" "$ling_dir"
        else
            printf "    ${d}. %s${n}\n" "$ling_dir"
        fi
    done < <(list_lings)
    printf '\n'
}

# -- dispatch --

usage()
{
    local b g y c d w n
    if use_color 1; then
        b='\033[1;34m' g='\033[1;32m' y='\033[1;33m'
        c='\033[1;36m' d='\033[2m' w='\033[1;37m' n='\033[0m'
    else
        b= g= y= c= d= w= n=
    fi

    printf "\n"
    printf "  ${w}rootkitlings${n} ${d}<command> [ling]${n}\n"
    printf "\n"
    printf "  ${w}check${n}    ${d}[N]${n}  Build and verify ling N\n"
    printf "  ${w}readme${n}   ${d}[N]${n}  Show the README for ling N\n"
    printf "  ${w}template${n} ${d}[N]${n}  Print boilerplate scaffold to stdout\n"
    printf "  ${w}hint${n}     ${d}[N]${n}  Get a nudge without seeing the solution\n"
    printf "  ${w}peek${n}     ${d}[N]${n}  Show the reference solution\n"
    printf "  ${w}reset${n}    ${d}[N]${n}  Restore hello.c to ling N reference\n"
    printf "  ${w}run${n}           Build and boot interactive VM\n"
    printf "  ${w}list${n}          Show all lings and progress\n"
    printf "  ${w}status${n}        Show current progress\n"
    printf "\n"
    printf "  ${d}Ling numbers: both 3 and 03 work.${n}\n"
    printf "  ${d}Capstones:    rootkitlings check capstone-0${n}\n"
    printf "\n"
    printf "  ${c}Workflow${n}\n"
    printf "    ${w}1.${n} rootkitlings readme              ${d}Read the exercise${n}\n"
    printf "    ${w}2.${n} rootkitlings template > hello.c  ${d}Load scaffold${n}\n"
    printf "    ${w}3.${n} \$EDITOR module/hello.c           ${d}Write your solution${n}\n"
    printf "    ${w}4.${n} rootkitlings check               ${d}Test it in a VM${n}\n"
    printf "    ${w}5.${n} rootkitlings hint                ${d}Nudge if stuck${n}\n"
    printf "    ${w}6.${n} rootkitlings peek                ${d}Reference (last resort)${n}\n"
    printf "\n"
}

if (( $# == 0 )); then
    usage
    exit 0
fi

case $1 in
    list)      cmd_list              ;;
    check)     shift; cmd_check     "$@" ;;
    template)  shift; cmd_template  "$@" ;;
    hint)      shift; cmd_hint      "$@" ;;
    peek)      shift; cmd_peek      "$@" ;;
    reset)     shift; cmd_reset     "$@" ;;
    readme)    shift; cmd_readme    "$@" ;;
    status)    cmd_status                ;;
    run)       shift; cmd_run            ;;
    -h|--help) usage                     ;;
    *) die "Unknown command: $1. Run 'rootkitlings --help' for usage." ;;
esac
