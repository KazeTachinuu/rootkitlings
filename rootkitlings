#!/usr/bin/bash
set -Eeuo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROGRESS="$ROOT_DIR/.progress"
ORDER="$ROOT_DIR/.order"

# -- colors --

_use_color() { [ -t "$1" ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; }

if _use_color 2; then
    B='\033[1;34m' G='\033[1;32m' Y='\033[1;33m' R='\033[1;31m'
    C='\033[1;36m' W='\033[1;37m' D='\033[2m' N='\033[0m'
else
    B= G= Y= R= C= W= D= N=
fi

if _use_color 1; then
    OB='\033[1;34m' OG='\033[1;32m' OY='\033[1;33m'
    OC='\033[1;36m' OW='\033[1;37m' OD='\033[2m' ON='\033[0m'
else
    OB= OG= OY= OC= OW= OD= ON=
fi

hdr()  { printf "${B}[*]${N} %s\n" "$1" >&2; }
ok()   { printf "${G}[+]${N} %s\n" "$1" >&2; }
info() { printf "${D}[.]${N} %s\n" "$1" >&2; }
warn() { printf "${Y}[-]${N} %s\n" "$1" >&2; }
die()  { printf "${R}[x]${N} %s\n" "$1" >&2; exit 1; }

# -- .order lookups --

order_entries() { grep -v '^#' "$ORDER" | grep -v '^$'; }
order_count()   { order_entries | wc -l; }
entry_at()      { order_entries | sed -n "$(($1 + 1))p"; }

index_of()
{
    local target=$1 i=0
    while IFS= read -r e; do
        [[ $e == "$target" ]] && printf '%s' "$i" && return
        i=$((i + 1))
    done < <(order_entries)
    return 1
}

# -- entry helpers --

entry_name()  { basename "$1"; }
is_capstone() { [[ $1 == capstones/* ]]; }

build_dir()
{
    local entry=${1:-$(current_entry)}
    if is_capstone "$entry"; then
        printf '%s' "$ROOT_DIR/$entry"
    else
        printf '%s' "$ROOT_DIR/module"
    fi
}

sol_path()
{
    local name
    name=$(entry_name "$1")
    local dir="$ROOT_DIR/.solutions/$name"
    [[ -d $dir ]] && printf '%s' "$dir" && return
    local file="$ROOT_DIR/.solutions/$name.c"
    [[ -f $file ]] && printf '%s' "$file" && return
    return 1
}

# -- progress --

current_pos()
{
    local p=0
    [[ -f $PROGRESS ]] && p=$(cat "$PROGRESS")
    local max
    max=$(( $(order_count) - 1 ))
    (( p > max )) && p=$max
    printf '%s' "$p"
}

current_entry() { entry_at "$(current_pos)"; }

# -- argument resolution --

resolve_arg()
{
    local arg=$1 match
    if [[ $arg == capstone-* ]]; then
        local id=${arg#capstone-}
        match=$(order_entries | grep "^capstones/${id}-" | head -1) || true
        [[ -n $match ]] || die "Unknown: $arg"
    elif [[ $arg =~ ^[0-9]+$ ]]; then
        local n
        n=$(printf '%02d' "$((10#$arg))")
        match=$(order_entries | grep "/${n}-" | head -1) || true
        [[ -n $match ]] || die "Ling $arg not found"
    else
        die "Invalid argument: '$arg'"
    fi
    printf '%s' "$match"
}

resolve_entry()
{
    if [[ -n ${1:-} ]]; then
        resolve_arg "$1"
    else
        current_entry
    fi
}

# -- display --

show_source()
{
    if command -v bat &>/dev/null; then
        bat --style=plain --paging=never "$1"
    elif command -v batcat &>/dev/null; then
        batcat --style=plain --paging=never "$1"
    else
        cat "$1"
    fi
}

show_markdown()
{
    if command -v glow &>/dev/null; then
        glow -w 80 "$1"
    elif command -v bat &>/dev/null; then
        bat --style=plain --paging=never --language=markdown "$1"
    elif command -v batcat &>/dev/null; then
        batcat --style=plain --paging=never --language=markdown "$1"
    else
        cat "$1"
    fi
}

# -- commands --

cmd_check()
{
    local entry
    entry=$(resolve_entry "${1:-}")
    local name
    name=$(entry_name "$entry")
    local check_script="$ROOT_DIR/$entry/check"
    local bdir
    bdir=$(build_dir "$entry")

    [[ -f $check_script ]] || die "No check script for $name"

    hdr "Checking $name"
    make -C "$ROOT_DIR" MODULE_DIR="$bdir" --quiet

    local output
    output=$("$ROOT_DIR/vm/boot" --check "$check_script" "$bdir/hello.ko" 2>&1) || true
    printf '%s\n' "$output"

    case "$output" in
        *"[+] PASSED"*)
            ok "$name passed"
            local idx
            idx=$(index_of "$entry") || return
            local next=$(( idx + 1 ))
            if (( next >= $(order_count) )); then
                printf '\n' >&2
                ok "All done."
                return
            fi
            if (( next > $(current_pos) )); then
                printf '%s' "$next" > "$PROGRESS"
            fi
            local next_entry
            next_entry=$(entry_at "$next")
            local next_name
            next_name=$(entry_name "$next_entry")
            printf '\n' >&2
            if is_capstone "$next_entry"; then
                hdr "Capstone time: $next_name"
                info "Edit: $next_entry/hello.c"
                info "rootkitlings readme capstone-${next_name%%-*}"
            else
                hdr "Next: $next_name"
                info "rootkitlings readme $((10#${next_name%%-*}))"
            fi
            ;;
        *)
            printf '\n' >&2
            local num=${name%%-*}
            if is_capstone "$entry"; then
                info "rootkitlings readme capstone-$num    Read the spec"
                info "rootkitlings peek capstone-$num      See the reference"
            else
                info "rootkitlings readme $((10#$num))    Read the contract"
                info "rootkitlings hint $((10#$num))      Get a nudge"
                info "rootkitlings peek $((10#$num))      See the solution"
            fi
            die "$name failed"
            ;;
    esac
}

cmd_readme()
{
    local entry
    entry=$(resolve_entry "${1:-}")
    local name
    name=$(entry_name "$entry")
    local readme="$ROOT_DIR/$entry/README.md"
    [[ -f $readme ]] || die "No README for $name"
    hdr "$name"
    show_markdown "$readme"
}

cmd_hint()
{
    local entry
    entry=$(resolve_entry "${1:-}")
    local name
    name=$(entry_name "$entry")
    local hint="$ROOT_DIR/$entry/hint"

    if [[ ! -f $hint ]]; then
        if is_capstone "$entry"; then
            hdr "Hint: $name"
            info "Re-read the README. The contract tells you exactly what to build."
            info "rootkitlings readme capstone-${name%%-*}"
        else
            warn "No hint for $name"
            info "rootkitlings readme $((10#${name%%-*}))"
        fi
        return
    fi

    printf "${C}[*]${N} ${C}Hint: %s${N}\n" "$name" >&2
    cat "$hint"
}

cmd_peek()
{
    local entry
    entry=$(resolve_entry "${1:-}")
    local name
    name=$(entry_name "$entry")
    local sol
    sol=$(sol_path "$entry") || die "No reference for $name"

    if [[ -d $sol ]]; then
        hdr "Reference: $name (multi-file)"
        for f in "$sol"/*.h "$sol"/*.c "$sol"/Kbuild; do
            [[ -f $f ]] || continue
            printf "\n${D}--- %s ---${N}\n" "$(basename "$f")" >&2
            show_source "$f"
        done
    else
        hdr "Reference: $name"
        show_source "$sol"
    fi
}

cmd_reset()
{
    local entry
    entry=$(resolve_entry "${1:-}")
    local name
    name=$(entry_name "$entry")
    local bdir
    bdir=$(build_dir "$entry")
    local sol
    sol=$(sol_path "$entry") || die "No reference for $name"

    if [[ -d $sol ]]; then
        rm -f "$bdir"/*.h "$bdir"/calc.c "$bdir"/main.c
        for f in "$sol"/*; do
            [[ -f $f ]] || continue
            cp "$f" "$bdir/$(basename "$f")"
        done
        ok "Restored $name reference (multi-file)"
    else
        cp "$sol" "$bdir/hello.c"
        if ! is_capstone "$entry"; then
            rm -f "$bdir"/*.h "$bdir"/calc.c "$bdir"/main.c
            cat > "$bdir/Kbuild" << 'KBUILD'
obj-m += hello.o
KBUILD
        fi
        ok "Restored $name reference"
    fi
}

cmd_run()
{
    local bdir
    bdir=$(build_dir)
    make -C "$ROOT_DIR" MODULE_DIR="$bdir" --quiet
    "$ROOT_DIR/vm/boot" "$bdir/hello.ko"
}

cmd_gdb()
{
    local bdir
    bdir=$(build_dir)
    make -C "$ROOT_DIR" MODULE_DIR="$bdir" --quiet
    "$ROOT_DIR/vm/boot" --gdb "$bdir/hello.ko"
}

cmd_status()
{
    local pos
    pos=$(current_pos)
    local entry
    entry=$(current_entry)
    local name
    name=$(entry_name "$entry")
    local total
    total=$(order_count)
    local pct=$(( pos * 100 / total ))
    local bar_len=30
    local filled=$(( pct * bar_len / 100 ))
    local empty=$(( bar_len - filled ))

    printf "\n"
    printf "${OW}  rootkitlings${ON}\n"
    printf "\n"
    printf "  ${OG}%s${ON}/${OD}%s${ON}  " "$pos" "$total"
    printf "${OG}%s${OD}%s${ON} %d%%\n" \
        "$(printf '%*s' "$filled" '' | tr ' ' '#')" \
        "$(printf '%*s' "$empty" '' | tr ' ' '.')" \
        "$pct"
    printf "\n"
    printf "  ${OC}Current${ON}  %s\n" "$name"
    if is_capstone "$entry"; then
        printf "  ${OC}Edit${ON}     %s/hello.c\n" "$entry"
        printf "           ${OD}Complete the capstone to continue${ON}\n"
    fi
    printf "\n"
    printf "  ${OW}check${ON}      Build and verify       ${OD}rootkitlings check${ON}\n"
    printf "  ${OW}readme${ON}     Read the exercise       ${OD}rootkitlings readme${ON}\n"
    printf "  ${OW}hint${ON}       Nudge (not the answer)  ${OD}rootkitlings hint${ON}\n"
    printf "  ${OW}peek${ON}       Reference solution      ${OD}rootkitlings peek${ON}\n"
    printf "  ${OW}run${ON}        Interactive VM           ${OD}rootkitlings run${ON}\n"
    printf "\n"
}

cmd_list()
{
    local pos
    pos=$(current_pos)
    local i=0 prev_cat=""

    while IFS= read -r entry; do
        local name
        name=$(entry_name "$entry")

        if is_capstone "$entry"; then
            if (( i < pos )); then
                printf "    ${OG}*${ON} %s\n" "$name"
            elif (( i == pos )); then
                printf "    ${OY}*${ON} %s  ${OY}<< capstone${ON}\n" "$name"
            else
                printf "    ${OD}*${ON} %s\n" "$name"
            fi
        else
            local cat_dir=${entry#lings/}
            cat_dir=${cat_dir%%/*}
            if [[ $cat_dir != "$prev_cat" ]]; then
                [[ -n $prev_cat ]] && printf '\n'
                printf "\n  ${OB}%s${ON}\n" "$cat_dir"
                prev_cat=$cat_dir
            fi
            if (( i < pos )); then
                printf "    ${OG}+${ON} %s\n" "$name"
            elif (( i == pos )); then
                printf "    ${OY}>${ON} %s  ${OY}<< you are here${ON}\n" "$name"
            else
                printf "    ${OD}.${ON} %s\n" "$name"
            fi
        fi
        i=$(( i + 1 ))
    done < <(order_entries)
    printf '\n'
}

# -- dispatch --

usage()
{
    printf "\n"
    printf "  ${OW}rootkitlings${ON} ${OD}<command> [ling]${ON}\n"
    printf "\n"
    printf "  ${OW}check${ON}    ${OD}[N]${ON}  Build and verify ling N (or current)\n"
    printf "  ${OW}readme${ON}   ${OD}[N]${ON}  Show the README for ling N\n"
    printf "  ${OW}hint${ON}     ${OD}[N]${ON}  Get a nudge without seeing the solution\n"
    printf "  ${OW}peek${ON}     ${OD}[N]${ON}  Show the reference solution\n"
    printf "  ${OW}reset${ON}    ${OD}[N]${ON}  Restore hello.c to ling N reference\n"
    printf "  ${OW}run${ON}           Build and boot interactive VM\n"
    printf "  ${OW}gdb${ON}           Boot VM paused, waiting for GDB on :1234\n"
    printf "  ${OW}list${ON}          Show all lings and progress\n"
    printf "  ${OW}status${ON}        Show current progress\n"
    printf "\n"
    printf "  ${OD}Ling numbers: both 3 and 03 work.${ON}\n"
    printf "  ${OD}Capstones:    rootkitlings check capstone-0${ON}\n"
    printf "\n"
    printf "  ${OC}Workflow${ON}\n"
    printf "    ${OW}1.${ON} rootkitlings readme              ${OD}Read the exercise${ON}\n"
    printf "    ${OW}2.${ON} \$EDITOR module/hello.c           ${OD}Write your solution${ON}\n"
    printf "    ${OW}3.${ON} rootkitlings check               ${OD}Test it in a VM${ON}\n"
    printf "    ${OW}4.${ON} rootkitlings hint                ${OD}Nudge if stuck${ON}\n"
    printf "    ${OW}5.${ON} rootkitlings peek                ${OD}Reference (last resort)${ON}\n"
    printf "\n"
}

if (( $# == 0 )); then
    usage
    exit 0
fi

case $1 in
    check)     shift; cmd_check  "${1:-}" ;;
    readme)    shift; cmd_readme "${1:-}" ;;
    hint)      shift; cmd_hint   "${1:-}" ;;
    peek)      shift; cmd_peek   "${1:-}" ;;
    reset)     shift; cmd_reset  "${1:-}" ;;
    run)       cmd_run       ;;
    gdb)       cmd_gdb       ;;
    list)      cmd_list      ;;
    status)    cmd_status    ;;
    -h|--help) usage         ;;
    *) die "Unknown command: $1. Run 'rootkitlings --help' for usage." ;;
esac
