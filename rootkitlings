def usage():
    print(
        '''rootkitlings <COMMAND> [EXERCISE]

Setup
  setup [--accept]  Review the lab boundary; accept to verify and save it

Learn
  read [EXERCISE]   Read a lesson (default: current)
  prereq [EXERCISE] Show what to complete and know first
  hint [EXERCISE]   Get a focused nudge
  solution [EXERCISE]
                     Show recorded reference files or changes

Work
  start [EXERCISE]  Create or reopen a workspace
  build [EXERCISE]  Compile without running checks
  check [EXERCISE]  Build and verify in a disposable guest
  run [EXERCISE]    Open an interactive disposable guest
  gdb [EXERCISE]    Open a guest waiting for GDB

Progress and recovery
  status             Show setup, progress, and the next command
  list               Show the course journey
  restore [EXERCISE] Archive edits and restore starting files
  reset EXERCISE     Reset progress from one exercise onward
  reset --all --yes  Reset all course progress
  clean [EXERCISE]   Remove build outputs only
  help               Show this help

Exercise selectors accept serials such as L00 or stable IDs.
When EXERCISE is omitted, the current exercise is used.
Commands also accept unambiguous prefixes.'''
    )


CMDS = {
    'setup': cmd_setup,
    'read': cmd_read,
    'start': cmd_start,
    'build': cmd_build,
    'check': cmd_check,
    'hint': cmd_hint,
    'solution': cmd_solution,
    'run': cmd_run,
    'gdb': lambda a: cmd_run(a, True),
    'status': cmd_status,
    'list': cmd_list,
    'prereq': cmd_prereq,
    'restore': cmd_restore,
    'reset': cmd_reset,
    'clean': cmd_clean,
    'help': lambda a: (none(a, 'help'), usage()),
}


def main(a):
    requested = a[0] if a else 'status'
    arguments = a[1:] if a else []
    matches = [command for command in CMDS if command.startswith(requested)]
    if not matches:
        die(f'Unknown command: {requested}')
    if len(matches) > 1:
        die(f'Ambiguous command {requested!r}. Matches: {", ".join(matches)}')
    command = matches[0]
    if command == 'help':
        CMDS[command](arguments)
        return 0
    initialize_runtime()
    if command in {'start', 'build', 'check', 'run', 'gdb'}:
        require_setup()
    CMDS[command](arguments)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (
        CLIError,
        MigrationError,
        SetupGateError,
        StateError,
        VerificationError,
        WorkspaceError,
    ) as error:
        print(f'{R}Error:{N} {error}', file=sys.stderr)
        raise SystemExit(1)
