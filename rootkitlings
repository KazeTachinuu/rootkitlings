            print('Workspace not started')
            print(f'Next    ./rootkitlings start {label(x)}')


def cmd_list(a):
    none(a, 'list')
    with STORE.read_locked() as s:
        completed = len(set(ROUTE) & s.completed)
        print(f'Course  {completed}/{len(ROUTE)} required complete\n')
        stage = None
        for x in CAT.required():
            if x.stage != stage:
                print(CAT.section(x))
                stage = x.stage
            if x.id in s.completed:
                state = 'passed'
            elif x.id == s.current:
                state = 'current'
            else:
                state = 'locked'
            print(f'  {state:<8} {label(x):<4} {x.title} [{x.difficulty}]')
        if CAT.elective_tracks:
            print('\nOptional tracks')
        for track in CAT.elective_tracks:
            print(f'{track.serial} {track.label}')
            for exercise_id in track.members:
                x = CAT.by_id[exercise_id]
                if x.id in s.completed:
                    state = 'passed'
                elif all(
                    prerequisite in s.completed
                    for prerequisite in x.prerequisites
                ):
                    state = 'optional'
                else:
                    state = 'locked'
                print(
                    f'  {state:<8} {label(x):<4} '
                    f'{x.title} [{x.difficulty}]'
                )
        print('\nStates: passed, current, optional, locked')
        if s.current:
            print(f'Next: ./rootkitlings read {label(CAT.by_id[s.current])}')


