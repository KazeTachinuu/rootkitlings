#!/usr/bin/env python3
"""Rootkitlings v2 learner CLI."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

from lib.catalog import Catalog, CatalogError
from lib.state import StateStore, StateError
from lib.workspace import (
    WorkspaceError,
    archive_and_remove_workspaces,
    canonical_tree_hash,
    create_snapshot,
    materialize,
    materialize_inherited,
    restore_workspace,
    verify_snapshot,
)

ROOT = Path(__file__).resolve().parent
RT = ROOT / '.rootkitlings'
STATE = RT / 'state.toml'
WORK = RT / 'work'
PASSED = RT / 'passed'
ARCHIVE = RT / 'archive'


class CLIError(RuntimeError):
    pass


def color(code):
    if (sys.stdout.isatty() or sys.stderr.isatty()) and not os.getenv('NO_COLOR'):
        return f'\33[{code}m'
    return ''


B, G, Y, R, D, N = map(color, ('1;34', '1;32', '1;33', '1;31', '2', '0'))


def die(message):
    raise CLIError(message)


def head(message):
    print(f'{B}{message}{N}')


def info(message):
    print(f'{D}Info:{N} {message}', file=sys.stderr)


def done(message):
    print(f'{G}Done:{N} {message}')


try:
    CAT = Catalog(ROOT)
except CatalogError as error:
    print(f'Error: invalid course catalog: {error}', file=sys.stderr)
    raise SystemExit(1)

ROUTE = tuple(CAT.required_route)
COMPLETION_DEPENDENCIES = {
    exercise.id: frozenset(CAT.completion_dependencies(exercise))
    for exercise in CAT.exercises
}
BASELINE_PROVIDERS = {
    exercise.id: (
        provider.id if (provider := CAT.baseline_provider(exercise)) else None
    )
    for exercise in CAT.exercises
}
STORE = StateStore(
    STATE,
    set(CAT.by_id),
    ROUTE,
    CAT.revision,
    COMPLETION_DEPENDENCIES,
    BASELINE_PROVIDERS,
)


def setup():
    for path in (RT, WORK, PASSED, ARCHIVE):
        path.mkdir(parents=True, exist_ok=True)
        if path.is_symlink():
            die(f'Runtime directory must not be a symlink: {path.relative_to(ROOT)}')
    STORE.migrate_v2(ARCHIVE)


def label(item):
    return item.serial or item.id


def shown(p):
    try:
        return str(Path(p).relative_to(ROOT))
    except ValueError:
        return str(p)


def current(state):
    return CAT.by_id[state.current] if state.current else None


def resolve(q, state):
    if not q:
        x = current(state)
        if not x:
            die('Required route complete; specify an exercise ID or serial')
        return x
    try:
        return CAT.resolve(q)
    except CatalogError as error:
        raise CLIError(str(error)) from error


def available(x, state):
    if x.status == 'required':
        if x.id in state.completed or state.current is None:
            return
        if ROUTE.index(x.id) > ROUTE.index(state.current):
            now = CAT.by_id[state.current]
            die(f'{label(x)} is locked. Complete {label(now)}: {now.title} first.')
    else:
        missing = [p for p in x.prerequisites if p not in state.completed]
        if missing:
            die(f'{label(x)} is locked; incomplete prerequisites: {", ".join(missing)}')


def wp(x):
    return WORK / x.id


def bd(x):
    return wp(x) if x.workspace.build == '.' else wp(x) / x.workspace.build


def need(x):
    p = wp(x)
    if not p.is_dir() or p.is_symlink():
        die(f'{label(x)} has no workspace. Run: ./rootkitlings start {label(x)}')
    return p


def snap(content_hash):
    verify_snapshot(PASSED / content_hash, content_hash)
    return PASSED / content_hash


def baseline(x, state):
    provider = CAT.baseline_provider(x)
    if provider is None:
        return ROOT / x.workspace.source
    r = state.exercises.get(provider.id)
    if not r or not r.passed_snapshot:
        die(f'{label(x)} needs a passed snapshot from {label(provider)}')
    return snap(r.passed_snapshot)


def materialize_workspace(x, state):
    source = baseline(x, state)
    provider = CAT.baseline_provider(x)
    if provider is not None and x.workspace.additions:
        return materialize_inherited(
            source,
            ROOT / x.workspace.additions,
            WORK,
            x.id,
            provider.workspace.files,
            x.workspace.files,
        )
    return materialize(source, WORK, x.id, x.workspace.files)


def one(a, command):
    if len(a) > 1:
        die(f'Usage: rootkitlings {command} [EXERCISE]')
    return a[0] if a else None


def none(a, command):
    if a:
        die(f'Usage: rootkitlings {command}')


def run(cmd, timeout=None, capture=False):
    try:
        return subprocess.run(
            cmd,
            cwd=ROOT,
            text=True,
            timeout=timeout,
            check=False,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.STDOUT if capture else None,
        )
    except subprocess.TimeoutExpired:
        die(f'Command timed out after {timeout}s: {" ".join(map(str, cmd))}')


def cmd_start(a):
    with STORE.locked() as s:
        x = resolve(one(a, 'start'), s)
        available(x, s)
        p = wp(x)
        r = s.exercise(x.id)
        if p.exists():
            if p.is_symlink() or not p.is_dir():
                die(f'Unsafe workspace: {p.relative_to(ROOT)}')
            if not r.baseline_hash:
                die(f'Workspace exists without recorded baseline: {p.relative_to(ROOT)}')
        else:
            materialize_workspace(x, s)
            r.baseline_hash, _ = create_snapshot(p, PASSED, x.workspace.files)
            provider = CAT.baseline_provider(x)
            r.baseline_provider = provider.id if provider else ''
            r.workspace_hash = canonical_tree_hash(p, x.workspace.files)
        head(f'{label(x)}: {x.title}')
        for q in x.workspace.editable:
            info(f'Edit {shown(p / q)}')


def cmd_read(a):
    with STORE.read_locked() as s:
        x = resolve(one(a, 'read'), s)
    head(f'{label(x)}: {x.title}')
    p = ROOT / x.resources.readme
    viewer = shutil.which('glow') or shutil.which('bat') or shutil.which('batcat')
    if viewer and Path(viewer).name == 'glow':
        width = min(int(os.getenv('COLUMNS', '80')), 100)
        run([viewer, '-w', str(width), str(p)])
    elif viewer:
        run([viewer, '--style=plain', '--paging=never', '--language=markdown', str(p)])
    else:
        print(p.read_text(), end='')
    info(f'Start: ./rootkitlings start {label(x)}')


def cmd_hint(a):
    with STORE.read_locked() as s:
        x = resolve(one(a, 'hint'), s)
    head(f'Hint for {label(x)}: {x.title}')
    print((ROOT / x.resources.hint).read_text(), end='')


def cmd_solution(a):
    # Self-study references remain intentionally available out of route order.
    with STORE.locked() as s:
        x = resolve(one(a, 'solution'), s)
        s.exercise(x.id).solution_revealed = True
    print(f'{Y}Warning:{N} Reference solution for {label(x)}: {x.title}', file=sys.stderr)
    for p in sorted((ROOT / x.resources.solution).iterdir()):
        if p.is_file() and (p.suffix in ('.c', '.h') or p.name == 'Kbuild'):
            print(f'\n--- {p.name} ---', file=sys.stderr)
            print(p.read_text(), end='')


def build_workspace(x):
    need(x)
    r = run([
        'make',
        '-C',
        str(ROOT),
        f'MODULE_DIR={bd(x)}',
        'W=1',
        '--quiet',
        'module',
    ])
    if r.returncode:
        die(f'Build failed for {label(x)}')
    m = bd(x) / 'hello.ko'
    if not m.is_file():
        die(f'Build produced no {m.relative_to(ROOT)}')
    return m


def cmd_build(a):
    with STORE.locked() as s:
        x = resolve(one(a, 'build'), s)
        available(x, s)
        workspace = wp(x)
        record = s.exercise(x.id)
        if workspace.exists():
            if workspace.is_symlink() or not workspace.is_dir():
                die(f'Unsafe workspace: {workspace.relative_to(ROOT)}')
            if not record.baseline_hash:
                die(
                    'Workspace exists without recorded baseline: '
                    f'{workspace.relative_to(ROOT)}'
                )
        else:
            materialize_workspace(x, s)
            record.baseline_hash, _ = create_snapshot(
                workspace,
                PASSED,
                x.workspace.files,
            )
            provider = CAT.baseline_provider(x)
            record.baseline_provider = provider.id if provider else ''
            record.workspace_hash = canonical_tree_hash(
                workspace,
                x.workspace.files,
            )
    module = build_workspace(x)
    done(f'Built {label(x)}: {shown(module)}')


def tools(x):
    out = []
    registry = {tool.id: tool.binary for tool in CAT.tools}
    for tid in x.verification.tools:
        if tid not in registry:
            die(f'Catalog has no verification tool {tid}')
        out += ['--tool', registry[tid]]
    return out


def bootargs(x):
    z = []
    for capability in x.verification.capabilities:
        z += ['--cap', capability]
    return z + tools(x)


def check_timeout(x):
    value = os.getenv('ROOTKITLINGS_CHECK_TIMEOUT')
    if value is None:
        return x.verification.timeout_seconds
    if not value.isdigit() or int(value) <= 0:
        die('ROOTKITLINGS_CHECK_TIMEOUT must be a positive integer')
    return int(value)


def record_attempt(x, passed):
    with STORE.locked() as s:
        available(x, s)
        r = s.exercise(x.id)
        r.attempts += 1
        r.workspace_hash = canonical_tree_hash(wp(x), x.workspace.files)
        if passed:
            content_hash, _ = create_snapshot(wp(x), PASSED, x.workspace.files)
            r.passed_snapshot = content_hash
            r.workspace_hash = content_hash
            s.completed.add(x.id)


def cmd_check(a):
    with STORE.read_locked() as s:
        x = resolve(one(a, 'check'), s)
        available(x, s)
    try:
        m = build_workspace(x)
    except CLIError:
        record_attempt(x, False)
        raise
    if x.resources.host_check and run(
        [str(ROOT / x.resources.host_check), str(bd(x))]
    ).returncode:
        record_attempt(x, False)
        die(f'Host check failed for {label(x)}')
    r = run(
        [
            str(ROOT / 'vm/boot'),
            *bootargs(x),
            '--check',
            str(ROOT / x.resources.check),
            str(m),
        ],
        timeout=check_timeout(x),
        capture=True,
    )
    if r.stdout:
        print(r.stdout, end='')
    passed = r.returncode == 0 and '[+] PASSED' in (r.stdout or '')
    record_attempt(x, passed)
    if not passed:
        info(f'Hint: ./rootkitlings hint {label(x)}')
        die(f'{label(x)} failed')
    done(f'Passed {label(x)}.')
    with STORE.read_locked() as s:
        next_item = current(s)
        if next_item:
            info(f'Next: {label(next_item)}: {next_item.title}')
        else:
            info('Required route complete')


def cmd_run(a, gdb=False):
    command_name = 'gdb' if gdb else 'run'
    q = None
    extra = []
    i = 0
    while i < len(a):
        if a[i] == '--cap':
            if i + 1 == len(a):
                die('--cap requires a capability')
            extra += ['--cap', a[i + 1]]
            i += 2
        elif a[i].startswith('-'):
            die(f'Unknown option: {a[i]}')
        elif q is None:
            q = a[i]
            i += 1
        else:
            die(f'{command_name} accepts at most one exercise')
    with STORE.read_locked() as s:
        x = resolve(q, s)
        available(x, s)
    command = [
        str(ROOT / 'vm/boot'),
        *(['--gdb'] if gdb else []),
        *bootargs(x),
        *extra,
        str(build_workspace(x)),
    ]
    raise SystemExit(run(command).returncode)


def cmd_status(a):
    none(a, 'status')
    with STORE.read_locked() as s:
        x = current(s)
        completed = len(set(ROUTE) & s.completed)
        print(f'Course  {completed}/{len(ROUTE)} required complete')
        if not x:
            print('Status  Required route complete')
            return
        print(f'ID      {label(x)} ({x.id})')
        print(f'Title   {x.title}')
        print(f'Stage   {CAT.section(x)}')
        print(f'Level   {x.difficulty}')
        concepts = ', '.join(CAT.concept_label(value) for value in x.teaches)
        print(f'Teaches {concepts}')
        tag_labels = {tag.id: tag.label for tag in CAT.tradecraft_tags}
        if x.tradecraft:
            print('Tradecraft ' + ', '.join(tag_labels[value] for value in x.tradecraft))
        edit_paths = ', '.join(shown(wp(x) / p) for p in x.workspace.editable)
        print(f'Edit    {edit_paths}')
        print('Next    ./rootkitlings read')


def cmd_list(a):
    none(a, 'list')
    with STORE.read_locked() as s:
        completed = len(set(ROUTE) & s.completed)
        print(f'Course  {completed}/{len(ROUTE)} required complete\n')
        stage = None
        xs = CAT.ordered() + sorted(
            (x for x in CAT.exercises if x.status != 'required'),
            key=lambda x: (x.stage, x.title),
        )
        for x in xs:
            if x.stage != stage:
                print(CAT.section(x))
                stage = x.stage
            if x.id in s.completed:
                state = 'passed'
            elif x.id == s.current:
                state = 'current'
            elif x.status == 'elective':
                state = 'elective'
            else:
                state = 'locked'
            print(f'  {state:<8} {label(x):<4} {x.title} [{x.difficulty}]')
        print()


def cmd_prereq(a):
    with STORE.read_locked() as s:
        x = resolve(one(a, 'prereq'), s)
    head(f'Prerequisites for {label(x)}: {x.title}')
    if x.id == ROUTE[0]:
        print('Course entry')
        for assumption in CAT.assumptions:
            print(
                f'  - {CAT.concept_label(assumption.concept)}: '
                f'{assumption.competency}'
            )
        print()
    print('Exercises')
    if not x.prerequisites:
        print('  - None')
    for p in x.prerequisites:
        y = CAT.by_id[p]
        print(f'  - {label(y)}: {y.title}')
    if x.requires:
        print('\nConcepts')
        for c in x.requires:
            print(f'  - {CAT.concept_label(c)}')


def cmd_restore(a):
    with STORE.locked() as s:
        x = resolve(one(a, 'restore'), s)
        need(x)
        r = s.exercises.get(x.id)
        if not r or not r.baseline_hash:
            die(f'{label(x)} has no recorded baseline')
        restored, arch = restore_workspace(
            WORK,
            ARCHIVE,
            x.id,
            snap(r.baseline_hash),
            x.workspace.files,
        )
        r.workspace_hash = canonical_tree_hash(restored, x.workspace.files)
    done(f'Archived work at {shown(arch)}')
    done(f'Restored {label(x)}')


def progress_reset_ids(selected):
    if selected is None:
        affected = set(CAT.by_id)
    elif selected.id in ROUTE:
        affected = set(ROUTE[ROUTE.index(selected.id):])
    else:
        affected = {selected.id}

    changed = True
    while changed:
        changed = False
        for exercise in CAT.exercises:
            if exercise.status == 'required' or exercise.id in affected:
                continue
            dependencies = set(CAT.completion_dependencies(exercise))
            if dependencies & affected:
                affected.add(exercise.id)
                changed = True
    return affected


def cmd_progress_reset(a):
    if len(a) != 1:
        die('Usage: rootkitlings progress-reset EXERCISE | --all')
    reset_all = a[0] == '--all'
    with STORE.locked() as s:
        selected = None if reset_all else resolve(a[0], s)
        affected = progress_reset_ids(selected)
        archives = archive_and_remove_workspaces(WORK, ARCHIVE, affected)
        s.clear_progress(affected)
    for stable_id, archive in sorted(archives.items()):
        done(f'Archived {stable_id} at {shown(archive)}')
    scope = 'all learner progress' if reset_all else f'{label(selected)} and its dependents'
    done(f'Reset {scope}')


def cmd_clean(a):
    with STORE.read_locked() as s:
        x = resolve(one(a, 'clean'), s)
    need(x)
    k = Path(os.getenv('KDIR', f'/lib/modules/{os.uname().release}/build'))
    if run(['make', '-C', str(k), f'M={bd(x)}', 'clean']).returncode:
        die(f'Could not clean {label(x)}')
    done(f'Cleaned {label(x)} build outputs')


def usage():
    print(
        '''rootkitlings <COMMAND> [EXERCISE]

  read start build check hint solution run gdb status list prereq
  build     Compile the selected workspace without checking it
  restore   Archive work and restore its starting baseline
  progress-reset EXERCISE | --all
              Archive affected work and reset learner progress
  clean     Remove selected workspace build outputs
  help      Show this help

Selectors accept stable IDs or serials. Commands accept unique prefixes.'''
    )


CMDS = {
    'read': cmd_read,
    'start': cmd_start,
    'build': cmd_build,
    'check': cmd_check,
    'hint': cmd_hint,
    'solution': cmd_solution,
    'run': cmd_run,
    'gdb': lambda a: cmd_run(a, True),
    'status': cmd_status,
    'list': cmd_list,
    'prereq': cmd_prereq,
    'restore': cmd_restore,
    'progress-reset': cmd_progress_reset,
    'clean': cmd_clean,
    'help': lambda a: (none(a, 'help'), usage()),
}


def main(a):
    requested = a[0] if a else 'status'
    arguments = a[1:] if a else []
    matches = [command for command in CMDS if command.startswith(requested)]
    if not matches:
        die(f'Unknown command: {requested}')
    if len(matches) > 1:
        die(f'Ambiguous command {requested!r}. Matches: {", ".join(matches)}')
    command = matches[0]
    if command == 'help':
        CMDS[command](arguments)
        return 0
    setup()
    CMDS[command](arguments)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (CLIError, StateError, WorkspaceError) as error:
        print(f'{R}Error:{N} {error}', file=sys.stderr)
        raise SystemExit(1)
