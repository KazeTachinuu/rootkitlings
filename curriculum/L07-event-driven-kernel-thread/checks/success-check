#!/bin/sh
# shellcheck disable=SC3043 # Checks run under BusyBox ash, which provides local.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Event-driven kernel thread"

endpoint=/proc/rklings
fixtures=/tmp/rklings-worker
actual=$fixtures/actual
mkdir -p "$fixtures"

: > "$fixtures/empty"
printf 'enable' > "$fixtures/enable"
printf 'enable\n' > "$fixtures/enable-lf"
printf 'disable' > "$fixtures/disable"
printf 'disable\n' > "$fixtures/disable-lf"
printf 'run' > "$fixtures/run"
printf 'run\n' > "$fixtures/run-lf"
printf '\n' > "$fixtures/lone-lf"
printf 'ena\nble' > "$fixtures/interior-lf"
printf 'enable\n\n' > "$fixtures/double-lf"
printf 'run\000' > "$fixtures/nul"
printf 'ru' > "$fixtures/prefix"
printf 'runner' > "$fixtures/suffix"
printf 'xrun' > "$fixtures/prefixed"
printf 'disable\nx' > "$fixtures/oversized"
chmod 0644 "$fixtures"/*

scan_workers()
{
	worker_count_value=0
	worker_pid_value=
	for comm in /proc/[0-9]*/comm; do
		[ -r "$comm" ] || continue
		if [ "$(cat "$comm")" = rkling_event ]; then
			worker_count_value=$((worker_count_value + 1))
			worker_pid_value=${comm#/proc/}
			worker_pid_value=${worker_pid_value%/comm}
		fi
	done
}

assert_no_worker()
{
	scan_workers
	if [ "$worker_count_value" -eq 0 ]; then
		_ok "rkling_event is absent"
	else
		_fail "rkling_event is still running"
	fi
}

assert_sleeping_worker()
{
	local sleep_attempt task_state

	sleep_attempt=0
	while [ "$sleep_attempt" -lt 100 ]; do
		scan_workers
		if [ "$worker_count_value" -eq 1 ]; then
			task_state=$(awk '{ print $3 }' "/proc/$worker_pid_value/stat" 2>/dev/null || true)
			if [ "$task_state" = S ]; then
				_ok "one rkling_event task is sleeping without work"
				return
			fi
		fi
		sleep 0.01
		sleep_attempt=$((sleep_attempt + 1))
	done
	_fail "one sleeping rkling_event task was not observed"
}

assert_not_loaded()
{
	assert_absent /sys/module/rklings
	assert_absent "$endpoint"
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings appears in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
	assert_no_worker
}

read_status()
{
	expected=$1
	label=$2
	if cat "$endpoint" > "$actual" &&
	   awk -v expected="$expected" '
		NR == 1 { if ($0 != "active=1") exit 1 }
		NR == 2 { if ($0 != "actions=" expected) exit 1 }
		NR == 3 { if ($0 !~ /^worker_runs=[0-9]+$/) exit 1 }
		END { if (NR != 3) exit 1 }
	   ' "$actual"; then
		status_runs=$(sed -n 's/^worker_runs=//p' "$actual")
		_ok "$label returns one complete $expected record"
		return 0
	fi
	status_runs=0
	_fail "$label: malformed or unexpected proc record"
	return 1
}

expect_disabled_errno()
{
	fixture=$1
	errno=$2
	label=$3
	before=$(status_field_test read "$endpoint" worker_runs)
	if proc_write_test errno "$endpoint" "$fixtures/$fixture" "$errno" > /dev/null; then
		_ok "$label returns errno $errno"
	else
		_fail "$label did not return errno $errno"
	fi
	if status_field_test unchanged "$endpoint" worker_runs "$before" 50 > /dev/null; then
		_ok "$label submits no work"
	else
		_fail "$label changed worker_runs"
	fi
	read_status disabled "$label" > /dev/null || true
}

check_loaded()
{
	assert_loaded rklings
	assert_exists "$endpoint"
	metadata=$(stat -c '%a:%u:%g' "$endpoint")
	if [ "$metadata" = 644:0:0 ]; then
		_ok "$endpoint is mode 0644 and owned by 0:0"
	else
		_fail "$endpoint metadata: expected 644:0:0, got $metadata"
	fi
	read_status disabled "module load" > /dev/null || true
	if [ "$status_runs" -eq 0 ]; then
		_ok "worker_runs begins at zero"
	else
		_fail "worker_runs starts at $status_runs"
	fi
	assert_sleeping_worker
	if status_field_test unchanged "$endpoint" worker_runs 0 300 > /dev/null; then
		_ok "the idle thread does not run autonomously"
	else
		_fail "worker_runs changed without a command"
	fi
}

check_rejections()
{
	expect_disabled_errno run 13 "disabled bare run"
	expect_disabled_errno run-lf 13 "disabled run with newline"
	expect_disabled_errno empty 22 "empty write"
	expect_disabled_errno lone-lf 22 "lone newline"
	expect_disabled_errno interior-lf 22 "interior newline"
	expect_disabled_errno double-lf 22 "second trailing newline"
	expect_disabled_errno nul 22 "embedded NUL"
	expect_disabled_errno prefix 22 "short prefix"
	expect_disabled_errno suffix 22 "suffix"
	expect_disabled_errno prefixed 22 "prefixed command"
	expect_disabled_errno oversized 7 "nine-byte command"

	if proc_write_test fault "$endpoint" "$fixtures/run" 14 > /dev/null; then
		_ok "partial user copy returns errno 14"
	else
		_fail "partial user copy did not return errno 14"
	fi
	if proc_write_test fault "$endpoint" "$fixtures/oversized" 7 > /dev/null; then
		_ok "oversized write is rejected before user copy"
	else
		_fail "oversized write touched user memory before rejection"
	fi
	if proc_write_test offset "$endpoint" "$fixtures/run" 1 22 > /dev/null; then
		_ok "nonzero offset returns errno 22"
	else
		_fail "nonzero offset did not return errno 22"
	fi
	if run_as 65534 65534 proc_write_test write "$endpoint" \
		"$fixtures/run" > "$fixtures/unprivileged.log" 2>&1; then
		_fail "unprivileged writer submitted work"
	else
		_ok "unprivileged writer is denied"
	fi
	if status_field_test unchanged "$endpoint" worker_runs 0 100 > /dev/null; then
		_ok "rejected writes leave the pending count empty"
	else
		_fail "a rejected write reached the worker"
	fi
}

check_exact_requests()
{
	if proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null; then
		_ok "enable returns its full byte count"
	else
		_fail "enable failed"
	fi
	read_status enabled "enable" > /dev/null || true

	expected=$status_runs
	step=1
	while [ "$step" -le 8 ]; do
		if ! proc_write_test write "$endpoint" "$fixtures/run" > /dev/null; then
			_fail "sequential run $step failed"
			break
		fi
		expected=$((expected + 1))
		if ! status_field_test equal "$endpoint" worker_runs "$expected" 1000 > /dev/null; then
			_fail "sequential run $step did not produce exactly one completion"
			break
		fi
		step=$((step + 1))
	done
	if [ "$step" -eq 9 ]; then
		_ok "eight sequential commands produce exactly eight runs"
	fi

	before=$(status_field_test read "$endpoint" worker_runs)
	if proc_write_test repeat "$endpoint" "$fixtures/run-lf" 256 > /dev/null; then
		_ok "one descriptor accepts a burst of 256 run commands"
	else
		_fail "burst run writes failed"
	fi
	target=$((before + 256))
	if status_field_test equal "$endpoint" worker_runs "$target" 3000 > /dev/null; then
		_ok "the burst produces exactly 256 additional runs"
	else
		_fail "the burst was lost, merged, or duplicated"
	fi

	before=$target
	pids=
	writer=1
	while [ "$writer" -le 4 ]; do
		proc_write_test repeat "$endpoint" "$fixtures/run" 256 > /dev/null &
		pids="$pids $!"
		writer=$((writer + 1))
	done
	writers_ok=1
	for pid in $pids; do
		wait "$pid" || writers_ok=0
	done
	if [ "$writers_ok" -eq 1 ]; then
		_ok "four concurrent writers submit 1024 commands"
	else
		_fail "a concurrent run writer failed"
	fi
	target=$((before + 1024))
	if status_field_test equal "$endpoint" worker_runs "$target" 5000 > /dev/null; then
		_ok "concurrent commands produce exactly 1024 additional runs"
	else
		_fail "concurrent commands were lost, merged, or duplicated"
	fi

	if status_field_test unchanged "$endpoint" worker_runs "$target" 300 > /dev/null; then
		_ok "the thread sleeps again after draining accepted work"
	else
		_fail "worker_runs changed after all requests completed"
	fi
	assert_sleeping_worker

	if proc_write_test write "$endpoint" "$fixtures/disable-lf" > /dev/null; then
		_ok "disable with newline returns its full byte count"
	else
		_fail "disable with newline failed"
	fi
	expect_disabled_errno run 13 "run after disable"
}

race_runner()
{
	local output index

	output=$1
	index=0

	: > "$output"
	while [ "$index" -lt 128 ]; do
		proc_write_test outcome "$endpoint" "$fixtures/run" >> "$output" ||
			return 1
		index=$((index + 1))
	done
}

race_toggler()
{
	local index=0

	while [ "$index" -lt 256 ]; do
		proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null ||
			return 1
		proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null ||
			return 1
		index=$((index + 1))
	done
	proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null
}

check_switch_race()
{
	if proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null; then
		_ok "actions are enabled before the run and switch race"
	else
		_fail "could not enable actions before the race"
	fi
	before=$(status_field_test read "$endpoint" worker_runs)

	runner_pids=
	runner=1
	while [ "$runner" -le 4 ]; do
		race_runner "$fixtures/race-$runner" &
		runner_pids="$runner_pids $!"
		runner=$((runner + 1))
	done
	race_toggler &
	toggler_pid=$!

	race_ok=1
	for pid in $runner_pids; do
		wait "$pid" || race_ok=0
	done
	wait "$toggler_pid" || race_ok=0
	if [ "$race_ok" -eq 1 ]; then
		_ok "run writers and the action switch complete concurrently"
	else
		_fail "a concurrent run or switch writer failed"
	fi

	if awk '$0 != "ok" && $0 != "13" { bad = 1 }
		END { exit bad }' "$fixtures"/race-[1-4]; then
		_ok "every raced run is accepted or returns EACCES"
	else
		_fail "a raced run returned an unexpected outcome"
	fi
	successes=$(awk '$0 == "ok" { count++ } END { print count + 0 }' \
		"$fixtures"/race-[1-4])
	denied=$(awk '$0 == "13" { count++ } END { print count + 0 }' \
		"$fixtures"/race-[1-4])
	total=$((successes + denied))
	if [ "$total" -eq 512 ]; then
		_ok "all 512 raced runs are accounted for: $successes accepted, $denied denied"
	else
		_fail "race outcomes: expected 512 results, got $successes accepted and $denied denied"
	fi

	proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null ||
		_fail "could not restore enabled actions after the race"
	target=$((before + successes))
	if status_field_test equal "$endpoint" worker_runs "$target" 5000 > /dev/null; then
		_ok "only the $successes accepted raced requests complete"
	else
		_fail "raced requests were lost, duplicated, or accepted after EACCES"
	fi
}

assert_not_loaded
attempt=1
while [ "$attempt" -le 2 ]; do
	load rklings.ko
	check_loaded
	check_rejections
	check_exact_requests
	check_switch_race
	proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null ||
		_fail "could not enable before unload"
	if proc_write_test unload "$endpoint" "$fixtures/run" rklings > /dev/null; then
		_ok "attempt $attempt rejects a held descriptor after unload"
	else
		_fail "attempt $attempt failed the held-descriptor unload check"
	fi
	assert_not_loaded
	attempt=$((attempt + 1))
done

summary
