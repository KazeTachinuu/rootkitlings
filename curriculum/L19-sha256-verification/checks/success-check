#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "SHA-256 verification"

assert_absent /sys/module/rklings
attempt=1
while [ "$attempt" -le 2 ]; do
	load rklings.ko
	assert_loaded rklings
	if dmesg | grep -q 'rklings: sha256 self-tests passed: 35 assertions'; then
		_ok "Linux SHA-256 vectors and comparisons passed"
	else
		_fail "SHA-256 self-test completion is missing"
	fi
	unload rklings
	assert_absent /sys/module/rklings
	attempt=$((attempt + 1))
done

summary
