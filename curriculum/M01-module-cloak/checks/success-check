#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Module hiding"

endpoint=/proc/rootkitlings

load rootkitlings.ko
assert_loaded rootkitlings
assert_exists "$endpoint"

# Module should be visible before hideing.
if lsmod | grep -q rootkitlings; then
	_ok "module visible in lsmod before hide"
else
	_fail "module not in lsmod before hide"
fi

# Cloak the module.
echo hide > "$endpoint"

if lsmod | grep -q rootkitlings; then
	_fail "module still visible in lsmod after hide"
else
	_ok "module hidden from lsmod after hide"
fi

# /proc/modules is the same view as lsmod.
if grep -q rootkitlings /proc/modules; then
	_fail "module still visible in /proc/modules after hide"
else
	_ok "module hidden from /proc/modules after hide"
fi

# Control interface should still work while hidden.
if [ -f "$endpoint" ]; then
	_ok "proc control interface still accessible while hidden"
else
	_fail "proc control interface disappeared"
fi

# Status should report cloaked.
if grep -q 'hidden=true' "$endpoint"; then
	_ok "status reports hidden=true"
else
	_fail "status does not report hidden=true"
fi

# Double cloak should be a no-op.
echo hide > "$endpoint"
if grep -q 'hidden=true' "$endpoint"; then
	_ok "double hide is a no-op"
else
	_fail "double hide changed state"
fi

# Unhide so rmmod can find it, then unload.
echo unhide > "$endpoint"
unload rootkitlings
assert_absent "$endpoint"

if lsmod | grep -q rootkitlings; then
	_fail "module still in lsmod after unload"
else
	_ok "module removed from lsmod after unload"
fi

summary
