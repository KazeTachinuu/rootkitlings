#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Non-target ports remain visible"

ifconfig lo 127.0.0.1 up

hidden_port=9999
other_port=8888

# Bind listeners on both ports.
busybox nc -l -p "$hidden_port" 0.0.0.0 -e /bin/true &
hidden_pid=$!
busybox nc -l -p "$other_port" 0.0.0.0 -e /bin/true &
other_pid=$!
sleep 1

other_hex=$(printf '%04X' "$other_port")

load rklings.ko hidden_port="$hidden_port"
assert_loaded rklings

# The other port must remain visible.
if grep -qi ":${other_hex} " /proc/net/tcp 2>/dev/null; then
	_ok "non-target port $other_port remains visible"
else
	_fail "non-target port $other_port was incorrectly hidden"
fi

unload rklings

kill "$hidden_pid" 2>/dev/null || true
kill "$other_pid" 2>/dev/null || true
wait "$hidden_pid" 2>/dev/null || true
wait "$other_pid" 2>/dev/null || true

summary
