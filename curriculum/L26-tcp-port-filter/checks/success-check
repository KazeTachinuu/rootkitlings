#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "TCP port hiding"

ifconfig lo 127.0.0.1 up

test_port=9999

# Bind a TCP listener on the test port.
busybox nc -l -p "$test_port" 0.0.0.0 -e /bin/true &
listener_pid=$!
sleep 1

# Convert port to hex (little-endian in /proc/net/tcp is uppercase hex).
port_hex=$(printf '%04X' "$test_port")
if grep -q ": $port_hex " /proc/net/tcp 2>/dev/null ||
   grep -qi ":${port_hex} " /proc/net/tcp 2>/dev/null; then
	_ok "port $test_port is visible before module load"
else
	_fail "port $test_port not visible even before module load"
	kill "$listener_pid" 2>/dev/null || true
	summary
fi

load rklings.ko hidden_port="$test_port"
assert_loaded rklings

# The port should now be hidden from /proc/net/tcp.
if grep -qi ":${port_hex} " /proc/net/tcp 2>/dev/null; then
	_fail "port $test_port is still visible after module load"
else
	_ok "port $test_port is hidden from /proc/net/tcp"
fi

unload rklings

# After unload, the port should reappear.
if grep -qi ":${port_hex} " /proc/net/tcp 2>/dev/null; then
	_ok "port $test_port reappears after module unload"
else
	_fail "port $test_port did not reappear after module unload"
fi

kill "$listener_pid" 2>/dev/null || true
wait "$listener_pid" 2>/dev/null || true

summary
