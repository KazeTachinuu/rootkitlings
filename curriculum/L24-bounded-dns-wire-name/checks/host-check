#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-bounded-dns-wire-name-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for relative in Kbuild codec/dns_name.c codec/dns_name.o core/main.c \
		include/dns_name.h include/ipv4_parser.h include/selftest.h \
		parser/ipv4.c tests/selftest.c; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done

gcc -std=c11 -Wall -Wextra -Werror -pedantic -O1 -g \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I"$build_dir/include" "$here/../fixtures/host/dns_name_test.c" \
	"$build_dir/codec/dns_name.c" -o "$scratch/dns-name-test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
	"$scratch/dns-name-test"

undefined=$(nm -u "$build_dir/codec/dns_name.o" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__SCT__WARN_trap|__fentry__|__fortify_panic|\
		__ref_stack_chk_guard|__stack_chk_fail|__x86_return_thunk|\
		memcpy|memset) ;;
		*) die "codec has unexpected external dependency: $symbol" ;;
	esac
done <<< "$undefined"

if nm "$build_dir/codec/dns_name.o" |
	grep -Eq '[[:space:]][bBdD][[:space:]]'; then
	die "codec must not own mutable or persistent object state"
fi
nm "$build_dir/codec/dns_name.o" |
	grep -Eq '[[:space:]]T[[:space:]]rk_dns_name_encode$' ||
	die "codec object does not define rk_dns_name_encode"
nm "$build_dir/codec/dns_name.o" |
	grep -Eq '[[:space:]]T[[:space:]]rk_dns_name_parse$' ||
	die "codec object does not define rk_dns_name_parse"

printf '[+] DNS codec structure and bounded behavior are valid\n'
