#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Protection property selection"

assert_absent /sys/module/rklings
attempt=1
while [ "$attempt" -le 2 ]; do
	load rklings.ko
	assert_loaded rklings
	if dmesg | grep -q 'rklings: protection self-tests passed: 294 assertions'; then
		_ok "kernel decision table and XOR self-tests passed"
	else
		_fail "kernel self-test completion is missing"
	fi
	if dmesg | grep -q 'rklings: runtime marker=rk-runtime-plaintext-visible'; then
		_ok "decoded plaintext exists while the module runs"
	else
		_fail "runtime plaintext demonstration is missing"
	fi
	unload rklings
	assert_absent /sys/module/rklings
	attempt=$((attempt + 1))
done

summary
