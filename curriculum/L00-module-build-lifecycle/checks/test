#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
work=$(mktemp -d "${TMPDIR:-/tmp}/rklings-module-build-lifecycle-test.XXXXXX")
trap 'rm -rf -- "$work"' EXIT

build_and_check()
{
	make -s -C "$KDIR" M="$work" clean
	make -s -C "$KDIR" M="$work" W=1 modules
	"$HERE/host-check" "$work" "$work/rklings.ko"
}

cp -a "$HERE/../solution/." "$work/"
build_and_check
"$HERE/../../../vm/boot" --check "$HERE/../../L00-module-build-lifecycle/checks/module-lifecycle-check" \
	"$work/rklings.ko"
printf '[+] reference solution passed host and disposable-guest checks\n'

cp "$HERE/../fixtures/missing-exit-main.c" "$work/core/main.c"
build_and_check
if output=$("$HERE/../../../vm/boot" --check \
	"$HERE/../../L00-module-build-lifecycle/checks/module-lifecycle-check" "$work/rklings.ko" 2>&1); then
	printf '%s\n[x] missing-exit fixture unexpectedly passed guest lifecycle\n' \
		"$output" >&2
	exit 1
fi
case $output in
	*"failed to unload rklings"*) ;;
	*) printf '%s\n[x] fixture failed for the wrong reason\n' "$output" >&2; exit 1 ;;
esac
printf '[+] missing-exit fixture rejected by the running kernel lifecycle\n'

cp -a "$HERE/../solution/." "$work/"
cp "$HERE/../fixtures/wrong-module-Kbuild" "$work/Kbuild"
if output=$(build_and_check 2>&1); then
	printf '%s\n' "$output" >&2
	printf '[x] wrong-module fixture unexpectedly passed\n' >&2
	exit 1
fi
case $output in
	*"artifact not found:"*) ;;
	*) printf '%s\n[x] component fixture failed for the wrong reason\n' "$output" >&2; exit 1 ;;
esac
printf '[+] wrong-module fixture rejected before guest boot\n'

cp -a "$HERE/../solution/." "$work/"
cp "$HERE/../fixtures/wrong-description-main.c" "$work/core/main.c"
if output=$(build_and_check 2>&1); then
	printf '%s\n' "$output" >&2
	printf '[x] wrong-description fixture unexpectedly passed\n' >&2
	exit 1
fi
case $output in
	*"module description must be: Rklings kernel module"*) ;;
	*) printf '%s\n[x] metadata fixture failed for the wrong reason\n' "$output" >&2; exit 1 ;;
esac
printf '[+] wrong-description fixture rejected before guest boot\n'
