#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Shell timeout and delayed work lifecycle"

# -- Pre-load state --
assert_absent /sys/module/rklings

# -- Load and verify structures initialized --
load rklings.ko

assert_loaded rklings

# Verify module parameters are exposed
if [ -d /sys/module/rklings/parameters ]; then
  _ok "parameters directory exists"
else
  _fail "parameters directory missing"
fi

# The module exposes shell_port and peer_address as parameters
if [ -f /sys/module/rklings/parameters/shell_port ]; then
  _ok "shell_port parameter exists"
else
  _fail "shell_port parameter missing"
fi

# -- Unload and verify clean teardown --
# The exit function must cancel delayed work and release resources cleanly.
unload rklings
assert_absent /sys/module/rklings

# -- Repeated load/unload cycle --
# Ensures no resource leaks across cycles.
_hdr "Repeated load/unload cycle"
load rklings.ko
assert_loaded rklings
unload rklings
assert_absent /sys/module/rklings

summary
