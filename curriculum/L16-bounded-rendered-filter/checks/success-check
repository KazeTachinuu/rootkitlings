#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Bounded read-result filtering"

endpoint=/proc/rootkitlings
registry=/sys/kernel/debug/kprobes/list
target=/tmp/rootkitlings-read-target
other=/tmp/rootkitlings-read-other
hardlink=/tmp/rootkitlings-read-hardlink
renamed=/tmp/rootkitlings-read-renamed
fixtures=/tmp/rootkitlings-read-fixtures
original=53454352455400534543524554
masked=58585858585800585858585858
mkdir -p "$fixtures"

probe_count()
{
	awk '$2 == "r" { split($3, name, "+"); if (name[1] == "vfs_read") count++ }
		END { print count + 0 }' "$registry"
}

status_hex()
{
	printf 'limit=512\nredactions=%s\noversize_results=%s\ncopy_failures=%s\nreturn_capacity=32\nreturns_missed=0\n' \
		"$1" "$2" "$3" | xxd -p | tr -d '\n'
}

assert_status()
{
	if read_result_test proc "$endpoint" "$(status_hex "$1" "$2" "$3")"; then
		_ok "$4 returns the exact status through small reads, EOF, and rewind"
	else
		_fail "$4 returned an unexpected status"
		cat "$endpoint" >&2 || true
	fi
}

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	rm -rf "$fixtures" "$target" "$other" "$hardlink" "$renamed" \
		2>/dev/null || true
}
trap cleanup EXIT INT TERM

test -r "$registry" || {
	_fail "Kprobe registry is not readable"
	summary
}
case $(uname -r) in
	7.2.*|7.2-*) _ok "guest runs the supported Linux 7.2 ABI" ;;
	*) _fail "guest kernel is not Linux 7.2.x" ;;
esac
if [ "$(uname -m)" = x86_64 ]; then
	_ok "guest architecture is x86_64"
else
	_fail "guest architecture is not x86_64"
fi
if awk '$3 == "vfs_read" { found = 1 } END { exit !found }' /proc/kallsyms; then
	_ok "vfs_read exists in the running kernel"
else
	_fail "vfs_read is absent"
fi
if awk '$3 == "__rootkitlings_missing_kretprobe_target_7_2__" { found = 1 }
	END { exit found }' /proc/kallsyms; then
	_ok "negative-control probe target is absent"
else
	_fail "negative-control probe target unexpectedly exists"
fi

read_result_test write "$target" "$original"
read_result_test write "$other" "$original"
probe_before=$(probe_count)
log_before=$(dmesg | wc -l)
load rootkitlings.ko
assert_loaded rootkitlings
assert_exists "$endpoint"
if [ "$(stat -c %a "$endpoint")" = 400 ]; then
	_ok "status endpoint is read-only mode 0400"
else
	_fail "status endpoint mode is not 0400"
fi
if [ "$(probe_count)" -eq $((probe_before + 1)) ]; then
	_ok "exactly one vfs_read return probe is registered"
else
	_fail "loaded state does not have exactly one vfs_read return probe"
fi
assert_status 0 0 0 "fresh load"

if read_result_test check read "$target" 0 13 "$masked" &&
	read_result_test check pread64 "$target" 0 4096 "$masked"; then
	_ok "read and pread64 replace both complete byte patterns"
else
	_fail "read or pread64 did not return the bounded replacement"
fi
assert_status 4 0 0 "two filtered reads"

for method in readv preadv mmap sendfile; do
	if read_result_test check "$method" "$target" 0 13 "$original"; then
		_ok "$method remains an independent unfiltered view"
	else
		_fail "$method did not preserve the underlying bytes"
	fi
done
assert_status 4 0 0 "alternate read paths"

if read_result_test check read "$other" 0 13 "$original"; then
	_ok "another inode is unchanged"
else
	_fail "another inode was filtered"
fi
busybox ln "$target" "$hardlink"
if read_result_test check read "$hardlink" 0 13 "$masked"; then
	_ok "a hard link selects the retained inode"
else
	_fail "a hard link to the retained inode was not filtered"
fi
busybox mv "$target" "$renamed"
if read_result_test check read "$renamed" 0 13 "$masked"; then
	_ok "renaming the retained inode keeps it selected"
else
	_fail "renamed retained inode was not filtered"
fi
read_result_test write "$target" "$original"
if read_result_test check read "$target" 0 13 "$original"; then
	_ok "a new inode at the original path is not selected"
else
	_fail "a replacement inode was incorrectly selected"
fi
rm "$target" "$hardlink"
busybox mv "$renamed" "$target"
assert_status 8 0 0 "inode identity checks"

if read_result_test invalid "$target"; then
	_ok "an invalid destination keeps the underlying EFAULT"
else
	_fail "invalid destination did not return EFAULT"
fi
assert_status 8 0 0 "underlying read failure"

dd if=/dev/zero of="$target" bs=512 count=1 2>/dev/null
printf SECRET | dd of="$target" bs=1 seek=0 conv=notrunc 2>/dev/null
printf SECRET | dd of="$target" bs=1 seek=506 conv=notrunc 2>/dev/null
middle500=$(dd if=/dev/zero bs=500 count=1 2>/dev/null | xxd -p | tr -d '\n')
exact512=585858585858${middle500}585858585858
if read_result_test check read "$target" 0 512 "$exact512"; then
	_ok "an exact 512-byte result is filtered at both boundaries"
else
	_fail "exact 512-byte result was not filtered correctly"
fi
assert_status 10 0 0 "exact limit"

dd if=/dev/zero of="$target" bs=513 count=1 2>/dev/null
printf SECRET | dd of="$target" bs=1 seek=0 conv=notrunc 2>/dev/null
zeros507=$(dd if=/dev/zero bs=507 count=1 2>/dev/null | xxd -p | tr -d '\n')
original513=534543524554${zeros507}
if read_result_test check read "$target" 0 513 "$original513"; then
	_ok "a 513-byte result is left unchanged"
else
	_fail "a 513-byte result changed"
fi
assert_status 10 1 0 "oversize result"

read_result_test write "$target" "$original"
if read_result_test check read "$target" 0 4096 "$masked"; then
	_ok "a large request with a short result is filtered"
else
	_fail "short result from a large request was not filtered"
fi
read_result_test write "$target" 534543524554
if read_result_test check read "$target" 0 3 534543 &&
	read_result_test check read "$target" 3 3 524554; then
	_ok "a pattern split across read results is unchanged"
else
	_fail "split pattern was incorrectly carried across reads"
fi
assert_status 12 1 0 "short and split results"

read_result_test write "$target" "$original"
if read_result_test stress "$target" 100 "$masked"; then
	_ok "twelve concurrent pread64 callers receive complete replacements"
else
	_fail "concurrent filtered reads returned a torn result"
fi
assert_status 2412 1 0 "concurrent reads"

read_result_test stress "$target" 100000 "$masked" "$original" &
stress_pid=$!
sleep 1
unload rootkitlings
if wait "$stress_pid"; then
	_ok "unload exposes only complete original or replacement results"
else
	_fail "read workload observed a torn result during unload"
fi
assert_absent "$endpoint"
if [ "$(probe_count)" -eq "$probe_before" ]; then
	_ok "unload removes the return probe"
else
	_fail "unload leaked the return probe"
fi

load rootkitlings.ko
assert_loaded rootkitlings
assert_status 0 0 0 "reload"
unload rootkitlings
assert_absent "$endpoint"
if read_result_test check read "$target" 0 13 "$original"; then
	_ok "final unload restores the original read result"
else
	_fail "final unload did not restore the original view"
fi

new_log=$fixtures/new-log
dmesg | tail -n "+$((log_before + 1))" > "$new_log"
if grep -Eq 'BUG:|WARNING:|Oops:|KASAN:|UBSAN:|general protection fault|use-after-free' "$new_log"; then
	_fail "kernel log contains a fault or warning"
	cat "$new_log" >&2
else
	_ok "kernel log is clean"
fi

summary
