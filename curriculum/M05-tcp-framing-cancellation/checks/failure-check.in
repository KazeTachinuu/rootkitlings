#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:?expected errno argument is required}
label=${2:?check label argument is required}
needs_listener=${3:?listener flag argument is required}

begin "$label"

fixtures=/tmp/rootkitlings-framed-failure
mkdir -p "$fixtures"

ifconfig lo 127.0.0.1 up

wait_for_file()
{
	path=$1
	index=0
	while [ ! -s "$path" ] && [ "$index" -lt 500 ]; do
		sleep 0.01
		index=$((index + 1))
	done
	[ -s "$path" ]
}

attempt=1
while [ "$attempt" -le 2 ]; do
	directory=$fixtures/attempt-$attempt
	mkdir -p "$directory"
	fixture_pid=
	if [ "$needs_listener" -eq 1 ]; then
		tcp_session_fixture hold "$directory" > "$directory/log" 2>&1 &
		fixture_pid=$!
		wait_for_file "$directory/ready" || _fail "listener was not ready"
		port=$(cat "$directory/port")
	else
		port=47023
	fi
	if module_load_params /rootkitlings/rootkitlings.ko "$expected_errno" \
			"peer_port=$port"; then
		_ok "attempt $attempt returned errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "attempt $attempt left a loaded module"
	else
		_ok "attempt $attempt left no loaded module"
	fi
	if [ -n "$fixture_pid" ]; then
		settle=0
		while [ ! -e "$directory/accepted" ] && [ "$settle" -lt 50 ]; do
			sleep 0.01
			settle=$((settle + 1))
		done
		if [ ! -e "$directory/accepted" ]; then
			_ok "attempt $attempt stopped before a socket connected"
			kill "$fixture_pid" 2>/dev/null || true
		elif wait_for_file "$directory/eof"; then
			_ok "attempt $attempt cancelled and released the connected socket"
		else
			_fail "attempt $attempt left the worker socket open"
			kill "$fixture_pid" 2>/dev/null || true
		fi
		wait "$fixture_pid" 2>/dev/null || true
	fi
	attempt=$((attempt + 1))
done

summary
