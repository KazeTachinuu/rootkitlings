#!/bin/sh
. /vm/checks/lib.sh

begin "35-sysfs-artifact"

load hello.ko
assert_exists /proc/rk_sysfs
assert_exists /sys/kernel/rk_marker/status
assert_read /proc/rk_sysfs "visible=yes"
assert_read /sys/kernel/rk_marker/status "visible"

printf hide >/proc/rk_sysfs
assert_read /proc/rk_sysfs "visible=no"
assert_absent /sys/kernel/rk_marker

if printf hide >/proc/rk_sysfs 2>/dev/null; then
    _fail "repeated hide accepted"
else
    _ok "repeated hide rejected"
fi
assert_read /proc/rk_sysfs "visible=no"

if printf unknown >/proc/rk_sysfs 2>/dev/null; then
    _fail "unknown command accepted"
else
    _ok "unknown command rejected"
fi
assert_read /proc/rk_sysfs "visible=no"

printf show >/proc/rk_sysfs
assert_read /proc/rk_sysfs "visible=yes"
assert_read /sys/kernel/rk_marker/status "visible"

if printf show >/proc/rk_sysfs 2>/dev/null; then
    _fail "repeated show accepted"
else
    _ok "repeated show rejected"
fi

unload hello
assert_absent /proc/rk_sysfs
assert_absent /sys/kernel/rk_marker
summary
