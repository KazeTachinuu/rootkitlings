#!/bin/sh
. /vm/checks/lib.sh

begin "26-credential-escalation"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_escalate

invalid=$(run_as 65534 65534 sh -c '
    printf evil > /proc/rk_escalate 2>/dev/null || true
    cat /proc/rk_escalate
')
if [ "$invalid" = "uid=65534" ]; then
    _ok "an unrelated command does not change credentials"
else
    _fail "invalid command changed credentials: '$invalid'"
fi

# commit_creds() changes this child shell, not the root check process.
# shellcheck disable=SC2016 # The single-quoted program expands in the guest shell.
result=$(run_as 65534 65534 sh -c '
    before=$(cat /proc/rk_escalate) || exit
    printf escalate > /proc/rk_escalate || exit
    after=$(cat /proc/rk_escalate) || exit
    printf "%s;%s\n" "$before" "$after"
')
if [ "$result" = "uid=65534;uid=0" ]; then
    _ok "caller changed from uid=65534 to uid=0"
else
    _fail "expected uid=65534;uid=0, got '$result'"
fi

unload hello
assert_absent /proc/rk_escalate

summary
