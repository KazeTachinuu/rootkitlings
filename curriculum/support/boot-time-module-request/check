#!/bin/sh
. /vm/checks/lib.sh

begin "8-boot-persistence"

path=/etc/modules-load.d/hello.conf
mkdir -p /etc/modules-load.d
printf 'operator-owned' >"$path"

load hello.ko
assert_contains /proc/rk_boot "state=foreign"

if printf install >/proc/rk_boot 2>/dev/null; then
    _fail "install overwrote a pre-existing path"
else
    _ok "install refuses a pre-existing path"
fi
assert_read "$path" "operator-owned"

if printf remove >/proc/rk_boot 2>/dev/null; then
    _fail "remove accepted foreign content"
else
    _ok "remove refuses foreign content"
fi
assert_read "$path" "operator-owned"
unload hello
assert_absent /proc/rk_boot

rm -f "$path"
load hello.ko
assert_contains /proc/rk_boot "state=absent"
if printf install >/proc/rk_boot; then
    _ok "install transaction succeeded"
else
    _fail "install transaction failed"
fi

bytes=$(wc -c <"$path")
content=$(cat "$path")
if [ "$bytes" -eq 6 ] && [ "$content" = hello ]; then
    _ok "request contains exactly hello plus newline"
else
    _fail "request bytes are not exactly hello plus newline"
fi
assert_contains /proc/rk_boot "state=installed"

unload hello
assert_absent /proc/rk_boot
if [ -f "$path" ]; then
    _ok "request survives module unload"
else
    _fail "request disappeared during module unload"
fi

load hello.ko
assert_contains /proc/rk_boot "state=installed"
if printf remove >/proc/rk_boot; then
    _ok "owned request removed explicitly"
else
    _fail "owned request could not be removed"
fi
if [ -e "$path" ]; then
    _fail "request remains after remove"
else
    _ok "request absent after remove"
fi

unload hello
assert_absent /proc/rk_boot
summary
