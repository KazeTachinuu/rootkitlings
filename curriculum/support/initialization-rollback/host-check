#!/usr/bin/bash
set -Eeuo pipefail

source_file=${1:?usage: host-check BUILD_DIR}/hello.c

awk '
	/goto free_primary;/ { saw_goto = 1 }
	/^free_primary:/ { saw_label = 1 }
	saw_label && /kfree\(primary\)/ { saw_free = 1 }
	saw_free && /return err;/ { saw_return = 1 }
	END { exit !(saw_goto && saw_label && saw_free && saw_return) }
' "$source_file" || {
	printf '[x] expected failure path: goto label, kfree(primary), return err\n' >&2
	exit 1
}

printf '[+] rollback path releases primary before returning the error\n'
