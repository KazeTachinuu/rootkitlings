#!/bin/sh
. /vm/checks/lib.sh

begin "31-fprobe"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_fprobe

before=$(cat /proc/rk_fprobe)
before_reads=$(printf '%s\n' "$before" | sed -n 's/^reads=//p')
before_opens=$(printf '%s\n' "$before" | sed -n 's/^opens=//p')
printf field-note >/tmp/rk_fprobe_io
after_open=$(cat /proc/rk_fprobe)
after_opens=$(printf '%s\n' "$after_open" | sed -n 's/^opens=//p')

if [ "$after_opens" -gt "$before_opens" ] 2>/dev/null; then
	_ok "fprobe attributed do_sys_openat2: $before_opens -> $after_opens"
else
	_fail "do_sys_openat2 counter did not increase: $before_opens -> $after_opens"
fi

cat /tmp/rk_fprobe_io >/dev/null
after_read=$(cat /proc/rk_fprobe)
after_reads=$(printf '%s\n' "$after_read" | sed -n 's/^reads=//p')

if [ "$after_reads" -gt "$before_reads" ] 2>/dev/null; then
	_ok "fprobe attributed vfs_read: $before_reads -> $after_reads"
else
	_fail "vfs_read counter did not increase: $before_reads -> $after_reads"
fi

assert_contains /proc/rk_fprobe "missed="

unload hello
assert_absent /proc/rk_fprobe
rm -f /tmp/rk_fprobe_io

summary
