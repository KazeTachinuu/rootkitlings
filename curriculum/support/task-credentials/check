#!/bin/sh
. /vm/checks/lib.sh

begin "25-credentials"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_creds

# The same callback must follow the credentials of two different readers.
root_creds=$(cat /proc/rk_creds)
if [ "$root_creds" = "uid=0 gid=0" ]; then
    _ok "root reader reported as uid=0 gid=0"
else
    _fail "unexpected root credentials: '$root_creds'"
fi

unpriv_creds=$(run_as 65534 65534 cat /proc/rk_creds)
if [ "$unpriv_creds" = "uid=65534 gid=65534" ]; then
    _ok "unprivileged reader reported as uid=65534 gid=65534"
else
    _fail "unexpected unprivileged credentials: '$unpriv_creds'"
fi

unload hello
assert_absent /proc/rk_creds

summary
