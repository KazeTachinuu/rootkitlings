#!/usr/bin/bash
set -Eeuo pipefail

(( $# == 2 )) || { printf '[x] usage: host-check BUILD_DIR ARTIFACT_PATH\n' >&2; exit 2; }
build=$1
module=$2

[[ -d $build && -f $module && ! -L $module ]] || {
	printf '[x] module artifact is missing: %s\n' "$module" >&2
	exit 1
}

if strings "$module" | grep -Fqx 'rootkit secret data'; then
	printf '[x] plaintext is embedded in the module artifact\n' >&2
	exit 1
fi

printf '[+] plaintext is absent from printable module strings\n'
