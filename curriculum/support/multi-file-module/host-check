#!/usr/bin/bash
set -Eeuo pipefail

(( $# == 2 )) || { printf '[x] usage: host-check BUILD_DIR ARTIFACT_PATH\n' >&2; exit 2; }
build=$1
module=$2

fail()
{
	printf '[x] %s\n' "$*" >&2
	exit 1
}

[[ -d $build && -f $module && ! -L $module ]] ||
	fail 'build directory and module artifact must be regular paths'

[[ -f $build/main.c ]] || fail 'main.c is missing'
[[ -f $build/calc.c ]] || fail 'calc.c is missing'
[[ -f $build/calc.h ]] || fail 'calc.h is missing'
[[ -f $build/Kbuild ]] || fail 'Kbuild is missing'

nm "$module" | grep -Eq '[[:space:]]T[[:space:]]+rk_add$' ||
	fail 'module artifact does not contain rk_add from calc.c'
nm "$module" | grep -Eq '[[:space:]]T[[:space:]]+rk_mul$' ||
	fail 'module artifact does not contain rk_mul from calc.c'

printf '[+] multi-file structure verified\n'
