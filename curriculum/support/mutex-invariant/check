#!/bin/sh
. /vm/checks/lib.sh

begin "22-mutex"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_mutex

# Observe the completion condition instead of guessing a scheduler delay.
i=0
while [ "$i" -lt 20 ]; do
    [ "$(cat /proc/rk_mutex)" = 20000 ] && break
    sleep 0.1
    i=$((i + 1))
done

assert_read /proc/rk_mutex "20000"

unload hello
assert_absent /proc/rk_mutex

summary
