#!/bin/sh
. /vm/checks/lib.sh

begin "11-proc-write"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_store

assert_read /proc/rk_store "hello"

# Write a value, read it back
printf '%s' "phantom" > /proc/rk_store
assert_read /proc/rk_store "phantom"

# Overwrite with another value
printf '%s' "specter" > /proc/rk_store
assert_read /proc/rk_store "specter"

if printf 'safe\0forged' > /proc/rk_store 2>/dev/null; then
    _fail "accepted an embedded NUL"
else
    _ok "embedded NUL rejected"
fi
assert_read /proc/rk_store "specter"

oversized=1234567890123456789012345678901234567890123456789012345678901234
if printf '%s' "$oversized" > /proc/rk_store 2>/dev/null; then
    _fail "accepted a 64-byte message without room for a terminator"
else
    _ok "oversized message rejected"
fi
assert_read /proc/rk_store "specter"

unload hello
assert_absent /proc/rk_store

summary
