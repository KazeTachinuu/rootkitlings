#!/bin/sh
. /vm/checks/lib.sh

begin "52-hmac"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_hmac
assert_contains /proc/rk_hmac "message=Hi There"
assert_contains /proc/rk_hmac "tag=b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"

message="command=test"
printf '%s' "$message" > /proc/rk_hmac
assert_contains /proc/rk_hmac "message=$message"
after=$(sed -n 's/^tag=//p' /proc/rk_hmac)
if [ "$after" = "fef31c32f1c026aed366f6458ee649707e94d985b3e9e55d6528ecab11d8682f" ]; then
    _ok "updated message has the expected HMAC-SHA-256 tag"
else
    _fail "unexpected updated tag: $after"
fi

before=$(cat /proc/rk_hmac)
if printf 'command\0forged' > /proc/rk_hmac 2>/dev/null; then
    _fail "embedded NUL accepted"
else
    _ok "embedded NUL rejected"
fi
assert_read /proc/rk_hmac "$before"

unload hello
assert_absent /proc/rk_hmac
summary
