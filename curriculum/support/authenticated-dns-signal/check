#!/bin/sh
. /vm/checks/lib.sh

byte_at()
{
    od -An -tu1 -j "$2" -N 1 "$1" | tr -d ' '
}

text_at()
{
    dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null
}

hmac_tag()
{
    key_hex=$(printf %s rootkitlings-dns-lab | xxd -p | tr -d '\n')
    inner_pad=
    outer_pad=
    index=0
    while [ "$index" -lt 64 ]; do
        position=$((index * 2))
        if [ "$position" -lt "${#key_hex}" ]; then
            byte=${key_hex:$position:2}
        else
            byte=00
        fi
        inner_pad="$inner_pad$(printf '%02x' $((0x$byte ^ 0x36)))"
        outer_pad="$outer_pad$(printf '%02x' $((0x$byte ^ 0x5c)))"
        index=$((index + 1))
    done
    inner=$(
        { printf %s "$inner_pad" | xxd -r -p; printf %s "$1"; } |
            sha256sum | cut -d ' ' -f 1
    )
    {
        printf %s "$outer_pad" | xxd -r -p
        printf %s "$inner" | xxd -r -p
    } | sha256sum | cut -c 1-16
}

begin "9-dns-c2"

ifconfig lo 127.0.0.1 up 2>/dev/null
capture=/tmp/dns-query
nc -u -l -p 5300 -s 127.0.0.1 >"$capture" 2>/dev/null &
listener=$!
sleep 0.2

load hello.ko bucket=20000
assert_loaded hello
assert_exists /proc/rk_dns_c2

signal="task-$$-$(date +%s)"
expected_tag=$(hmac_tag "$signal")
expected_campaign=6f158b1adc32cad8
if printf %s "$signal" >/proc/rk_dns_c2; then
    _ok "runtime signal sent"
else
    _fail "runtime signal rejected"
fi

attempt=0
while [ "$attempt" -lt 30 ] && [ ! -s "$capture" ]; do
    sleep 0.1
    attempt=$((attempt + 1))
done
kill "$listener" 2>/dev/null || true
wait "$listener" 2>/dev/null || true

offset=12
signal_length=$(byte_at "$capture" "$offset")
offset=$((offset + 1))
wire_signal=$(text_at "$capture" "$offset" "$signal_length")
offset=$((offset + signal_length))

tag_length=$(byte_at "$capture" "$offset")
offset=$((offset + 1))
wire_tag=$(text_at "$capture" "$offset" "$tag_length")
offset=$((offset + tag_length))

campaign_length=$(byte_at "$capture" "$offset")
offset=$((offset + 1))
wire_campaign=$(text_at "$capture" "$offset" "$campaign_length")
offset=$((offset + campaign_length))

suffix_length=$(byte_at "$capture" "$offset")
offset=$((offset + 1))
wire_suffix=$(text_at "$capture" "$offset" "$suffix_length")
offset=$((offset + suffix_length))

if [ "$wire_signal" = "$signal" ]; then
    _ok "runtime signal decoded from QNAME"
else
    _fail "decoded signal differs from runtime input"
fi
if [ "$tag_length" -eq 16 ] && [ "$wire_tag" = "$expected_tag" ]; then
    _ok "HMAC tag independently verified"
else
    _fail "invalid HMAC tag: $wire_tag"
fi
if [ "$campaign_length" -eq 16 ] && \
   [ "$wire_campaign" = "$expected_campaign" ]; then
    _ok "campaign label matches bucket 20000"
else
    _fail "invalid campaign label: $wire_campaign"
fi
if [ "$wire_suffix" = example ]; then
    _ok "reserved suffix decoded"
else
    _fail "invalid suffix: $wire_suffix"
fi

header_tail=$(dd if="$capture" bs=1 skip=2 count=10 2>/dev/null | xxd -p)
if [ "$header_tail" = 01000001000000000000 ]; then
    _ok "DNS header requests exactly one recursive question"
else
    _fail "invalid DNS header: $header_tail"
fi
question_tail=$(dd if="$capture" bs=1 skip="$offset" count=5 \
    2>/dev/null | xxd -p)
if [ "$question_tail" = 0000100001 ]; then
    _ok "question terminates with TXT class IN"
else
    _fail "invalid question tail: $question_tail"
fi

sent=$(sed -n 's/^sent=//p' /proc/rk_dns_c2)
captured=$(wc -c <"$capture")
if [ "$sent" -eq "$captured" ]; then
    _ok "reported send length equals captured datagram"
else
    _fail "sent=$sent but captured=$captured"
fi

packet_id_hex=$(dd if="$capture" bs=1 count=2 2>/dev/null | xxd -p)
packet_id=$((0x$packet_id_hex))
assert_contains /proc/rk_dns_c2 "id=$packet_id"
assert_contains /proc/rk_dns_c2 \
    "query=$signal.$expected_tag.$expected_campaign.example"

status_before=$(cat /proc/rk_dns_c2)
for invalid in '-leading' 'trailing-' 'bad_label'; do
    if printf %s "$invalid" >/proc/rk_dns_c2 2>/dev/null; then
        _fail "invalid label accepted: $invalid"
    else
        _ok "invalid label rejected: $invalid"
    fi
done
overlong=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
if printf %s "$overlong" >/proc/rk_dns_c2 2>/dev/null; then
    _fail "64-byte label accepted"
else
    _ok "64-byte label rejected"
fi
status_after=$(cat /proc/rk_dns_c2)
if [ "$status_after" = "$status_before" ]; then
    _ok "rejected input leaves status unchanged"
else
    _fail "rejected input changed committed status"
fi

unload hello
assert_absent /proc/rk_dns_c2
rm -f "$capture"
summary
