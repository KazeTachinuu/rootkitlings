#!/usr/bin/bash
set -Eeuo pipefail

(( $# == 2 )) || { printf '[x] usage: host-check BUILD_DIR ARTIFACT_PATH\n' >&2; exit 2; }
build=$1
module=$2
[[ -d $build && -f $module && ! -L $module ]] || {
	printf '[x] build directory and module artifact must be regular paths\n' >&2
	exit 2
}

nm "$module" | grep -Eq '[[:space:]]t[[:space:]]+checksum$' || {
	printf '[x] checksum is not available as a local module symbol\n' >&2
	exit 1
}

readelf -S "$module" | grep -q '\.debug_info' || {
	printf '[x] module has no GDB debug information\n' >&2
	exit 1
}

printf '[+] checksum symbol and debug information verified\n'
