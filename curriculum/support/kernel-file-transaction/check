#!/bin/sh
. /vm/checks/lib.sh

begin "48-kernel-file-io"

# Create content that cannot be reproduced from a fixed reference fixture.
token="clean_$$_$(date +%s)"
original=$(printf '#!/bin/sh\nprintf %%s %s\n' "$token")
printf '%s\n' "$original" > /tmp/rk_victim.sh
chmod 755 /tmp/rk_victim.sh

# Verify it runs clean
clean=$(/tmp/rk_victim.sh)
if [ "$clean" = "$token" ]; then
    _ok "victim script runs clean"
else
    _fail "victim script broken before edit"
fi

load hello.ko
assert_loaded hello
assert_exists /proc/rk_infect

# Module should prepend exactly one line and preserve every original byte.
content=$(cat /tmp/rk_victim.sh)
expected=$(printf '# inspection marker\n%s' "$original")
if [ "$content" = "$expected" ]; then
    _ok "marker prepended and original bytes preserved"
else
    _fail "edited content differs from expected"
fi

assert_contains /proc/rk_infect "infected=yes"
assert_contains /proc/rk_infect "target=/tmp/rk_victim.sh"

unload hello
assert_absent /proc/rk_infect

# After unload, module should restore the original file
restored=$(cat /tmp/rk_victim.sh)
if [ "$restored" = "$original" ]; then
    _ok "original content restored byte-for-byte"
else
    _fail "restored content differs from original"
fi

# A later writer owns its change; unload must not overwrite it with stale data.
load hello.ko
printf '%s\n' '# external change' >> /tmp/rk_victim.sh
assert_contains /proc/rk_infect "infected=changed"
changed=$(cat /tmp/rk_victim.sh)
unload hello
after_refusal=$(cat /tmp/rk_victim.sh)
if [ "$after_refusal" = "$changed" ]; then
    _ok "cleanup preserved a newer external change"
else
    _fail "cleanup overwrote a newer external change"
fi

rm -f /tmp/rk_victim.sh

summary
