#!/bin/sh
. /lib/check.sh

begin "23-waiting"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_gate

assert_read /proc/rk_gate "0"

if printf wrong >/proc/rk_gate 2>/dev/null; then
    _fail "unknown command accepted"
else
    _ok "unknown command rejected"
fi
if printf 'wakewakewakewake' >/proc/rk_gate 2>/dev/null; then
    _fail "oversized command accepted"
else
    _ok "oversized command rejected"
fi
assert_read /proc/rk_gate "0"

printf '%s' "wake" > /proc/rk_gate
sleep 1
assert_read /proc/rk_gate "1"

printf '%s' "wake" > /proc/rk_gate
sleep 1
assert_read /proc/rk_gate "2"

unload hello
assert_absent /proc/rk_gate

summary
