#!/bin/sh
. /vm/checks/lib.sh

begin "37-file-content"

token="context_$$_$(date +%s)"
original="$token SECRET data and another SECRET here"
expected="$token XXXXXX data and another XXXXXX here"
printf '%s\n' "$original" > /tmp/rk_target
mkdir -p /tmp/other
printf '%s\n' 'other SECRET' > /tmp/other/rk_target

load hello.ko
assert_loaded hello
assert_exists /proc/rk_content

# Read the target file via read() syscall (not sendfile)
# BusyBox cat uses sendfile which bypasses sys_read hooks
content=$(dd if=/tmp/rk_target bs=4096 count=1 2>/dev/null)
if [ "$content" = "$expected" ]; then
    _ok "both matches redacted and every surrounding byte preserved"
else
    _fail "expected '$expected', got '$content'"
fi

other=$(dd if=/tmp/other/rk_target bs=4096 count=1 2>/dev/null)
if [ "$other" = "other SECRET" ]; then
    _ok "same basename on another inode is untouched"
else
    _fail "unrelated same-name file was filtered: '$other'"
fi

# Check redaction counter
assert_contains /proc/rk_content "redactions="
count=$(cat /proc/rk_content | sed -n 's/^redactions=//p')
if [ "$count" -gt 0 ] 2>/dev/null; then
    _ok "redaction counter = $count"
else
    _fail "redaction counter not incremented ($count)"
fi

unload hello
assert_absent /proc/rk_content

# After unload, file should read normally again
content_after=$(dd if=/tmp/rk_target bs=4096 count=1 2>/dev/null)
if [ "$content_after" = "$original" ]; then
    _ok "original view restored after unload"
else
    _fail "expected original '$original', got '$content_after'"
fi

rm -f /tmp/rk_target /tmp/other/rk_target
rmdir /tmp/other

summary
