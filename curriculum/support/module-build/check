#!/bin/sh
. /lib/check.sh

begin "01-build"

info=$(modinfo /rootkitlings/hello.ko 2>/dev/null)
case "$info" in
    *"license:        GPL"*) _ok "modinfo reads module metadata" ;;
    *) _fail "modinfo could not read hello.ko" ;;
esac

load hello.ko
assert_loaded hello

if [ -d /sys/module/hello/sections ]; then
    _ok "module sections present (valid ELF module)"
else
    _fail "module sections missing"
fi

assert_log "hello: loaded"

unload hello
assert_absent /sys/module/hello
assert_log "hello: unloaded"

summary
