#!/bin/sh
. /lib/check.sh

begin "24-current-task"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_task

# Capture the actual reader PID instead of accepting any string containing
# "pid". The callback runs in this background cat process.
cat /proc/rk_task > /tmp/rk_task.out &
reader_pid=$!
wait "$reader_pid"
content=$(cat /tmp/rk_task.out)
reported_pid=$(printf '%s\n' "$content" | sed -n 's/^pid=\([0-9]*\) comm=.*/\1/p')
reported_comm=$(printf '%s\n' "$content" | sed -n 's/^pid=[0-9]* comm=\(.*\)$/\1/p')
if [ "$reported_pid" = "$reader_pid" ]; then
    _ok "reported the actual reader PID $reader_pid"
else
    _fail "reader PID was $reader_pid, module reported '$reported_pid'"
fi

if [ "$reported_comm" = "cat" ]; then
    _ok "reported the reader command name"
else
    _fail "expected comm=cat, got '$reported_comm'"
fi

unload hello
assert_absent /proc/rk_task
rm -f /tmp/rk_task.out

summary
