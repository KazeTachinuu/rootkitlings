#!/bin/sh
. /vm/checks/lib.sh

begin "44-udp-redirect"

ifconfig lo 127.0.0.1 up 2>/dev/null

load hello.ko
assert_loaded hello
assert_exists /proc/rk_redirect

nc -l -u -p 9999 -s 127.0.0.1 > /tmp/redirect_recv &
NC_PID=$!
sleep 1

token="redirect_$$_$(date +%s)"
printf '%s' "$token" | nc -u -w 1 127.0.0.1 7777 2>/dev/null || true
sleep 1

# Check whether the redirected packet arrived at 9999.
kill $NC_PID 2>/dev/null; wait $NC_PID 2>/dev/null
recv=$(cat /tmp/redirect_recv 2>/dev/null)
if [ "$recv" = "$token" ]; then
    _ok "exact UDP payload redirected to port 9999"
else
    _fail "expected '$token', got '$recv'"
fi

redirected=$(sed -n 's/^redirected=//p' /proc/rk_redirect)
if [ "$redirected" -gt 0 ] 2>/dev/null; then
    _ok "redirect counter = $redirected"
else
    _fail "redirect counter not incremented ($redirected)"
fi

assert_contains /proc/rk_redirect "redirect_port=9999"

nc -l -u -p 8888 -s 127.0.0.1 > /tmp/passthrough_recv &
NC_PID=$!
sleep 1
passthrough="passthrough_$$_$(date +%s)"
printf '%s' "$passthrough" | nc -u -w 1 127.0.0.1 8888 2>/dev/null || true
sleep 1
kill $NC_PID 2>/dev/null; wait $NC_PID 2>/dev/null
recv=$(cat /tmp/passthrough_recv 2>/dev/null)
if [ "$recv" = "$passthrough" ]; then
    _ok "unmatched UDP destination passed through"
else
    _fail "unmatched UDP payload changed or lost: '$recv'"
fi

after_passthrough=$(sed -n 's/^redirected=//p' /proc/rk_redirect)
if [ "$after_passthrough" = "$redirected" ]; then
    _ok "unmatched packet did not increment redirect counter"
else
    _fail "redirect counter changed for unmatched packet: $redirected -> $after_passthrough"
fi

unload hello
assert_absent /proc/rk_redirect

rm -f /tmp/redirect_recv /tmp/passthrough_recv

summary
