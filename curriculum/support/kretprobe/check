#!/bin/sh
. /lib/check.sh

begin "30-kretprobe"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_retprobe

# Record a baseline, then make one successful vfs_read and one that reaches
# vfs_read but returns -EISDIR. Opening a nonexistent path would fail before
# vfs_read and would not test the return probe.
baseline=$(cat /proc/rk_retprobe)
before_success=$(printf '%s\n' "$baseline" | sed -n 's/.*success=\([0-9]*\).*/\1/p')
before_failed=$(printf '%s\n' "$baseline" | sed -n 's/.*failed=\([0-9]*\).*/\1/p')
cat /etc/passwd > /dev/null
cat /proc > /dev/null 2>&1 || true

assert_contains /proc/rk_retprobe "success="
assert_contains /proc/rk_retprobe "failed="

stats=$(cat /proc/rk_retprobe)
success=$(printf '%s\n' "$stats" | sed -n 's/.*success=\([0-9]*\).*/\1/p')
failed=$(printf '%s\n' "$stats" | sed -n 's/.*failed=\([0-9]*\).*/\1/p')
if [ "$success" -gt "$before_success" ] 2>/dev/null; then
    _ok "successful read observed ($before_success -> $success)"
else
    _fail "successful read counter did not increase"
fi
if [ "$failed" -gt "$before_failed" ] 2>/dev/null; then
    _ok "failed read observed ($before_failed -> $failed)"
else
    _fail "failed read counter did not increase"
fi

unload hello
assert_absent /proc/rk_retprobe

summary
