#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
expect_allocation=${3:-@EXPECT_ALLOCATION@}
begin "$label"

kmem_trace_setup

for attempt in 1 2; do
	kmem_trace_start
	if module_load_test /rootkitlings/rootkitlings.ko "$expected_errno"; then
		_ok "attempt $attempt returns errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong result"
	fi
	kmem_trace_stop
	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	assert_absent /proc/rootkitlings_events
	if grep -q '__x64_sys_rmdir' /sys/kernel/debug/kprobes/list; then
		_fail "attempt $attempt left the rmdir probe registered"
	else
		_ok "attempt $attempt leaves no rmdir probe"
	fi
	worker=0
	for comm in /proc/[0-9]*/comm; do
		test -r "$comm" || continue
		test "$(cat "$comm")" = rkling_core && worker=$((worker + 1))
	done
	if test "$worker" -eq 0; then
		_ok "attempt $attempt leaves no worker"
	else
		_fail "attempt $attempt left a worker"
	fi
	if test "$expect_allocation" -eq 1; then
		assert_one_loader_allocation_freed \
			"attempt $attempt frees its state allocation"
	fi
done

kmem_trace_disable
kmem_trace_restore

summary
