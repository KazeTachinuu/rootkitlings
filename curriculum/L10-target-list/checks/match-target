#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Match returns true for listed names"

load rklings.ko

# The match function is internal (not directly testable from userspace),
# but we verify the proc interface stores and retrieves names exactly.

# Add targets with special characters in names
printf 'add secret.txt' > /proc/rklings
printf 'add .hidden' > /proc/rklings
printf 'add my_process' > /proc/rklings

content=$(cat /proc/rklings)
case "$content" in
    *secret.txt*) _ok "secret.txt is listed" ;;
    *) _fail "secret.txt not found in listing" ;;
esac
case "$content" in
    *.hidden*) _ok ".hidden is listed" ;;
    *) _fail ".hidden not found in listing" ;;
esac
case "$content" in
    *my_process*) _ok "my_process is listed" ;;
    *) _fail "my_process not found in listing" ;;
esac

# Verify exact line-by-line output
expected="secret.txt
.hidden
my_process"
if [ "$content" = "$expected" ]; then
    _ok "exact line-by-line ordering preserved"
else
    _fail "ordering mismatch: expected 3 lines in order, got '$content'"
fi

# Test load/unload cycle preserves nothing (fresh state)
unload rklings
load rklings.ko
content=$(cat /proc/rklings)
if [ -z "$content" ]; then
    _ok "target list is empty after reload"
else
    _fail "expected empty after reload, got '$content'"
fi

unload rklings

summary
