#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Bounded IPv4 parser"

assert_absent /sys/module/rklings
load rklings.ko
assert_loaded rklings
assert_param rklings parser_selftest Y
assert_log "rklings: IPv4 parser self-tests passed: 14 assertions"
if grep -q '^rklings ' /proc/modules; then
	_ok "module appears in /proc/modules"
else
	_fail "module is absent from /proc/modules"
fi
unload rklings
assert_absent /sys/module/rklings
if grep -q '^rklings ' /proc/modules; then
	_fail "module remains in /proc/modules"
else
	_ok "module left /proc/modules"
fi

summary
