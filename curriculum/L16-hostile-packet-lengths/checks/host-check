#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) ||
	die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

for relative in Kbuild main.c main.o include/ipv4_parser.h parser/ipv4.c \
		parser/ipv4.o; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done
[[ -f $module && ! -L $module ]] || die "module must be a regular file"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-ipv4-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
compiler=${CC:-gcc}
command -v "$compiler" >/dev/null || die "$compiler is required"

"$compiler" -std=c11 -Wall -Wextra -Werror -pedantic \
	-fsanitize=address,undefined -fno-omit-frame-pointer -g \
	-I "$build_dir/include" \
	"$here/../fixtures/host/parser_test.c" "$build_dir/parser/ipv4.c" \
	-o "$scratch/parser-test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
	"$scratch/parser-test"

nm "$build_dir/parser/ipv4.o" |
	grep -Eq '[[:space:]]T[[:space:]]rk_parse_ipv4$' ||
	die "parser object does not define rk_parse_ipv4"
nm "$module" | grep -Eq '[[:space:]][Tt][[:space:]]rk_parse_ipv4$' ||
	die "module does not contain rk_parse_ipv4"
nm -u "$build_dir/main.o" |
	grep -Eq '[[:space:]]U[[:space:]]rk_parse_ipv4$' ||
	die "kernel self-test does not call rk_parse_ipv4"
strings "$module" |
	grep -Fq 'rootkitlings: IPv4 parser self-tests passed: %u assertions' ||
	die "module does not report its kernel self-test result"

printf '[+] host corpus and kernel self-test wiring verified\n'
