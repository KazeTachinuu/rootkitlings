#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "File download: chunked transfer over TCP"

ifconfig lo 127.0.0.1 up

# Create a test file with known content
TEST_FILE="/tmp/rklings-download-test.txt"
RECV_FILE="/tmp/rklings-download-recv.bin"
printf "rootkitlings-test-content-12345\n" > "$TEST_FILE"

# Start a TCP listener that captures received data.
# The module connects to peer_port and sends length-prefixed frames.
nc -l -p 4444 > "$RECV_FILE" &
NC_PID=$!
sleep 1

# Load module with target_file pointing to our test file
load rklings.ko target_file="$TEST_FILE"

# Give the transfer time to complete
sleep 2

# The module connects, sends framed data, then disconnects.
# nc should have exited after the connection closed.
wait $NC_PID 2>/dev/null

# Verify we received data
if [ -s "$RECV_FILE" ]; then
  _ok "received data from module"
else
  _fail "no data received from module"
fi

# The received data contains length-prefixed frames.
# The file content should appear somewhere in the binary stream.
if grep -q "rootkitlings-test-content-12345" "$RECV_FILE"; then
  _ok "received data contains expected file content"
else
  _fail "received data does not contain expected file content"
fi

# Module should still be loaded after download
assert_loaded rklings

unload rklings
assert_absent /sys/module/rklings

# Cleanup
rm -f "$TEST_FILE" "$RECV_FILE"

summary
