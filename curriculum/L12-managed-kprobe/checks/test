#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
baseline=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-managed-kprobe-baseline.XXXXXX")
work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-managed-kprobe-work.XXXXXX")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-managed-kprobe-test.XXXXXX")
trap 'rm -rf -- "$baseline" "$work" "$scratch"' EXIT

cp -a "$HERE/../../L02-owned-kernel-state/solution/." "$baseline/"
cp -a "$HERE/../../L03-proc-publication/solution/." "$baseline/"
cp -a "$HERE/../../L04-proc-read-contract/solution/." "$baseline/"
cp -a "$HERE/../../L05-bounded-control-switch/solution/." "$baseline/"
cp -a "$baseline/." "$work/"
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../starter/"}
	mkdir -p "$work/$(dirname "$relative")"
	cp -p "$source" "$work/$relative"
done < <(find "$HERE/../starter" -type f -print0)
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../solution/"}
	mkdir -p "$work/$(dirname "$relative")"
	cp -p "$source" "$work/$relative"
done < <(find "$HERE/../solution" -type f -print0)

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
for option in X86_64 IKCONFIG_PROC KPROBES KPROBES_ON_FTRACE OPTPROBES \
	KALLSYMS KALLSYMS_ALL DEBUG_FS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] this lesson requires CONFIG_%s=y\n' "$option" >&2
		exit 1
	}
done

symvers=$KDIR/Module.symvers
[[ -f $symvers ]] || {
	printf '[x] kernel export manifest not found: %s\n' "$symvers" >&2
	exit 1
}
awk '$2 == "vfs_mkdir" && $4 == "EXPORT_SYMBOL" { found = 1 }
	END { exit !found }' "$symvers" || {
	printf '[x] pinned kernel must export vfs_mkdir\n' >&2
	exit 1
}
if awk '$2 == "filename_rmdir" { found = 1 } END { exit !found }' \
	"$symvers"; then
	printf '[x] filename_rmdir unexpectedly appears in the module export manifest\n' >&2
	exit 1
fi
for symbol in register_kprobes unregister_kprobes; do
	awk -v symbol="$symbol" '$2 == symbol && $4 == "EXPORT_SYMBOL_GPL" {
		found = 1
	} END { exit !found }' "$symvers" || {
		printf '[x] pinned kernel must GPL-export %s\n' "$symbol" >&2
		exit 1
	}
done
for symbol in vfs_mkdir filename_rmdir; do
	awk -v symbol="$symbol" '$3 == symbol { found = 1 }
		END { exit !found }' /proc/kallsyms || {
		printf '[x] running kernel lacks target symbol %s\n' "$symbol" >&2
		exit 1
	}
done
if grep -q '[[:space:]]__rootkitlings_missing_kprobe_target_7_2__$' \
	/proc/kallsyms; then
	printf '[x] injected missing Kprobe target exists in the running kernel\n' >&2
	exit 1
fi

mapfile -t changed_files < <(
	diff -qr "$HERE/../starter" "$HERE/../solution" |
		sed -nE 's#^Files .*/starter/(.*) and .*/solution/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == instrumentation/probes.c ]] || {
	printf '[x] learner edit surface is %s, expected instrumentation/probes.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

template_build=$scratch/starter
cp -a "$baseline" "$template_build"
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../starter/"}
	mkdir -p "$template_build/$(dirname "$relative")"
	cp -p "$source" "$template_build/$relative"
done < <(find "$HERE/../starter" -type f -print0)
if ! make -s -C "$KDIR" M="$template_build" W=1 \
	ROOTKITLINGS_FAIL_POINT=0 modules >"$scratch/template.log" 2>&1; then
	cat "$scratch/template.log" >&2
	printf '[x] template build failed\n' >&2
	exit 1
fi
if grep -q 'warning:' "$scratch/template.log"; then
	cat "$scratch/template.log" >&2
	printf '[x] template builds with warnings\n' >&2
	exit 1
fi

build_variant()
{
	local name=$1 point=$2 destination=$scratch/$1 log=$scratch/$1.log
	cp -a "$work" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules >"$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s builds with warnings\n' "$name" >&2
		exit 1
	fi
}

build_variant success 0
build_variant preflight 1
build_variant allocation 2
build_variant publication 3
build_variant missing 4
"$HERE/host-check" "$scratch/success" \
	"$scratch/success/rootkitlings.ko" "$scratch/missing"

rebuild_host_fixture()
{
	local directory=$1 label=$2 log=$scratch/host-$2-build.log

	if ! make -s -C "$KDIR" M="$directory" W=1 \
		ROOTKITLINGS_FAIL_POINT=0 modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s fixture did not build\n' "$label" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s fixture builds with warnings\n' "$label" >&2
		exit 1
	fi
}

expect_host_rejection()
{
	local directory=$1 label=$2

	if "$HERE/host-check" "$directory" "$directory/rootkitlings.ko" \
		"$scratch/missing" > "$scratch/host-$label.log" 2>&1; then
		printf '[x] host checker accepted %s\n' "$label" >&2
		exit 1
	fi
}

formatted=$scratch/host-formatting
cp -a "$scratch/success" "$formatted"
sed -i \
	-e 's/if (rk_state_actions_enabled(probe_state))/if ( rk_state_actions_enabled ( probe_state ) )/' \
	"$formatted/instrumentation/probes.c"
sed -i '/if ( rk_state_actions_enabled ( probe_state ) )/i\	/* Handler arguments are intentionally unused. */\
\t(void)probe;\
\t(void)registers;' "$formatted/instrumentation/probes.c"
awk '
	/probe_state = state;/ {
		print "\tprobe_state"
		print "\t\t= state;"
		next
	}
	/error = register_kprobes\(probes, ARRAY_SIZE\(probes\)\);/ {
		print "\terror = register_kprobes("
		print "\t\tprobes,"
		print "\t\tARRAY_SIZE(probes)"
		print "\t);"
		next
	}
	/unregister_kprobes\(probes, ARRAY_SIZE\(probes\)\);/ {
		print "\tunregister_kprobes("
		print "\t\tprobes,"
		print "\t\tARRAY_SIZE(probes)"
		print "\t);"
		next
	}
	{ print }
' "$formatted/instrumentation/probes.c" \
	> "$formatted/instrumentation/probes.c.new"
mv "$formatted/instrumentation/probes.c.new" \
	"$formatted/instrumentation/probes.c"
"$HERE/host-check" "$formatted" "$formatted/rootkitlings.ko" \
	"$scratch/missing" > "$scratch/host-formatting.log"

sleeping_handler=$scratch/host-sleeping-handler
cp -a "$scratch/success" "$sleeping_handler"
sed -i '/#include <linux\/errno.h>/a #include <linux/delay.h>' \
	"$sleeping_handler/instrumentation/probes.c"
sed -i '/if (rk_state_actions_enabled(probe_state))/i\	usleep_range(10, 20);' \
	"$sleeping_handler/instrumentation/probes.c"
rebuild_host_fixture "$sleeping_handler" sleeping-handler
expect_host_rejection "$sleeping_handler" a-sleeping-probe-handler

nonzero_handler=$scratch/host-nonzero-handler
cp -a "$scratch/success" "$nonzero_handler"
sed -i '/if (rk_state_actions_enabled(probe_state))/i\	if (probe != NULL)\
\t\treturn 1;' "$nonzero_handler/instrumentation/probes.c"
expect_host_rejection "$nonzero_handler" a-nonzero-handler-return

swapped_handlers=$scratch/host-swapped-handlers
cp -a "$scratch/success" "$swapped_handlers"
sed -i \
	-e 's/\.pre_handler = rk_vfs_mkdir_pre/.pre_handler = rk_swap_placeholder/' \
	-e 's/\.pre_handler = rk_filename_rmdir_pre/.pre_handler = rk_vfs_mkdir_pre/' \
	-e 's/\.pre_handler = rk_swap_placeholder/.pre_handler = rk_filename_rmdir_pre/' \
	"$swapped_handlers/instrumentation/probes.c"
expect_host_rejection "$swapped_handlers" swapped-probe-handlers

manual_rollback=$scratch/host-manual-rollback
cp -a "$scratch/success" "$manual_rollback"
sed -i '/#define RK_MISSING_TARGET/a #define RK_UNREGISTER unregister_kprobes' \
	"$manual_rollback/instrumentation/probes.c"
sed -i '/if (error)/c\	if (error) {\
\t\tRK_UNREGISTER(probes, 1);' \
	"$manual_rollback/instrumentation/probes.c"
sed -i '0,/probe_state = NULL;/s//probe_state = NULL;\
\t}/' "$manual_rollback/instrumentation/probes.c"
rebuild_host_fixture "$manual_rollback" manual-rollback
expect_host_rejection "$manual_rollback" manual-batch-rollback

address_alias=$scratch/host-address-alias
cp -a "$scratch/success" "$address_alias"
sed -i '/#define RK_MISSING_TARGET/a #define RK_ADDR addr' \
	"$address_alias/instrumentation/probes.c"
sed -i '/static struct rk_state \*probe_state;/a static kprobe_opcode_t *saved_address;' \
	"$address_alias/instrumentation/probes.c"
sed -i '/error = register_kprobes/a\	if (!error)\
\t\tWRITE_ONCE(saved_address, mkdir_probe.RK_ADDR);' \
	"$address_alias/instrumentation/probes.c"
rebuild_host_fixture "$address_alias" address-alias
expect_host_rejection "$address_alias" a-copied-probe-address

wrong_target=$scratch/host-wrong-target
cp -a "$scratch/success" "$wrong_target"
sed -i 's/"filename_rmdir"/"vfs_rmdir"/' \
	"$wrong_target/instrumentation/probes.c"
if "$HERE/host-check" "$wrong_target" "$wrong_target/rootkitlings.ko" \
	"$scratch/missing" > "$scratch/host-wrong-target.log" 2>&1; then
	printf '[x] host checker accepted the wrong internal target\n' >&2
	exit 1
fi

unconditional=$scratch/host-unconditional
cp -a "$scratch/success" "$unconditional"
sed -i '/if (rk_state_actions_enabled(probe_state))/d' \
	"$unconditional/instrumentation/probes.c"
if "$HERE/host-check" "$unconditional" "$unconditional/rootkitlings.ko" \
	"$scratch/missing" > "$scratch/host-unconditional.log" 2>&1; then
	printf '[x] host checker accepted unconditional handler observations\n' >&2
	exit 1
fi

ignored_switch=$scratch/host-ignored-switch
cp -a "$scratch/success" "$ignored_switch"
sed -i \
	's/if (rk_state_actions_enabled(probe_state))/rk_state_actions_enabled(probe_state);/' \
	"$ignored_switch/instrumentation/probes.c"
if "$HERE/host-check" "$ignored_switch" \
	"$ignored_switch/rootkitlings.ko" "$scratch/missing" \
	> "$scratch/host-ignored-switch.log" 2>&1; then
	printf '[x] host checker accepted handlers that ignore the action switch\n' >&2
	exit 1
fi

reset_flag=$scratch/host-reset-flag
cp -a "$scratch/success" "$reset_flag"
sed -i '/WRITE_ONCE(state->vfs_mkdir_seen, true);/a\
\tWRITE_ONCE(state->vfs_mkdir_seen, false);' \
	"$reset_flag/core/state.c"
if "$HERE/host-check" "$reset_flag" "$reset_flag/rootkitlings.ko" \
	"$scratch/missing" > "$scratch/host-reset-flag.log" 2>&1; then
	printf '[x] host checker accepted a non-monotonic observation flag\n' >&2
	exit 1
fi

cp -a "$work" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 \
	ROOTKITLINGS_FAIL_POINT=99 modules >"$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

sed -e 's/@EXPECTED_ERRNO@/12/g' \
	-e 's/@LABEL@/Probe cleanup after procfs publication failure/g' \
	"$HERE/probe-failure-check.in" > "$scratch/publication-check"
sed -e 's/@EXPECTED_ERRNO@/2/g' \
	-e 's/@LABEL@/Batch rollback after a missing second symbol/g' \
	"$HERE/probe-failure-check.in" > "$scratch/missing-check"
chmod 0755 "$scratch/publication-check" "$scratch/missing-check"

run_guest()
{
	local check_script=$1 module=$2 output
	shift 2
	if ! output=$("$HERE/../../../vm/boot" --check "$check_script" \
		--tool vm/tools/run_as "$@" \
		"$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest did not complete\n' >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/../../L03-proc-publication/checks/failure-ecanceled-check" \
	"$scratch/preflight/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/../../L03-proc-publication/checks/failure-enomem-check" \
	"$scratch/allocation/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$scratch/publication-check" \
	"$scratch/publication/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$scratch/missing-check" \
	"$scratch/missing/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/success-check" "$scratch/success/rootkitlings.ko" \
	--tool vm/tools/proc_write_test
