#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Current-task attribution"

assert_not_loaded()
{
	assert_absent /sys/module/rklings
	assert_absent /proc/rklings
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings appears in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
}

check_loaded()
{
	assert_loaded rklings
	assert_exists /proc/rklings
	mode=$(stat -c '%a' /proc/rklings)
	if [ "$mode" = 444 ]; then
		_ok "/proc/rklings mode is 0444"
	else
		_fail "/proc/rklings mode: expected 0444, got $mode"
	fi
	if grep -q '^rklings ' /proc/modules; then
		_ok "rklings appears in /proc/modules"
	else
		_fail "rklings is absent from /proc/modules"
	fi
}

assert_not_loaded
for attempt in 1 2; do
	load rklings.ko
	check_loaded
	if task_attribution_test /proc/rklings rklings; then
		_ok "attempt $attempt passed attribution, read, and unload checks"
	else
		_fail "attempt $attempt failed attribution, read, or unload checks"
	fi
	assert_not_loaded
done

summary
