#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Blocked root shell unload"
port=46124
capture=/tmp/rootkitlings-root-shell-unload
rm -f "$capture"
ifconfig lo 127.0.0.1 up

has_line()
{
	tr '\r' '\n' < "$1" | grep -Eq "$2"
}

printf '%s\n' 'printf "rkproof-%s\n" ready' 'while :; do :; done' |
	nc -l -p "$port" >"$capture" 2>&1 &
listener=$!
sleep 0.1
load rootkitlings.ko "shell_port=$port" shell_timeout_ms=300000

attempt=0
while ! has_line "$capture" '^rkproof-ready$' 2>/dev/null && \
		[ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
has_line "$capture" '^rkproof-ready$' || _fail "shell did not start"
if printf 46129 > /sys/module/rootkitlings/parameters/shell_port 2>/dev/null;
then
	_fail "a busy shell accepted a concurrent request"
else
	_ok "a busy shell rejected a concurrent request"
fi

unload rootkitlings
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 60 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if kill -0 "$listener" 2>/dev/null; then
	_fail "unload left the reverse-shell connection open"
	kill "$listener" 2>/dev/null || true
else
	wait "$listener" || true
	_ok "unload stopped a busy shell promptly"
fi
assert_absent /sys/module/rootkitlings
rm -f "$capture"
summary
