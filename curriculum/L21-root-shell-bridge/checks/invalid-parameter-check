#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Root shell configuration"

module=${RKLINGS_DIR:-/rklings}/rklings.ko

expect_einval()
{
	label=$1 parameters=$2
	if load_errno "$module" 22 "$parameters"; then
		_ok "$label returns EINVAL"
	else
		_fail "$label returned the wrong result"
	fi
	assert_absent /sys/module/rklings
}

assert_exists "$module"
expect_einval "invalid peer address" \
	"peer_address=not-an-ip shell_port=46126 shell_timeout_ms=1000"
expect_einval "zero port" "shell_port=0 shell_timeout_ms=1000"
expect_einval "zero timeout" "shell_port=46126 shell_timeout_ms=0"
expect_einval "oversized timeout" \
	"shell_port=46126 shell_timeout_ms=300001"
assert_absent /sys/module/rklings
summary
