#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Refused root shell connection"
ifconfig lo 127.0.0.1 up

has_line()
{
	tr '\r' '\n' < "$1" | grep -Eq "$2"
}

load rklings.ko shell_port=46125 shell_timeout_ms=1000
ticket=$(cat /sys/module/rklings/parameters/shell_ticket)
request_id=${ticket%% *}
sleep 0.4
if test "$(cat /sys/module/rklings/parameters/shell_status)" = \
		"$request_id refused -111"; then
	_ok "refusal reports the exact request and releases its resources"
else
	_fail "refused connection status is missing or incorrect"
fi

capture=/tmp/rklings-root-shell-retry
printf '%s\n' 'printf "rkproof-%s\n" retry' 'exit' |
	nc -l -p 46126 >"$capture" 2>&1 &
listener=$!
sleep 0.1
printf 46126 > /sys/module/rklings/parameters/shell_port
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
wait "$listener" || _fail "retry shell transport failed"
if has_line "$capture" '^rkproof-retry$'; then
	_ok "a refused connection released capacity for a later request"
else
	_fail "retry after refusal did not reach the shell"
fi
unload rklings
assert_absent /sys/module/rklings
rm -f "$capture"
summary
