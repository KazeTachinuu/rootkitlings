#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Refused root shell connection"
ifconfig lo 127.0.0.1 up

load rootkitlings.ko shell_port=46125 shell_timeout_ms=250
sleep 0.4
_ok "a refused connection released its worker and socket"

capture=/tmp/rootkitlings-root-shell-retry
printf '%s\n' 'echo retry=ok' 'exit' |
	nc -l -p 46126 -s 127.0.0.1 >"$capture" 2>&1 &
listener=$!
sleep 0.1
printf 46126 > /sys/module/rootkitlings/parameters/shell_port
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
wait "$listener" || _fail "retry shell transport failed"
if grep -qx 'retry=ok' "$capture"; then
	_ok "a refused connection released capacity for a later request"
else
	_fail "retry after refusal did not reach the shell"
fi
unload rootkitlings
assert_absent /sys/module/rootkitlings
rm -f "$capture"
summary
