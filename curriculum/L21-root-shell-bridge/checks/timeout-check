#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Root shell timeout"
port=46123
capture=/tmp/rootkitlings-root-shell-timeout
rm -f "$capture"
ifconfig lo 127.0.0.1 up

printf '%s\n' 'echo shell-ready' 'sleep 60' |
	nc -l -p "$port" -s 127.0.0.1 >"$capture" 2>&1 &
listener=$!
sleep 0.1
load rootkitlings.ko "shell_port=$port" shell_timeout_ms=250
ticket=$(cat /sys/module/rootkitlings/parameters/shell_ticket)
request_id=${ticket%% *}

attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 60 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if kill -0 "$listener" 2>/dev/null; then
	_fail "timeout left the reverse-shell connection open"
	kill "$listener" 2>/dev/null || true
else
	wait "$listener" || true
	_ok "timeout closed a shell running a command"
fi
if grep -qx shell-ready "$capture"; then
	_ok "shell ran before its deadline"
else
	_fail "shell never reached the listener"
fi

leaked=
for command in /proc/[0-9]*/cmdline; do
	[ -r "$command" ] || continue
	line=$(tr '\000' ' ' <"$command")
	case $line in *'sleep 60'*) leaked=$command ;; esac
done
if [ -z "$leaked" ]; then
	_ok "timeout killed the shell process group"
else
	_fail "timeout left a shell command running"
fi
if test "$(cat /sys/module/rootkitlings/parameters/shell_status)" = \
		"$request_id timed-out -110"; then
	_ok "timeout reports the exact request and result"
else
	_fail "timeout status is missing or incorrect"
fi

printf '%s\n' 'echo retry=ok' 'exit' |
	nc -l -p 46127 -s 127.0.0.1 >"$capture.retry" 2>&1 &
listener=$!
sleep 0.1
attempt=0
while ! printf 46127 \
		> /sys/module/rootkitlings/parameters/shell_port 2>/dev/null && \
		[ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if [ "$attempt" -lt 100 ]; then fully_requested=1; else fully_requested=; fi
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
wait "$listener" || _fail "retry after timeout failed"
if [ "$fully_requested" = 1 ] && grep -qx 'retry=ok' "$capture.retry"; then
	_ok "timed-out state accepted a later request"
else
	_fail "timed-out state did not release capacity"
fi

unload rootkitlings
assert_absent /sys/module/rootkitlings
rm -f "$capture" "$capture.retry"
summary
