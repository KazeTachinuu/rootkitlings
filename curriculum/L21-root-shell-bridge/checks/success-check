#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Root shell bridge"
port=46121
capture=/tmp/rootkitlings-root-shell
rm -f "$capture"
ifconfig lo 127.0.0.1 up

valid_ticket()
{
	value=$1
	printf '%s\n' "$value" |
		grep -Eq '^[0-9a-f]{8} [0-9a-f]{16}$' || return 1
	case $value in
		00000000\ *|*\ 0000000000000000) return 1 ;;
	esac
}

show_capture()
{
	_hdr "$2"
	cat "$1"
}

has_line()
{
	tr '\r' '\n' < "$1" | grep -Eq "$2"
}

{
	# Expansion belongs to the remote shell.
	# shellcheck disable=SC2016
	printf '%s\n' \
		'printf "rkproof-%s=%s\n" uid "$(id -u)"' \
		'value=no' \
		'if test -t 0 && test -t 1 && test -t 2; then value=yes; fi' \
		'printf "rkproof-%s=%s\n" tty "$value"' \
		'printf "rkproof-%s=%s\n" bash "${BASH_VERSION%%.*}"' \
		'printf "rkproof-%s=%s\n" dir "$PWD"' \
		'printf "rkproof-%s\n" marker' \
		'exit'
} | nc -l -p "$port" -s 127.0.0.2 >"$capture" 2>&1 &
listener=$!
sleep 0.1

load rootkitlings.ko peer_address=127.0.0.2 "shell_port=$port" \
	shell_timeout_ms=5000
assert_contains /sys/module/rootkitlings/parameters/peer_address \
	127.0.0.2
first_ticket=$(cat /sys/module/rootkitlings/parameters/shell_ticket)
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if kill -0 "$listener" 2>/dev/null; then
	_fail "root shell did not finish"
	kill "$listener" 2>/dev/null || true
	wait "$listener" 2>/dev/null || true
else
	wait "$listener" || _fail "loopback shell transport failed"
fi
show_capture "$capture" "First shell transcript"

if test "$(head -n 1 "$capture" | tr -d '\r')" = \
		"RKSH $first_ticket"; then
	_ok "shell prelude proves the accepted request and cookie"
else
	_fail "shell prelude does not match the published ticket"
fi

if has_line "$capture" '^rkproof-uid=0$'; then
	_ok "user-mode helper executed the shell as root"
else
	_fail "shell did not report UID 0"
fi
if has_line "$capture" '^rkproof-tty=yes$'; then
	_ok "Bash owns a PTY on standard input, output, and error"
else
	_fail "shell standard descriptors are not attached to a PTY"
fi
if has_line "$capture" '^rkproof-bash=[1-9][0-9]*$'; then
	_ok "the PTY runs interactive Bash"
else
	_fail "shell did not expose a Bash version"
fi
if has_line "$capture" '^rkproof-dir=/$'; then
	_ok "shell started at the disposable filesystem root"
else
	_fail "shell started in an unexpected directory"
fi
if has_line "$capture" '^rkproof-marker$'; then
	_ok "socket descriptors carried commands and output"
else
	_fail "shell marker did not cross the socket"
fi

port=46122
printf '%s\n' 'printf "rkproof-%s\n" second' 'exit' |
	nc -l -p "$port" -s 127.0.0.2 >"$capture.second" 2>&1 &
listener=$!
sleep 0.1
attempt=0
while ! printf '%s' "$port" \
		> /sys/module/rootkitlings/parameters/shell_port 2>/dev/null && \
		[ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
[ "$attempt" -lt 100 ] || _fail "completed shell did not release capacity"
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if kill -0 "$listener" 2>/dev/null; then
	_fail "second root shell did not finish"
	kill "$listener" 2>/dev/null || true
	wait "$listener" 2>/dev/null || true
else
	wait "$listener" || _fail "second shell transport failed"
fi
show_capture "$capture.second" "Second shell transcript"
second_ticket=$(cat /sys/module/rootkitlings/parameters/shell_ticket)
second_id=${second_ticket%% *}
if test "$(head -n 1 "$capture.second" | tr -d '\r')" = \
		"RKSH $second_ticket"; then
	_ok "a later request receives a fresh ownership cookie"
else
	_fail "later shell prelude does not match its ticket"
fi
if valid_ticket "$first_ticket" && valid_ticket "$second_ticket" &&
	test "$first_ticket" != "$second_ticket"; then
	_ok "request IDs and cookies are nonzero and distinct"
else
	_fail "shell tickets are zero, malformed, or reused"
fi
if has_line "$capture.second" '^rkproof-second$'; then
	_ok "an exited shell released capacity for a later request"
else
	_fail "second shell did not run"
fi
if test "$(cat /sys/module/rootkitlings/parameters/shell_status)" = \
		"$second_id exited 0"; then
	_ok "completed shell reports its exact request and result"
else
	_fail "completed shell status is not honest"
fi

unload rootkitlings
assert_absent /sys/module/rootkitlings
_ok "completed sessions unload cleanly"
rm -f "$capture" "$capture.second"
summary
