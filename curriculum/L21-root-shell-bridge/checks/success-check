#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Root shell bridge"
port=46121
capture=/tmp/rootkitlings-root-shell
rm -f "$capture"
ifconfig lo 127.0.0.1 up

{
	# Expansion belongs to the remote shell.
	# shellcheck disable=SC2016
	printf '%s\n' \
		'printf "uid=%s\n" "$(id -u)"' \
		'printf "dir=%s\n" "$PWD"' \
		'printf "marker=rootkitlings-shell\n"' \
		'exit'
} | nc -l -p "$port" -s 127.0.0.1 >"$capture" 2>&1 &
listener=$!
sleep 0.1

load rootkitlings.ko "shell_port=$port" shell_timeout_ms=5000
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if kill -0 "$listener" 2>/dev/null; then
	_fail "root shell did not finish"
	kill "$listener" 2>/dev/null || true
else
	wait "$listener" || _fail "loopback shell transport failed"
fi

if grep -qx 'uid=0' "$capture"; then
	_ok "user-mode helper executed the shell as root"
else
	_fail "shell did not report UID 0"
fi
if grep -qx 'dir=/' "$capture"; then
	_ok "shell started at the disposable filesystem root"
else
	_fail "shell started in an unexpected directory"
fi
if grep -qx 'marker=rootkitlings-shell' "$capture"; then
	_ok "socket descriptors carried commands and output"
else
	_fail "shell marker did not cross the socket"
fi

port=46122
printf '%s\n' 'echo marker=second-shell' 'exit' |
	nc -l -p "$port" -s 127.0.0.1 >"$capture.second" 2>&1 &
listener=$!
sleep 0.1
attempt=0
while ! printf '%s' "$port" \
		> /sys/module/rootkitlings/parameters/shell_port 2>/dev/null && \
		[ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
[ "$attempt" -lt 100 ] || _fail "completed shell did not release capacity"
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
wait "$listener" || _fail "second shell transport failed"
if grep -qx 'marker=second-shell' "$capture.second"; then
	_ok "an exited shell released capacity for a later request"
else
	_fail "second shell did not run"
fi

unload rootkitlings
assert_absent /sys/module/rootkitlings
_ok "completed sessions unload cleanly"
rm -f "$capture" "$capture.second"
summary
