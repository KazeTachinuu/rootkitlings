#!/usr/bin/bash
set -Eeuo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$here/../../../scripts/lesson-env"
scratch=$(mktemp -d \
	"${TMPDIR:-/tmp}/rootkitlings-root-shell-bridge-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

for command in make nm; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

for script in test host-check success-check timeout-check unload-check \
		refused-check invalid-parameter-check; do
	bash -n "$here/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$here/test" "$here/host-check"
	shellcheck -x -s sh "$here/success-check" "$here/timeout-check" \
		"$here/unload-check" "$here/refused-check" \
		"$here/invalid-parameter-check"
fi

starter=$here/../starter
solution_overlay=$here/../solution
expected_starter=$(cat <<'EOF'
Kbuild
core/main.c
execution/root_shell.c
include/root_shell.h
EOF
)
actual_starter=$(find "$starter" -type f -printf '%P\n' | sort)
[[ $actual_starter == "$expected_starter" ]] || {
	printf '[x] starter has an unexpected path set\n' >&2
	exit 1
}
actual_solution=$(find "$solution_overlay" -type f -printf '%P\n' | sort)
[[ $actual_solution == "$expected_starter" ]] || {
	printf '[x] solution has an unexpected path set\n' >&2
	exit 1
}
for relative in Kbuild core/main.c include/root_shell.h; do
	cmp -s "$starter/$relative" "$solution_overlay/$relative" || {
		printf '[x] immutable solution file changed: %s\n' "$relative" >&2
		exit 1
	}
done

compose()
{
	local destination=$1 overlay=${2:-}

	cp -a "$starter" "$destination"
	if [[ -n $overlay ]]; then
		cp -a "$overlay/." "$destination/"
	fi
}

build()
{
	local source=$1 destination=$2 point=${3:-0} log=$2.log

	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
			ROOTKITLINGS_FAIL_POINT="$point" modules >"$log" 2>&1; then
		cat "$log" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s builds with warnings\n' "${destination##*/}" >&2
		exit 1
	fi
}

compose "$scratch/solution-source" "$solution_overlay"
compose "$scratch/starter-source"
build "$scratch/solution-source" "$scratch/solution"
build "$scratch/starter-source" "$scratch/starter"
"$here/host-check" "$scratch/solution" \
	"$scratch/solution/rootkitlings.ko"
if "$here/host-check" "$scratch/starter" \
		"$scratch/starter/rootkitlings.ko" \
		>"$scratch/starter-host.log" 2>&1; then
	printf '[x] host checker accepted the unfinished starter\n' >&2
	exit 1
fi

cp -a "$scratch/solution-source" "$scratch/unknown-source"
if make -s -C "$KDIR" M="$scratch/unknown-source" W=1 \
		ROOTKITLINGS_FAIL_POINT=99 modules \
		>"$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure point compiled\n' >&2
	exit 1
fi
grep -Fq 'unknown ROOTKITLINGS_FAIL_POINT' "$scratch/unknown.log" || {
	cat "$scratch/unknown.log" >&2
	printf '[x] unknown failure point failed for the wrong reason\n' >&2
	exit 1
}

guest()
{
	local check=$1 label=$2 output
	shift 2

	if ! output=$("$here/../../../vm/boot" --check "$check" \
			"$@" "$scratch/solution/rootkitlings.ko" 2>&1); then
		printf '%s\n[x] guest rejected %s\n' "$output" "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

guest "$here/success-check" solution
guest "$here/timeout-check" timeout
guest "$here/unload-check" unload
guest "$here/refused-check" refused
guest "$here/invalid-parameter-check" invalid-configuration \
	--tool vm/tools/module_load_params

printf '[+] root-shell bridge checker regression passed\n'
