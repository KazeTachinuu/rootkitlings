#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Reversible load-request transaction"

root=/etc/modules-load.d
target=$root/rootkitlings.conf
sibling=$root/.rootkitlings.conf.rootkitlings
extra=$root/extra-link

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	umount "$root" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mkdir -p "$root"
mount -t tmpfs -o nosuid,nodev,noexec,mode=0700 tmpfs "$root"
chmod 0700 "$root"

reset_target()
{
	rm -f "$target" "$sibling" "$extra"
	printf 'original-request\n' > "$target"
	chmod 0600 "$target"
}

expect_load_error()
{
	expected=$1
	label=$2
	if load_errno /rootkitlings/rootkitlings.ko "$expected" \
			"peer_port=47023 retry_base_ms=200 retry_max_ms=200"; then
		_ok "$label returns errno $expected"
	else
		_fail "$label returned the wrong error"
	fi
	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings_agent
}

reset_target
chmod 0644 "$target"
expect_load_error 1 "wrong target mode"
if test "$(cat "$target")" = original-request &&
		test "$(stat -c %a "$target")" = 644 && test ! -e "$sibling"; then
	_ok "mode rejection changes no name, byte, or mode"
else
	_fail "mode rejection changed the fixture"
fi

reset_target
ln "$target" "$extra"
expect_load_error 1 "multiply linked target"
if cmp -s "$target" "$extra" && test ! -e "$sibling"; then
	_ok "link-count rejection preserves both links"
else
	_fail "link-count rejection changed the fixture"
fi

reset_target
printf 'foreign-sibling\n' > "$sibling"
chmod 0600 "$sibling"
# The module loader maps an init return of EEXIST to EBUSY.
expect_load_error 16 "occupied sibling"
if test "$(cat "$target")" = original-request &&
		test "$(cat "$sibling")" = foreign-sibling; then
	_ok "occupied sibling remains untouched"
else
	_fail "occupied sibling rejection changed a file"
fi

reset_target
dd if=/dev/zero of="$target" bs=257 count=1 2>/dev/null
chmod 0600 "$target"
expect_load_error 27 "257-byte target"
if test "$(wc -c < "$target")" -eq 257 && test ! -e "$sibling"; then
	_ok "oversized target remains unchanged"
else
	_fail "oversized target rejection changed the fixture"
fi

reset_target
printf 'rootkitlings\n' > "$target"
chmod 0600 "$target"
expect_load_error 114 "already installed exact request"
if test "$(wc -c < "$target")" -eq 13 &&
		test "$(cat "$target")" = rootkitlings && test ! -e "$sibling"; then
	_ok "exact pre-existing request is not claimed or rewritten"
else
	_fail "exact pre-existing request was changed"
fi

summary
