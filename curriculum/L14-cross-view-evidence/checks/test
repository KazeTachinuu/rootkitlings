#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../../scripts/lesson-env"
baseline=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r15-baseline.XXXXXX")
work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r15-work.XXXXXX")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r15-test.XXXXXX")
trap 'rm -rf -- "$baseline" "$work" "$scratch"' EXIT

for source in \
	"$HERE/../../owned-kernel-state/solution" \
	"$HERE/../../proc-publication/solution" \
	"$HERE/../../proc-read-contract/solution" \
	"$HERE/../../bounded-control-switch/solution" \
	"$HERE/../../managed-kprobe/starter" \
	"$HERE/../../managed-kprobe/solution"; do
	cp -a "$source/." "$baseline/"
done
cp -a "$baseline/." "$work/"
cp -a "$HERE/../starter/." "$work/"
cp -a "$HERE/../solution/." "$work/"

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
for option in X86_64 IKCONFIG_PROC KPROBES KPROBES_ON_FTRACE OPTPROBES \
	KALLSYMS KALLSYMS_ALL DEBUG_FS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] this lesson requires CONFIG_%s=y\n' "$option" >&2
		exit 1
	}
done
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || {
	printf '[x] pinned kernel build is not configured for its GCC toolchain\n' >&2
	exit 1
}
command -v gcc >/dev/null || {
	printf '[x] gcc is required\n' >&2
	exit 1
}

symvers=$KDIR/Module.symvers
[[ -f $symvers ]] || {
	printf '[x] kernel export manifest not found: %s\n' "$symvers" >&2
	exit 1
}
awk '$2 == "vfs_mkdir" && $4 == "EXPORT_SYMBOL" { found = 1 }
	END { exit !found }' "$symvers" || {
	printf '[x] pinned kernel must export vfs_mkdir\n' >&2
	exit 1
}
if awk '$2 == "filename_rmdir" { found = 1 } END { exit !found }' \
	"$symvers"; then
	printf '[x] filename_rmdir unexpectedly appears in the export manifest\n' >&2
	exit 1
fi
for symbol in register_kprobes unregister_kprobes; do
	awk -v symbol="$symbol" '$2 == symbol && $4 == "EXPORT_SYMBOL_GPL" {
		found = 1
	} END { exit !found }' "$symvers" || {
		printf '[x] pinned kernel must GPL-export %s\n' "$symbol" >&2
		exit 1
	}
done
for symbol in vfs_mkdir filename_rmdir; do
	awk -v symbol="$symbol" '$3 == symbol { found = 1 }
		END { exit !found }' /proc/kallsyms || {
		printf '[x] running kernel lacks target symbol %s\n' "$symbol" >&2
		exit 1
	}
done
if grep -q '[[:space:]]__rootkitlings_missing_kprobe_target_7_2__$' \
	/proc/kallsyms; then
	printf '[x] negative-control Kprobe target exists in the running kernel\n' >&2
	exit 1
fi

for script in test host-check success-check probe-failure-check.in; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" \
		"$HERE/probe-failure-check.in"
fi

mapfile -t changed_files < <(
	cd "$HERE/../solution"
	find . -type f -printf '%P\n' | sort
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == interface/proc.c ]] || {
	printf '[x] learner edit surface is %s, expected interface/proc.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2 point=${3:-0}
	local log=$destination.log
	cp -a "$baseline/." "$destination/"
	cp -a "$source/." "$destination/"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "${source##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "${source##*/}" >&2
		exit 1
	fi
}

build_tree "$HERE/../starter" "$scratch/starter"
build_tree "$work" "$scratch/solution"

build_variant()
{
	local name=$1 point=$2 destination=$scratch/$1 log=$scratch/$1.log
	cp -a "$work" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "$name" >&2
		exit 1
	fi
}

build_variant success 0
build_variant preflight 1
build_variant allocation 2
build_variant publication 3
build_variant missing 4
"$HERE/host-check" "$scratch/success" \
	"$scratch/success/rootkitlings.ko" "$scratch/missing"

expect_host_rejection()
{
	local directory=$1 label=$2
	if "$HERE/host-check" "$directory" "$directory/rootkitlings.ko" \
		"$scratch/missing" > "$scratch/host-$label.log" 2>&1; then
		printf '[x] host checker accepted %s\n' "$label" >&2
		exit 1
	fi
}

rebuild_host_fixture()
{
	local directory=$1 label=$2 log=$scratch/rebuild-$2.log
	if ! make -s -C "$KDIR" M="$directory" W=1 \
		ROOTKITLINGS_FAIL_POINT=0 modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] host fixture %s did not rebuild\n' "$label" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] host fixture %s rebuilt with warnings\n' "$label" >&2
		exit 1
	fi
}

formatted=$scratch/host-formatting
cp -a "$scratch/success" "$formatted"
sed -i \
	-e 's/if (id == RK_PROBE_FILENAME_RMDIR)/\/\* selected item \*\/\n\tif (RK_PROBE_FILENAME_RMDIR == id) {/' \
	-e '0,/return SEQ_SKIP;/s//return SEQ_SKIP;\n\t}/' \
	"$formatted/interface/proc.c"
"$HERE/host-check" "$formatted" "$formatted/rootkitlings.ko" \
	"$scratch/missing" > "$scratch/host-formatting.log"

parenthesized=$scratch/host-parenthesized
cp -a "$scratch/success" "$parenthesized"
sed -i \
	's/if (id == RK_PROBE_FILENAME_RMDIR)/if (((id) == (RK_PROBE_FILENAME_RMDIR)))/' \
	"$parenthesized/interface/proc.c"
"$HERE/host-check" "$parenthesized" "$parenthesized/rootkitlings.ko" \
	"$scratch/missing" > "$scratch/host-parenthesized.log"

unconditional=$scratch/host-unconditional
cp -a "$scratch/success" "$unconditional"
sed -i 's/if (id == RK_PROBE_FILENAME_RMDIR)/if (true)/' \
	"$unconditional/interface/proc.c"
expect_host_rejection "$unconditional" unconditional-suppression

second_skip=$scratch/host-second-skip
cp -a "$scratch/success" "$second_skip"
sed -i '/if (id == RK_PROBE_VFS_MKDIR) {/a\
\t\treturn SEQ_SKIP;' "$second_skip/interface/proc.c"
expect_host_rejection "$second_skip" a-second-skip

early_exit=$scratch/host-early-exit
cp -a "$scratch/success" "$early_exit"
sed -i '/if (id == RK_PROBE_VFS_MKDIR) {/i\
\tif (id == RK_PROBE_VFS_MKDIR)\
\t\treturn 0;' "$early_exit/interface/proc.c"
expect_host_rejection "$early_exit" an-early-exit

name_filter=$scratch/host-name-filter
cp -a "$scratch/success" "$name_filter"
sed -i 's/id == RK_PROBE_FILENAME_RMDIR/strcmp(rk_probe_name(id), "filename_rmdir") == 0/' \
	"$name_filter/interface/proc.c"
expect_host_rejection "$name_filter" a-name-based-filter

hidden_helper=$scratch/host-hidden-helper
cp -a "$scratch/success" "$hidden_helper"
sed -i '/static int rk_proc_show/i\
static bool rk_probe_is_suppressed(enum rk_probe_id id)\
{\
\treturn id == RK_PROBE_FILENAME_RMDIR;\
}\
' "$hidden_helper/interface/proc.c"
sed -i 's/if (id == RK_PROBE_FILENAME_RMDIR)/if (rk_probe_is_suppressed(id))/' \
	"$hidden_helper/interface/proc.c"
rebuild_host_fixture "$hidden_helper" helper-factored-filter
"$HERE/host-check" "$hidden_helper" "$hidden_helper/rootkitlings.ko" \
	"$scratch/missing" > "$scratch/host-helper.log"

no_suppression=$scratch/host-no-suppression
cp -a "$scratch/success" "$no_suppression"
sed -i 's/id == RK_PROBE_FILENAME_RMDIR/false/' \
	"$no_suppression/interface/proc.c"
expect_host_rejection "$no_suppression" no-suppression

wrong_suppression=$scratch/host-wrong-suppression
cp -a "$scratch/success" "$wrong_suppression"
sed -i 's/id == RK_PROBE_FILENAME_RMDIR/id == RK_PROBE_VFS_MKDIR/' \
	"$wrong_suppression/interface/proc.c"
expect_host_rejection "$wrong_suppression" wrong-selected-item

catalog_mutation=$scratch/host-catalog-mutation
cp -a "$scratch/success" "$catalog_mutation"
sed -i 's/"filename_rmdir"/"vfs_rmdir"/' \
	"$catalog_mutation/instrumentation/probes.c"
rebuild_host_fixture "$catalog_mutation" mutated-catalog
expect_host_rejection "$catalog_mutation" a-mutated-catalog

registration_mutation=$scratch/host-registration-mutation
cp -a "$scratch/success" "$registration_mutation"
sed -i '0,/register_kprobes(probes, ARRAY_SIZE(probes))/s//register_kprobes(probes, 1)/' \
	"$registration_mutation/instrumentation/probes.c"
rebuild_host_fixture "$registration_mutation" shortened-registration
expect_host_rejection "$registration_mutation" a-shortened-registration-set

hide_toggle=$scratch/host-hide-toggle
cp -a "$scratch/success" "$hide_toggle"
sed -i '/static struct proc_dir_entry \*proc_entry;/a static bool hide_rmdir = true;' \
	"$hide_toggle/interface/proc.c"
expect_host_rejection "$hide_toggle" a-hide-toggle

module_list=$scratch/host-module-list
cp -a "$scratch/success" "$module_list"
sed -i '/static struct proc_dir_entry \*proc_entry;/a static struct list_head *raw_module_list;' \
	"$module_list/interface/proc.c"
expect_host_rejection "$module_list" raw-list-state

cp -a "$work" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 \
	ROOTKITLINGS_FAIL_POINT=99 modules > "$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

sed -e 's/@EXPECTED_ERRNO@/12/g' \
	-e 's/@LABEL@/Probe cleanup after procfs publication failure/g' \
	"$HERE/probe-failure-check.in" > "$scratch/publication-check"
sed -e 's/@EXPECTED_ERRNO@/2/g' \
	-e 's/@LABEL@/Batch rollback after a missing second symbol/g' \
	"$HERE/probe-failure-check.in" > "$scratch/missing-check"
chmod 0755 "$scratch/publication-check" "$scratch/missing-check"

run_guest()
{
	local check_script=$1 module=$2 output
	shift 2
	if ! output=$("$HERE/../../../../vm/boot" --check "$check_script" \
		--tool vm/tools/run_as "$@" \
		"$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest did not complete\n' >&2
		exit 1
	fi
	printf '%s\n' "$output"
	grep -Fq '[+] PASSED' <<< "$output" || {
		printf '[x] guest checks did not pass\n' >&2
		exit 1
	}
}

run_guest "$HERE/../../proc-publication/checks/failure-ecanceled-check" \
	"$scratch/preflight/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/../../proc-publication/checks/failure-enomem-check" \
	"$scratch/allocation/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$scratch/publication-check" \
	"$scratch/publication/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$scratch/missing-check" \
	"$scratch/missing/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/success-check" "$scratch/success/rootkitlings.ko" \
	--tool vm/tools/proc_read_test --tool vm/tools/proc_write_test
