#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Callback shell"

fixture_dir=/tmp/rk-agent-fixture
test_port=9999

mkdir -p "$fixture_dir"
rm -f "$fixture_dir/ready" "$fixture_dir/first_complete" \
      "$fixture_dir/second_connected" "$fixture_dir/eof"

ifconfig lo 127.0.0.1 up

agent_fixture serve "$fixture_dir" "$test_port" &
fixture_pid=$!

# Wait for the listener to be ready
tries=0
while [ ! -f "$fixture_dir/ready" ] && [ "$tries" -lt 20 ]; do
	sleep 0.1
	tries=$((tries + 1))
done

if [ ! -f "$fixture_dir/ready" ]; then
	_fail "agent fixture did not become ready"
	kill "$fixture_pid" 2>/dev/null
	summary
fi

_ok "fixture listening on port $test_port"

load rklings.ko peer_address=127.0.0.1 peer_port="$test_port" \
	retry_base_ms=25 retry_max_ms=200

# Wait for the fixture to complete the first session
tries=0
while [ ! -f "$fixture_dir/first_complete" ] && [ "$tries" -lt 100 ]; do
	sleep 0.1
	tries=$((tries + 1))
done

if [ -f "$fixture_dir/first_complete" ]; then
	_ok "agent completed protocol exchange (PING/PONG, INFO, ERR, QUIT)"
else
	_fail "agent did not complete protocol exchange"
fi

unload rklings

# Wait for fixture to see the second connection's EOF
tries=0
while [ ! -f "$fixture_dir/eof" ] && [ "$tries" -lt 50 ]; do
	sleep 0.1
	tries=$((tries + 1))
done

if [ -f "$fixture_dir/second_connected" ]; then
	_ok "agent reconnected after QUIT"
else
	_fail "agent did not reconnect"
fi

wait "$fixture_pid" 2>/dev/null
rm -rf "$fixture_dir"

summary
