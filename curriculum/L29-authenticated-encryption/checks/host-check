#!/usr/bin/bash
set -Eeuo pipefail
die(){ printf '[x] %s\n' "$*" >&2; exit 1; }
(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build=$(realpath -e -- "$1") || die "build not found"
module=$(realpath -e -- "$2") || die "module not found"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-authenticated-encryption-host.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT
[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for f in Kbuild core/main.c crypto/platform.c crypto/aead.c include/aead.h \
	include/platform.h include/selftest.h tests/selftest.c; do
	[[ -f $build/$f && ! -L $build/$f ]] || die "build is missing regular file: $f"
done
gcc -std=c11 -Wall -Wextra -Werror -pedantic -O1 -g \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I"$build/include" "$here/../fixtures/host/aead_test.c" \
	"$here/../fixtures/host/platform.c" "$build/crypto/aead.c" -o "$tmp/test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 "$tmp/test"
printf '[+] authenticated-encryption host behavior passed\n'
