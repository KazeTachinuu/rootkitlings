#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-authenticated-replay-safe-message-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
for option in CONFIG_CC_IS_GCC=y CONFIG_CRYPTO_HMAC=y CONFIG_CRYPTO_SHA256=y; do
	grep -qx "$option" "$KDIR/.config" || {
		printf '[x] pinned kernel is missing %s\n' "$option" >&2
		exit 1
	}
done
for command in gcc make nm openssl; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

assert_clean_tree()
{
	local generated

	generated=$(find "$HERE" -type f \( \
		-name '*.o' -o -name '*.ko' -o -name '*.mod' -o \
		-name '*.mod.c' -o -name Module.symvers -o -name modules.order -o \
		-name '.*.cmd' \) -print -quit)
	[[ -z $generated ]] || {
		printf '[x] generated artifact stored in lesson: %s\n' \
			"${generated#"$HERE/"}" >&2
		exit 1
	}
}

assert_clean_tree

for script in test host-check success-check failure-check \
	allocation-failure-check key-failure-check digest-failure-check; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check" \
		"$HERE/allocation-failure-check" "$HERE/key-failure-check" \
		"$HERE/digest-failure-check"
fi

mapfile -t changed_files < <(
	diff -qr "$HERE/../starter" "$HERE/../solution" |
		sed -nE 's#^Files .*/starter/(.*) and .*/solution/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == message/authenticated.c ]] || {
	printf '[x] wrong learner edit surface: %s\n' "${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2 point=${3:-0}
	local log=$destination.log

	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules > "$log" 2>&1; then
		cat "$log" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s builds with warnings\n' "${destination##*/}" >&2
		exit 1
	fi
}

build_tree "$HERE/../starter" "$scratch/starter"
build_tree "$HERE/../solution" "$scratch/solution"
build_tree "$HERE/../solution" "$scratch/allocation" 1
build_tree "$HERE/../solution" "$scratch/key-failure" 2
build_tree "$HERE/../solution" "$scratch/digest-failure" 3
cp -a "$HERE/../solution" "$scratch/unknown-failure-point"
if make -s -C "$KDIR" M="$scratch/unknown-failure-point" W=1 \
	ROOTKITLINGS_FAIL_POINT=99 modules >"$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure point compiled\n' >&2
	exit 1
fi
grep -Fq 'must be between 0 and 3' "$scratch/unknown.log" || {
	cat "$scratch/unknown.log" >&2
	printf '[x] unknown failure point failed for the wrong reason\n' >&2
	exit 1
}

"$HERE/host-check" "$scratch/solution" "$scratch/solution/rootkitlings.ko"
if "$HERE/host-check" "$scratch/starter" \
	"$scratch/starter/rootkitlings.ko" > "$scratch/template-host.log" 2>&1; then
	printf '[x] host checker accepted unfinished learner file\n' >&2
	exit 1
fi

build_mutant()
{
	local name=$1 mutator=$2
	local directory=$scratch/$name log=$scratch/$name.log

	cp -a "$HERE/../solution" "$directory"
	"$mutator" "$directory/message/authenticated.c"
	if ! make -s -C "$KDIR" M="$directory" W=1 \
		ROOTKITLINGS_FAIL_POINT=0 modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] mutant did not compile: %s\n' "$name" >&2
		exit 1
	fi
	if "$HERE/host-check" "$directory" "$directory/rootkitlings.ko" \
		> "$scratch/$name-host.log" 2>&1; then
		printf '[x] host checker accepted mutant: %s\n' "$name" >&2
		exit 1
	fi
}

mutate_short_tag()
{
	sed -i '0,/RK_AUTH_TAG_LENGTH))/s//1))/' "$1"
}
mutate_skip_tag()
{
	sed -i 's/if (!rk_platform_tags_equal/if (false \&\& !rk_platform_tags_equal/' "$1"
}
mutate_parse_before_auth()
{
	sed -i '/rk_platform_lock(receiver->context);/i\
\tif (message[0] != RK_AUTH_VERSION)\
\t\treturn -EPROTONOSUPPORT;' "$1"
}
mutate_ignore_epoch()
{
	sed -i 's/if (epoch != receiver->epoch)/if (false)/' "$1"
}
mutate_accept_duplicate()
{
	sed -i 's/if (sequence < receiver->next_sequence)/if (false)/' "$1"
}
mutate_accept_gap()
{
	sed -i 's/if (sequence > receiver->next_sequence)/if (false)/' "$1"
}
mutate_wrap()
{
	sed -i 's/if (sequence == ~(u64)0)/if (false)/' "$1"
}
mutate_early_output()
{
	sed -i '/error = rk_platform_hmac/i\
\treceiver->output_level = message[18];' "$1"
}
mutate_no_lock()
{
	sed -i '/rk_platform_lock(receiver->context);/d; /rk_platform_unlock(receiver->context);/d' "$1"
}
mutate_uncleared_digest()
{
	sed -i '/rk_platform_clear(digest, sizeof(digest));/d' "$1"
}
mutate_ignores_comparator_result()
{
	sed -i '/if (!rk_platform_tags_equal/,+1c\
\t(void)rk_platform_tags_equal(digest, message + RK_AUTH_BODY_LENGTH,\
\t\t\t\t     RK_AUTH_TAG_LENGTH);\
\tif (__builtin_memcmp(digest, message + RK_AUTH_BODY_LENGTH,\
\t\t\t     RK_AUTH_TAG_LENGTH)) {' "$1"
}

build_mutant short-tag mutate_short_tag
build_mutant skips-tag-check mutate_skip_tag
build_mutant parses-before-auth mutate_parse_before_auth
build_mutant ignores-epoch mutate_ignore_epoch
build_mutant accepts-duplicate mutate_accept_duplicate
build_mutant accepts-gap mutate_accept_gap
build_mutant wraps-sequence mutate_wrap
build_mutant mutates-before-auth mutate_early_output
build_mutant omits-transition-lock mutate_no_lock
build_mutant leaves-digest mutate_uncleared_digest
build_mutant ignores-comparator-result mutate_ignores_comparator_result

cp -a "$HERE/../solution" "$scratch/alternate"
cp "$HERE/../fixtures/alternate/authenticated.c" \
	"$scratch/alternate/message/authenticated.c"
build_tree "$scratch/alternate" "$scratch/alternate-build"
"$HERE/host-check" "$scratch/alternate-build" \
	"$scratch/alternate-build/rootkitlings.ko"

run_guest()
{
	local check=$1 module=$2 label=$3 output
	if ! output=$("$HERE/../../../vm/boot" --check "$check" \
		"$module" --tool vm/tools/module_load_test 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] guest rejected %s\n' "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/success-check" "$scratch/solution/rootkitlings.ko" solution
run_guest "$HERE/success-check" \
	"$scratch/alternate-build/rootkitlings.ko" alternate
run_guest "$HERE/failure-check" "$scratch/starter/rootkitlings.ko" template
run_guest "$HERE/allocation-failure-check" \
	"$scratch/allocation/rootkitlings.ko" allocation-failure
run_guest "$HERE/key-failure-check" \
	"$scratch/key-failure/rootkitlings.ko" key-failure
run_guest "$HERE/digest-failure-check" \
	"$scratch/digest-failure/rootkitlings.ko" digest-failure

"$HERE/../../L11-one-use-authorization/checks/test"
"$HERE/../../L27-sha256-verification/checks/test"

assert_clean_tree

printf '[+] authenticated-replay-safe-message passed\n'
