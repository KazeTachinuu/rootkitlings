#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Authentication context allocation failure"
if module_load_test /rootkitlings/rootkitlings.ko 12; then
	_ok "allocation failure is propagated as ENOMEM"
else
	_fail "allocation failure returned the wrong error"
fi
assert_absent /sys/module/rootkitlings
summary
