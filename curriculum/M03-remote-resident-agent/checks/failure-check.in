#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
begin "$label"

root=/etc/modules-load.d
target=$root/rootkitlings.conf
sibling=$root/.rootkitlings.conf.rootkitlings
original=/tmp/rootkitlings-m03-original

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	umount "$root" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mkdir -p "$root"
mount -t tmpfs -o nosuid,nodev,noexec,mode=0700 tmpfs "$root"
chmod 0700 "$root"
printf 'operator-original\n' > "$target"
chmod 0600 "$target"
cp "$target" "$original"

rmdir_before=$(grep -c '__x64_sys_rmdir' /sys/kernel/debug/kprobes/list || true)
filldir_before=$(grep -c 'filldir64' /sys/kernel/debug/kprobes/list || true)
iterate_before=$(grep -c 'iterate_dir' /sys/kernel/debug/kprobes/list || true)

attempt=1
while test "$attempt" -le 2; do
	if module_load_params /rootkitlings/rootkitlings.ko "$expected_errno" \
			"peer_port=47023 retry_base_ms=20 retry_max_ms=80"; then
		_ok "attempt $attempt returns errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong result"
	fi
	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	assert_absent /proc/rootkitlings_events
	assert_absent /proc/rootkitlings_evidence
	assert_absent /proc/rootkitlings_agent
	if test "$(grep -c '__x64_sys_rmdir' /sys/kernel/debug/kprobes/list || true)" = "$rmdir_before" &&
	   test "$(grep -c 'filldir64' /sys/kernel/debug/kprobes/list || true)" = "$filldir_before" &&
	   test "$(grep -c 'iterate_dir' /sys/kernel/debug/kprobes/list || true)" = "$iterate_before"; then
		_ok "attempt $attempt restores every probe count"
	else
		_fail "attempt $attempt left a probe registered"
	fi
	workers=0
	for comm in /proc/[0-9]*/comm; do
		test -r "$comm" || continue
		case $(cat "$comm") in rkling_core|rkling_agent) workers=$((workers + 1)) ;; esac
	done
	if test "$workers" -eq 0; then
		_ok "attempt $attempt leaves no worker"
	else
		_fail "attempt $attempt left $workers workers"
	fi
	if cmp -s "$original" "$target" && test ! -e "$sibling"; then
		_ok "attempt $attempt restores the boot request names and bytes"
	else
		_fail "attempt $attempt left a boot-request edit"
	fi
	attempt=$((attempt + 1))
done

summary
