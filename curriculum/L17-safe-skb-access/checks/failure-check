#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Rejected unsafe sk_buff adapter"

assert_absent /sys/module/rklings
if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko 22; then
	_ok "kernel self-tests rejected the adapter with EINVAL"
else
	_fail "module load did not return EINVAL"
fi
assert_absent /sys/module/rklings

summary
