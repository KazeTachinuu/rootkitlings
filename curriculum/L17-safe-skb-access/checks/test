#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-safe-skb-access-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || {
	printf '[x] pinned kernel build is not configured for GCC\n' >&2
	exit 1
}
for command in make nm python3; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

for script in test host-check success-check failure-check; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check"
fi

mapfile -t changed_files < <(
	cd "$HERE/../solution"
	find . -type f -printf '%P\n' | sort
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == access/skb_access.c ]] || {
	printf '[x] learner edit surface is %s, expected access/skb_access.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2
	local log=$destination.log
	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "${source##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "${source##*/}" >&2
		exit 1
	fi
}

starter=$scratch/starter-source
solution=$scratch/solution-source
cp -a "$HERE/../../L16-hostile-packet-lengths/solution" "$starter"
cp -a "$HERE/../starter/." "$starter/"
cp -a "$starter" "$solution"
cp -a "$HERE/../solution/." "$solution/"

build_tree "$starter" "$scratch/starter"
build_tree "$solution" "$scratch/solution"
"$HERE/host-check" "$scratch/solution" \
	"$scratch/solution/rootkitlings.ko"

run_guest()
{
	local check=$1 module=$2 label=$3 output
	shift 3
	if ! output=$("$HERE/../../../vm/boot" --check \
		"$check" "$module" "$@" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] guest rejected %s\n' "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/success-check" "$scratch/solution/rootkitlings.ko" solution
run_guest "$HERE/failure-check" "$scratch/starter/rootkitlings.ko" starter \
	--tool vm/tools/module_load_test

build_mutant()
{
	local name=$1
	cp -a "$solution" "$scratch/$name"
	shift
	"$@" "$scratch/$name/access/skb_access.c"
	local log=$scratch/$name.log
	if ! make -s -C "$KDIR" M="$scratch/$name" W=1 modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] mutant did not compile: %s\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] mutant build has warnings: %s\n' "$name" >&2
		exit 1
	fi
}

mutate_offset_zero()
{
	sed -i 's/network_offset = skb_network_offset(skb);/network_offset = 0;/' "$1"
}
build_mutant offset-zero mutate_offset_zero
run_guest "$HERE/failure-check" "$scratch/offset-zero/rootkitlings.ko" \
	"zero network offset" --tool vm/tools/module_load_test

mutate_raw_len()
{
	sed -i 's/logical_available = skb->len - distance;/logical_available = skb->len;/' "$1"
}
build_mutant raw-len mutate_raw_len
run_guest "$HERE/failure-check" "$scratch/raw-len/rootkitlings.ko" \
	"raw skb length" --tool vm/tools/module_load_test

mutate_unreadable()
{
	sed -i '/if (!skb_frags_readable(skb))/{N;d;}' "$1"
}
build_mutant unreadable mutate_unreadable
run_guest "$HERE/failure-check" "$scratch/unreadable/rootkitlings.ko" \
	"ignored unreadable fragments" --tool vm/tools/module_load_test

mutate_early_output()
{
	sed -i '0,/return RK_SKB_ACCESS_INVALID_ARGUMENT;/s//return RK_SKB_ACCESS_INVALID_ARGUMENT;\
\t*available = 0;/' "$1"
}
build_mutant early-output mutate_early_output
run_guest "$HERE/failure-check" "$scratch/early-output/rootkitlings.ko" \
	"early output mutation" --tool vm/tools/module_load_test

mutate_prefix_only()
{
	sed -i '/if (!skb_frags_readable(skb))/i\
\tif (length > RK_IPV4_PREFIX_LENGTH)\
\t\treturn RK_SKB_ACCESS_TRUNCATED;' "$1"
}
build_mutant prefix-only mutate_prefix_only
run_guest "$HERE/failure-check" "$scratch/prefix-only/rootkitlings.ko" \
	"IPv4-prefix-only adapter" --tool vm/tools/module_load_test

mutate_last_failure_byte()
{
	sed -i 's/return RK_SKB_ACCESS_TRUNCATED;/return bytes[RK_SKB_READ_LIMIT - 1] = 0, RK_SKB_ACCESS_TRUNCATED;/' "$1"
}
build_mutant last-failure-byte mutate_last_failure_byte
run_guest "$HERE/failure-check" "$scratch/last-failure-byte/rootkitlings.ko" \
	"partial failure-output mutation" --tool vm/tools/module_load_test

mutate_direct_data()
{
	python3 - "$1" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
source = path.read_text(encoding="utf-8")
source, count = re.subn(
    r"source = skb_header_pointer_careful\([^;]+;",
    "source = skb->data + (int)copy_offset;",
    source,
    count=1,
)
if count != 1:
    raise SystemExit("could not create direct-data mutant")
path.write_text(source, encoding="utf-8")
PY
}
build_mutant direct-data mutate_direct_data
run_guest "$HERE/failure-check" "$scratch/direct-data/rootkitlings.ko" \
	"direct linear-data access" --tool vm/tools/module_load_test

build_mutant plain-helper \
	sed -i 's/skb_header_pointer_careful/skb_header_pointer/'
"$HERE/host-check" "$scratch/plain-helper" \
	"$scratch/plain-helper/rootkitlings.ko"
run_guest "$HERE/success-check" "$scratch/plain-helper/rootkitlings.ko" \
	"equivalent explicit-readability implementation"
