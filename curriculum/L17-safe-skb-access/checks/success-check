#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Safe sk_buff access"

assert_absent /sys/module/rklings
load rklings.ko
assert_loaded rklings
if dmesg | grep -q 'rklings: skb access self-tests passed:'; then
	_ok "kernel self-tests covered real sk_buff layouts"
else
	_fail "kernel self-test completion was not logged"
fi
unload rklings
assert_absent /sys/module/rklings

summary
