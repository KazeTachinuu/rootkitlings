#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

for relative in Kbuild core/main.c include/rootkit.h interface/proc.c \
		instrumentation/netfilter_observer.c \
		instrumentation/netfilter_observer.o; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done
[[ -f $module && ! -L $module ]] || die "module must be a regular file"

object=$build_dir/instrumentation/netfilter_observer.o
undefined=$(nm -u "$object" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__fentry__|__x86_return_thunk|init_net|nf_register_net_hook|\
		nf_unregister_net_hook|synchronize_rcu) ;;
		*) die "observer has out-of-scope external dependency: $symbol" ;;
	esac
done <<< "$undefined"

fixture=$here/../fixtures/host/netfilter_observer_test.c
includes=$here/../fixtures/host/include
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rklings-netfilter-observer-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
for point in 0 1; do
	binary=$scratch/netfilter-observer-$point
	if ! gcc -std=c11 -Wall -Wextra -Werror -pedantic \
			-fsanitize=address,undefined -fno-omit-frame-pointer \
			-I"$includes" -DRKLINGS_FAIL_POINT="$point" \
			"$build_dir/instrumentation/netfilter_observer.c" "$fixture" \
			-o "$binary" > "$binary.log" 2>&1; then
		cat "$binary.log" >&2
		die "Netfilter observer behavior fixture did not compile"
	fi
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
		UBSAN_OPTIONS=halt_on_error=1 "$binary" ||
		die "Netfilter observer behavior failed at injection point $point"
done

printf '[+] Netfilter observer behavior verified\n'
