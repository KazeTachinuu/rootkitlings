#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
begin "$label"

registry=/sys/kernel/debug/kprobes/list

probe_count()
{
	kind=$1
	target=$2
	awk -v kind="$kind" -v target="$target" '
		$2 == kind {
			split($3, name, "+")
			if (name[1] == target)
				count++
		}
		END { print count + 0 }
	' "$registry"
}

mkdir_before=$(probe_count k vfs_mkdir)
rmdir_before=$(probe_count k filename_rmdir)
iterate_before=$(probe_count r iterate_dir)
filldir_before=$(probe_count k filldir64)

attempt=1
while [ "$attempt" -le 2 ]; do
	if module_load_test /rklings/rklings.ko "$expected_errno"; then
		_ok "attempt $attempt returned errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rklings
	assert_absent /proc/rklings
	assert_absent /proc/rklings_hidden
	if [ "$(probe_count k vfs_mkdir)" -eq "$mkdir_before" ] &&
	   [ "$(probe_count k filename_rmdir)" -eq "$rmdir_before" ] &&
	   [ "$(probe_count r iterate_dir)" -eq "$iterate_before" ] &&
	   [ "$(probe_count k filldir64)" -eq "$filldir_before" ]; then
		_ok "attempt $attempt restores all four probe registrations"
	else
		_fail "attempt $attempt leaked a probe registration"
	fi
	attempt=$((attempt + 1))
done

summary
