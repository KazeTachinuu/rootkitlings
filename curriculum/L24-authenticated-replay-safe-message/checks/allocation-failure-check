#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Authentication context allocation failure"
if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko 12; then
	_ok "allocation failure is propagated as ENOMEM"
else
	_fail "allocation failure returned the wrong error"
fi
assert_absent /sys/module/rklings
summary
