#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "HMAC calculation failure"
if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko 5; then
	_ok "digest failure is propagated as EIO"
else
	_fail "digest failure returned the wrong error"
fi
assert_absent /sys/module/rklings
summary
