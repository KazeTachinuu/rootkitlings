#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "HMAC key setup failure"
if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko 129; then
	_ok "key setup failure is propagated as EKEYREJECTED"
else
	_fail "key setup failure returned the wrong error"
fi
assert_absent /sys/module/rklings
summary
