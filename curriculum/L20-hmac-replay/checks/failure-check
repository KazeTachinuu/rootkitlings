#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Rejected unfinished authenticated receiver"
if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko 22; then
	_ok "unfinished receiver is rejected with EINVAL"
else
	_fail "unfinished receiver returned the wrong error"
fi
assert_absent /sys/module/rklings
summary
