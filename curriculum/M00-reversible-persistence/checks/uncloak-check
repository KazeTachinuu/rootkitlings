#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Module uncloak"

load rklings.ko
assert_loaded rklings

mkdir rklings.h.m 2>/dev/null

if ! lsmod | grep -q rklings; then
	_ok "module hidden after h.m"
else
	_fail "module still visible after hide"
fi

mkdir rklings.u.m 2>/dev/null

if lsmod | grep -q rklings; then
	_ok "mkdir rklings.u.m restores module visibility"
else
	_fail "module not visible after unhide"
fi

unload rklings

if dmesg | grep -Eqi '(BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task)'; then
	_fail "kernel log contains a fault report"
else
	_ok "clean unload after unhide"
fi

summary
