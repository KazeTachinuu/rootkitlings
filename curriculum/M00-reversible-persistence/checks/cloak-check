#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Module cloak"

load rklings.ko
assert_loaded rklings

if lsmod | grep -q rklings; then
	_ok "module visible before cloak"
else
	_fail "module not visible before cloak"
fi

mkdir rklings.h.m 2>/dev/null

if ! lsmod | grep -q rklings; then
	_ok "mkdir rklings.h.m hides module from lsmod"
else
	_fail "module still visible after hide"
fi

unload rklings

if dmesg | grep -Eqi '(BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task)'; then
	_fail "kernel log contains a fault report"
else
	_ok "clean unload after hide"
fi

summary
