#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Unpersist"

persist_dir=/etc/modules-load.d
persist_file=$persist_dir/rklings.conf

mkdir -p "$persist_dir"
rm -f "$persist_file"

load rklings.ko
assert_loaded rklings

mkdir rklings.persist 2>/dev/null
sleep 1

if [ ! -f "$persist_file" ]; then
	_fail "persist did not create file (nothing to unpersist)"
	unload rklings
	summary
fi

mkdir rklings.unpersist 2>/dev/null
sleep 1

if [ ! -f "$persist_file" ]; then
	_ok "mkdir rklings.unpersist removed conf file"
else
	_fail "persistence file still exists after unpersist"
fi

unload rklings

summary
