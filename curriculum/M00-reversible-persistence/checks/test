#!/usr/bin/bash
set -Eeuo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$here/../../../scripts/lesson-env"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rklings-persistence-stealth-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

for script in persist-check unpersist-check cloak-check uncloak-check; do
	bash -n "$here/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s sh "$here/persist-check"
	shellcheck -x -s sh "$here/unpersist-check"
	shellcheck -x -s sh "$here/cloak-check"
	shellcheck -x -s sh "$here/uncloak-check"
fi

cp -a "$here/../solution" "$scratch/solution"
if ! make -s -C "$KDIR" M="$scratch/solution" W=1 modules \
		>"$scratch/build.log" 2>&1; then
	cat "$scratch/build.log" >&2
	printf '[x] solution build failed\n' >&2
	exit 1
fi
if grep -q 'warning:' "$scratch/build.log"; then
	cat "$scratch/build.log" >&2
	printf '[x] solution builds with warnings\n' >&2
	exit 1
fi

for check in persist-check cloak-check uncloak-check; do
	if ! output=$("$here/../../../vm/boot" --check "$here/$check" \
			--tool vm/tools/mkdir_escalation_test \
			"$scratch/solution/rklings.ko" 2>&1); then
		printf '%s\n[x] %s rejected solution\n' "$output" "$check" >&2
		exit 1
	fi
	printf '%s\n' "$output"
done

printf '[+] persistence-stealth checker regression passed\n'
