#!/usr/bin/bash
set -Eeuo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$here/../../../scripts/lesson-env"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rklings-reversible-persistence-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

for script in test success-check; do bash -n "$here/$script"; done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$here/test"
	shellcheck -x -s sh "$here/success-check"
fi

cp -a "$here/../solution" "$scratch/solution"
if ! make -s -C "$KDIR" M="$scratch/solution" W=1 modules \
		>"$scratch/build.log" 2>&1; then
	cat "$scratch/build.log" >&2
	printf '[x] solution build failed\n' >&2
	exit 1
fi
if grep -q 'warning:' "$scratch/build.log"; then
	cat "$scratch/build.log" >&2
	printf '[x] solution builds with warnings\n' >&2
	exit 1
fi

if ! output=$("$here/../../../vm/boot" --check "$here/success-check" \
		--tool vm/tools/proc_write_test \
		"$scratch/solution/rklings.ko" 2>&1); then
	printf '%s\n[x] guest rejected solution\n' "$output" >&2
	exit 1
fi
printf '%s\n' "$output"

printf '[+] reversible-persistence checker regression passed\n'
