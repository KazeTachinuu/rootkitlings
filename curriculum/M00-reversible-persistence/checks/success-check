#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

endpoint=/proc/rklings
persist_dir=/etc/modules-load.d
persist_file=$persist_dir/rklings.conf
staging_file=$persist_dir/.rklings.conf.staging
marker=/mnt/persist/.check-phase
fixtures=/tmp/m00-fixtures

mkdir -p "$fixtures"

read_field() {
	sed -n "s/^$2=//p" "$1"
}

# -- phase 2: verify persistence survived reboot --

if [ -f "$marker" ]; then
	begin "Persistence survives reboot"

	if grep -q rklings /proc/modules 2>/dev/null; then
		_ok "module loaded automatically after reboot"
	else
		_fail "module was not loaded after reboot"
	fi

	if [ -f "$persist_file" ] && grep -q rklings "$persist_file"; then
		_ok "persistence file survived reboot"
	else
		_fail "persistence file missing or empty after reboot"
	fi

	assert_exists "$endpoint"
	rm -f "$marker"
	summary
fi

# -- phase 1: persist, verify transaction, rollback, reboot --

begin "Reversible persistence"

mkdir -p "$persist_dir"
rm -f "$persist_file" "$staging_file"
: > "$persist_file"
chmod 0600 "$persist_file"

printf 'persist' > "$fixtures/persist"

load rklings.ko
assert_loaded rklings
assert_exists "$endpoint"

_state=$(read_field "$endpoint" persistence)
if [ "$_state" = "idle" ]; then
	_ok "initial persistence state is idle"
else
	_fail "initial persistence state is not idle (got: $_state)"
fi

proc_write_test write "$endpoint" "$fixtures/persist" > /dev/null
sleep 1

_state=$(read_field "$endpoint" persistence)
if [ "$_state" = "applied" ]; then
	_ok "persistence state is applied"
else
	_fail "persistence state is not applied after trigger (got: $_state)"
fi

if [ -f "$persist_file" ] && grep -q rklings "$persist_file"; then
	_ok "persistence file contains the module name"
else
	_fail "persistence file is missing or has wrong content"
fi

# Test rollback: unload should reverse the transaction
unload rklings

if [ -f "$persist_file" ] && ! grep -q rklings "$persist_file"; then
	_ok "persistence rolled back on unload"
else
	_fail "persistence file was not rolled back"
fi

if [ ! -f "$staging_file" ]; then
	_ok "staging file cleaned up"
else
	_fail "staging file still exists"
fi

assert_absent "$endpoint"

# Re-load and persist for the reboot test
: > "$persist_file"
chmod 0600 "$persist_file"

load rklings.ko
proc_write_test write "$endpoint" "$fixtures/persist" > /dev/null
sleep 1

if [ -f "$persist_file" ] && grep -q rklings "$persist_file"; then
	_ok "re-persisted for reboot test"
else
	_fail "re-persist failed"
fi

# Phase 1 passed: reboot to test actual persistence
if [ "$_fail" -gt 0 ]; then
	summary
fi

printf 'phase2\n' > "$marker"
reboot -f
while :; do sleep 1; done
