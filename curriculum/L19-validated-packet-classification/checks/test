#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-validated-packet-classification-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
for option in NET INET NETFILTER PROC_FS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] this lesson requires CONFIG_%s=y\n' "$option" >&2
		exit 1
	}
done
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || {
	printf '[x] pinned kernel build is not configured for GCC\n' >&2
	exit 1
}
for command in gcc make nm; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

for script in test host-check success-check failure-check.in; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check.in"
fi

source_root=$scratch/sources
mkdir "$source_root"
starter=$("$ROOTKITLINGS_ROOT/scripts/catalog" materialize starter L19 \
	"$source_root" --name starter-source)
solution=$("$ROOTKITLINGS_ROOT/scripts/catalog" materialize solution L19 \
	"$source_root" --name solution-source)

for tree in "$starter" "$solution"; do
	label=${tree##*/}
	cmp -s "$HERE/../../L16-hostile-packet-lengths/solution/parser/ipv4.c" \
		"$tree/parser/ipv4.c" || {
		printf '[x] %s parser differs from accepted L16\n' "$label" >&2
		exit 1
	}
	cmp -s "$HERE/../../L16-hostile-packet-lengths/solution/include/ipv4_parser.h" \
		"$tree/include/ipv4_parser.h" || {
		printf '[x] %s parser API differs from accepted L16\n' "$label" >&2
		exit 1
	}
	cmp -s "$HERE/../../L17-safe-skb-access/solution/access/skb_access.c" \
		"$tree/access/skb_access.c" || {
		printf '[x] %s skb access differs from accepted L17\n' "$label" >&2
		exit 1
	}
	cmp -s "$HERE/../../L17-safe-skb-access/starter/include/skb_access.h" \
		"$tree/include/skb_access.h" || {
		printf '[x] %s skb access API differs from accepted L17\n' "$label" >&2
		exit 1
	}
done

mapfile -t changed_files < <(
	diff -qr "$starter" "$solution" |
		sed -nE 's#^Files .*/starter-source/(.*) and .*/solution-source/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == classifier/udp.c ]] || {
	printf '[x] learner edit surface is %s, expected classifier/udp.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2 point=${3:-0}
	local log=$destination.log
	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "${source##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "${source##*/}" >&2
		exit 1
	fi
}

build_tree "$starter" "$scratch/starter"
build_tree "$solution" "$scratch/solution"
build_tree "$solution" "$scratch/register-failure" 1
build_tree "$solution" "$scratch/proc-failure" 2
"$HERE/host-check" "$scratch/solution" \
	"$scratch/solution/rootkitlings.ko"

if "$HERE/host-check" "$scratch/starter" \
	"$scratch/starter/rootkitlings.ko" > "$scratch/starter-host.log" 2>&1; then
	printf '[x] host checker accepted the unfinished classifier\n' >&2
	exit 1
fi

build_mutant()
{
	local name=$1
	cp -a "$solution" "$scratch/$name"
	shift
	"$@" "$scratch/$name/classifier/udp.c"
	local log=$scratch/$name.log
	if ! make -s -C "$KDIR" M="$scratch/$name" W=1 modules \
		> "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] mutant did not compile: %s\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] mutant build has warnings: %s\n' "$name" >&2
		exit 1
	fi
	if "$HERE/host-check" "$scratch/$name" \
		"$scratch/$name/rootkitlings.ko" > "$scratch/$name-host.log" 2>&1; then
		printf '[x] host checker accepted mutant: %s\n' "$name" >&2
		exit 1
	fi
}

mutate_little_endian()
{
	sed -i 's/((unsigned int)bytes\[0\] << 8) | bytes\[1\]/bytes[0] | ((unsigned int)bytes[1] << 8)/' "$1"
}
build_mutant little-endian mutate_little_endian

mutate_exact_payload()
{
	sed -i 's/datagram_length > ipv4->payload_length/datagram_length != ipv4->payload_length/' "$1"
}
build_mutant exact-payload mutate_exact_payload

mutate_buffer_as_datagram()
{
	sed -i 's/datagram_length > ipv4->payload_length/datagram_length > udp_header_length/' "$1"
}
build_mutant buffer-as-datagram mutate_buffer_as_datagram

mutate_early_output()
{
	sed -i '/datagram_length = rk_read_be16/a\
\tview->source_port = parsed.source_port;' "$1"
}
build_mutant early-output mutate_early_output

mutate_hardcoded_offsets()
{
	sed -i 's/parsed.datagram_offset = ipv4->payload_offset;/parsed.datagram_offset = 20;/' "$1"
	sed -i 's/parsed.payload_offset = ipv4->payload_offset + RK_UDP_HEADER_LENGTH;/parsed.payload_offset = 28;/' "$1"
}
build_mutant hardcoded-offsets mutate_hardcoded_offsets

mutate_protocol_first()
{
	sed -i 's/ || target_port > 65535//' "$1"
	sed -i '/return RK_UDP_OTHER_PROTOCOL;/a\
\tif (target_port > 65535)\
\t\treturn RK_UDP_MALFORMED;' "$1"
}
build_mutant protocol-before-argument mutate_protocol_first

mutate_extent_before_pointer()
{
	sed -i '/if (!udp_header)/,+1d' "$1"
	sed -i '/return RK_UDP_TRUNCATED;/a\
\tif (!udp_header)\
\t\treturn RK_UDP_MALFORMED;' "$1"
}
build_mutant extent-before-pointer mutate_extent_before_pointer

mutate_unaligned_cast()
{
	sed -i 's/((unsigned int)bytes\[0\] << 8) | bytes\[1\]/__builtin_bswap16(*(const unsigned short *)bytes)/' "$1"
}
build_mutant unaligned-cast mutate_unaligned_cast

mutate_inspect_other_protocol()
{
	sed -i 's/if (ipv4->protocol != RK_IPV4_PROTOCOL_UDP)$/if (ipv4->protocol != RK_IPV4_PROTOCOL_UDP) {/' "$1"
	sed -i '/return RK_UDP_OTHER_PROTOCOL;/i\
\t\tif (udp_header)\
\t\t\t(void)*(volatile const unsigned char *)udp_header;' "$1"
	sed -i '/return RK_UDP_OTHER_PROTOCOL;/a\
\t}' "$1"
}
build_mutant inspect-other-protocol mutate_inspect_other_protocol

equivalent=$scratch/equivalent
cp -a "$solution" "$equivalent"
sed -i 's/((unsigned int)bytes\[0\] << 8) | bytes\[1\]/bytes[1] + (unsigned int)bytes[0] * 256U/' \
	"$equivalent/classifier/udp.c"
sed -i 's/if (!ipv4 || !view || target_port > 65535)/if (!ipv4 || !view)/' \
	"$equivalent/classifier/udp.c"
sed -i '/if (ipv4->protocol != RK_IPV4_PROTOCOL_UDP)/i\
\tif (target_port > 65535)\
\t\treturn RK_UDP_MALFORMED;' "$equivalent/classifier/udp.c"
build_tree "$equivalent" "$scratch/equivalent-build"
"$HERE/host-check" "$scratch/equivalent-build" \
	"$scratch/equivalent-build/rootkitlings.ko"

cp -a "$solution" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 \
	ROOTKITLINGS_FAIL_POINT=99 modules > "$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

sed -e 's/@EXPECTED_ERRNO@/22/g' \
	-e 's/@LABEL@/Unfinished classifier rejection/g' \
	"$HERE/failure-check.in" > "$scratch/starter-failure-check"
sed -e 's/@EXPECTED_ERRNO@/97/g' \
	-e 's/@LABEL@/Netfilter registration failure rollback/g' \
	"$HERE/failure-check.in" > "$scratch/register-failure-check"
sed -e 's/@EXPECTED_ERRNO@/12/g' \
	-e 's/@LABEL@/Proc publication failure rollback/g' \
	"$HERE/failure-check.in" > "$scratch/proc-failure-check"
chmod 0755 "$scratch/"*failure-check

run_guest()
{
	local check_script=$1 module=$2 label=$3 output
	shift 3
	if ! output=$("$HERE/../../../vm/boot" --check "$check_script" \
		"$@" "$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest rejected %s\n' "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/success-check" "$scratch/solution/rootkitlings.ko" \
	solution --tool vm/tools/proc_read_test --tool vm/tools/packet_classifier_test
run_guest "$scratch/starter-failure-check" \
	"$scratch/starter/rootkitlings.ko" starter --tool vm/tools/module_load_test
run_guest "$scratch/register-failure-check" \
	"$scratch/register-failure/rootkitlings.ko" registration-failure \
	--tool vm/tools/module_load_test
run_guest "$scratch/proc-failure-check" \
	"$scratch/proc-failure/rootkitlings.ko" proc-failure \
	--tool vm/tools/module_load_test

printf '[+] validated-packet-classification passed\n'
