#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
begin "$label"

endpoint=/proc/rklings
ifconfig lo 127.0.0.1 up

attempt=1
while [ "$attempt" -le 2 ]; do
	if module_load_test /rklings/rklings.ko "$expected_errno"; then
		_ok "attempt $attempt returned errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rklings
	assert_absent "$endpoint"
	if grep -q '^rklings ' /proc/modules; then
		_fail "attempt $attempt left rklings in /proc/modules"
	else
		_ok "attempt $attempt left no loaded module"
	fi
	if ping -4 -q -c 1 -W 1 127.0.0.1 > /dev/null 2>&1; then
		_ok "IPv4 remains usable after attempt $attempt"
	else
		_fail "IPv4 failed after attempt $attempt"
	fi
	attempt=$((attempt + 1))
done

summary
