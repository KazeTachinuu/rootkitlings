#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR ARTIFACT_PATH"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
realpath -e -- "$2" >/dev/null 2>&1 || die "artifact not found: $2"
for path in execution/scheduler.c execution/scheduler.o; do
	[[ -f $build_dir/$path && ! -L $build_dir/$path ]] ||
		die "build output is missing regular file: $path"
done

command -v objdump >/dev/null || die "objdump is required"

for symbol in rk_state_timer_fires rk_state_record_timer_fire \
	rk_state_worker_runs rk_state_record_worker_run; do
	nm "$build_dir/core/state.o" | grep -Eq "[[:space:]]T[[:space:]]+$symbol$" ||
		die "core/state.o must define $symbol"
done

proc_undefined=$(nm -u "$build_dir/interface/proc.o")
for symbol in rk_state_timer_fires rk_state_worker_runs; do
	grep -Eq "[[:space:]]$symbol$" <<< "$proc_undefined" ||
		die "interface/proc.o has no $symbol dependency"
done

scheduler=$build_dir/execution/scheduler.o
scheduler_undefined=$(nm -u "$scheduler")
for symbol in mod_timer timer_shutdown_sync cancel_work_sync queue_work_on system_percpu_wq \
	rk_state_actions_enabled rk_state_record_worker_run rk_state_record_timer_fire; do
	grep -Eq "[[:space:]]$symbol$" <<< "$scheduler_undefined" ||
		die "execution/scheduler.o has no $symbol dependency"
done
if grep -Eq '[[:space:]](alloc_workqueue|apply_workqueue_attrs|__alloc_workqueue_key)$' \
	<<< "$scheduler_undefined"; then
	die "use the normal system workqueue through schedule_work"
fi
if grep -Eq '[[:space:]](__kmalloc|__kmalloc_cache_noprof|kmalloc_noprof|kfree|kvfree|vfree)$' \
	<<< "$scheduler_undefined"; then
	die "scheduler callbacks must use preallocated timer and work objects"
fi
if grep -Eq '[[:space:]](_printk|printk)$' <<< "$scheduler_undefined"; then
	die "scheduler behavior must be observable through owned state, not logging"
fi

scheduler_disassembly=$(objdump -dr "$scheduler")
timer_disassembly=$(sed -n '/<rk_action_timer>:/,/^$/p' <<< "$scheduler_disassembly")
work_disassembly=$(sed -n '/<rk_action_run>:/,/^$/p' <<< "$scheduler_disassembly")
[[ -n $timer_disassembly ]] || die "execution/scheduler.c must define rk_action_timer"
[[ -n $work_disassembly ]] || die "execution/scheduler.c must define rk_action_run"

expected_functions=$'rk_action_run\nrk_action_timer\nrk_scheduler_start\nrk_scheduler_stop'
actual_functions=$(nm --defined-only "$scheduler" |
	awk '$2 ~ /^[tT]$/ { print $3 }' | LC_ALL=C sort)
[[ $actual_functions == "$expected_functions" ]] ||
	die "execution/scheduler.c must define only the four scaffolded functions"

call_relocations()
{
	awk '$2 ~ /^R_[^[:space:]]*(PLT|CALL)/ {
		symbol = $3
		sub(/[+-].*$/, "", symbol)
		print symbol
	}' <<< "$1"
}

assert_direct_calls()
{
	local function=$1 disassembly=$2 symbol calls count
	shift 2
	calls=$(call_relocations "$disassembly")
	while IFS= read -r symbol; do
		[[ -n $symbol ]] || continue
		case " $* " in
			*" $symbol "*) ;;
			*)
				case "$symbol" in
					__fentry__|__x86_return_thunk) ;;
					*) die "$function directly calls unexpected symbol: $symbol" ;;
				esac
			;;
		esac
	done <<< "$calls"
	for symbol in "$@"; do
		count=$(awk -v expected="$symbol" '$0 == expected { count++ }
			END { print count + 0 }' <<< "$calls")
		[[ $count -eq 1 ]] ||
			die "$function must directly call $symbol exactly once"
	done
	if grep -Eq '[[:space:]](call|jmp)[[:space:]]+\*' <<< "$disassembly"; then
		die "$function must not call through a function pointer"
	fi
}

assert_direct_calls rk_action_timer "$timer_disassembly" \
	rk_state_record_timer_fire queue_work_on mod_timer
assert_direct_calls rk_action_run "$work_disassembly" \
	rk_state_actions_enabled rk_state_record_worker_run
all_scheduler_calls=$(call_relocations "$scheduler_disassembly")
for symbol in rk_state_record_timer_fire rk_state_record_worker_run; do
	count=$(awk -v expected="$symbol" '$0 == expected { count++ }
		END { print count + 0 }' <<< "$all_scheduler_calls")
	[[ $count -eq 1 ]] || die "$symbol must have exactly one scheduler caller"
done

state_disassembly=$(objdump -dr "$build_dir/core/state.o")
for function in rk_state_record_timer_fire rk_state_actions_enabled \
	rk_state_record_worker_run; do
	helper_disassembly=$(sed -n "/<$function>:/,/^$/p" <<< "$state_disassembly")
	[[ -n $helper_disassembly ]] || die "core/state.c must define $function"
	assert_direct_calls "$function" "$helper_disassembly"
	if grep -Eq '[[:space:]]lock[[:space:]]' <<< "$helper_disassembly"; then
		die "$function must remain a lock-free single-writer helper"
	fi
done

main_undefined=$(nm -u "$build_dir/core/main.o")
for symbol in rk_scheduler_start rk_scheduler_stop; do
	grep -Eq "[[:space:]]$symbol$" <<< "$main_undefined" ||
		die "core/main.o has no $symbol dependency"
done

printf '[+] timer deferral, single-writer counters, and teardown verified\n'
