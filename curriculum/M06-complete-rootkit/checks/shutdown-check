#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Clean shutdown"

load rklings.ko
assert_loaded rklings

# Exercise a few features before unloading
mkdir rklings.h.m 2>/dev/null
mkdir rklings.u.m 2>/dev/null
mkdir rklings.persist 2>/dev/null
mkdir rklings.unpersist 2>/dev/null

unload rklings

if grep -q rklings /proc/modules 2>/dev/null; then
	_fail "module still loaded after rmmod"
else
	_ok "module unloaded cleanly"
fi

if dmesg | grep -Eqi '(BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task)'; then
	_fail "kernel log contains a fault report"
else
	_ok "kernel log is clean after unload"
fi

summary
