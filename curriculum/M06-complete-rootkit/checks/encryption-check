#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Encryption"

load rklings.ko
assert_loaded rklings

# Verify that the module loaded the crypto subsystem.
if grep -q 'rklings' /proc/modules 2>/dev/null; then
	_ok "module loaded with crypto support"
else
	_fail "module not loaded"
fi

# If the secure-agent-fixture is available, send a command and verify
# the response is encrypted (non-empty, non-plaintext).
if [ -x /vm/tools/secure_agent_fixture ]; then
	if secure_agent_fixture verify-encryption 2>/dev/null; then
		_ok "traffic is AES-256-GCM encrypted"
	else
		_fail "encryption verification failed"
	fi
else
	_ok "secure-agent-fixture not available (skipped)"
fi

unload rklings

summary
