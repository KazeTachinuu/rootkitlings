#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Remote commands"

load rklings.ko
assert_loaded rklings

# The remote check verifies that the wire protocol listener accepts
# connections and processes encrypted commands. The secure-agent-fixture
# tool handles key provisioning and encrypted communication.

if [ -x /vm/tools/secure_agent_fixture ]; then
	if secure_agent_fixture ping 2>/dev/null; then
		_ok "remote ping via encrypted channel"
	else
		_fail "remote ping failed"
	fi

	if secure_agent_fixture status 2>/dev/null; then
		_ok "remote status via encrypted channel"
	else
		_fail "remote status failed"
	fi
else
	_ok "secure-agent-fixture not available (skipped)"
fi

unload rklings

summary
