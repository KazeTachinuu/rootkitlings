#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
baseline=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-transactional-credential-replacement-baseline.XXXXXX")
work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-transactional-credential-replacement-work.XXXXXX")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-transactional-credential-replacement-test.XXXXXX")
trap 'rm -rf -- "$baseline" "$work" "$scratch"' EXIT

cp -a "$HERE/../../L02-owned-kernel-state/solution/." "$baseline/"
cp -a "$HERE/../../L03-proc-publication/solution/." "$baseline/"
cp -a "$HERE/../../L04-proc-read-contract/solution/." "$baseline/"
cp -a "$HERE/../../L05-bounded-control-switch/solution/." "$baseline/"
cp -a "$HERE/../../L08-current-task-attribution/solution/." "$baseline/"
cp -a "$HERE/../../L09-linux-credential-model/solution/." "$baseline/"
cp -a "$baseline/." "$work/"
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../starter/"}
	mkdir -p "$work/$(dirname "$relative")"
	cp -p "$source" "$work/$relative"
done < <(find "$HERE/../starter" -type f -print0)
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../solution/"}
	mkdir -p "$work/$(dirname "$relative")"
	cp -p "$source" "$work/$relative"
done < <(find "$HERE/../solution" -type f -print0)

grep -qx 'CONFIG_MULTIUSER=y' "$KDIR/.config" || {
	printf '[x] this lesson requires CONFIG_MULTIUSER=y\n' >&2
	exit 1
}
grep -qx 'CONFIG_USER_NS=y' "$KDIR/.config" || {
	printf '[x] this lesson requires CONFIG_USER_NS=y\n' >&2
	exit 1
}

for compiler in gcc clang; do
	command -v "$compiler" >/dev/null || {
		printf '[x] %s is required\n' "$compiler" >&2
		exit 1
	}
	"$compiler" -std=c11 -Wall -Wextra -Werror -pthread -static \
		-o "$scratch/cred_trigger_test.$compiler" \
		"$HERE/../../../vm/tools/cred_trigger_test.c"
done
make -s -C "$HERE/../../.." -B vm/tools/cred_trigger_test

mapfile -t changed_files < <(
	diff -qr "$HERE/../starter" "$HERE/../solution" |
		sed -nE 's#^Files .*/template/(.*) and .*/solution/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == privilege/credentials.c ]] || {
	printf '[x] learner edit surface is %s, expected privilege/credentials.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

template_build=$scratch/starter
cp -a "$baseline" "$template_build"
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../starter/"}
	mkdir -p "$template_build/$(dirname "$relative")"
	cp -p "$source" "$template_build/$relative"
done < <(find "$HERE/../starter" -type f -print0)
if ! make -s -C "$KDIR" M="$template_build" W=1 \
	ROOTKITLINGS_FAIL_POINT=0 modules >"$scratch/template.log" 2>&1; then
	cat "$scratch/template.log" >&2
	printf '[x] template build failed\n' >&2
	exit 1
fi
if grep -q 'warning:' "$scratch/template.log"; then
	cat "$scratch/template.log" >&2
	printf '[x] template builds with warnings\n' >&2
	exit 1
fi

build_variant()
{
	local name=$1 point=$2 destination=$scratch/$1 log=$scratch/$1.log
	cp -a "$work" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules >"$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s builds with warnings\n' "$name" >&2
		exit 1
	fi
}

build_variant success 0
build_variant preflight 1
build_variant allocation 2
build_variant publication 3
build_variant credential_prepare 4
build_variant credential_cancel 5
"$HERE/host-check" "$scratch/success" "$scratch/success/rootkitlings.ko" \
	"$scratch/credential_cancel"

formatted=$scratch/host-formatting
cp -a "$scratch/success" "$formatted"
awk '
	/replacement = prepare_kernel_cred\(&init_task\);/ {
		print "\treplacement = prepare_kernel_cred("
		print "\t\t&init_task"
		print "\t);"
		next
	}
	/return commit_creds\(replacement\);/ {
		print "\treturn commit_creds("
		print "\t\treplacement"
		print "\t);"
		next
	}
	{ print }
' "$formatted/privilege/credentials.c" > "$formatted/privilege/credentials.c.new"
mv "$formatted/privilege/credentials.c.new" "$formatted/privilege/credentials.c"
"$HERE/host-check" "$formatted" "$formatted/rootkitlings.ko" \
	"$scratch/credential_cancel" > "$scratch/host-formatting.log"

duplicate=$scratch/host-duplicate
cp -a "$scratch/success" "$duplicate"
sed -i '/replacement = prepare_kernel_cred/a\	replacement = prepare_kernel_cred(\&init_task);' \
	"$duplicate/privilege/credentials.c"
if "$HERE/host-check" "$duplicate" "$duplicate/rootkitlings.ko" \
	"$scratch/credential_cancel" > "$scratch/host-duplicate.log" 2>&1; then
	printf '[x] host checker accepted two credential preparations\n' >&2
	exit 1
fi

retained=$scratch/host-retained
cp -a "$scratch/success" "$retained"
sed -i '2i static struct cred *retained_credential;' \
	"$retained/privilege/credentials.c"
if "$HERE/host-check" "$retained" "$retained/rootkitlings.ko" \
	"$scratch/credential_cancel" > "$scratch/host-retained.log" 2>&1; then
	printf '[x] host checker accepted a retained credential pointer\n' >&2
	exit 1
fi

partial=$scratch/host-partial
cp -a "$scratch/success" "$partial"
sed -i '/replacement = prepare_kernel_cred/a\	(*replacement).\
\t\tuid = (*replacement).uid;' \
	"$partial/privilege/credentials.c"
if "$HERE/host-check" "$partial" "$partial/rootkitlings.ko" \
	"$scratch/credential_cancel" > "$scratch/host-partial.log" 2>&1; then
	printf '[x] host checker accepted multiline credential field access\n' >&2
	exit 1
fi

wrong_null=$scratch/host-wrong-null
cp -a "$scratch/success" "$wrong_null"
sed -i '/if (!replacement)/{n;s/return -ENOMEM;/return 0;/;}' \
	"$wrong_null/privilege/credentials.c"
if "$HERE/host-check" "$wrong_null" "$wrong_null/rootkitlings.ko" \
	"$scratch/credential_cancel" > "$scratch/host-wrong-null.log" 2>&1; then
	printf '[x] host checker accepted an incorrect NULL result\n' >&2
	exit 1
fi

abort_after_commit=$scratch/host-abort-after-commit
cp -a "$scratch/success" "$abort_after_commit"

sed -i '/struct cred \*replacement;/a\	int error;' \
	"$abort_after_commit/privilege/credentials.c"
sed -i '/abort_creds(replacement);/d' \
	"$abort_after_commit/privilege/credentials.c"
sed -i '/return commit_creds(replacement);/c\	error = commit_creds(replacement);\
\tabort_creds(replacement);\
\treturn error;' \
	"$abort_after_commit/privilege/credentials.c"
make -s -C "$KDIR" M="$abort_after_commit" W=1 \
	ROOTKITLINGS_FAIL_POINT=0 modules \
	> "$scratch/host-abort-after-commit-build.log" 2>&1
if grep -q 'warning:' "$scratch/host-abort-after-commit-build.log"; then
	cat "$scratch/host-abort-after-commit-build.log" >&2
	printf '[x] abort-after-commit fixture builds with warnings\n' >&2
	exit 1
fi
if "$HERE/host-check" "$abort_after_commit" \
	"$abort_after_commit/rootkitlings.ko" "$scratch/credential_cancel" \
	> "$scratch/host-abort-after-commit.log" 2>&1; then
	printf '[x] host checker accepted abort after commit\n' >&2
	exit 1
fi

cp -a "$work" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 ROOTKITLINGS_FAIL_POINT=99 \
	modules >"$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

sed -e 's/@EXPECTED_ERRNO@/12/g' \
	-e 's/@LABEL@/Credential preparation failure/g' \
	"$HERE/credential-failure-check.in" > "$scratch/prepare-check"
sed -e 's/@EXPECTED_ERRNO@/125/g' \
	-e 's/@LABEL@/Credential cancellation/g' \
	"$HERE/credential-failure-check.in" > "$scratch/cancel-check"
chmod 0755 "$scratch/prepare-check" "$scratch/cancel-check"

run_guest()
{
	local check_script=$1 module=$2 output
	shift 2
	if ! output=$("$HERE/../../../vm/boot" --check "$check_script" \
		--tool vm/tools/run_as "$@" \
		"$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest did not complete\n' >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/../../L03-proc-publication/checks/failure-ecanceled-check" \
	"$scratch/preflight/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/../../L03-proc-publication/checks/failure-enomem-check" \
	"$scratch/allocation/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$HERE/../../L03-proc-publication/checks/failure-after-state-check" \
	"$scratch/publication/rootkitlings.ko" --tool vm/tools/module_load_test
run_guest "$scratch/prepare-check" \
	"$scratch/credential_prepare/rootkitlings.ko" \
	--tool vm/tools/cred_trigger_test --tool vm/tools/proc_write_test
run_guest "$scratch/cancel-check" \
	"$scratch/credential_cancel/rootkitlings.ko" \
	--tool vm/tools/cred_trigger_test --tool vm/tools/proc_write_test
run_guest "$HERE/success-check" "$scratch/success/rootkitlings.ko" \
	--tool vm/tools/cred_trigger_test --tool vm/tools/proc_write_test
