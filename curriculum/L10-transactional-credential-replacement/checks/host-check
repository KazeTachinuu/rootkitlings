#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 3 )) ||
	die "usage: ${0##*/} SUCCESS_DIR SUCCESS_ARTIFACT CANCEL_DIR"
success_dir=$(realpath -e -- "$1" 2>/dev/null) ||
	die "success directory not found: $1"
artifact=$(realpath -e -- "$2" 2>/dev/null) ||
	die "artifact not found: $2"
cancel_dir=$(realpath -e -- "$3" 2>/dev/null) ||
	die "cancel directory not found: $3"
success_object=$success_dir/privilege/credentials.o
cancel_object=$cancel_dir/privilege/credentials.o

[[ -f $artifact && ! -L $artifact ]] ||
	die "artifact must be a regular file"
for object in "$success_object" "$cancel_object"; do
	[[ -f $object && ! -L $object ]] ||
		die "build is missing ${object#*/}"
done

success_undefined=$(nm -u "$success_object" | awk '{ print $NF }')
for symbol in commit_creds init_task prepare_kernel_cred; do
	grep -Fxq "$symbol" <<< "$success_undefined" ||
		die "success path has no $symbol dependency"
done
for forbidden in abort_creds prepare_creds; do
	if grep -Fxq "$forbidden" <<< "$success_undefined"; then
		die "success path depends on $forbidden"
	fi
done

cancel_undefined=$(nm -u "$cancel_object" | awk '{ print $NF }')
for symbol in abort_creds init_task prepare_kernel_cred; do
	grep -Fxq "$symbol" <<< "$cancel_undefined" ||
		die "cancellation path has no $symbol dependency"
done
if grep -Fxq commit_creds <<< "$cancel_undefined"; then
	die "cancellation path publishes the prepared credential"
fi

nm -g --defined-only "$success_object" | awk '{ print $3 }' |
	grep -Fxq rk_credentials_replace_current ||
	die "credential object does not export its replacement operation"
if nm --defined-only "$success_object" |
	awk '$2 ~ /^[bBdD]$/ && $3 !~ /^(__UNIQUE_ID|__already_done)/ { found = 1 }
		END { exit !found }'; then
	die "credential operation retains mutable global state"
fi

proc_undefined=$(nm -u "$success_dir/interface/proc.o" | awk '{ print $NF }')
grep -Fxq rk_credentials_replace_current <<< "$proc_undefined" ||
	die "control endpoint does not use the credential operation"

printf '[+] compiled credential commit and cancellation paths verified\n'
