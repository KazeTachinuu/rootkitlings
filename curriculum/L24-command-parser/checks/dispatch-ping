#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Command dispatch: PING handler compiles and module lifecycle"

# The dispatch function routes parsed commands to stub handlers.
# Since the handlers are internal (no network, no proc exposure), we verify
# the module loads and unloads, which confirms the dispatch switch statement
# and all handler stubs compile without error.

assert_absent /sys/module/rklings

load rklings.ko
assert_loaded rklings

# Module description confirms this is the command parser module
DESC=$(modinfo -F description /rklings/rklings.ko 2>/dev/null)
if [ -n "$DESC" ]; then
  _ok "module has description: $DESC"
else
  # modinfo may not be available in minimal BusyBox; skip gracefully
  _ok "module loaded (modinfo not available for description check)"
fi

unload rklings
assert_absent /sys/module/rklings

summary
