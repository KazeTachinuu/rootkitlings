#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR ARTIFACT_PATH"
build_dir=$(realpath -e -- "$1" 2>/dev/null) ||
	die "build directory not found: $1"
artifact=$(realpath -e -- "$2" 2>/dev/null) ||
	die "artifact not found: $2"
object=$build_dir/interface/proc.o

[[ -f $artifact && ! -L $artifact ]] ||
	die "artifact must be a regular file"
[[ -f $object && ! -L $object ]] ||
	die "build is missing interface/proc.o"

undefined=$(nm -u "$object" | awk '{ print $NF }')
for symbol in from_kuid_munged from_kgid_munged init_user_ns; do
	grep -Fxq "$symbol" <<< "$undefined" ||
		die "credential view has no $symbol dependency"
done
for forbidden in abort_creds commit_creds get_task_cred override_creds \
		prepare_creds prepare_kernel_cred put_cred revert_creds; do
	if grep -Fxq "$forbidden" <<< "$undefined"; then
		die "read-only credential view depends on $forbidden"
	fi
done
if grep -Eq \
		'^(__kmalloc|__kmalloc_cache_noprof|kmalloc_noprof|kfree|kvfree|vfree)$' \
		<<< "$undefined"; then
	die "credential rendering must not allocate"
fi

printf '[+] compiled credential view is read-only and namespace-aware\n'
