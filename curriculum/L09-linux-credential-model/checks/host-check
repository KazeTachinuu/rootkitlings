#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR ARTIFACT_PATH"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

"$here/../../L08-current-task-attribution/checks/host-check" "$build_dir" "$artifact"

source=$build_dir/interface/proc.c
source_text=$(tr '\n' ' ' < "$source")
proc_undefined=$(nm -u "$build_dir/interface/proc.o")
for symbol in from_kuid_munged from_kgid_munged init_user_ns; do
	grep -Eq "[[:space:]]$symbol$" <<< "$proc_undefined" ||
		die "interface/proc.o has no $symbol dependency"
done

mapfile -t current_cred_calls < <(
	grep -Eo '\bcurrent_cred[[:space:]]*\(' <<< "$source_text" || true
)
(( ${#current_cred_calls[@]} == 1 )) ||
	die "take exactly one current_cred() snapshot"
mapfile -t credential_vars < <(
	grep -oE 'const[[:space:]]+struct[[:space:]]+cred[[:space:]]*\*[[:space:]]*[[:alpha:]_][[:alnum:]_]*' <<< "$source_text" |
		sed -E 's/.*\*[[:space:]]*//'
)
(( ${#credential_vars[@]} == 1 )) ||
	die "declare exactly one local const credential pointer"
mapfile -t all_credential_vars < <(
	grep -oE 'struct[[:space:]]+cred[[:space:]]*\*[[:space:]]*[[:alpha:]_][[:alnum:]_]*' <<< "$source_text" |
		sed -E 's/.*\*[[:space:]]*//'
)
(( ${#all_credential_vars[@]} == 1 )) ||
	die "do not introduce a second or mutable credential pointer"
credential_var=${credential_vars[0]}
grep -Eq "\b${credential_var}[[:space:]]*=[[:space:]]*current_cred[[:space:]]*\(" <<< "$source_text" ||
	die "assign current_cred() to the local const credential pointer"
mapfile -t seq_user_ns_calls < <(
	grep -Eo '\bseq_user_ns[[:space:]]*\(' <<< "$source_text" || true
)
(( ${#seq_user_ns_calls[@]} == 1 )) ||
	die "obtain the opener namespace exactly once with seq_user_ns()"
mapfile -t namespace_vars < <(
	grep -oE 'struct[[:space:]]+user_namespace[[:space:]]*\*[[:space:]]*[[:alpha:]_][[:alnum:]_]*' <<< "$source_text" |
		sed -E 's/.*\*[[:space:]]*//'
)
(( ${#namespace_vars[@]} == 1 )) ||
	die "declare exactly one local user-namespace pointer"
namespace_var=${namespace_vars[0]}
grep -Eq "\b${namespace_var}[[:space:]]*=[[:space:]]*seq_user_ns[[:space:]]*\(" <<< "$source_text" ||
	die "assign seq_user_ns() to the local namespace pointer"

for field in uid euid suid fsuid; do
	grep -Eq "from_kuid_munged[[:space:]]*\([^,]+,[[:space:]]*${credential_var}->${field}[[:space:]]*\)" <<< "$source_text" ||
		die "translate the snapshot's $field through from_kuid_munged()"
done
for field in gid egid sgid fsgid; do
	grep -Eq "from_kgid_munged[[:space:]]*\([^,]+,[[:space:]]*${credential_var}->${field}[[:space:]]*\)" <<< "$source_text" ||
		die "translate the snapshot's $field through from_kgid_munged()"
done
[[ $(grep -Eo "from_kuid_munged[[:space:]]*\([[:space:]]*${namespace_var}[[:space:]]*," <<< "$source_text" | wc -l) -eq 4 ]] ||
	die "translate all four UIDs through the opener namespace"
[[ $(grep -Eo "from_kgid_munged[[:space:]]*\([[:space:]]*${namespace_var}[[:space:]]*," <<< "$source_text" | wc -l) -eq 4 ]] ||
	die "translate all four GIDs through the opener namespace"

if grep -Eq '\b(__kuid_val|__kgid_val|from_kuid|from_kgid)[[:space:]]*\(' <<< "$source_text"; then
	die "use only the munged namespace translation helpers"
fi
if grep -Eq 'from_k(uid|gid)_munged[[:space:]]*\([[:space:]]*&init_user_ns' <<< "$source_text"; then
	die "ID rendering must use the opener namespace, not init_user_ns"
fi

grep -Eq "${credential_var}->user_ns[[:space:]]*==[[:space:]]*&init_user_ns" <<< "$source_text" ||
	die "report whether capability sets are anchored in init_user_ns"
for field in cap_permitted cap_effective; do
	grep -Eq "\(unsigned[[:space:]]+long[[:space:]]+long\)[[:space:]]*${credential_var}->${field}\.val" <<< "$source_text" ||
		die "render $field as fixed-width hexadecimal"
done
if grep -Eq '\bseq_put_hex_ll[[:space:]]*\(' <<< "$source_text"; then
	die "seq_put_hex_ll is not exported to external modules"
fi
mapfile -t capability_formats < <(
	grep -Eo '%016llx' <<< "$source_text" || true
)
(( ${#capability_formats[@]} == 2 )) ||
	die "render exactly two fixed-width capability sets"

if grep -Eq '\b(cap_inheritable|cap_bset|cap_ambient|securebits|group_info|session_keyring|process_keyring|thread_keyring)\b' <<< "$source_text"; then
	die "the record contains credential state outside this lesson's contract"
fi
if grep -Eq '\b(prepare_creds|prepare_kernel_cred|commit_creds|abort_creds|override_creds|revert_creds|get_current_cred|get_task_cred|put_cred)[[:space:]]*\(' <<< "$source_text"; then
	die "this lesson must only read the immediate current credential snapshot"
fi
if grep -Eq 'current_real_cred[[:space:]]*\(' <<< "$source_text"; then
	die "report current's subjective credentials, not real_cred"
fi
if grep -Eq '\([[:space:]]*struct[[:space:]]+cred[[:space:]]*\*' <<< "$source_text"; then
	die "do not cast away credential constness"
fi

printf '[+] immutable current credentials, opener-relative IDs, and capability scope verified\n'
