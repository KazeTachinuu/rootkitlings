#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Linux credential model"

assert_not_loaded()
{
	assert_absent /sys/module/rklings
	assert_absent /proc/rklings
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings appears in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
}

check_loaded()
{
	assert_loaded rklings
	assert_exists /proc/rklings
	mode=$(stat -c '%a' /proc/rklings)
	if [ "$mode" = 444 ]; then
		_ok "/proc/rklings mode is 0444"
	else
		_fail "/proc/rklings mode: expected 0444, got $mode"
	fi
}

run_case()
{
	label=$1
	shift
	if "$@"; then
		_ok "$label"
	else
		_fail "$label"
	fi
}

assert_not_loaded
for attempt in 1 2; do
	load rklings.ko
	check_loaded
	run_case "attempt $attempt initial root snapshot" \
		credential_snapshot_test current /proc/rklings
	run_case "attempt $attempt initial unprivileged snapshot" \
		run_as 65534 65534 credential_snapshot_test current /proc/rklings
	run_case "attempt $attempt distinct credential roles" \
		credential_snapshot_test roles /proc/rklings
	run_case "attempt $attempt credentials changed after open" \
		credential_snapshot_test after-open /proc/rklings
	run_case "attempt $attempt nested user namespace snapshot" \
		run_as 65534 65534 busybox unshare -Ur \
		credential_snapshot_test current /proc/rklings
	run_case "attempt $attempt opener and reader namespace split" \
		credential_snapshot_test cross-ns /proc/rklings
	unload rklings
	assert_not_loaded
done

summary
