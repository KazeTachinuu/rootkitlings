#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Self-escalation via mkdir rklings.e"

load rklings.ko
assert_loaded rklings

# Verify /proc/rklings exists
assert_exists /proc/rklings

# As non-root student, mkdir rklings.e should escalate self to uid 0
uid=$(su student -c 'mkdir /tmp/rklings.e 2>/dev/null; id -u')
if [ "$uid" = "0" ]; then
    _ok "self-escalation returned uid 0"
else
    _fail "expected uid 0 after self-escalation, got $uid"
fi

# Check dmesg for the escalation log
assert_log "rklings: escalated pid"

# Cleanup
rm -rf /tmp/rklings.e 2>/dev/null
unload rklings

summary
