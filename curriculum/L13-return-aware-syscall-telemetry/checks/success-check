#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Return-aware rmdir telemetry"

endpoint=/proc/rootkitlings
registry=/sys/kernel/debug/kprobes/list
selected=/tmp/rootkitlings-rmdir-watch
near=/tmp/rootkitlings-rmdir-watch-extra
other=/tmp/rootkitlings-rmdir-other
fixtures=/tmp/rootkitlings-return-telemetry
actual=$fixtures/actual
mkdir -p "$fixtures"

probe_count()
{
	awk '
		$2 == "r" {
			split($3, name, "+")
			if (name[1] == "__x64_sys_rmdir")
				count++
		}
		END { print count + 0 }
	' "$registry"
}

assert_registry_delta()
{
	expected=$1
	label=$2
	now=$(probe_count)
	if [ "$now" -eq $((probe_before + expected)) ]; then
		_ok "$label has the expected return probe"
	else
		_fail "$label: expected probe delta $expected, got $((now - probe_before))"
	fi
}

assert_status()
{
	actions=$1
	success=$2
	failure=$3
	label=$4
	printf 'active=1\nactions=%s\nselected_success_seen=%s\nselected_failure_seen=%s\nreturn_capacity=16\nreturns_missed=0\n' \
		"$actions" "$success" "$failure" > "$fixtures/expected"
	if cat "$endpoint" > "$actual" && cmp -s "$fixtures/expected" "$actual"; then
		_ok "$label returns the complete status record"
	else
		_fail "$label returned an unexpected status record"
		printf '%s\n' 'expected:' >&2
		cat "$fixtures/expected" >&2
		printf '%s\n' 'actual:' >&2
		cat "$actual" >&2
	fi
}

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	rm -rf "$fixtures" "$selected" "$near" "$other" \
		/tmp/rootkitlings-rmdir-other-* /tmp/rootkitlings-rmdir-stress-* \
		2>/dev/null || true
}
trap cleanup EXIT INT TERM

test -r "$registry" || {
	_fail "Kprobe registry is not readable"
	summary
}
probe_before=$(probe_count)

case $(uname -r) in
	7.2.*|7.2-*) _ok "guest runs the supported Linux 7.2 ABI" ;;
	*) _fail "guest kernel is not Linux 7.2.x" ;;
esac
if [ "$(uname -m)" = x86_64 ]; then
	_ok "guest architecture is x86_64"
else
	_fail "guest architecture is not x86_64"
fi
if [ -r /proc/config.gz ]; then
	busybox gzip -dc /proc/config.gz > "$fixtures/config"
	for option in X86_64 KPROBES KRETPROBES KRETPROBE_ON_RETHOOK \
		KPROBES_ON_FTRACE KALLSYMS KALLSYMS_ALL DEBUG_FS \
		ARCH_HAS_SYSCALL_WRAPPER; do
		if grep -qx "CONFIG_$option=y" "$fixtures/config"; then
			_ok "CONFIG_$option is enabled"
		else
			_fail "CONFIG_$option is not enabled"
		fi
	done
else
	_fail "guest kernel configuration is unavailable"
fi
if awk '$3 == "__x64_sys_rmdir" { found = 1 } END { exit !found }' \
	/proc/kallsyms; then
	_ok "native rmdir wrapper exists in the running kernel"
else
	_fail "native rmdir wrapper is absent"
fi

load rootkitlings.ko
assert_loaded rootkitlings
assert_exists "$endpoint"
assert_registry_delta 1 "loaded state"
assert_status disabled 0 0 "initial state"

mkdir "$selected"
if rmdir "$selected" && ! test -e "$selected"; then
	_ok "disabled selected rmdir keeps its successful result"
else
	_fail "disabled selected rmdir did not succeed normally"
fi
if rmdir "$selected" 2>/dev/null; then
	_fail "disabled missing selected path unexpectedly succeeded"
else
	_ok "disabled missing selected path keeps its failed result"
fi
assert_status disabled 0 0 "disabled observations"

printf 'enable\n' > "$endpoint"
assert_status enabled 0 0 "enabled state from newline-terminated command"
printf 'disable\n' > "$endpoint"
assert_status disabled 0 0 "disabled state from newline-terminated command"
printf enable > "$endpoint"
assert_status enabled 0 0 "re-enabled state"

mkdir "$near"
if rmdir "$near" && ! test -e "$near"; then
	_ok "near-match path keeps its successful result"
else
	_fail "near-match path did not succeed normally"
fi
if rmdir "$other" 2>/dev/null; then
	_fail "unmatched missing path unexpectedly succeeded"
else
	_ok "unmatched missing path keeps its failed result"
fi
assert_status enabled 0 0 "unmatched paths"

if rmdir_telemetry_test invalid; then
	_ok "invalid userspace pointer returns EFAULT without a kernel fault"
else
	_fail "invalid userspace pointer was not handled safely"
fi
if rmdir_telemetry_test boundary; then
	_ok "unterminated page-boundary path returns EFAULT safely"
else
	_fail "page-boundary path was not handled safely"
fi
assert_status enabled 0 0 "hostile userspace pointers"

if rmdir_telemetry_test concurrent; then
	_ok "concurrent selected and unmatched calls keep their normal results"
else
	_fail "concurrent rmdir workload failed"
fi
assert_status enabled 1 0 "concurrent return correlation"

if rmdir "$selected" 2>/dev/null; then
	_fail "selected missing path unexpectedly succeeded"
else
	_ok "selected missing path keeps its failed result"
fi
assert_status enabled 1 1 "selected failure result"

rmdir_telemetry_test stress 3 &
stress_pid=$!
sleep 1
unload rootkitlings
if wait "$stress_pid"; then
	_ok "ordinary rmdir calls remain valid across unload"
else
	_fail "rmdir stress failed while unloading"
fi
assert_absent "$endpoint"
assert_registry_delta 0 "unloaded state"

load rootkitlings.ko
assert_loaded rootkitlings
assert_registry_delta 1 "reloaded state"
assert_status disabled 0 0 "fresh reload"
unload rootkitlings
assert_absent "$endpoint"
assert_registry_delta 0 "second unloaded state"

mkdir "$selected"
if rmdir "$selected" && ! test -e "$selected"; then
	_ok "selected rmdir remains normal after final unload"
else
	_fail "selected rmdir changed after final unload"
fi

summary
