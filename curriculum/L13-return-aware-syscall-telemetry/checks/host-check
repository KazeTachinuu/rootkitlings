#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

extract_function()
{
	local source=$1 name=$2
	awk -v name="$name" '
		BEGIN { found = 0; depth = 0; opened = 0 }
		!found && $0 ~ name "[[:space:]]*\\(" { found = 1 }
		found {
			print
			line = $0
			opens = gsub(/\{/, "{", line)
			line = $0
			closes = gsub(/\}/, "}", line)
			if (opens > 0) opened = 1
			depth += opens - closes
			if (opened && depth == 0) exit
		}
	' "$source"
}

strip_c_comments()
{
	python3 -c 'import re, sys
source = sys.stdin.read()
sys.stdout.write(re.sub(r"/\*.*?\*/|//[^\n]*", "", source, flags=re.S))'
}

flatten_function()
{
	strip_c_comments | tr -d '[:space:]'
}

(( $# == 3 )) || die "usage: ${0##*/} SUCCESS_DIR SUCCESS_ARTIFACT MISSING_DIR"
success_dir=$(realpath -e -- "$1" 2>/dev/null) || die "success directory not found: $1"
success_artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"
missing_dir=$(realpath -e -- "$3" 2>/dev/null) || die "missing-target directory not found: $3"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

"$here/../../L05-bounded-control-switch/checks/host-check" \
	"$success_dir" "$success_artifact"

for path in instrumentation/return_probe.c instrumentation/return_probe.o; do
	[[ -f $success_dir/$path && ! -L $success_dir/$path ]] ||
		die "success build is missing regular file: $path"
done
[[ -f $missing_dir/instrumentation/return_probe.o &&
	! -L $missing_dir/instrumentation/return_probe.o ]] ||
	die "missing-target build lacks instrumentation/return_probe.o"

source_file=$success_dir/instrumentation/return_probe.c
missing_source=$missing_dir/instrumentation/return_probe.c
source_text=$(strip_c_comments < "$source_file" | tr '\n' ' ')
source_flat=$(tr -d '[:space:]' <<< "$source_text")
missing_text=$(strip_c_comments < "$missing_source" | tr '\n' ' ')

mapfile -t state_declarations < <(
	grep -E '^[[:space:]]*static[[:space:]]+struct[[:space:]]+rk_state[[:space:]]*\*[[:space:]]*[[:alnum:]_]+[[:space:]]*;' \
		"$source_file"
)
(( ${#state_declarations[@]} == 1 )) ||
	die "define exactly one private borrowed-state pointer"
state_name=$(sed -E 's/.*\*[[:space:]]*([[:alnum:]_]+)[[:space:]]*;.*/\1/' \
	<<< "${state_declarations[0]}")

check_probe_object()
{
	local object=$1 label=$2 symbol count

	while read -r symbol; do
		case $symbol in
			__fentry__|__ref_stack_chk_guard|__stack_chk_fail|\
			__x86_return_thunk|copy_from_user_nofault|register_kretprobe|\
			rk_state_actions_enabled|rk_state_mark_selected_failure|\
			rk_state_mark_selected_success|unregister_kretprobe) ;;
			*) die "$label return-probe object has forbidden dependency: $symbol" ;;
		esac
	done < <(nm -u "$object" | awk '{ print $NF }')

	for specification in \
		'copy_from_user_nofault 1' \
		'register_kretprobe 1' \
		'rk_state_actions_enabled 1' \
		'rk_state_mark_selected_failure 1' \
		'rk_state_mark_selected_success 1' \
		'unregister_kretprobe 1'; do
		read -r symbol count <<< "$specification"
		[[ $(objdump -r "$object" |
			grep -Ec "[[:space:]]${symbol}([+-]|$)") -eq $count ]] ||
			die "$label return-probe object must call $symbol exactly $count time(s)"
	done
}

check_probe_object "$success_dir/instrumentation/return_probe.o" success
check_probe_object "$missing_dir/instrumentation/return_probe.o" missing-target

mapfile -t probe_defines < <(
	grep -E '^[[:space:]]*#[[:space:]]*define[[:space:]]+' "$source_file"
)
(( ${#probe_defines[@]} == 3 )) ||
	die "instrumentation/return_probe.c must not add preprocessor aliases"
grep -Eq '^[[:space:]]*#[[:space:]]*define[[:space:]]+RK_SELECTED_PATH[[:space:]]+"/tmp/rootkitlings-rmdir-watch"[[:space:]]*$' \
	"$source_file" || die "keep the supplied selected path"
grep -Eq '^[[:space:]]*#[[:space:]]*define[[:space:]]+RK_USER_PATH_SIZE[[:space:]]+64[[:space:]]*$' \
	"$source_file" || die "keep the supplied bounded path size"
grep -Eq '^[[:space:]]*#[[:space:]]*define[[:space:]]+RK_MISSING_TARGET[[:space:]]+"__rootkitlings_missing_kretprobe_target_7_2__"[[:space:]]*$' \
	"$source_file" || die "keep the supplied missing-target selector"

grep -Eq '\.symbol_name[[:space:]]*=[[:space:]]*"__x64_sys_rmdir"' \
	<<< "$source_text" || die "the success probe must name __x64_sys_rmdir"
grep -Fq '"__rootkitlings_missing_kretprobe_target_7_2__"' \
	<<< "$missing_text" || die "failure point 4 must use the missing target"
if strings "$success_dir/instrumentation/return_probe.o" |
	grep -Fqx '__rootkitlings_missing_kretprobe_target_7_2__'; then
	die "the success object contains the missing failure target"
fi
strings "$missing_dir/instrumentation/return_probe.o" |
	grep -Fqx '__rootkitlings_missing_kretprobe_target_7_2__' ||
	die "failure point 4 did not compile the missing target"

[[ $(grep -Ec 'static[[:space:]]+struct[[:space:]]+kretprobe[[:space:]]+[[:alnum:]_]+' \
	"$source_file") -eq 1 ]] || die "define exactly one private Kretprobe"
for field in entry_handler handler data_size maxactive; do
	grep -Eq "\.${field}[[:space:]]*=" "$source_file" ||
		die "the Kretprobe descriptor must set $field"
done
grep -Eq '\.data_size[[:space:]]*=[[:space:]]*sizeof[[:space:]]*\([[:space:]]*struct[[:space:]]+rk_rmdir_instance[[:space:]]*\)' \
	"$source_file" || die "reserve one rk_rmdir_instance per active call"
grep -Eq '\.maxactive[[:space:]]*=[[:space:]]*RK_RETURN_CAPACITY' \
	"$source_file" || die "derive Kretprobe capacity from RK_RETURN_CAPACITY"
grep -Eq '#define[[:space:]]+RK_RETURN_CAPACITY[[:space:]]+16' \
	"$success_dir/include/rootkit.h" || die "return capacity must be 16"

entry_body=$(extract_function "$source_file" rk_rmdir_entry)
return_body=$(extract_function "$source_file" rk_rmdir_return)
start_body=$(extract_function "$source_file" rk_return_probe_start)
stop_body=$(extract_function "$source_file" rk_return_probe_stop)
[[ -n $entry_body && -n $return_body && -n $start_body && -n $stop_body ]] ||
	die "return_probe.c must define both handlers and lifecycle operations"
entry_flat=$(flatten_function <<< "$entry_body")
return_flat=$(flatten_function <<< "$return_body")
start_flat=$(flatten_function <<< "$start_body")
stop_flat=$(flatten_function <<< "$stop_body")

# Check the learner-visible invariants, not one official spelling.  Runtime
# checks provide the behavioral oracle; these checks keep the implementation on
# the intended bounded mechanism and reject unsafe operations before loading it.
grep -Eq -- '->data' <<< "$entry_flat" ||
	die "entry handler must use its Kretprobe instance data"
grep -Eq -- "->selected=false;.*rk_state_actions_enabled\\(${state_name}\\)" \
	<<< "$entry_flat" ||
	die "entry handler must initialize private data before reading admission state"
grep -Eq 'regs_get_kernel_argument\([^,]+,0\)' <<< "$source_flat" ||
	die "decode kernel argument zero for the native syscall register frame"
grep -Eq -- '->di' <<< "$source_flat" ||
	die "decode the first native x86-64 syscall argument from di"
grep -Eq 'rk_path_is_selected\(' <<< "$entry_flat" ||
	die "entry handling must classify the decoded userspace path"
grep -Eq 'return(-?[1-9][0-9]*|true);' <<< "$entry_flat" ||
	die "disabled entry handling must skip the matching return callback"
[[ $(grep -Eo 'return(-?[1-9][0-9]*|true);' <<< "$entry_flat" | wc -l) -eq 1 ]] ||
	die "entry handler must have exactly one path that skips return handling"
grep -Eq 'return0;' <<< "$entry_flat" ||
	die "admitted entry handling must request a matching return callback"

grep -Eq -- '->data' <<< "$return_flat" ||
	die "return handler must use the matching Kretprobe instance data"
grep -Eq -- '->selected' <<< "$return_flat" ||
	die "return handler must consult the saved path classification"
grep -Eq 'regs_return_value\(' <<< "$return_flat" ||
	die "return handler must read the architecture return value"
grep -Eq "(==0|0==|![[:alnum:]_]+).*rk_state_mark_selected_success\\(${state_name}\\)" \
	<<< "$return_flat" ||
	die "zero return values must mark selected success"
grep -Eq "(<0|0>).*rk_state_mark_selected_failure\\(${state_name}\\)" \
	<<< "$return_flat" ||
	die "negative return values must mark selected failure"
grep -Eq 'return0;' <<< "$return_flat" ||
	die "return handler must preserve the probed return path"
(( $(grep -Eo 'return0;' <<< "$return_flat" | wc -l) <= 2 )) ||
	die "return handler has an unrelated early return"

grep -Eq "${state_name}=[[:alnum:]_]+;.*register_kretprobe\\(&rmdir_probe\\)" \
	<<< "$start_flat" ||
	die "publish borrowed state before registering the Kretprobe"
grep -Eq "register_kretprobe\\(&rmdir_probe\\).*${state_name}=NULL;" \
	<<< "$start_flat" ||
	die "clear borrowed state when Kretprobe registration fails"
grep -Eq "unregister_kretprobe\\(&rmdir_probe\\).*${state_name}=NULL;" \
	<<< "$stop_flat" ||
	die "teardown must unregister before releasing borrowed state"

copy_body=$(extract_function "$source_file" rk_copy_user_path_nofault)
classifier_body=$(extract_function "$source_file" rk_path_is_selected)
copy_flat=$(flatten_function <<< "$copy_body")
classifier_flat=$(flatten_function <<< "$classifier_body")
grep -Eq 'for\([^;]+;[^;]+<[^;]+;[^)]+\+\+\)' <<< "$copy_flat" ||
	die "the no-fault copy helper must remain bounded"
grep -Eq 'copy_from_user_nofault\([^,]+\+[^,]+,[^,]+\+[^,]+,1\)' \
	<<< "$copy_flat" ||
	die "copy the userspace path one byte at a time without faults"
grep -Eq "copy_from_user_nofault.*return-EFAULT;.*(=='\\\\0'|==0|if\\(![^)]+\\)).*return[^;]+\+1;.*return-ENAMETOOLONG;" \
	<<< "$copy_flat" ||
	die "the no-fault copy helper must distinguish fault, NUL, and overlength"
grep -Eq 'char[[:alnum:]_]+\[RK_USER_PATH_SIZE\]' <<< "$classifier_flat" ||
	die "classify paths in the supplied bounded local buffer"
grep -Eq 'rk_copy_user_path_nofault\([^,]+,[^,]+,sizeof\([^)]+\)\)' \
	<<< "$classifier_flat" ||
	die "classify only a complete no-fault path copy"
grep -Eq '(==sizeof\(RK_SELECTED_PATH\)|sizeof\(RK_SELECTED_PATH\)==).*(!?memcmp\([^,]+,RK_SELECTED_PATH,sizeof\(RK_SELECTED_PATH\)\)(==0)?)' \
	<<< "$classifier_flat" ||
	die "classify only one complete exact watched path"

owned_sources=(
	"$success_dir/Kbuild"
	"$success_dir/core/main.c"
	"$success_dir/core/state.c"
	"$success_dir/include/rootkit.h"
	"$source_file"
	"$success_dir/interface/proc.c"
)
owned_text=$(strip_c_comments < <(cat "${owned_sources[@]}") | tr '\n' ' ')
if grep -Eq '(^|[^[:alnum:]_])(addr|kallsyms_lookup|sprint_symbol|lookup_symbol)([^[:alnum:]_]|$)|%p[xsS]?' \
	<<< "$owned_text"; then
	die "do not copy, format, publish, or resolve raw probe addresses"
fi
if grep -Eq '\b(pr_(info|notice|warn|err|debug)|printk|copy_from_user|strncpy_from_user_nofault|kmalloc|kzalloc|kfree|mutex_lock|schedule|msleep|usleep_range|wait_event)[[:space:]]*\(' \
	<<< "$source_text"; then
	die "probe telemetry must remain no-fault, bounded, non-sleeping, and silent"
fi
while IFS= read -r declaration; do
	grep -Eq "^[[:space:]]*static[[:space:]]+struct[[:space:]]+rk_state[[:space:]]*\\*[[:space:]]*${state_name}[[:space:]]*;[[:space:]]*$" \
		<<< "$declaration" ||
		die "do not correlate calls through global scratch storage"
done < <(grep -E '^[[:space:]]*static[[:space:]]+[^();]+;' "$source_file")
if grep -Eq -- '->[[:space:]]*(ax|di|si|dx|r10|r8|r9)[[:space:]]*=[^=]' \
	<<< "$source_text"; then
	die "probe handlers must not modify saved registers"
fi

state_source=$success_dir/core/state.c
state_text=$(strip_c_comments < "$state_source" | tr '\n' ' ')
for field in selected_success_seen selected_failure_seen; do
	grep -Eq "bool[[:space:]]+${field}" <<< "$state_text" ||
		die "$field must be a private bool"
	grep -Eq "READ_ONCE[[:space:]]*\([[:space:]]*state->${field}[[:space:]]*\)" \
		<<< "$state_text" || die "$field reader must use READ_ONCE"
	grep -Eq "WRITE_ONCE[[:space:]]*\([[:space:]]*state->${field}[[:space:]]*,[[:space:]]*true[[:space:]]*\)" \
		<<< "$state_text" || die "$field marker must store only true"
	[[ $(grep -Eo "WRITE_ONCE[[:space:]]*\([[:space:]]*state->${field}[[:space:]]*," \
		<<< "$state_text" | wc -l) -eq 1 ]] ||
		die "$field must have one monotonic store"
	[[ $(grep -Eo "state->${field}[[:space:]]*=" <<< "$state_text" | wc -l) -eq 1 ]] ||
		die "$field must be initialized once and never reset"
done
if grep -Eq '\b(atomic_t|atomic_long_t|atomic_(read|set|inc))\b' \
	<<< "$state_text"; then
	die "monotonic same-value observations do not need counters"
fi

proc_source=$success_dir/interface/proc.c
proc_text=$(strip_c_comments < "$proc_source" | tr '\n' ' ')
for field in selected_success_seen selected_failure_seen return_capacity returns_missed; do
	grep -Fq "${field}=" <<< "$proc_text" || die "proc status must publish $field"
done

main_source=$success_dir/core/main.c
init_text=$(strip_c_comments <<< "$(extract_function "$main_source" rk_init)" | tr '\n' ' ')
exit_text=$(strip_c_comments <<< "$(extract_function "$main_source" rk_exit)" | tr '\n' ' ')
grep -Eq 'rk_return_probe_start[[:space:]]*\([^;]+\)[[:space:]]*;.*rk_proc_publish[[:space:]]*\([^;]+\)[[:space:]]*;.*rk_return_probe_stop[[:space:]]*\([^;]*\)[[:space:]]*;.*rk_state_destroy[[:space:]]*\([^;]+\)[[:space:]]*;' \
	<<< "$init_text" ||
	die "publication rollback must publish after registration, then stop before destroy"
grep -Eq 'rk_proc_unpublish[[:space:]]*\([^;]*\)[[:space:]]*;.*rk_return_probe_stop[[:space:]]*\([^;]*\)[[:space:]]*;.*rk_state_destroy[[:space:]]*\([^;]+\)[[:space:]]*;' \
	<<< "$exit_text" ||
	die "unload order must be proc unpublish, probe unregister, state destroy"

printf '[+] per-instance syscall return correlation and lifecycle verified\n'
