#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "State allocation rejection"

assert_not_loaded()
{
	assert_absent /sys/module/rklings
	if grep -q '^rklings ' /proc/modules; then
		_fail "rklings appears in /proc/modules"
	else
		_ok "rklings is absent from /proc/modules"
	fi
}

assert_not_loaded
for attempt in 1 2; do
	if module_load_test /rklings/rklings.ko 12; then
		_ok "attempt $attempt returned numeric ENOMEM"
	else
		_fail "attempt $attempt did not return ENOMEM"
	fi
	assert_not_loaded
done

summary
