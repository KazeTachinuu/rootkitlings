#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
baseline=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-owned-kernel-state-baseline.XXXXXX")
work=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-owned-kernel-state-work.XXXXXX")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-owned-kernel-state-test.XXXXXX")
trap 'rm -rf -- "$baseline" "$work" "$scratch"' EXIT

cp -a "$HERE/../../L01-precise-init-failure/solution/." "$baseline/"
cp -a "$baseline/." "$work/"
while IFS= read -r -d '' source; do
	relative=${source#"$HERE/../solution/"}
	mkdir -p "$work/$(dirname "$relative")"
	cp -p "$source" "$work/$relative"
done < <(find "$HERE/../solution" -type f -print0)

build_variant()
{
	local name=$1 point=$2 destination=$scratch/$1 log=$scratch/$1.log
	cp -a "$work" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules >"$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s builds with warnings\n' "$name" >&2
		exit 1
	fi
}

build_variant success 0
build_variant preflight 1
build_variant allocation 2
"$HERE/host-check" "$scratch/success" "$scratch/success/rootkitlings.ko"

sed -i 's/^struct rk_state;$/struct rk_state { unsigned int active; };/' \
	"$work/include/rootkit.h"
sed -i '/^struct rk_state {$/,/^};$/d' "$work/core/state.c"
build_variant public-state 0
if output=$("$HERE/host-check" "$scratch/public-state" \
	"$scratch/public-state/rootkitlings.ko" 2>&1); then
	printf '%s\n[x] public-state fixture unexpectedly passed\n' "$output" >&2
	exit 1
fi
case $output in
	*"struct rk_state layout is visible outside core/state.c"*) ;;
	*)
		printf '%s\n[x] public-state fixture failed for the wrong reason\n' \
			"$output" >&2
		exit 1
		;;
esac
printf '[+] public-state fixture rejected by an incomplete-type compile test\n'

cp -p "$HERE/../solution/include/rootkit.h" "$work/include/rootkit.h"
cp -p "$HERE/../solution/core/state.c" "$work/core/state.c"
cp "$HERE/../fixtures/no-free-state.c" "$work/core/state.c"
build_variant no-free 0
if output=$("$HERE/host-check" "$scratch/no-free" \
	"$scratch/no-free/rootkitlings.ko" 2>&1); then
	printf '%s\n[x] wrong-free fixture unexpectedly passed\n' "$output" >&2
	exit 1
fi
case $output in
	*"destroy must free the exact object returned by create"*) ;;
	*) printf '%s\n[x] wrong-free fixture failed for the wrong reason\n' "$output" >&2; exit 1 ;;
esac
printf '[+] wrong-free fixture rejected by lifecycle instrumentation\n'

cp -p "$HERE/../solution/core/state.c" "$work/core/state.c"
cp "$HERE/../fixtures/collapsed-error-main.c" "$work/core/main.c"
build_variant collapsed-error 0
if output=$("$HERE/host-check" "$scratch/collapsed-error" \
	"$scratch/collapsed-error/rootkitlings.ko" 2>&1); then
	printf '%s\n[x] collapsed-error fixture unexpectedly passed\n' "$output" >&2
	exit 1
fi
case $output in
	*"init must preserve the constructor's exact error"*) ;;
	*) printf '%s\n[x] collapsed-error fixture failed for the wrong reason\n' "$output" >&2; exit 1 ;;
esac
printf '[+] collapsed-error fixture rejected by injected constructor error\n'

cp -p "$HERE/../solution/core/main.c" "$work/core/main.c"

cp -a "$work" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 ROOTKITLINGS_FAIL_POINT=99 \
	modules >"$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

run_guest()
{
	local check_script=$1 module=$2 output
	shift 2
	if ! output=$("$HERE/../../../vm/boot" --check "$check_script" "$@" "$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest did not complete\n' >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/failure-ecanceled-check" "$scratch/preflight/rootkitlings.ko" \
	--tool vm/tools/module_load_test
run_guest "$HERE/failure-enomem-check" "$scratch/allocation/rootkitlings.ko" \
	--tool vm/tools/module_load_test
run_guest "$HERE/../../L00-module-build-lifecycle/checks/module-lifecycle-check" "$scratch/success/rootkitlings.ko"
