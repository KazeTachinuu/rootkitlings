#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
begin "$label"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-authorization-failure
mkdir -p "$fixtures"
printf 'enable' > "$fixtures/enable"

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

read_token()
{
	token=$(sed -n 's/^token=//p' "$endpoint")
	completed=$(sed -n 's/^completed_actions=//p' "$endpoint")
	case "$token" in
		*[!0-9a-f]*) return 1 ;;
		????????????????????????????????) return 0 ;;
		*) return 1 ;;
	esac
}

assert_not_loaded
attempt=1
while [ "$attempt" -le 2 ]; do
	load rootkitlings.ko
	assert_loaded rootkitlings
	assert_exists "$endpoint"
	if proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null; then
		_ok "attempt $attempt enabled the action"
	else
		_fail "attempt $attempt could not enable the action"
	fi
	if ! read_token; then
		_fail "attempt $attempt could not read the current token"
	fi
	stale=$token
	if run_as 65534 65534 cred_trigger_test token-race "$endpoint" \
		"$stale" 24 "$expected_errno" > /dev/null; then
		_ok "attempt $attempt admits exactly one failing same-token writer"
	else
		_fail "attempt $attempt violated failure-path one-use admission"
	fi
	if ! read_token; then
		_fail "attempt $attempt could not read the replacement token"
	fi
	if [ "$completed" = 0 ]; then
		_ok "attempt $attempt did not count a failed credential change"
	else
		_fail "attempt $attempt counted a failed credential change"
	fi
	if [ "$token" != "$stale" ]; then
		_ok "attempt $attempt consumed and rotated before returning failure"
	else
		_fail "attempt $attempt retained a token after accepted failure"
	fi
	if run_as 65534 65534 cred_trigger_test token-unchanged \
		"$endpoint" "$stale" 13 > /dev/null; then
		_ok "attempt $attempt rejects the failed action's stale token"
	else
		_fail "attempt $attempt accepted or mishandled stale replay"
	fi
	fresh=$token
	if run_as 65534 65534 cred_trigger_test token-unchanged \
		"$endpoint" "$fresh" "$expected_errno" > /dev/null; then
		_ok "attempt $attempt propagates the credential error"
	else
		_fail "attempt $attempt changed credentials or returned the wrong error"
	fi
	previous=$fresh
	if ! read_token; then
		_fail "attempt $attempt could not read the second replacement token"
	fi
	if [ "$token" != "$previous" ] && [ "$completed" = 0 ]; then
		_ok "attempt $attempt rotates again and keeps the success count at zero"
	else
		_fail "attempt $attempt did not preserve failure accounting"
	fi
	unload rootkitlings
	assert_not_loaded
	attempt=$((attempt + 1))
done

summary
