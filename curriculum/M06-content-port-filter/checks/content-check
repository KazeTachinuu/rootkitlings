#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Content hiding"

load rklings.ko

test_file=/tmp/rk_content_test
printf "line one\nSECRET treasure\nline three\nhidden SECRET data\nline five\n" > "$test_file"

echo "hide content SECRET" > /proc/rklings

filtered=$(cat "$test_file")
if echo "$filtered" | grep -q "SECRET"; then
	_fail "lines containing SECRET still visible"
else
	_ok "lines containing SECRET are hidden"
fi

if echo "$filtered" | grep -q "line one"; then
	_ok "non-matching lines still visible"
else
	_fail "non-matching lines were removed"
fi

if echo "$filtered" | grep -q "line five"; then
	_ok "lines after hidden content still visible"
else
	_fail "lines after hidden content were removed"
fi

echo "unhide content 0" > /proc/rklings

restored=$(cat "$test_file")
if echo "$restored" | grep -q "SECRET"; then
	_ok "unhidden content is visible again"
else
	_fail "content still hidden after unhide"
fi

rm -f "$test_file"
unload rklings

summary
