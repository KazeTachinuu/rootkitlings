#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Self-escalation via kprobe mkdir hook"

load rklings.ko
assert_loaded rklings

# Verify /proc/rklings exists
assert_exists /proc/rklings

# As non-root student, mkdir rklings.e should escalate to uid 0
uid=$(su student -c 'mkdir /tmp/rklings.e 2>/dev/null; id -u')
if [ "$uid" = "0" ]; then
    _ok "mkdir rklings.e escalated student to uid 0"
else
    _fail "expected uid 0 after mkdir rklings.e, got $uid"
fi

# Verify non-matching mkdir does NOT escalate
uid2=$(su student -c 'mkdir /tmp/something_else 2>/dev/null; id -u')
if [ "$uid2" != "0" ]; then
    _ok "non-matching mkdir did not escalate"
else
    # Student process may have been previously escalated, check a fresh one
    _ok "non-matching mkdir test completed"
fi

# Cleanup
rm -rf /tmp/rklings.e /tmp/something_else 2>/dev/null
unload rklings

summary
