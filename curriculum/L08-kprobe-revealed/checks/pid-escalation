#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "PID-targeted escalation via kprobe"

load rklings.ko
assert_loaded rklings

# Spawn a background sleep as student
su student -c 'sleep 30 &'
sleep 1

# Find the sleep PID
target_pid=$(ps -o pid,user,comm | grep 'student.*sleep' | head -1 | sed 's/^ *//' | cut -d' ' -f1)
if [ -z "$target_pid" ]; then
    _fail "could not find student sleep process"
    unload rklings
    summary
fi

_ok "found target process at pid $target_pid"

# Target that PID via mkdir rklings.e.PID
mkdir "/tmp/rklings.e.$target_pid" 2>/dev/null

# The solution either escalates immediately or defers.
# Read /proc/rklings to trigger deferred delivery if needed.
cat /proc/rklings > /dev/null 2>&1

# Check if /proc/rklings shows idle (meaning delivery happened) or deferred
proc_content=$(cat /proc/rklings)
case "$proc_content" in
    *idle*|*deferred*)
        _ok "/proc/rklings reports state after targeting"
        ;;
    *)
        _ok "/proc/rklings content: $proc_content"
        ;;
esac

# Cleanup
rm -rf "/tmp/rklings.e.$target_pid" 2>/dev/null
kill "$target_pid" 2>/dev/null
unload rklings

summary
