#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Root shell timeout"
port=46123
capture=/tmp/rklings-root-shell-timeout
rm -f "$capture"
ifconfig lo 127.0.0.1 up

has_line()
{
	tr '\r' '\n' < "$1" | grep -Eq "$2"
}

printf '%s\n' 'printf "rkproof-%s\n" ready' 'sleep 60' |
	nc -l -p "$port" >"$capture" 2>&1 &
listener=$!
sleep 0.1
load rklings.ko "shell_port=$port" shell_timeout_ms=1000
ticket=$(cat /sys/module/rklings/parameters/shell_ticket)
request_id=${ticket%% *}

attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 60 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if kill -0 "$listener" 2>/dev/null; then
	_fail "timeout left the reverse-shell connection open"
	kill "$listener" 2>/dev/null || true
else
	wait "$listener" || true
	_ok "timeout closed a shell running a command"
fi
if has_line "$capture" '^rkproof-ready$'; then
	_ok "shell ran before its deadline"
else
	_fail "shell never reached the listener"
fi

leaked=
for command in /proc/[0-9]*/cmdline; do
	[ -r "$command" ] || continue
	line=$(tr '\000' ' ' <"$command")
	case $line in *'sleep 60'*) leaked=$command ;; esac
done
if [ -z "$leaked" ]; then
	_ok "timeout killed the shell process group"
else
	_fail "timeout left a shell command running"
fi
if test "$(cat /sys/module/rklings/parameters/shell_status)" = \
		"$request_id timed-out -110"; then
	_ok "timeout reports the exact request and result"
else
	_fail "timeout status is missing or incorrect"
fi

printf '%s\n' 'printf "rkproof-%s\n" retry' 'exit' |
	nc -l -p 46127 >"$capture.retry" 2>&1 &
listener=$!
sleep 0.1
attempt=0
while ! printf 46127 \
		> /sys/module/rklings/parameters/shell_port 2>/dev/null && \
		[ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
if [ "$attempt" -lt 100 ]; then fully_requested=1; else fully_requested=; fi
attempt=0
while kill -0 "$listener" 2>/dev/null && [ "$attempt" -lt 100 ]; do
	sleep 0.05
	attempt=$((attempt + 1))
done
wait "$listener" || _fail "retry after timeout failed"
if [ "$fully_requested" = 1 ] && \
		has_line "$capture.retry" '^rkproof-retry$'; then
	_ok "timed-out state accepted a later request"
else
	_fail "timed-out state did not release capacity"
fi

unload rklings
assert_absent /sys/module/rklings
rm -f "$capture" "$capture.retry"
summary
