#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
baseline=$(mktemp -d "${TMPDIR:-/tmp}/rklings-precise-init-failure-baseline.XXXXXX")
work=$(mktemp -d "${TMPDIR:-/tmp}/rklings-precise-init-failure-work.XXXXXX")
trap 'rm -rf -- "$baseline" "$work"' EXIT
cp -a "$HERE/../../L00-module-build-lifecycle/solution/." "$baseline/"
cp -a "$baseline/." "$work/"
for path in Kbuild core/main.c; do cp -p "$HERE/../solution/$path" "$work/$path"; done

"$HERE/check" "$work" "$baseline"

cp "$HERE/../fixtures/hardcoded-Kbuild" "$work/Kbuild"
if output=$("$HERE/check" "$work" "$baseline" 2>&1); then
	printf '%s\n[-] hardcoded Kbuild unexpectedly passed\n' "$output" >&2
	exit 1
fi
case $output in
	*"unknown failure-point value compiled successfully"*) ;;
	*) printf '%s\n[-] hardcoded fixture failed for the wrong reason\n' "$output" >&2; exit 1 ;;
esac
printf '[+] hardcoded failure-point fixture rejected before guest boot\n'

cp -p "$HERE/../solution/Kbuild" "$work/Kbuild"
cp "$HERE/../fixtures/wrong-errno-main.c" "$work/core/main.c"
if output=$("$HERE/check" "$work" "$baseline" 2>&1); then
	printf '%s\n[-] wrong-errno fixture unexpectedly passed\n' "$output" >&2
	exit 1
fi
case $output in
	*"did not return ECANCELED"*) ;;
	*) printf '%s\n[-] wrong-errno fixture failed for the wrong reason\n' "$output" >&2; exit 1 ;;
esac
printf '[+] wrong-errno fixture rejected in disposable guest\n'
