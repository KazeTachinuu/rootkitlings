#!/usr/bin/bash
set -Eeuo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

checks=(escalation-check persist-check cloak-check file-check content-check port-check)

for script in "${checks[@]}"; do bash -n "$here/$script"; done
if command -v shellcheck >/dev/null; then
	for script in "${checks[@]}"; do
		shellcheck -x -s sh "$here/$script"
	done
fi

printf '[+] local-covert-control check scripts are syntactically valid\n'
