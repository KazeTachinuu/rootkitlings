#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Port hiding"

ifconfig lo 127.0.0.1 up 2>/dev/null

load rklings.ko
assert_loaded rklings

test_port=7777
port_hex=$(printf '%04X' "$test_port")

nc -l -p "$test_port" 0.0.0.0 &
nc_pid=$!
sleep 1

if grep -q "$port_hex" /proc/net/tcp; then
	_ok "port $test_port visible before hiding"
else
	_fail "port $test_port not found in /proc/net/tcp"
	kill "$nc_pid" 2>/dev/null
	unload rklings
	summary
fi

mkdir "rklings.h.p.$test_port" 2>/dev/null

if grep -q "$port_hex" /proc/net/tcp; then
	_fail "port $test_port still visible after hiding"
else
	_ok "port $test_port hidden from /proc/net/tcp"
fi

kill "$nc_pid" 2>/dev/null
unload rklings

summary
