#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Local covert control"

load rklings.ko
assert_loaded rklings
assert_exists /proc/rklings_status

if lsmod | grep -q rklings; then
	_ok "module visible before cloak"
else
	_fail "module not visible before cloak"
fi

mkdir rklings.h.m 2>/dev/null
if ! lsmod | grep -q rklings; then
	_ok "mkdir rklings.h.m hides module"
else
	_fail "module still visible after hide"
fi

mkdir rklings.u.m 2>/dev/null
if lsmod | grep -q rklings; then
	_ok "mkdir rklings.u.m restores module"
else
	_fail "module not visible after unhide"
fi

if ! mkdir /tmp/rklings.nonexistent 2>/dev/null; then
	_ok "unrecognized rklings path returns error"
else
	rmdir /tmp/rklings.nonexistent 2>/dev/null
	_fail "unrecognized rklings path created a directory"
fi

if mkdir /tmp/normaldir 2>/dev/null; then
	rmdir /tmp/normaldir
	_ok "normal mkdir still works"
else
	_fail "normal mkdir is broken"
fi

unload rklings
assert_absent /proc/rklings_status

if dmesg | grep -Eqi '(BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task)'; then
	_fail "kernel log contains a fault report"
else
	_ok "kernel log is clean"
fi

summary
