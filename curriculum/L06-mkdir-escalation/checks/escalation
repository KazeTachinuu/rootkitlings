#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "mkdir rklings.e grants root credentials"

load rklings.ko

# Run mkdir as a non-root user (uid 1000). The hook should detect
# "rklings.e" and replace credentials with root (uid 0).
uid_after=$(su student -c 'mkdir /tmp/rklings.e 2>/dev/null; id -u')

if [ "$uid_after" = "0" ]; then
    _ok "uid after escalation is 0 (root)"
else
    _fail "uid after escalation: expected 0, got '$uid_after'"
fi

assert_log "rklings: escalated pid"

# Clean up.
rm -rf /tmp/rklings.e 2>/dev/null
unload rklings

summary
