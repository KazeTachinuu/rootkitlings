#!/bin/sh
# Check: All five kretprobes register successfully on load
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "All kretprobes register"

load rklings.ko
assert_loaded rklings

# Verify the module is loaded and the kretprobes are active by checking
# /sys/kernel/debug/kprobes/list (if available) or just that the module loaded
# without error. The solution registers 5 probes with goto-chain rollback,
# so if any probe fails, the module refuses to load.
if [ -f /sys/kernel/debug/kprobes/list ]; then
    probe_count=$(grep -c 'rklings' /sys/kernel/debug/kprobes/list 2>/dev/null || echo 0)
    # Each kretprobe registers at least one kprobe entry
    if [ "$probe_count" -ge 5 ]; then
        _ok "at least 5 kprobes registered for rklings"
    else
        # kprobes might not list module name; just verify module is up
        _ok "module loaded (probe listing shows $probe_count entries)"
    fi
else
    _ok "module loaded successfully (all probes registered)"
fi

# Verify /proc/rklings exists (proc interface is created in init)
assert_exists /proc/rklings

unload rklings
assert_absent /sys/module/rklings

summary
