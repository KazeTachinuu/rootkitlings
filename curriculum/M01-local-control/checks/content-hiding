#!/bin/sh
# Check: mkdir rklings.h.c.<string> hides lines containing that string from read()
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Content-line hiding via read filter"

TESTFILE=/tmp/rk_content_test.txt
cat > "$TESTFILE" <<'LINES'
normal line one
SECRET_DATA hidden payload
normal line two
another SECRET_DATA line
final line
LINES

load rklings.ko
assert_loaded rklings

# Before hiding, the secret lines should be readable
before=$(cat "$TESTFILE" | grep -c 'SECRET_DATA')
if [ "$before" -eq 2 ]; then
    _ok "SECRET_DATA lines visible before hiding ($before lines)"
else
    _fail "expected 2 SECRET_DATA lines before hiding, got $before"
fi

# Add content pattern to hide list
mkdir /tmp/rklings.h.c.SECRET_DATA 2>/dev/null

# After hiding, lines containing SECRET_DATA should be filtered from read()
after=$(cat "$TESTFILE" | grep -c 'SECRET_DATA')
if [ "$after" -eq 0 ]; then
    _ok "SECRET_DATA lines filtered from read output"
else
    _fail "SECRET_DATA lines still visible after hiding ($after remain)"
fi

# Normal lines should still be present
normal=$(cat "$TESTFILE" | grep -c 'normal line')
if [ "$normal" -ge 2 ]; then
    _ok "non-matching lines still readable ($normal lines)"
else
    _fail "non-matching lines also affected ($normal remain)"
fi

# Cleanup
rmdir /tmp/rklings.h.c.SECRET_DATA 2>/dev/null
rm -f "$TESTFILE"

unload rklings
assert_absent /sys/module/rklings

summary
