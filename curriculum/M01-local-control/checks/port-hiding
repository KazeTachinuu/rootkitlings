#!/bin/sh
# Check: mkdir rklings.h.p.<port> hides ports from /proc/net/tcp
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Port hiding via tcp seq_show filter"

ifconfig lo 127.0.0.1 up 2>/dev/null

load rklings.ko
assert_loaded rklings

# Start a listener on a known port
nc -l -p 9999 > /dev/null 2>&1 &
NC_PID=$!
sleep 0.3

# Convert port 9999 to hex for /proc/net/tcp (9999 = 0x270F)
# Check netstat or /proc/net/tcp for the port
if netstat -tln 2>/dev/null | grep -q ':9999'; then
    _ok "port 9999 visible in netstat before hiding"
else
    # Try /proc/net/tcp with hex port
    if cat /proc/net/tcp | grep -qi '270F'; then
        _ok "port 9999 visible in /proc/net/tcp before hiding"
    else
        _ok "port 9999 listener started (visibility check skipped)"
    fi
fi

# Add port to hide list
mkdir /tmp/rklings.h.p.9999 2>/dev/null

# After hiding, the port should be filtered from tcp seq_show output
if netstat -tln 2>/dev/null | grep -q ':9999'; then
    _fail "port 9999 still visible in netstat after hiding"
else
    _ok "port 9999 hidden from netstat"
fi

# Cleanup
kill "$NC_PID" 2>/dev/null
wait "$NC_PID" 2>/dev/null
rmdir /tmp/rklings.h.p.9999 2>/dev/null

unload rklings
assert_absent /sys/module/rklings

summary
