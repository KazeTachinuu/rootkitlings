#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
ROOT=$ROOTKITLINGS_ROOT
REMOTE_AGENT=$HERE/../../M07-remote-resident-agent
CONCEALMENT=$HERE/../../M03-concealment-evidence-map
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-complete-rootkit.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] final project requires x86_64\n' >&2
	exit 1
}
for option in CC_IS_GCC CRYPTO_GCM CRYPTO_AES CRYPTO_HMAC CRYPTO_SHA256 \
	KPROBES KRETPROBES KRETPROBE_ON_RETHOOK KPROBES_ON_FTRACE KALLSYMS \
	KALLSYMS_ALL DEBUG_FS MODULES MODULE_UNLOAD MULTIUSER USER_NS PID_NS \
	NET NET_NS INET PROC_FS; do
	grep -Eq "^CONFIG_$option=[ym]$" "$KDIR/.config" || {
		printf '[x] final project requires CONFIG_%s\n' "$option" >&2
		exit 1
	}
done
for command in base64 gcc gzip make nm; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done
for script in test host-check success-check; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check"
fi

materialize()
{
	local tree=$1 destination=$2
	"$ROOT/scripts/catalog" materialize "$tree" C00 "${destination%/*}" \
		--name "${destination##*/}" >/dev/null
}

materialize starter "$scratch/starter"
make -s -C "$KDIR" M="$scratch/starter" W=1 modules \
	> "$scratch/starter.log" 2>&1
if "$HERE/host-check" "$scratch/starter" "$scratch/starter/rootkitlings.ko" \
		> "$scratch/starter-host.log" 2>&1; then
	printf '[x] host checker accepted unfinished learner file\n' >&2; exit 1
fi

materialize solution "$scratch/solution"
make -s -C "$KDIR" M="$scratch/solution" W=1 modules \
	> "$scratch/solution.log" 2>&1
! grep -q 'warning:' "$scratch/solution.log" || {
	cat "$scratch/solution.log"
	exit 1
}
"$HERE/host-check" "$scratch/solution" "$scratch/solution/rootkitlings.ko"

materialize solution "$scratch/fail-14"
make -s -C "$KDIR" M="$scratch/fail-14" W=1 \
	ROOTKITLINGS_FAIL_POINT=14 modules > "$scratch/fail-14.log" 2>&1

gcc -std=c11 -Wall -Wextra -Werror -pedantic -static \
	-o "$scratch/secure_agent_fixture" "$ROOT/vm/tools/secure_agent_fixture.c"
mkdir -p "$scratch/checks"

run_guest()
{
	local check=$1 module=$2 label=$3 output
	shift 3
	if ! output=$("$ROOT/vm/boot" --check "$check" "$@" "$module" 2>&1); then
		printf '%s\n[x] guest rejected %s\n' "$output" "$label" >&2; exit 1
	fi
	printf '%s\n' "$output"
}

append_binary()
{
	local marker=$1 binary=$2 script=$3
	printf '\n%s\n' "$marker" >> "$script"
	gzip -c "$binary" | base64 -w 76 >> "$script"
	chmod 0755 "$script"
}

cp "$HERE/success-check" "$scratch/checks/success-check"
append_binary __ROOTKITLINGS_SECURE_FIXTURE__ \
	"$scratch/secure_agent_fixture" "$scratch/checks/success-check"
run_guest "$scratch/checks/success-check" \
	"$scratch/solution/rootkitlings.ko" solution

run_guest "$REMOTE_AGENT/checks/failure-check.in" \
	"$scratch/fail-14/rootkitlings.ko" packet-redirect-rollback \
	--check-arg 4 --check-arg 'Packet redirect registration' \
	--check-arg complete-rootkit --tool vm/tools/module_load_params

cp "$CONCEALMENT/checks/success-check" "$scratch/concealment-regression"
chmod 0755 "$scratch/concealment-regression"
run_guest "$scratch/concealment-regression" \
	"$scratch/solution/rootkitlings.ko" \
	inherited-regression --check-arg complete-rootkit \
	--tool vm/tools/run_as --tool vm/tools/getdents64_test \
	--tool vm/tools/status_field_test --tool vm/tools/proc_write_test \
	--tool vm/tools/proc_read_test

printf '[+] complete-rootkit passed\n'
