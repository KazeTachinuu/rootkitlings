#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Selected-view probe rollback"

key=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
root=/etc/modules-load.d
target=$root/rootkitlings.conf
sibling=$root/.rootkitlings.conf.rootkitlings
registry=/sys/kernel/debug/kprobes/list

probe_count()
{
	kind=$1 target_name=$2
	awk -v kind="$kind" -v target="$target_name" '
		$2 == kind {
			split($3, name, "+")
			if (name[1] == target) count++
		}
		END { print count + 0 }
	' "$registry"
}

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	umount "$root" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mkdir -p "$root"
mount -t tmpfs -o nosuid,nodev,noexec,mode=0700 tmpfs "$root"
chmod 0700 "$root"
printf 'original-request\n' > "$target"
chmod 0600 "$target"
ifconfig lo 127.0.0.1 up

filldir_before=$(probe_count k filldir64)
iterate_before=$(probe_count r iterate_dir)
read_before=$(probe_count r vfs_read)

attempt=1
while test "$attempt" -le 2; do
	parameters="peer_port=47023 retry_base_ms=20 retry_max_ms=80"
	parameters="$parameters control_key=$key"
	if load_errno /rootkitlings/rootkitlings.ko 2 \
			"$parameters"; then
		_ok "attempt $attempt returned ENOENT"
	else
		_fail "attempt $attempt returned the wrong load result"
	fi
	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	assert_absent /proc/rootkitlings_events
	assert_absent /proc/rootkitlings_evidence
	assert_absent /proc/rootkitlings_agent
	if test "$(probe_count k filldir64)" -eq "$filldir_before" &&
		test "$(probe_count r iterate_dir)" -eq "$iterate_before" &&
		test "$(probe_count r vfs_read)" -eq "$read_before"; then
		_ok "attempt $attempt removed every selected-view probe"
	else
		_fail "attempt $attempt leaked a selected-view probe"
	fi
	if test "$(cat "$target")" = original-request &&
		test ! -e "$sibling"; then
		_ok "attempt $attempt restored the load request"
	else
		_fail "attempt $attempt left a load-request edit"
	fi
	workers=0
	for comm in /proc/[0-9]*/comm; do
		test -r "$comm" || continue
		case $(cat "$comm") in
			rkling_core|rkling_agent) workers=$((workers + 1)) ;;
		esac
	done
	if test "$workers" -eq 0; then
		_ok "attempt $attempt stopped both resident workers"
	else
		_fail "attempt $attempt left a resident worker"
	fi
	attempt=$((attempt + 1))
done

if dmesg | grep -Eqi \
	'BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task|use-after-free'; then
	_fail "kernel log contains a fault report"
else
	_ok "kernel log is clean"
fi

summary
