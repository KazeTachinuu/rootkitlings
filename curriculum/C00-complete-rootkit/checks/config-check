#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Complete rootkit configuration boundaries"

key=3a8f51c26de409b7741fa083cc6259e8d043b7fa19ce562d80a41fe637c9520b
module=/rootkitlings/rootkitlings.ko
root=/etc/modules-load.d
target=$root/rootkitlings.conf
sibling=$root/.rootkitlings.conf.rootkitlings

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	umount "$root" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

expect_rejected()
{
	label=$1
	shift
	parameters="control_key=$key"
	for parameter in "$@"; do
		parameters="$parameters $parameter"
	done
	if load_errno "$module" 22 "$parameters"; then
		_ok "$label returns EINVAL"
	else
		_fail "$label returned the wrong result"
	fi
	assert_absent /sys/module/rootkitlings
	if test "$(cat "$target")" = operator-original &&
			test ! -e "$sibling"; then
		_ok "$label leaves the load request unchanged"
	else
		_fail "$label left a load-request edit"
	fi
}

expect_accepted()
{
	label=$1
	shift
	_show_command insmod "$module" "control_key=$key" "$@"
	if insmod "$module" "control_key=$key" "$@"; then
		_ok "$label is accepted"
		_show_command rmmod rootkitlings
		rmmod rootkitlings || _fail "$label did not unload"
	else
		_fail "$label was rejected"
	fi
	assert_absent /sys/module/rootkitlings
	if test "$(cat "$target")" = operator-original &&
			test ! -e "$sibling"; then
		_ok "$label restores the load request"
	else
		_fail "$label left a load-request edit"
	fi
}

assert_exists "$module"
mkdir -p "$root"
mount -t tmpfs -o nosuid,nodev,noexec,mode=0700 tmpfs "$root"
chmod 0700 "$root"
printf 'operator-original\n' > "$target"
chmod 0600 "$target"
expect_accepted "minimum timing values" peer_port=1 \
	retry_base_ms=1 retry_max_ms=1 shell_timeout_ms=1 \
	redirect_from_port=1 redirect_to_port=65535
expect_accepted "maximum timing values" peer_port=65535 \
	retry_base_ms=5000 retry_max_ms=5000 shell_timeout_ms=300000 \
	redirect_from_port=65534 redirect_to_port=65535
expect_rejected "zero peer port" peer_port=0
expect_rejected "zero retry delay" peer_port=47023 retry_base_ms=0
expect_rejected "reversed retry range" peer_port=47023 \
	retry_base_ms=81 retry_max_ms=80
expect_rejected "oversized retry ceiling" peer_port=47023 \
	retry_base_ms=1 retry_max_ms=5001
expect_rejected "zero shell timeout" peer_port=47023 shell_timeout_ms=0
expect_rejected "oversized shell timeout" peer_port=47023 \
	shell_timeout_ms=300001
expect_rejected "zero redirect source" peer_port=47023 \
	redirect_from_port=0 redirect_to_port=5489
expect_rejected "zero redirect target" peer_port=47023 \
	redirect_from_port=5488 redirect_to_port=0
expect_rejected "identical redirect ports" peer_port=47023 \
	redirect_from_port=5488 redirect_to_port=5488

if dmesg | grep -Eqi '(BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task)'; then
	_fail "rejected configurations produced a kernel fault"
else
	_ok "rejected configurations left a clean kernel log"
fi

summary
