#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
host_include=$here/../../L14-packed-directory-filter/fixtures/host/include
replace_source=$here/../../L15-bounded-rendered-filter/solution
fixture=$here/../fixtures/host/visibility_filter_test.c
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-visibility.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for path in instrumentation/getdents_probe.c \
		instrumentation/getdents_probe.o include/visibility.h \
		instrumentation/dirent_filter.c \
		include/replace.h instrumentation/replace.c \
		instrumentation/replace.o \
		interface/evidence.c interface/evidence.o; do
	[[ -f $build/$path && ! -L $build/$path ]] ||
		die "visibility component is missing: $path"
done

for path in include/replace.h instrumentation/replace.c; do
	cmp -s "$replace_source/$path" "$build/$path" ||
		die "bounded replacement helper changed: $path"
done

gcc -std=c11 -Wall -Wextra -Werror -pedantic \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I "$host_include" -I "$build/include" \
	"$build/instrumentation/dirent_filter.c" "$fixture" \
	-o "$scratch/directory-filter"
ASAN_OPTIONS=detect_leaks=1:abort_on_error=1 \
	"$scratch/directory-filter"

for symbol in register_kprobe unregister_kprobe register_kretprobe \
		unregister_kretprobe copy_from_user_nofault \
		copy_to_user_nofault filp_open igrab iput rk_filter_dirents64_if \
		rk_replace_equal; do
	nm -u "$build/instrumentation/getdents_probe.o" |
		awk -v symbol="$symbol" '$NF == symbol { found = 1 }
			END { exit !found }' ||
		die "visibility integration lacks $symbol"
done

for target in filldir64 iterate_dir vfs_read /proc/modules \
		/rootkitlings /etc/modules-load.d /sys/module; do
	strings "$build/instrumentation/getdents_probe.o" |
		grep -Fqx "$target" ||
		die "visibility integration lacks target: $target"
done

grep -Fqx 'evidence_map_version=2' \
	<(strings "$build/interface/evidence.o") ||
	die "evidence component does not publish version 2"

printf '[+] selected-view concealment integration verified\n'
