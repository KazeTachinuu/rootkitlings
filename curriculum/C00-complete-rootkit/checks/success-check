#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Complete rootkit"

test_port=9999
test_key="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
fixture_dir=$(mktemp -d)

ifconfig lo 127.0.0.1 up

secure_agent_fixture serve "$fixture_dir" "$test_port" 127.0.0.1 "$test_key" &
fixture_pid=$!

wait_marker()
{
	_timeout="${2:-200}"
	_elapsed=0
	while [ ! -f "$fixture_dir/$1" ] && [ "$_elapsed" -lt "$_timeout" ]; do
		sleep 0.1
		_elapsed=$((_elapsed + 1))
	done
	[ -f "$fixture_dir/$1" ]
}

if wait_marker ready 50; then
	_ok "secure fixture listening"
else
	_fail "secure fixture did not become ready"
	kill "$fixture_pid" 2>/dev/null
	summary
fi

load rootkitlings.ko peer_address=127.0.0.1 peer_port="$test_port" \
	retry_base_ms=25 retry_max_ms=200 control_key="$test_key" \
	shell_timeout_ms=2000

if wait_marker replay_rejected; then
	_ok "authenticated exchange with replay rejection"
else
	_fail "authenticated exchange failed"
fi

if wait_marker tamper_rejected; then
	_ok "tampered message rejected"
else
	_fail "tamper rejection failed"
fi

if wait_marker root_shell_complete; then
	_ok "root shell execution verified"
else
	_fail "root shell execution failed"
fi

if wait_marker control_complete; then
	_ok "control channel commands verified"
else
	_fail "control channel commands failed"
fi

if wait_marker quit_complete; then
	_ok "clean session termination"
else
	_fail "session termination failed"
fi

if wait_marker shell_replay_rejected; then
	_ok "shell command replay rejected"
else
	_fail "shell command replay not rejected"
fi

if wait_marker shell_tamper_rejected; then
	_ok "shell command tamper rejected"
else
	_fail "shell command tamper not rejected"
fi

if test -r /proc/rkling_status; then
	_ok "/proc/rkling_status exists"
else
	_fail "/proc/rkling_status not found"
fi

if ! grep -q rootkitlings /proc/modules; then
	_ok "module hidden from lsmod on load"
else
	_fail "module visible in lsmod after load"
fi

# Wait for the fixture to uncloak the module before rmmod
if wait_marker uncloaked; then
	_ok "fixture uncloaked module"
else
	_fail "fixture did not uncloak module"
fi

# Wait for the fixture to reach the final expect_eof point
if wait_marker blocked_receive; then
	_ok "fixture reached final phase"
else
	_fail "fixture did not reach final phase"
fi

# Unload triggers control channel close so the fixture can see EOF
unload rootkitlings

if wait_marker eof 100; then
	_ok "fixture protocol completed"
else
	_fail "fixture did not complete"
fi

kill "$fixture_pid" 2>/dev/null
wait "$fixture_pid" 2>/dev/null

workers=0
for comm in /proc/[0-9]*/comm; do
	test -r "$comm" || continue
	case $(cat "$comm") in
		rkling_*) workers=$((workers + 1)) ;;
	esac
done
if test "$workers" -eq 0; then
	_ok "unload left no resident threads"
else
	_fail "unload left $workers resident threads"
fi

if dmesg | grep -Eqi '(BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task)'; then
	_fail "kernel log contains a fault report"
else
	_ok "kernel log is clean"
fi

rm -rf "$fixture_dir"
summary
