#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Selected-view concealment and independent evidence"

key=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
control=/proc/rootkitlings
events=/proc/rootkitlings_events
evidence=/proc/rootkitlings_evidence
agent_status=/proc/rootkitlings_agent
request_root=/etc/modules-load.d
request=$request_root/rootkitlings.conf
sibling=$request_root/.rootkitlings.conf.rootkitlings
registry=/sys/kernel/debug/kprobes/list
listener=

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	if test -n "$listener"; then
		kill "$listener" 2>/dev/null || true
		wait "$listener" 2>/dev/null || true
	fi
	umount "$request_root" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

listed()
{
	expectation=$1 directory=$2 name=$3 capacity=${4:-32768}
	getdents64_test "$expectation" "$directory" "$capacity" "$name" \
		> /dev/null
}

probe_count()
{
	kind=$1 target=$2
	awk -v kind="$kind" -v target="$target" '
		$2 == kind {
			split($3, name, "+")
			if (name[1] == target) count++
		}
		END { print count + 0 }
	' "$registry"
}

assert_names()
{
	expectation=$1 directory=$2
	shift 2
	for name in "$@"; do
		if listed "$expectation" "$directory" "$name"; then
			_ok "$directory $expectation name: $name"
		else
			_fail "$directory has the wrong view of: $name"
		fi
	done
}

observe_many()
{
	target_pid=$1 index=0
	while test "$index" -lt 32; do
		getdents64_test either /proc 32768 "$target_pid" \
			> /dev/null || return 1
		modules=$(cat /proc/modules) || return 1
		case $modules in
			*rootkitlings*)
				case $modules in *------------*) return 1 ;; esac ;;
			*------------*) ;;
			*) return 1 ;;
		esac
		index=$((index + 1))
	done
}

toggle_many()
{
	index=0
	while test "$index" -lt 32; do
		printf disable > "$control" || return 1
		printf enable > "$control" || return 1
		index=$((index + 1))
	done
}

mkdir -p "$request_root"
mount -t tmpfs -o nosuid,nodev,noexec,mode=0700 tmpfs "$request_root"
chmod 0700 "$request_root"
printf 'operator-original\n' > "$request"
chmod 0600 "$request"
ifconfig lo 127.0.0.1 up

nc -l -p 47023 -s 127.0.0.2 > /dev/null 2>&1 &
listener=$!
filldir_before=$(probe_count k filldir64)
iterate_before=$(probe_count r iterate_dir)
read_before=$(probe_count r vfs_read)
load rootkitlings.ko peer_address=127.0.0.2 peer_port=47023 \
	retry_base_ms=20 retry_max_ms=80 "control_key=$key"
assert_loaded rootkitlings
for path in "$control" "$events" "$evidence" "$agent_status"; do
	assert_exists "$path"
done

worker=$(sed -n 's/^target_worker_pid=//p' "$evidence")
agent=$(sed -n 's/^target_agent_pid=//p' "$evidence")
if test "$worker" -gt 0 2>/dev/null && test "$agent" -gt 0 2>/dev/null;
then
	_ok "evidence identifies the resident worker and agent"
else
	_fail "evidence has invalid process identities"
fi

assert_names visible /proc rootkitlings rootkitlings_events \
	rootkitlings_evidence rootkitlings_agent "$worker" "$agent"
assert_names visible /rootkitlings rootkitlings.ko
assert_names visible "$request_root" rootkitlings.conf \
	.rootkitlings.conf.rootkitlings
assert_names visible /sys/module rootkitlings
if read_result_test contains read /proc/modules rootkitlings; then
	_ok "disabled state leaves the module name unchanged"
else
	_fail "disabled state altered /proc/modules"
fi

printf enable > "$control"
assert_names hidden /proc rootkitlings rootkitlings_events \
	rootkitlings_evidence rootkitlings_agent "$worker" "$agent"
assert_names hidden /rootkitlings rootkitlings.ko
assert_names hidden "$request_root" rootkitlings.conf \
	.rootkitlings.conf.rootkitlings
assert_names hidden /sys/module rootkitlings

if test -r /rootkitlings/rootkitlings.ko &&
	test -r "$request" && test -r "$sibling" &&
	test -d /sys/module/rootkitlings &&
	test -r "$control" && test -r "$events" &&
	test -r "$evidence" && test -r "$agent_status"; then
	_ok "every omitted name remains reachable by its exact path"
else
	_fail "an exact artifact path became unavailable"
fi
if test "$(cat "$request")" = rootkitlings &&
	test "$(cat "$sibling")" = operator-original; then
	_ok "direct load-request reads preserve both real files"
else
	_fail "direct load-request evidence changed"
fi
if test "$(cat "/proc/$worker/comm")" = rkling_core &&
	test "$(cat "/proc/$agent/comm")" = rkling_agent; then
	_ok "direct process views expose both resident tasks"
else
	_fail "direct process evidence is missing"
fi
if /bin/busybox unshare -pf --mount-proc sh -c \
	"grep -Fxq 'target_worker_pid=0' /proc/rootkitlings_evidence && \
	 grep -Fxq 'target_agent_pid=0' /proc/rootkitlings_evidence"; then
	_ok "a child PID namespace receives translated process identities"
else
	_fail "process identities crossed a PID namespace"
fi

if read_result_test excludes read /proc/modules rootkitlings &&
	read_result_test contains read /proc/modules ------------; then
	_ok "bounded read masks only the selected module token"
else
	_fail "selected /proc/modules read was not masked"
fi
if read_result_test contains readv /proc/modules rootkitlings; then
	_ok "readv remains an independent module view"
else
	_fail "alternate module evidence was unexpectedly filtered"
fi
if getdents64_test legacy /proc "$worker" &&
	getdents64_test legacy /rootkitlings rootkitlings.ko; then
	_ok "legacy getdents remains an independent directory view"
else
	_fail "alternate directory evidence was unexpectedly filtered"
fi
if awk '$3 == "rk_visibility_start" { found = 1 }
	END { exit !found }' /proc/kallsyms &&
	grep -q 'iterate_dir' "$registry" && grep -q 'vfs_read' "$registry";
then
	_ok "symbols and the probe registry remain independent evidence"
else
	_fail "independent symbol or probe evidence is missing"
fi

port=$(printf '%04X' 47023)
if awk -v port="$port" '
	index($2, ":" port) || index($3, ":" port) { found = 1 }
	END { exit !found }
' /proc/net/tcp; then
	_ok "the control socket remains visible in /proc/net/tcp"
else
	_fail "the control socket was not independently visible"
fi

oversize_before=$(sed -n 's/^directory_oversize=//p' "$evidence")
if listed visible /proc "$worker" 65536 &&
	test "$(sed -n 's/^directory_oversize=//p' "$evidence")" \
		-gt "$oversize_before"; then
	_ok "an oversized directory request remains unchanged"
else
	_fail "the oversized-result boundary was not preserved"
fi
if listed visible /proc self && listed visible /proc thread-self &&
	listed visible /proc 1; then
	_ok "unrelated proc names remain visible"
else
	_fail "an unrelated proc name was removed"
fi

printf disable > "$control"
if getdents64_test isolate /proc "$control" "$worker" > /dev/null; then
	_ok "an all-target result remains positive and makes progress"
else
	_fail "all-target handling produced false EOF"
fi

pids=
index=0
while test "$index" -lt 4; do
	observe_many "$worker" &
	pids="$pids $!"
	index=$((index + 1))
done
toggle_many &
pids="$pids $!"
concurrent_ok=1
for pid in $pids; do
	wait "$pid" || concurrent_ok=0
done
directory_missed=$(sed -n 's/^directory_returns_missed=//p' "$evidence")
read_missed=$(sed -n 's/^read_returns_missed=//p' "$evidence")
if test "$concurrent_ok" -eq 1 && test "$directory_missed" = 0 &&
	test "$read_missed" = 0; then
	_ok "concurrent toggles return complete directory and read views"
else
	_fail "concurrent selected-view operations were missed or torn"
fi

printf disable > "$control"
assert_names visible /proc rootkitlings rootkitlings_events \
	rootkitlings_evidence rootkitlings_agent "$worker" "$agent"
assert_names visible /rootkitlings rootkitlings.ko
assert_names visible "$request_root" rootkitlings.conf \
	.rootkitlings.conf.rootkitlings
assert_names visible /sys/module rootkitlings
if read_result_test contains read /proc/modules rootkitlings; then
	_ok "disabling actions restores the original module read"
else
	_fail "disabled state did not restore /proc/modules"
fi

if grep -Fxq 'outside_filter_scope=direct-path-lookup' "$evidence" &&
	grep -Fxq 'outside_filter_scope=alternate-read-apis' "$evidence" &&
	grep -Fxq 'outside_filter_scope=proc-net-tcp-and-sock-diag' \
		"$evidence" &&
	grep -Fxq 'outside_filter_scope=root-shell-process' "$evidence";
then
	_ok "evidence states the selected-view boundary"
else
	_fail "evidence overstates concealment"
fi

unload rootkitlings
assert_absent "$control"
assert_absent "$events"
assert_absent "$evidence"
assert_absent "$agent_status"
if test "$(probe_count k filldir64)" -eq "$filldir_before" &&
	test "$(probe_count r iterate_dir)" -eq "$iterate_before" &&
	test "$(probe_count r vfs_read)" -eq "$read_before"; then
	_ok "unload removes the selected-view probes"
else
	_fail "unload left a selected-view probe"
fi
if dmesg | grep -Eqi \
	'BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task|use-after-free'; then
	_fail "kernel log contains a fault report"
else
	_ok "kernel log is clean"
fi

summary
