#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
parent=$here/../../M08-authenticated-reverse-shell

[[ -f $module && ! -L $module ]] || die "module must be a regular file"

while IFS= read -r source; do
	relative=${source#"$parent/starter/"}
	case $relative in security/control.c) continue ;; esac
	cmp -s "$source" "$build/$relative" ||
		die "inherited authenticated-shell file changed: $relative"
done < <(find "$parent/starter" -type f | sort)

while IFS= read -r source; do
	relative=${source#"$parent/solution/"}
	case $relative in Kbuild|core/main.c) continue ;; esac
	cmp -s "$source" "$build/$relative" ||
		die "inherited authenticated-shell file changed: $relative"
done < <(find "$parent/solution" -type f | sort)

for symbol in rk_netfilter_start rk_netfilter_stop; do
	nm -u "$build/core/main.o" |
		awk -v symbol="$symbol" '$2 == symbol { found = 1 }
			END { exit !found }' ||
		die "module lifecycle does not call $symbol"
done

for object in core/main.o instrumentation/netfilter_observer.o \
		access/skb_access.o classifier/udp.o mutation/udp_redirect.o \
		mutation/writable.o parser/ipv4.o; do
	[[ -f $build/$object && ! -L $build/$object ]] ||
		die "packet integration component is missing: $object"
done

printf '[+] complete-rootkit host integration passed\n'
