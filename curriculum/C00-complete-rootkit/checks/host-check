#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
remote_agent=$here/../../M03-remote-resident-agent
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-complete-rootkit-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"

while IFS= read -r source; do
	relative=${source#"$remote_agent/starter/"}
	case $relative in
		include/agent.h|include/framing.h|include/platform.h|include/protocol.h)
			continue ;;
		network/agent.c|network/protocol.c)
			continue ;;
	esac
	cmp -s "$source" "$build/$relative" ||
		die "inherited resident-agent addition changed: $relative"
done < <(find "$remote_agent/starter" -type f | sort)
while IFS= read -r source; do
	relative=${source#"$remote_agent/solution/"}
	case $relative in Kbuild|core/main.c|network/agent.c) continue ;; esac
	cmp -s "$source" "$build/$relative" ||
		die "inherited resident-agent solution changed: $relative"
done < <(find "$remote_agent/solution" -type f | sort)
while IFS= read -r source; do
	relative=${source#"$here/../starter/"}
	case $relative in security/control.c) continue ;; esac
	cmp -s "$source" "$build/$relative" || die "supplied addition changed: $relative"
done < <(find "$here/../starter" -type f | sort)

gcc -std=c11 -Wall -Wextra -Werror -pedantic -O1 -g \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I"$build/include" "$here/../fixtures/host/control_test.c" \
	"$here/../fixtures/host/crypto_oracle.c" "$build/security/control.c" \
	"$build/network/protocol.c" \
	-lcrypto -o "$scratch/control-test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
	"$scratch/control-test"

for symbol in rk_secure_channel_start rk_secure_channel_stop \
		rk_secure_open_request rk_secure_seal_reply; do
	nm "$build/security/control.o" |
		awk -v symbol="$symbol" '$2 == "T" && $3 == symbol { found = 1 }
			END { exit !found }' || die "learner object lacks $symbol"
done
if nm "$build/security/control.o" | grep -Eq '[[:space:]][bBdD][[:space:]]'; then
	die "learner file must not own mutable persistent object state"
fi
for symbol in rk_secure_open_request rk_secure_seal_reply; do
	nm -u "$build/network/agent.o" |
		awk -v symbol="$symbol" '$2 == symbol { found = 1 } END { exit !found }' ||
		die "agent does not use $symbol"
done
for symbol in rk_state_actions_enabled rk_state_set_actions_enabled \
		rk_state_worker_runs rk_worker_request; do
	nm -u "$build/network/agent.o" |
		awk -v symbol="$symbol" '$2 == symbol { found = 1 }
			END { exit !found }' ||
		die "agent does not operate the resident core through $symbol"
done
for symbol in rk_agent_enable_commands rk_agent_start; do
	nm -u "$build/core/main.o" |
		awk -v symbol="$symbol" '$2 == symbol { found = 1 } END { exit !found }' ||
		die "module initialization does not call $symbol"
done
for object in crypto/aead.o crypto/aead_platform.o crypto/auth_platform.o \
		message/authenticated.o signal/authenticated_dns.o signal/status.o \
		transport/udp.o wire/dns_query.o; do
	[[ -f $build/$object ]] || die "built component is missing: $object"
done
for object in core/main.o core/state.o interface/proc.o execution/worker.o \
		execution/scheduler.o control/authorization.o privilege/credentials.o \
		instrumentation/return_probe.o instrumentation/events.o \
		instrumentation/dirent_filter.o instrumentation/getdents_probe.o \
		interface/evidence.o network/framing.o network/protocol.o \
		network/agent.o persistence/platform.o persistence/transaction.o \
		interface/agent_status.o security/control.o; do
	[[ -f $build/$object && ! -L $build/$object ]] ||
		die "complete rootkit component is missing: $object"
done

printf '[+] authenticated control host behavior passed\n'
