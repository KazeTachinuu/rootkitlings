#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR ARTIFACT_PATH"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"
[[ -d $build_dir && ! -L $build_dir ]] || die "build directory must be a real directory"
[[ -f $artifact && ! -L $artifact ]] || die "artifact must be a regular file"
[[ $artifact == "$build_dir/rootkitlings.ko" ]] ||
	die "expected artifact at: $build_dir/rootkitlings.ko"

for path in core/main.o core/state.o interface/proc.o execution/worker.o \
	execution/scheduler.o include/rootkit.h; do
	[[ -f $build_dir/$path && ! -L $build_dir/$path ]] ||
		die "build output is missing regular file: $path"
done

for tool in modinfo nm; do
	command -v "$tool" >/dev/null || die "$tool is required"
done
[[ $(modinfo -F license "$artifact") == GPL ]] || die "module license must be GPL"
[[ $(modinfo -F description "$artifact") == 'Rootkitlings kernel module' ]] ||
	die "module description must be: Rootkitlings kernel module"

undefined=$(nm -u "$artifact")
for forbidden in queue_work_on cancel_work_sync flush_work alloc_workqueue \
	__alloc_workqueue_key system_wq system_highpri_wq system_long_wq \
	system_unbound_wq system_freezable_wq system_power_efficient_wq \
	system_freezable_power_efficient_wq; do
	while IFS= read -r line; do
		[[ ${line##* } == "$forbidden" ]] &&
			die "the resident core must not depend on workqueue symbol $forbidden"
	done <<< "$undefined"
done

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
"$here/worker-behavior-check" "$build_dir/execution/worker.c"

printf '[+] resident worker admission, consumption, stop priority, and cleanup verified\n'
