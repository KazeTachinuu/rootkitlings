#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "Controlled resident core"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-core
actual=$fixtures/actual
mkdir -p "$fixtures"

: > "$fixtures/empty"
printf 'enable' > "$fixtures/enable"
printf 'enable\n' > "$fixtures/enable-lf"
printf 'disable' > "$fixtures/disable"
printf 'disable\n' > "$fixtures/disable-lf"
printf 'run' > "$fixtures/run"
printf 'run\n' > "$fixtures/run-lf"
printf '\n' > "$fixtures/lone-lf"
printf 'ena\nble' > "$fixtures/interior-lf"
printf 'enable\n\n' > "$fixtures/double-lf"
printf 'run\000' > "$fixtures/nul"
printf 'ru' > "$fixtures/prefix"
printf 'runner' > "$fixtures/suffix"
printf 'xrun' > "$fixtures/prefixed"
printf 'disable\nx' > "$fixtures/oversized"
chmod 0644 "$fixtures"/*

scan_workers()
{
	worker_count_value=0
	worker_pid_value=
	for comm in /proc/[0-9]*/comm; do
		[ -r "$comm" ] || continue
		if [ "$(cat "$comm")" = rkling_core ]; then
			worker_count_value=$((worker_count_value + 1))
			worker_pid_value=${comm#/proc/}
			worker_pid_value=${worker_pid_value%/comm}
		fi
	done
}

assert_no_worker()
{
	scan_workers
	if [ "$worker_count_value" -eq 0 ]; then
		_ok "rkling_core is absent"
	else
		_fail "rkling_core is still running"
	fi
}

assert_sleeping_worker()
{
	sleep_attempt=0
	while [ "$sleep_attempt" -lt 100 ]; do
		scan_workers
		if [ "$worker_count_value" -eq 1 ]; then
			task_state=$(sed -n 's/.*) \([A-Z]\) .*/\1/p' "/proc/$worker_pid_value/stat" 2>/dev/null)
			if [ "$task_state" = S ]; then
				_ok "one rkling_core task is sleeping with an empty slot"
				return
			fi
		fi
		sleep 0.01
		sleep_attempt=$((sleep_attempt + 1))
	done
	_fail "one sleeping rkling_core task was not observed"
}

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
	assert_no_worker
}

read_status()
{
	expected=$1
	label=$2
	if cat "$endpoint" > "$actual" &&
	   awk -v expected="$expected" '
		BEGIN { valid = 1 }
		NR == 1 { if ($0 != "active=1") valid = 0 }
		NR == 2 { if ($0 != "actions=" expected) valid = 0 }
		NR == 3 { if ($0 !~ /^timer_fires=[0-9]+$/) valid = 0 }
		NR == 4 { if ($0 !~ /^worker_runs=[0-9]+$/) valid = 0 }
		END { exit !(valid && NR == 4) }
	   ' "$actual"; then
		status_timer=$(sed -n 's/^timer_fires=//p' "$actual")
		status_runs=$(sed -n 's/^worker_runs=//p' "$actual")
		_ok "$label returns one complete $expected record"
		return 0
	fi
	status_timer=0
	status_runs=0
	_fail "$label: malformed or unexpected proc record"
	return 1
}

expect_disabled_errno()
{
	fixture=$1
	errno=$2
	label=$3
	before=$(status_field_test read "$endpoint" worker_runs)
	if proc_write_test errno "$endpoint" "$fixtures/$fixture" "$errno" > /dev/null; then
		_ok "$label returns errno $errno"
	else
		_fail "$label did not return errno $errno"
	fi
	if status_field_test unchanged "$endpoint" worker_runs "$before" 80 > /dev/null; then
		_ok "$label does not execute an action"
	else
		_fail "$label changed worker_runs"
	fi
}

check_loaded()
{
	assert_loaded rootkitlings
	assert_exists "$endpoint"
	metadata=$(stat -c '%a:%u:%g' "$endpoint")
	if [ "$metadata" = 644:0:0 ]; then
		_ok "$endpoint is mode 0644 and owned by 0:0"
	else
		_fail "$endpoint metadata: expected 644:0:0, got $metadata"
	fi
	read_status disabled "module load" > /dev/null || true
	if [ "$status_runs" -eq 0 ]; then
		_ok "worker_runs begins at zero"
	else
		_fail "worker_runs starts at $status_runs"
	fi
	assert_sleeping_worker
}

check_rejections()
{
	expect_disabled_errno run 13 "disabled bare run"
	expect_disabled_errno run-lf 13 "disabled run with newline"
	expect_disabled_errno empty 22 "empty write"
	expect_disabled_errno lone-lf 22 "lone newline"
	expect_disabled_errno interior-lf 22 "interior newline"
	expect_disabled_errno double-lf 22 "second trailing newline"
	expect_disabled_errno nul 22 "embedded NUL"
	expect_disabled_errno prefix 22 "short prefix"
	expect_disabled_errno suffix 22 "suffix"
	expect_disabled_errno prefixed 22 "prefixed command"
	expect_disabled_errno oversized 7 "nine-byte command"

	if proc_write_test fault "$endpoint" "$fixtures/run" 14 > /dev/null; then
		_ok "partial user copy returns errno 14"
	else
		_fail "partial user copy did not return errno 14"
	fi
	if proc_write_test fault "$endpoint" "$fixtures/oversized" 7 > /dev/null; then
		_ok "oversized write is rejected before user copy"
	else
		_fail "oversized write touched user memory before rejection"
	fi
	if proc_write_test offset "$endpoint" "$fixtures/run" 1 22 > /dev/null; then
		_ok "nonzero offset returns errno 22"
	else
		_fail "nonzero offset did not return errno 22"
	fi
	if run_as 65534 65534 proc_write_test write "$endpoint" \
		"$fixtures/run" > "$fixtures/unprivileged.log" 2>&1; then
		_fail "unprivileged writer submitted a request"
	else
		_ok "unprivileged writer is denied"
	fi
	read_status disabled "rejected writes" > /dev/null || true
}

check_disabled_timer()
{
	read_status disabled "disabled scheduler" > /dev/null || true
	before_timer=$status_timer
	before_runs=$status_runs
	step=1
	while [ "$step" -le 3 ]; do
		if status_timer=$(status_field_test advance "$endpoint" timer_fires \
			"$status_timer" 1200); then
			step=$((step + 1))
		else
			_fail "timer did not produce firing $step"
			break
		fi
	done
	if [ "$step" -eq 4 ]; then
		_ok "timer records three firings while actions are disabled"
	fi
	if status_field_test unchanged "$endpoint" worker_runs "$before_runs" 300 > /dev/null; then
		_ok "disabled periodic requests execute no actions"
	else
		_fail "worker_runs changed while actions were disabled"
	fi
	disabled_timer=$status_timer
}

settle_worker_runs()
{
	settled=0
	settle_attempt=1
	while [ "$settle_attempt" -le 3 ]; do
		settled_runs=$(status_field_test read "$endpoint" worker_runs)
		if status_field_test unchanged "$endpoint" worker_runs \
			"$settled_runs" 300 > /dev/null 2>&1; then
			settled=1
			break
		fi
		settle_attempt=$((settle_attempt + 1))
	done
	[ "$settled" -eq 1 ]
}

check_manual_and_periodic_requests()
{
	if proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null; then
		_ok "enable returns its full byte count"
	else
		_fail "enable failed"
	fi
	read_status enabled "enable" > /dev/null || true
	enabled_before=$status_runs
	if status_runs=$(status_field_test advance "$endpoint" worker_runs \
		"$enabled_before" 1200); then
		_ok "the enabled timer reaches the resident worker"
	else
		_fail "enabled periodic requests produced no action"
	fi

	if proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null &&
	   settle_worker_runs; then
		_ok "worker_runs settles before the admission accounting window"
	else
		_fail "worker_runs did not settle before admission accounting"
	fi
	before_timer=$(status_field_test read "$endpoint" timer_fires)
	before_runs=$settled_runs
	if proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null; then
		_ok "actions are enabled for concurrent requests"
	else
		_fail "could not enable actions for concurrent requests"
	fi
	pids=
	writer=1
	while [ "$writer" -le 4 ]; do
		(
			i=0
			while [ "$i" -lt 64 ]; do
				proc_write_test outcome "$endpoint" "$fixtures/run" || exit 1
				i=$((i + 1))
			done
		) > "$fixtures/outcomes-$writer" &
		pids="$pids $!"
		writer=$((writer + 1))
	done
	writers_ok=1
	for pid in $pids; do
		wait "$pid" || writers_ok=0
	done
	if [ "$writers_ok" -eq 1 ]; then
		_ok "four concurrent writers receive bounded request outcomes"
	else
		_fail "a concurrent request writer failed"
	fi
	if grep -h -Ev '^(ok|11)$' "$fixtures"/outcomes-* > "$fixtures/bad-outcomes"; then
		_fail "a manual request returned an outcome other than success or EAGAIN"
	else
		_ok "every manual request returns success or errno 11"
	fi
	ok_count=0
	again_count=0
	for outcome_file in "$fixtures"/outcomes-*; do
		count=$(grep -c '^ok$' "$outcome_file" 2>/dev/null || true)
		ok_count=$((ok_count + count))
		count=$(grep -c '^11$' "$outcome_file" 2>/dev/null || true)
		again_count=$((again_count + count))
	done
	if [ $((ok_count + again_count)) -eq 256 ] && [ "$ok_count" -gt 0 ]; then
		_ok "256 concurrent writes are accounted for and at least one enters the slot"
	else
		_fail "manual outcomes: success=$ok_count EAGAIN=$again_count"
	fi

	if proc_write_test write "$endpoint" "$fixtures/disable-lf" > /dev/null; then
		_ok "disable with newline returns its full byte count"
	else
		_fail "disable with newline failed"
	fi
	if settle_worker_runs; then
		_ok "worker_runs settles after disable"
	else
		_fail "worker_runs did not settle after disable"
	fi
	final_runs=$settled_runs
	final_timer=$(status_field_test read "$endpoint" timer_fires)
	worker_delta=$((final_runs - before_runs))
	timer_delta=$((final_timer - before_timer))
	maximum_runs=$((ok_count + timer_delta))
	if [ "$worker_delta" -ge 0 ] && [ "$worker_delta" -le "$maximum_runs" ]; then
		_ok "the capacity-one path does not invent completed actions"
	else
		_fail "worker delta $worker_delta exceeds $maximum_runs admitted sources"
	fi
	read_status disabled "disabled after concurrent requests" > /dev/null || true
	expect_disabled_errno run 13 "run after disable"
}

assert_not_loaded

load rootkitlings.ko
check_loaded
check_rejections
check_disabled_timer
first_cycle_timer=$disabled_timer
unload rootkitlings
assert_not_loaded

load rootkitlings.ko
check_loaded
if [ "$status_timer" -lt "$first_cycle_timer" ]; then
	_ok "the second load starts with fresh counters"
else
	_fail "timer_fires did not reset: first=$first_cycle_timer second=$status_timer"
fi
check_disabled_timer
check_manual_and_periodic_requests

if proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null; then
	_ok "actions enabled before active unload"
else
	_fail "could not enable before active unload"
fi
active_before=$(status_field_test read "$endpoint" worker_runs)
if status_field_test advance "$endpoint" worker_runs "$active_before" 1200 > /dev/null; then
	_ok "worker is active before unload"
else
	_fail "worker did not become active before unload"
fi
if proc_write_test unload "$endpoint" "$fixtures/run" rootkitlings > /dev/null; then
	_ok "held proc descriptor rejects a request after active unload"
else
	_fail "held-descriptor active unload check failed"
fi
assert_not_loaded
sleep 0.3
assert_not_loaded

summary
