#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../../scripts/lesson-env"
ROOT=$ROOTKITLINGS_ROOT
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-m01.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || { printf '[x] M01 requires x86_64\n' >&2; exit 1; }
for option in X86_64 KPROBES KRETPROBES KRETPROBE_ON_RETHOOK \
	KPROBES_ON_FTRACE KALLSYMS KALLSYMS_ALL DEBUG_FS \
	ARCH_HAS_SYSCALL_WRAPPER MODULES MODULE_UNLOAD MULTIUSER USER_NS \
	CRYPTO_LIB_UTILS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] M01 requires CONFIG_%s=y\n' "$option" >&2; exit 1;
	}
done
grep -Eqx '(CONFIG_PREEMPT_RT=n|# CONFIG_PREEMPT_RT is not set)' \
	"$KDIR/.config" || {
	printf '[x] M01 requires CONFIG_PREEMPT_RT=n\n' >&2; exit 1;
}

mapfile -t supplied < <(
	cd "$HERE/additions"
	find . -type f -printf '%P\n' | sort
)
expected_supplied=(control/authorization.c instrumentation/events.c \
	instrumentation/return_probe.c privilege/credentials.c)
[[ ${supplied[*]} == "${expected_supplied[*]}" ]] || {
	printf '[x] cumulative additions differ\n' >&2
	exit 1
}
mapfile -t changed < <(
	cd "$HERE/solution-overlay"
	find . -type f -printf '%P\n' | sort
)
expected=(Kbuild control/authorization.c core/main.c include/rootkit.h \
	instrumentation/events.c instrumentation/return_probe.c interface/proc.c)
[[ ${changed[*]} == "${expected[*]}" ]] || {
	printf '[x] learner edit surface differs\nexpected: %s\nactual: %s\n' \
		"${expected[*]}" "${changed[*]}" >&2; exit 1;
}

for script in test host-check success-check failure-check.in action-failure-check.in; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check.in" \
		"$HERE/action-failure-check.in"
fi
for compiler in gcc clang; do
	"$compiler" -std=c11 -Wall -Wextra -Werror -static \
		-o "$scratch/event_stream_test.$compiler" "$ROOT/vm/tools/event_stream_test.c"
done
make -s -C "$ROOT" -B vm/tools/event_stream_test vm/tools/cred_trigger_test \
	vm/tools/module_load_test vm/tools/status_field_test

build_variant()
{
	local name=$1 point=$2 directory log
	directory=$scratch/$name
	log=$scratch/$name.log
	mkdir -p "$directory"
	cp -a "$HERE/../../stage-02/m00-controlled-resident-core/solution/." \
		"$directory/"
	cp -a "$HERE/additions/." "$directory/"
	cp -a "$HERE/solution-overlay/." "$directory/"
	if ! make -s -C "$KDIR" M="$directory" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules >"$log" 2>&1; then
		cat "$log" >&2; printf '[x] %s build failed\n' "$name" >&2; exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2; printf '[x] %s builds with warnings\n' "$name" >&2; exit 1
	fi
}

build_variant success 0
for point in {1..9}; do build_variant "failure-$point" "$point"; done
"$HERE/../r12-one-use-authorization/host-check" \
	"$scratch/success" "$scratch/success/rootkitlings.ko" \
	"$scratch/failure-8" "$scratch/failure-9"
"$HERE/host-check" "$scratch/success" "$scratch/success/rootkitlings.ko"

rebuild_fixture()
{
	local directory=$1 label=$2 log=$scratch/$2-build.log
	if ! make -s -C "$KDIR" M="$directory" W=1 \
		ROOTKITLINGS_FAIL_POINT=0 modules >"$log" 2>&1; then
		cat "$log" >&2; printf '[x] %s fixture did not build\n' "$label" >&2; exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2; printf '[x] %s fixture warns\n' "$label" >&2; exit 1
	fi
}

reject_fixture()
{
	local directory=$1 label=$2
	if "$HERE/host-check" "$directory" "$directory/rootkitlings.ko" \
		>"$scratch/$label-host.log" 2>&1; then
		printf '[x] host checker accepted %s\n' "$label" >&2; exit 1
	fi
}

formatted=$scratch/valid-equivalent
cp -a "$scratch/success" "$formatted"
sed -i '/spin_lock(&event_lock);/i\
\t/* The lock protects complete records and every ring index. */' \
	"$formatted/instrumentation/events.c"
sed -i '/void rk_events_record_rmdir(long result)/,/^}/c\
void rk_events_record_rmdir(long result)\
{\
\tif (result > 0)\
\t\treturn;\
\trk_events_append(RK_EVENT_RMDIR, result == 0);\
}' "$formatted/instrumentation/events.c"
sed -i 's/retained++;/++retained;/; s/overwritten++;/++overwritten;/' \
	"$formatted/instrumentation/events.c"
sed -i 's/record->sequence = next_sequence++;/record->sequence = next_sequence; ++next_sequence;/' \
	"$formatted/instrumentation/events.c"
rebuild_fixture "$formatted" valid-equivalent
"$HERE/host-check" "$formatted" "$formatted/rootkitlings.ko" \
	>"$scratch/valid-equivalent-host.log"

macro_sleep=$scratch/macro-sleep
cp -a "$scratch/success" "$macro_sleep"
sed -i '/#include <linux\/errno.h>/a #include <linux/delay.h>\n#define RK_SLEEP usleep_range' \
	"$macro_sleep/instrumentation/events.c"
sed -i '/spin_lock(&event_lock);/a\
\tRK_SLEEP(10, 20);' "$macro_sleep/instrumentation/events.c"
rebuild_fixture "$macro_sleep" macro-sleep
reject_fixture "$macro_sleep" macro-hidden-sleeping-lock

outside_ring=$scratch/outside-ring
cp -a "$scratch/success" "$outside_ring"
sed -i '/static struct rk_state \*probe_state;/a static u64 next_sequence;' \
	"$outside_ring/instrumentation/return_probe.c"
reject_fixture "$outside_ring" ring-storage-outside-owner

caller_tid=$scratch/caller-tid
cp -a "$scratch/success" "$caller_tid"
sed -i 's/rk_events_record_credential_change(void)/rk_events_record_credential_change(pid_t tid)/' \
	"$caller_tid/include/rootkit.h"
reject_fixture "$caller_tid" caller-supplied-attribution

format_lock=$scratch/format-under-lock
cp -a "$scratch/success" "$format_lock"
sed -i '/spin_lock(&event_lock);/a\
\tseq_puts(NULL, "forbidden");' "$format_lock/instrumentation/events.c"
rebuild_fixture "$format_lock" format-under-lock
reject_fixture "$format_lock" formatting-under-lock

unlocked_sequence=$scratch/unlocked-sequence
cp -a "$scratch/success" "$unlocked_sequence"
sed -i '/static void rk_events_append/,/^}/ {
	/record->sequence = next_sequence++;/d
	/spin_unlock(&event_lock);/a\
\trecord->sequence = next_sequence++;
}' "$unlocked_sequence/instrumentation/events.c"
rebuild_fixture "$unlocked_sequence" unlocked-sequence
reject_fixture "$unlocked_sequence" unlocked-sequence-allocation

unlocked_record=$scratch/unlocked-record
cp -a "$scratch/success" "$unlocked_record"
sed -i '/static void rk_events_append/,/^}/ {
	/record->tid = task_pid_nr(current);/d
	/spin_unlock(&event_lock);/a\
\trecord->tid = task_pid_nr(current);
}' "$unlocked_record/instrumentation/events.c"
rebuild_fixture "$unlocked_record" unlocked-record
reject_fixture "$unlocked_record" unlocked-record-publication

unlocked_snapshot=$scratch/unlocked-snapshot
cp -a "$scratch/success" "$unlocked_snapshot"
sed -i '/static void rk_events_snapshot/,/^}/ {
	/snapshot->overwritten = overwritten;/d
	/spin_unlock(&event_lock);/a\
\tsnapshot->overwritten = overwritten;
}' "$unlocked_snapshot/instrumentation/events.c"
rebuild_fixture "$unlocked_snapshot" unlocked-snapshot
reject_fixture "$unlocked_snapshot" unlocked-snapshot-copy

unlocked_reset=$scratch/unlocked-reset
cp -a "$scratch/success" "$unlocked_reset"
sed -i '/void rk_events_reset/,/^}/ {
	/next_sequence = 1;/d
	/spin_unlock(&event_lock);/a\
\tnext_sequence = 1;
}' "$unlocked_reset/instrumentation/events.c"
rebuild_fixture "$unlocked_reset" unlocked-reset
reject_fixture "$unlocked_reset" unlocked-reset-mutation

second_lock=$scratch/second-lock
cp -a "$scratch/success" "$second_lock"
sed -i '/DEFINE_SPINLOCK(event_lock);/a static DEFINE_SPINLOCK(second_event_lock);' \
	"$second_lock/instrumentation/events.c"
sed -i '/oldest = 0;/i\
\tspin_lock(&second_event_lock);\
\tspin_unlock(&second_event_lock);' \
	"$second_lock/instrumentation/events.c"
rebuild_fixture "$second_lock" second-lock
reject_fixture "$second_lock" split-ring-lock-ownership

mkdir -p "$scratch/unknown"
cp -a "$HERE/../../stage-02/m00-controlled-resident-core/solution/." \
	"$scratch/unknown/"
cp -a "$HERE/additions/." "$scratch/unknown/"
cp -a "$HERE/solution-overlay/." "$scratch/unknown/"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 \
	ROOTKITLINGS_FAIL_POINT=99 modules >"$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure point compiled\n' >&2; exit 1
fi

run_guest()
{
	local check=$1 module=$2 output
	shift 2
	if ! output=$("$ROOT/vm/boot" --check "$check" --tool vm/tools/run_as \
		"$@" "$module" 2>&1); then
		printf '%s\n' "$output" >&2; exit 1
	fi
	printf '%s\n' "$output"
	grep -Fq '[+] PASSED' <<< "$output" || exit 1
}

declare -a labels=(unused Preflight Allocation 'Control publication' Worker \
	'Authorization startup' 'Missing Kretprobe target' 'Events publication')
declare -a errnos=(0 125 12 12 4 4 2 12)
for point in {1..7}; do
	sed -e "s/@LABEL@/${labels[$point]}/g" \
		-e "s/@EXPECTED_ERRNO@/${errnos[$point]}/g" \
		-e "s/@EXPECT_ALLOCATION@/$((point >= 3 ? 1 : 0))/g" \
		"$HERE/failure-check.in" > "$scratch/check-$point"
	chmod 0755 "$scratch/check-$point"
	run_guest "$scratch/check-$point" "$scratch/failure-$point/rootkitlings.ko" \
		--tool vm/tools/module_load_test
done
for specification in '8 12 Credential preparation' '9 125 Credential cancellation'; do
	read -r point expected label_rest <<< "$specification"
	sed -e "s/@LABEL@/$label_rest/g" -e "s/@EXPECTED_ERRNO@/$expected/g" \
		"$HERE/action-failure-check.in" > "$scratch/action-$point"
	chmod 0755 "$scratch/action-$point"
	run_guest "$scratch/action-$point" "$scratch/failure-$point/rootkitlings.ko" \
		--tool vm/tools/cred_trigger_test
done
run_guest "$HERE/success-check" "$scratch/success/rootkitlings.ko" \
	--tool vm/tools/event_stream_test --tool vm/tools/status_field_test \
	--tool vm/tools/proc_write_test --tool vm/tools/proc_read_test \
	--tool vm/tools/cred_trigger_test --tool vm/tools/rmdir_telemetry_test

printf '[+] record authorized actions and rmdir results milestone passed\n'
