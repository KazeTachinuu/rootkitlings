#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "Transactional credential replacement"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-credentials
mkdir -p "$fixtures/root"
chmod 0755 "$fixtures" "$fixtures/root"
: > "$fixtures/empty"
printf 'enable' > "$fixtures/enable"
printf 'enable\n' > "$fixtures/enable-lf"
printf 'disable' > "$fixtures/disable"
printf 'rooted' > "$fixtures/rooted"
printf 'rootx' > "$fixtures/rootx"
printf ' root' > "$fixtures/leading-space"
printf 'root ' > "$fixtures/trailing-space"
printf 'root\r\n' > "$fixtures/crlf"
printf 'root\000' > "$fixtures/nul"
printf 'root\n\n' > "$fixtures/double-lf"
printf 'disable\nx' > "$fixtures/oversized"
chmod 0644 "$fixtures/empty" "$fixtures/enable" "$fixtures/enable-lf" \
	"$fixtures/disable" "$fixtures/rooted" "$fixtures/rootx" \
	"$fixtures/leading-space" "$fixtures/trailing-space" "$fixtures/crlf" \
	"$fixtures/nul" "$fixtures/double-lf" "$fixtures/oversized"

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

assert_actions()
{
	expected=$1
	label=$2
	record=$(cat "$endpoint") || {
		_fail "$label could not read the status record"
		return
	}
	if [ "$(printf '%s\n' "$record" | wc -l)" -eq 9 ] &&
	   [ "$(printf '%s\n' "$record" | sed -n '2p')" = "actions=$expected" ]; then
		_ok "$label reports actions=$expected in one nine-line record"
	else
		_fail "$label returned an invalid status record"
	fi
}

check_loaded()
{
	assert_loaded rootkitlings
	assert_exists "$endpoint"
	metadata=$(stat -c '%a:%u:%g' "$endpoint")
	if [ "$metadata" = 666:0:0 ]; then
		_ok "$endpoint is mode 0666 and owned by 0:0"
	else
		_fail "$endpoint metadata: expected 666:0:0, got $metadata"
	fi
	assert_actions disabled "module load"
}

expect_parser_errno()
{
	fixture=$1
	errno=$2
	label=$3
	if chpst -u 65534:65534 proc_write_test errno "$endpoint" \
		"$fixtures/$fixture" "$errno" > /dev/null; then
		_ok "$label returns errno $errno"
	else
		_fail "$label did not return errno $errno"
	fi
	assert_actions disabled "$label"
}

check_rejections()
{
	if chpst -u 65534:65534 \
		cred_trigger_test unchanged "$endpoint" root 13 > /dev/null; then
		_ok "disabled root returns EACCES without changing its writer"
	else
		_fail "disabled root changed its writer or returned the wrong error"
	fi
	if chpst -u 65534:65534 \
		cred_trigger_test unchanged "$endpoint" rooted 22 > /dev/null; then
		_ok "rooted returns EINVAL without changing its writer"
	else
		_fail "malformed root command changed its writer"
	fi
	expect_parser_errno empty 22 "empty write"
	expect_parser_errno rootx 22 "root with a suffix"
	expect_parser_errno leading-space 22 "leading space"
	expect_parser_errno trailing-space 22 "trailing space"
	expect_parser_errno crlf 22 "CRLF ending"
	expect_parser_errno nul 22 "embedded NUL"
	expect_parser_errno double-lf 22 "second trailing newline"
	expect_parser_errno oversized 7 "nine-byte command"

	if chpst -u 65534:65534 proc_write_test fault "$endpoint" \
		"$fixtures/enable" 14 > /dev/null; then
		_ok "partial user copy returns EFAULT"
	else
		_fail "partial user copy did not return EFAULT"
	fi
	assert_actions disabled "partial user copy"
	if chpst -u 65534:65534 proc_write_test offset "$endpoint" \
		"$fixtures/enable" 1 22 > /dev/null; then
		_ok "nonzero offset returns EINVAL"
	else
		_fail "nonzero offset did not return EINVAL"
	fi
	assert_actions disabled "nonzero offset"
}

enable_unprivileged()
{
	if chpst -u 65534:65534 proc_write_test write "$endpoint" \
		"$fixtures/enable-lf" > /dev/null; then
		_ok "an unprivileged writer can enable the operational switch"
	else
		_fail "unprivileged enable failed"
	fi
	assert_actions enabled "enable"
}

check_successes()
{
	enable_unprivileged
	if chpst -u 65534:65534 cred_trigger_test replace "$endpoint" \
		"$fixtures/root" > /dev/null; then
		_ok "root installs the complete init credential only on its writing process"
	else
		_fail "root did not install the complete init credential"
	fi
	if chpst -u 65534:65534 cred_trigger_test thread-scope "$endpoint" \
		> /dev/null; then
		_ok "root changes the writing thread but not an existing sibling"
	else
		_fail "credential replacement escaped the writing thread"
	fi
	if chpst -u 65534:65534 proc_write_test write "$endpoint" \
		"$fixtures/disable" > /dev/null; then
		_ok "an unprivileged writer can disable the operational switch"
	else
		_fail "unprivileged disable failed"
	fi
	assert_actions disabled "disable"
	if chpst -u 65534:65534 \
		cred_trigger_test unchanged "$endpoint" root 13 > /dev/null; then
		_ok "disable blocks the next writing task without changing it"
	else
		_fail "disable did not block the next root action"
	fi
}

toggle_actions()
{
	i=0
	while [ "$i" -lt 48 ]; do
		proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null || return 1
		proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null || return 1
		i=$((i + 1))
	done
}

check_concurrency()
{
	toggle_actions &
	toggler=$!
	pids=
	i=0
	while [ "$i" -lt 24 ]; do
		chpst -u 65534:65534 cred_trigger_test outcome "$endpoint" \
			> "$fixtures/outcome-$i" 2>&1 &
		pids="$pids $!"
		i=$((i + 1))
	done
	ok=1
	for pid in $pids; do
		wait "$pid" || ok=0
	done
	wait "$toggler" || ok=0
	if [ "$ok" -eq 1 ]; then
		_ok "concurrent writers are either unchanged-and-denied or completely replaced"
	else
		_fail "a concurrent writer observed a partial credential outcome"
	fi
	proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null ||
		_fail "could not restore the disabled state"
	assert_actions disabled "concurrent access"
}

assert_not_loaded
attempt=1
while [ "$attempt" -le 2 ]; do
	load rootkitlings.ko
	check_loaded
	check_rejections
	check_successes
	check_concurrency
	if proc_write_test unload "$endpoint" "$fixtures/enable" rootkitlings \
		> /dev/null; then
		_ok "attempt $attempt rejects a held descriptor after unload"
	else
		_fail "attempt $attempt failed the held-descriptor unload check"
	fi
	assert_not_loaded
	attempt=$((attempt + 1))
done

summary
