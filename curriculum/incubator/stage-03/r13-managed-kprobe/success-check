#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Managed named Kprobes"

endpoint=/proc/rootkitlings
registry=/sys/kernel/debug/kprobes/list
fixtures=/tmp/rootkitlings-probes
target_dir=/tmp/rootkitlings-probe-target
actual=$fixtures/actual
mkdir -p "$fixtures"

: > "$fixtures/empty"
printf 'enable' > "$fixtures/enable"
printf 'enable\n' > "$fixtures/enable-lf"
printf 'disable' > "$fixtures/disable"
printf 'disable\n' > "$fixtures/disable-lf"
printf '\n' > "$fixtures/lone-lf"
printf 'ena\nble' > "$fixtures/interior-lf"
printf 'enable\n\n' > "$fixtures/double-lf"
printf 'enable\000' > "$fixtures/nul"
printf 'enabl' > "$fixtures/prefix"
printf 'enabled' > "$fixtures/suffix"
printf 'xenable' > "$fixtures/prefixed"
printf 'disable\nx' > "$fixtures/oversized"
printf 'active=1\nactions=disabled\nvfs_mkdir_seen=0\nfilename_rmdir_seen=0\n' \
	> "$fixtures/status-disabled-00"
printf 'active=1\nactions=enabled\nvfs_mkdir_seen=0\nfilename_rmdir_seen=0\n' \
	> "$fixtures/status-enabled-00"
printf 'active=1\nactions=enabled\nvfs_mkdir_seen=1\nfilename_rmdir_seen=0\n' \
	> "$fixtures/status-enabled-10"
printf 'active=1\nactions=enabled\nvfs_mkdir_seen=1\nfilename_rmdir_seen=1\n' \
	> "$fixtures/status-enabled-11"
printf 'active=1\nactions=disabled\nvfs_mkdir_seen=1\nfilename_rmdir_seen=1\n' \
	> "$fixtures/status-disabled-11"
chmod 0644 "$fixtures"/*

probe_count()
{
	target=$1
	awk -v target="$target" '
		$2 == "k" {
			split($3, name, "+")
			if (name[1] == target)
				count++
		}
		END { print count + 0 }
	' "$registry"
}

assert_registry_delta()
{
	expected_delta=$1
	label=$2
	mkdir_now=$(probe_count vfs_mkdir)
	rmdir_now=$(probe_count filename_rmdir)
	if [ "$mkdir_now" -eq $((mkdir_before + expected_delta)) ] &&
	   [ "$rmdir_now" -eq $((rmdir_before + expected_delta)) ]; then
		_ok "$label has the expected target probe set"
	else
		_fail "$label: unexpected target probe counts"
	fi
}

assert_status()
{
	expected=$1
	label=$2
	if cat "$endpoint" > "$actual" &&
	   cmp -s "$fixtures/status-$expected" "$actual"; then
		_ok "$label returns the complete $expected record"
	else
		_fail "$label returned an unexpected status record"
	fi
}

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
	assert_registry_delta 0 "unloaded state"
}

check_abi()
{
	case $(uname -r) in
		7.2.*|7.2-*) _ok "guest runs the supported Linux 7.2 ABI" ;;
		*) _fail "guest kernel is not Linux 7.2.x" ;;
	esac
	if [ "$(uname -m)" = x86_64 ]; then
		_ok "guest architecture is x86_64"
	else
		_fail "guest architecture is not x86_64"
	fi
	if [ -r /proc/config.gz ]; then
		busybox gzip -dc /proc/config.gz > "$fixtures/config"
		for option in X86_64 IKCONFIG_PROC KPROBES KPROBES_ON_FTRACE \
			OPTPROBES KALLSYMS KALLSYMS_ALL DEBUG_FS; do
			if grep -qx "CONFIG_$option=y" "$fixtures/config"; then
				_ok "CONFIG_$option is enabled"
			else
				_fail "CONFIG_$option is not enabled"
			fi
		done
	else
		_fail "guest kernel configuration is unavailable"
	fi
	if [ -r "$registry" ]; then
		_ok "Kprobe debugfs registry is readable"
	else
		_fail "Kprobe debugfs registry is unavailable"
	fi
	for target in vfs_mkdir filename_rmdir; do
		if awk -v target="$target" '$3 == target { found = 1 } END { exit !found }' \
			/proc/kallsyms; then
			_ok "$target is present in the running kernel"
		else
			_fail "$target is absent from the running kernel"
		fi
	done
	if grep -q '[[:space:]]__rootkitlings_missing_kprobe_target_7_2__$' \
		/proc/kallsyms; then
		_fail "the injected missing target unexpectedly exists"
	else
		_ok "the injected failure target is absent"
	fi
}

expect_errno()
{
	fixture=$1
	errno=$2
	label=$3
	if proc_write_test errno "$endpoint" "$fixtures/$fixture" "$errno" \
		> /dev/null; then
		_ok "$label returns errno $errno"
	else
		_fail "$label did not return errno $errno"
	fi
	assert_status disabled-00 "$label"
}

check_loaded()
{
	assert_loaded rootkitlings
	assert_exists "$endpoint"
	metadata=$(stat -c '%a:%u:%g' "$endpoint")
	if [ "$metadata" = 644:0:0 ]; then
		_ok "$endpoint is mode 0644 and owned by 0:0"
	else
		_fail "$endpoint metadata: expected 644:0:0, got $metadata"
	fi
	assert_registry_delta 1 "loaded module"
	assert_status disabled-00 "module load"
}

check_rejections()
{
	expect_errno empty 22 "empty write"
	expect_errno lone-lf 22 "lone newline"
	expect_errno interior-lf 22 "interior newline"
	expect_errno double-lf 22 "second trailing newline"
	expect_errno nul 22 "embedded NUL"
	expect_errno prefix 22 "short prefix"
	expect_errno suffix 22 "suffix"
	expect_errno prefixed 22 "prefixed command"
	expect_errno oversized 7 "nine-byte command"

	if proc_write_test fault "$endpoint" "$fixtures/enable" 14 > /dev/null; then
		_ok "partial user copy returns errno 14"
	else
		_fail "partial user copy did not return errno 14"
	fi
	assert_status disabled-00 "partial user copy"
	if proc_write_test fault "$endpoint" "$fixtures/oversized" 7 > /dev/null; then
		_ok "oversized write is rejected before user copy"
	else
		_fail "oversized write touched user memory"
	fi
	assert_status disabled-00 "oversized partial buffer"
	if proc_write_test offset "$endpoint" "$fixtures/enable" 1 22 > /dev/null; then
		_ok "nonzero offset returns errno 22"
	else
		_fail "nonzero offset did not return errno 22"
	fi
	assert_status disabled-00 "nonzero offset"
	if run_as 65534 65534 proc_write_test write "$endpoint" \
		"$fixtures/enable" > "$fixtures/unprivileged.log" 2>&1; then
		_fail "unprivileged writer changed the root control"
	else
		_ok "unprivileged writer is denied"
	fi
	assert_status disabled-00 "unprivileged write"
}

exercise_targets()
{
	if mkdir "$target_dir" && test -d "$target_dir"; then
		_ok "disabled mkdir keeps its normal result"
	else
		_fail "disabled mkdir failed"
	fi
	if rmdir "$target_dir" && test ! -e "$target_dir"; then
		_ok "disabled rmdir keeps its normal result"
	else
		_fail "disabled rmdir failed"
	fi
	assert_status disabled-00 "disabled target calls"

	if proc_write_test write "$endpoint" "$fixtures/enable-lf" > /dev/null; then
		_ok "enable with newline returns its full byte count"
	else
		_fail "enable with newline failed"
	fi
	assert_status enabled-00 "enable"

	if mkdir "$target_dir" && test -d "$target_dir"; then
		_ok "enabled mkdir keeps its normal result"
	else
		_fail "enabled mkdir failed"
	fi
	assert_status enabled-10 "enabled mkdir"
	if rmdir "$target_dir" && test ! -e "$target_dir"; then
		_ok "enabled rmdir keeps its normal result"
	else
		_fail "enabled rmdir failed"
	fi
	assert_status enabled-11 "enabled rmdir"

	if proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null; then
		_ok "disable returns its full byte count"
	else
		_fail "disable failed"
	fi
	assert_status disabled-11 "disable"
	if proc_write_test write "$endpoint" "$fixtures/disable-lf" > /dev/null; then
		_ok "disable with newline returns its full byte count"
	else
		_fail "disable with newline failed"
	fi
	assert_status disabled-11 "disable with newline"
}

toggle_actions()
{
	i=0
	while [ "$i" -lt 32 ]; do
		proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null || return 1
		proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null || return 1
		i=$((i + 1))
	done
}

check_concurrency()
{
	toggle_actions &
	toggler=$!
	read_ok=1
	i=0
	while [ "$i" -lt 96 ]; do
		if ! cat "$endpoint" > "$actual"; then
			read_ok=0
			break
		fi
		if ! cmp -s "$fixtures/status-disabled-11" "$actual" &&
		   ! cmp -s "$fixtures/status-enabled-11" "$actual"; then
			read_ok=0
			break
		fi
		i=$((i + 1))
	done
	if ! wait "$toggler"; then
		_fail "concurrent control writer failed"
	elif [ "$read_ok" -eq 1 ]; then
		_ok "concurrent reads return 96 complete records"
	else
		_fail "concurrent read returned a partial record"
	fi
	proc_write_test write "$endpoint" "$fixtures/disable" > /dev/null ||
		_fail "could not restore disabled actions"
	assert_status disabled-11 "concurrent access"
}

run_targets_after_unload()
{
	if mkdir "$target_dir" && rmdir "$target_dir" &&
	   test ! -e "$target_dir"; then
		_ok "mkdir and rmdir remain normal after unload"
	else
		_fail "a target operation failed after unload"
	fi
	assert_registry_delta 0 "post-unload target calls"
}

check_abi
mkdir_before=$(probe_count vfs_mkdir)
rmdir_before=$(probe_count filename_rmdir)
assert_not_loaded

attempt=1
while [ "$attempt" -le 2 ]; do
	load rootkitlings.ko
	check_loaded
	check_rejections
	exercise_targets
	check_concurrency
	if proc_write_test unload "$endpoint" "$fixtures/enable" rootkitlings \
		> /dev/null; then
		_ok "attempt $attempt rejects a held descriptor after unload"
	else
		_fail "attempt $attempt failed the held-descriptor unload check"
	fi
	assert_not_loaded
	run_targets_after_unload
	attempt=$((attempt + 1))
done

summary
