#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "@LABEL@"

endpoint=/proc/rootkitlings
registry=/sys/kernel/debug/kprobes/list
fixtures=/tmp/rootkitlings-probe-failure
mkdir -p "$fixtures"

probe_count()
{
	target=$1
	awk -v target="$target" '
		$2 == "k" {
			split($3, name, "+")
			if (name[1] == target)
				count++
		}
		END { print count + 0 }
	' "$registry"
}

assert_registry_baseline()
{
	label=$1
	mkdir_now=$(probe_count vfs_mkdir)
	rmdir_now=$(probe_count filename_rmdir)
	if [ "$mkdir_now" -eq "$mkdir_before" ] &&
	   [ "$rmdir_now" -eq "$rmdir_before" ]; then
		_ok "$label leaves no target probe registered"
	else
		_fail "$label changed target probe counts"
	fi
}

assert_state_allocation_freed()
{
	label=$1
	allocs=$fixtures/state-allocs
	frees=$fixtures/frees
	: > "$allocs"
	: > "$frees"
	# shellcheck disable=SC2154 # Set by kmem_trace_stop in /lib/check.sh.
	while IFS= read -r line; do
		case "$line" in
			*module_load_tes-*' kmalloc: '*) kind=alloc ;;
			*module_load_tes-*' kfree: '*) kind=free ;;
			*) continue ;;
		esac
		ptr=
		bytes_req=
		for field in $line; do
			case "$field" in
				ptr=*)
					ptr=${field#ptr=}
					ptr=${ptr#0x}
					;;
				bytes_req=*) bytes_req=${field#bytes_req=} ;;
			esac
		done
		[ -n "$ptr" ] || continue
		case "$kind" in
			alloc)
				[ "$bytes_req" = 4 ] && printf '%s\n' "$ptr" >> "$allocs"
				;;
			free) printf '%s\n' "$ptr" >> "$frees" ;;
		esac
	done < "$_kmem_trace_copy"
	state_ptr=$(sed -n '1p' "$allocs")
	if [ "$(wc -l < "$allocs")" -eq 1 ] &&
	   [ -n "$state_ptr" ] && [ "$state_ptr" != 0000000000000000 ] &&
	   grep -Fqx "$state_ptr" "$frees"; then
		_ok "$label"
	else
		_fail "$label: the four-byte state allocation was not matched by a free"
	fi
}

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	kmem_trace_restore
}

test -r "$registry" || {
	_fail "Kprobe registry is not readable"
	summary
}
mkdir_before=$(probe_count vfs_mkdir)
rmdir_before=$(probe_count filename_rmdir)
kmem_trace_setup
trap cleanup EXIT INT TERM

attempt=1
while [ "$attempt" -le 2 ]; do
	kmem_trace_start
	if module_load_test /rootkitlings/rootkitlings.ko @EXPECTED_ERRNO@; then
		_ok "attempt $attempt returned errno @EXPECTED_ERRNO@"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	kmem_trace_stop
	assert_state_allocation_freed \
		"attempt $attempt freed module state after rollback"
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "attempt $attempt left rootkitlings in /proc/modules"
	else
		_ok "attempt $attempt leaves no loaded module"
	fi
	assert_registry_baseline "attempt $attempt"
	attempt=$((attempt + 1))
done

summary
