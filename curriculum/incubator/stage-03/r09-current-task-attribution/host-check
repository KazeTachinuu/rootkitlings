#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR ARTIFACT_PATH"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"

[[ -d $build_dir && ! -L $build_dir ]] ||
	die "build directory must be a real directory"
[[ -f $artifact && ! -L $artifact ]] || die "artifact must be a regular file"
[[ $artifact == "$build_dir/rootkitlings.ko" ]] ||
	die "expected artifact at: $build_dir/rootkitlings.ko"

for path in core/main.o core/state.o interface/proc.o include/rootkit.h \
	interface/proc.c; do
	[[ -f $build_dir/$path && ! -L $build_dir/$path ]] ||
		die "build output is missing regular file: $path"
done

command -v modinfo >/dev/null || die "modinfo is required"
command -v nm >/dev/null || die "nm is required"
[[ $(modinfo -F license "$artifact") == GPL ]] || die "module license must be GPL"
[[ $(modinfo -F description "$artifact") == 'Rootkitlings kernel module' ]] ||
	die "module description must be: Rootkitlings kernel module"

for symbol in rk_state_create rk_state_is_active rk_state_destroy; do
	nm "$build_dir/core/state.o" | grep -Eq "[[:space:]]T[[:space:]]+$symbol$" ||
		die "core/state.o must define $symbol"
done
for symbol in rk_state_create rk_state_destroy rk_proc_publish rk_proc_unpublish; do
	nm -u "$build_dir/core/main.o" | grep -Eq "[[:space:]]U[[:space:]]+$symbol$" ||
		die "core/main.o must call $symbol"
done

proc_undefined=$(nm -u "$build_dir/interface/proc.o")
for symbol in const_current_task proc_create_single_data proc_remove \
	rk_state_is_active seq_escape_mem seq_printf; do
	grep -Eq "[[:space:]]$symbol$" <<< "$proc_undefined" ||
		die "interface/proc.o has no $symbol dependency"
done
grep -Eq '[[:space:]](sized_strscpy|strscpy_pad)$' <<< "$proc_undefined" ||
	die "interface/proc.o has no bounded task-name copy dependency"

if grep -Eq '[[:space:]](__kmalloc|__kmalloc_cache_noprof|kmalloc_noprof|kfree|kvfree|vfree)$' \
	<<< "$proc_undefined"; then
	die "interface/proc.o must not allocate or free memory"
fi
if grep -Eq '[[:space:]](mutex_lock|mutex_unlock|_raw_spin_lock|_raw_spin_unlock)$' \
	<<< "$proc_undefined"; then
	die "interface/proc.o must not add a lock"
fi
unexpected_data=$(
	nm --defined-only "$build_dir/interface/proc.o" |
		awk '$2 ~ /^[bBdD]$/ && $3 != ".bss" && $3 != ".data" && $3 != "proc_entry" { print $3 }'
)
[[ -z $unexpected_data ]] ||
	die "interface/proc.o stores unexpected global data: $unexpected_data"

source=$build_dir/interface/proc.c
source_text=$(tr '\n' ' ' < "$source")

if grep -Eq -- '->[[:space:]]*(pid|tgid|comm)([^[:alnum:]_]|$)' "$source"; then
	die "use task_pid_nr() and get_task_comm(), not raw task fields"
fi
if grep -Eq 'task_(tgid|pid_vnr|tgid_vnr|pid_nr_ns|tgid_nr_ns)[[:space:]]*\(' "$source"; then
	die "reader_tid must use task_pid_nr(), not a process-wide or namespace-relative ID"
fi
if grep -Eq '(get_task_struct|put_task_struct)[[:space:]]*\(' "$source"; then
	die "the callback must not retain a task reference"
fi
if grep -Eq 'static[^;]*(task_struct|reader_tid|reader_comm)' <<< "$source_text"; then
	die "task attribution must stay local to the show callback"
fi
if grep -Eq 'seq_(printf|puts)[[:space:]]*\([^;]*%s' <<< "$source_text"; then
	die "do not print a task command name through raw %s output"
fi

mapfile -t task_vars < <(
	sed -nE 's/.*struct[[:space:]]+task_struct[[:space:]]*\*[[:space:]]*([[:alpha:]_][[:alnum:]_]*)[[:space:]]*=[[:space:]]*current[[:space:]]*;.*/\1/p' "$source"
)
(( ${#task_vars[@]} == 1 )) ||
	die "copy current into exactly one local task pointer"
task_var=${task_vars[0]}
grep -Eq "task_pid_nr[[:space:]]*\([[:space:]]*${task_var}[[:space:]]*\)" "$source" ||
	die "snapshot the local task pointer with task_pid_nr()"
grep -Eq "get_task_comm[[:space:]]*\([^,]+,[[:space:]]*${task_var}[[:space:]]*\)" "$source" ||
	die "snapshot the same local task pointer with get_task_comm()"
grep -Eq 'char[[:space:]]+[[:alpha:]_][[:alnum:]_]*[[:space:]]*\[[[:space:]]*TASK_COMM_LEN[[:space:]]*\]' "$source" ||
	die "copy the command name into a local TASK_COMM_LEN array"

for token in seq_escape_mem ESCAPE_NAP ESCAPE_APPEND ESCAPE_HEX; do
	grep -Fq "$token" "$source" || die "the supplied quoted-name helper needs $token"
done

header_text=$(tr '\n' ' ' < "$build_dir/include/rootkit.h")
grep -Eq 'struct[[:space:]]+rk_state[[:space:]]*;' <<< "$header_text" ||
	die "rootkit.h must forward-declare struct rk_state"
if grep -Eq 'struct[[:space:]]+rk_state[[:space:]]*\{' <<< "$header_text"; then
	die "struct rk_state layout must remain private to core/state.c"
fi

printf '[+] callback-local task snapshots and quoted output verified\n'
