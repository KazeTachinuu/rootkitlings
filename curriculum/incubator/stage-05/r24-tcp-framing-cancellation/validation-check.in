#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

module=${1:?module basename argument is required}
label=${2:?validation label argument is required}

begin "$label"

if module_load_params "/rootkitlings/$module" 22 'peer_port=47023'; then
	_ok "$module was rejected by instrumented behavior tests"
else
	_fail "$module returned the wrong error"
fi
assert_absent /sys/module/rootkitlings
assert_absent /proc/rootkitlings

summary
