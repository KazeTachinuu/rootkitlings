#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../../scripts/lesson-env"
scratch=$(mktemp -d "$HERE/.r24-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
for option in NET NET_NS INET PROC_FS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] this lesson requires CONFIG_%s=y\n' "$option" >&2
		exit 1
	}
done
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || {
	printf '[x] pinned kernel build is not configured for GCC\n' >&2
	exit 1
}
for command in gcc make nm; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

for symbol in sock_create_kern kernel_connect kernel_sendmsg kernel_recvmsg \
		kernel_sock_shutdown sock_release kthread_create_on_node \
		wake_up_process kthread_stop; do
	awk -v symbol="$symbol" '$2 == symbol && $4 == "EXPORT_SYMBOL" { found = 1 }
		 END { exit !found }' "$KDIR/Module.symvers" || {
		printf '[x] pinned kernel does not export %s\n' "$symbol" >&2
		exit 1
	}
done

for script in test host-check success-check failure-check.in \
		validation-check.in; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check.in" \
		"$HERE/validation-check.in"
fi

mapfile -t changed_files < <(
	diff -qr "$HERE/template" "$HERE/solution" |
		sed -nE 's#^Files .*/template/(.*) and .*/solution/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == session/tcp_session.c ]] || {
	printf '[x] learner edit surface is %s\n' "${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2 point=${3:-0}
	local log=$destination.log
	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
			ROOTKITLINGS_FAIL_POINT="$point" modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "${source##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "${source##*/}" >&2
		exit 1
	fi
}

build_tree "$HERE/template" "$scratch/template"
build_tree "$HERE/solution" "$scratch/solution"
build_tree "$HERE/solution" "$scratch/worker-failure" 1
build_tree "$HERE/solution" "$scratch/proc-failure" 2
"$HERE/host-check" "$scratch/solution" "$scratch/solution/rootkitlings.ko"
if "$HERE/host-check" "$scratch/template" \
		"$scratch/template/rootkitlings.ko" > "$scratch/template-host.log" 2>&1; then
	printf '[x] host checker accepted the unfinished session\n' >&2
	exit 1
fi

equivalent=$scratch/equivalent
cp -a "$HERE/solution" "$equivalent"
sed -i -e 's/\<offset\>/position/g' -e 's/\<remaining\>/left/g' \
	-e 's/\<context\>/cookie/g' -e 's/\<received\>/decoded/g' \
	-e 's/\<error\>/result/g' "$equivalent/session/tcp_session.c"
sed -i -e '/size_t position = 0;/d' \
	-e 's/while (position < length)/while (length)/g' \
	-e 's/bytes + position/bytes/g' \
	-e 's/length - position/length/g' \
	-e 's/position += result;/bytes += result; length -= result;/g' \
	"$equivalent/session/tcp_session.c"
make -s -C "$KDIR" M="$equivalent" W=1 modules > "$equivalent.log" 2>&1 || {
	cat "$equivalent.log" >&2
	printf '[x] equivalent implementation build failed\n' >&2
	exit 1
}
if grep -q 'warning:' "$equivalent.log"; then
	cat "$equivalent.log" >&2
	printf '[x] equivalent implementation warned\n' >&2
	exit 1
fi
"$HERE/host-check" "$equivalent" "$equivalent/rootkitlings.ko"

build_mutant()
{
	local name=$1 expression=$2
	local directory=$scratch/$name
	cp -a "$HERE/solution" "$directory"
	sed -i "$expression" "$directory/session/tcp_session.c"
	make -s -C "$KDIR" M="$directory" W=1 modules > "$directory.log" 2>&1 || {
		cat "$directory.log" >&2
		printf '[x] mutant did not build: %s\n' "$name" >&2
		exit 1
	}
	if grep -q 'warning:' "$directory.log"; then
		cat "$directory.log" >&2
		printf '[x] mutant warned: %s\n' "$name" >&2
		exit 1
	fi
	cp "$directory/rootkitlings.ko" "$scratch/$name.ko"
}

build_mutant short-send '0,/offset += result;/s//return 0;/'
build_mutant short-receive \
	'/static int rk_receive_exact/,/^}/s/offset += result;/return 0;/'
build_mutant short-drain 's/remaining -= chunk;/remaining = 0;/'
build_mutant late-publish '0,/if (session->stopping)/s//if (false)/'
build_mutant double-release \
	'0,/ops->release(socket, context);/s//ops->release(socket, context); ops->release(socket, context);/'
build_mutant stop-error 's/if (!session->stopping)/if (true)/'
build_mutant connect-leak \
	'/^close:/,/socket = NULL;/s/ops->release(socket, context);/(void)socket;/'

cp "$scratch/template/rootkitlings.ko" "$scratch/template.ko"
if make -s -C "$KDIR" M="$scratch/solution" W=1 \
		ROOTKITLINGS_FAIL_POINT=99 modules > "$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure point compiled successfully\n' >&2
	exit 1
fi

modules='template.ko short-send.ko short-receive.ko short-drain.ko late-publish.ko double-release.ko stop-error.ko connect-leak.ko'

run_guest()
{
	local check=$1 module=$2 label=$3 output
	shift 3
	if ! output=$("$HERE/../../../../vm/boot" --check "$check" "$@" \
			"$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest rejected %s\n' "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
	grep -Fq '[+] PASSED' <<< "$output" || {
		printf '[x] guest did not pass %s\n' "$label" >&2
		exit 1
	}
}

for name in $modules; do
	run_guest "$HERE/validation-check.in" "$scratch/$name" "$name" \
		--tool tools/module_load_params \
		--check-arg "$name" --check-arg "Reject $name"
done
run_guest "$HERE/failure-check.in" \
	"$scratch/worker-failure/rootkitlings.ko" worker-failure \
	--tool tools/module_load_params --tool tools/tcp_session_fixture \
	--check-arg 4 --check-arg 'Worker creation failure' --check-arg 0
run_guest "$HERE/failure-check.in" \
	"$scratch/proc-failure/rootkitlings.ko" proc-failure \
	--tool tools/module_load_params --tool tools/tcp_session_fixture \
	--check-arg 12 --check-arg 'Proc publication rollback' --check-arg 1
run_guest "$HERE/success-check" "$scratch/solution/rootkitlings.ko" \
	solution --tool tools/proc_read_test --tool tools/tcp_session_fixture

printf '[+] R24 cancellable framed TCP session passed\n'
