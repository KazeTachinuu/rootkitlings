#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "Cancellable framed TCP session"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-framed-session
expected=$fixtures/expected
actual=$fixtures/actual
fixture_pid=

cleanup()
{
	if [ -d /sys/module/rootkitlings ]; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	if [ -n "$fixture_pid" ]; then
		kill "$fixture_pid" 2>/dev/null || true
		wait "$fixture_pid" 2>/dev/null || true
	fi
}
trap cleanup EXIT

mkdir -p "$fixtures"

wait_for_file()
{
	path=$1
	index=0
	while [ ! -s "$path" ] && [ "$index" -lt 800 ]; do
		sleep 0.01
		index=$((index + 1))
	done
	[ -s "$path" ]
}

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings remains in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

start_fixture()
{
	directory=$1
	mkdir -p "$directory"
	tcp_session_fixture serve "$directory" > "$directory/log" 2>&1 &
	fixture_pid=$!
	if wait_for_file "$directory/ready"; then
		_ok "dynamic loopback listener is ready"
	else
		_fail "loopback listener did not become ready"
	fi
}

write_expected()
{
	port=$1
	printf 'state=running\nsocket=active\nstopping=0\npeer_address=127.0.0.1\npeer_port=%s\nframes=6\noversized=2\nlast_error=0\n' \
		"$port" > "$expected"
}

wait_for_counts()
{
	index=0
	while [ "$index" -lt 400 ]; do
		if [ "$(sed -n 's/^frames=//p' "$endpoint")" = 6 ] &&
		   [ "$(sed -n 's/^oversized=//p' "$endpoint")" = 2 ]; then
			return 0
		fi
		sleep 0.01
		index=$((index + 1))
	done
	return 1
}

run_cycle()
{
	directory=$1
	mode=$2
	start_fixture "$directory"
	port=$(cat "$directory/port")
	load rootkitlings.ko "peer_port=$port"
	assert_loaded rootkitlings
	assert_exists "$endpoint"
	if dmesg | grep -q 'rootkitlings: framed session self-tests passed:'; then
		_ok "instrumented framing and cancellation cases passed before start"
	else
		_fail "instrumented session evidence is missing"
	fi
	if wait_for_file "$directory/accepted"; then
		_ok "worker connected to the supplied init_net listener"
	else
		_fail "listener did not accept the worker connection"
	fi
	if wait_for_file "$directory/complete" && wait_for_counts; then
		_ok "split, coalesced, binary, empty, and oversized frames completed"
	else
		_fail "framed traffic did not complete"
	fi
	write_expected "$port"
	if cat "$endpoint" > "$actual" && cmp -s "$expected" "$actual"; then
		_ok "status reports successful echoes and complete oversized drains"
	else
		_fail "session status is incomplete or malformed"
	fi
	if [ "$mode" = held ]; then
		if proc_read_test "$endpoint" "$expected" rootkitlings; then
			_ok "held proc read retires while blocked receive is cancelled"
		else
			_fail "held proc or blocked-receive unload failed"
		fi
	else
		unload rootkitlings
	fi
	if wait_for_file "$directory/eof"; then
		_ok "peer observed EOF after shutdown and worker release"
	else
		_fail "peer did not observe EOF after unload"
	fi
	wait "$fixture_pid" || _fail "TCP fixture failed"
	fixture_pid=
	assert_not_loaded
}

assert_not_loaded
ifconfig lo 127.0.0.1 up
run_cycle "$fixtures/first" held
run_cycle "$fixtures/second" normal

summary
