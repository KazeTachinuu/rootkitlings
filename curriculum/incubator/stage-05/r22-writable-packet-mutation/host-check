#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r22-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for relative in Kbuild access/skb_access.c classifier/udp.c core/main.c \
		include/ipv4_parser.h include/rootkit.h include/skb_access.h \
		include/udp_classifier.h include/udp_redirect.h include/writable.h \
		instrumentation/netfilter_observer.c interface/proc.c \
		mutation/udp_redirect.c mutation/udp_redirect.o mutation/writable.c \
		parser/ipv4.c tests/selftest.c; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done

gcc -std=c11 -Wall -Wextra -Werror -pedantic -O1 -g \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I"$here/fixtures/host/include" -I"$build_dir/include" \
	"$here/fixtures/host/mutator_test.c" \
	"$build_dir/mutation/udp_redirect.c" -o "$scratch/mutator_test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
	"$scratch/mutator_test"

undefined=$(nm -u "$build_dir/mutation/udp_redirect.o" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__fentry__|__ref_stack_chk_guard|__stack_chk_fail|\
		__x86_return_thunk|inet_proto_csum_replace4|\
		memcmp|rk_skb_make_writable|skb_copy_bits) ;;
		*) die "mutator has unexpected external dependency: $symbol" ;;
	esac
done <<< "$undefined"

if nm "$build_dir/mutation/udp_redirect.o" |
	grep -Eq '[[:space:]][bBcCdDgGsS][[:space:]]'; then
	die "mutator must not own mutable object state"
fi

printf '[+] mutator structure and bounded behavior are valid\n'
