#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "Writable UDP destination mutation"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-mutation
actual=$fixtures/actual
expected=$fixtures/expected
mkdir -p "$fixtures"
helper=$fixtures/traffic_test
sed -n '/^__ROOTKITLINGS_TRAFFIC_HELPER__$/,$p' /check |
	sed '1d' | busybox base64 -d | busybox gzip -d > "$helper"
chmod 0755 "$helper"

field()
{
	sed -n "s/^$1=//p" "$endpoint"
}

assert_delta()
{
	name=$1
	before=$2
	expected_delta=$3
	label=$4
	after=$(field "$name")
	if [ "$after" -eq $((before + expected_delta)) ]; then
		_ok "$label"
	else
		_fail "$label changed $name from $before to $after"
	fi
}

status_is_well_formed()
{
	file=$1
	[ "$(wc -l < "$file")" -eq 10 ] || return 1
	[ "$(sed -n '1p' "$file")" = state=registered ] || return 1
	[ "$(sed -n '2p' "$file")" = match_port=47021 ] || return 1
	[ "$(sed -n '3p' "$file")" = replacement_port=47022 ] || return 1
	for name in callbacks rewritten unchanged invalid unsupported stale \
		not_writable; do
		value=$(sed -n "s/^$name=//p" "$file")
		case "$value" in
			''|*[!0-9]*) return 1 ;;
		esac
	done
}

assert_status()
{
	cat "$endpoint" > "$actual" || {
		_fail "could not read mutation status"
		return
	}
	if status_is_well_formed "$actual"; then
		_ok "status has the exact documented fields"
	else
		_fail "status is malformed or contains invented fields"
	fi
}

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings remains in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

assert_not_loaded
ifconfig lo 127.0.0.1 up
load rootkitlings.ko match_port=47021 replacement_port=47022
assert_loaded rootkitlings
assert_exists "$endpoint"
if [ "$(stat -c '%a:%u:%g' "$endpoint")" = 400:0:0 ]; then
	_ok "$endpoint is read-only and owned by root"
else
	_fail "$endpoint has unexpected mode or ownership"
fi
if dmesg | grep -q \
	'rootkitlings: writable UDP mutation self-tests passed:'; then
	_ok "real sk_buff mutation fixtures passed before publication"
else
	_fail "real sk_buff mutation fixture evidence is missing"
fi
assert_status
cp "$actual" "$expected"
if proc_read_test "$endpoint" "$expected"; then
	_ok "small reads, EOF, seek, and rewind preserve one status snapshot"
else
	_fail "seq_file read behavior changed the status record"
fi

before=$(field rewritten)
if "$helper" redirect 47021 47022; then
	_ok "binary UDP payload arrives at the replacement port"
else
	_fail "UDP destination rewrite failed"
fi
assert_delta rewritten "$before" 1 "one matched datagram is rewritten once"

before=$(field unchanged)
if "$helper" direct 47021 47022; then
	_ok "unmatched UDP payload stays on its original port"
else
	_fail "unmatched UDP delivery changed"
fi
assert_delta unchanged "$before" 1 "unmatched UDP is observed without mutation"

before=$(field unchanged)
if "$helper" alternate 47021 47022; then
	_ok "alternate loopback address stays on its original port"
else
	_fail "alternate-address UDP delivery changed"
fi
assert_delta unchanged "$before" 1 \
	"only the exact controlled loopback address is rewritten"

before=$(field callbacks)
if ping -6 -q -c 1 -W 1 ::1 >/dev/null 2>&1; then
	_ok "IPv6 loopback positive control completed"
else
	_fail "IPv6 loopback positive control failed"
fi
assert_delta callbacks "$before" 0 "IPv6 does not cross the IPv4 hook"

before=$(field callbacks)
if busybox unshare -n sh -c \
	'ifconfig lo 127.0.0.1 up && /tmp/rootkitlings-mutation/traffic_test direct 47021 47022' \
	>/dev/null 2>&1; then
	_ok "child network namespace UDP positive control completed"
else
	_fail "child network namespace UDP positive control failed"
fi
assert_delta callbacks "$before" 0 \
	"child namespace traffic does not cross the init_net hook"

before=$(field rewritten)
if "$helper" gso 47021 47022; then
	_ok "one UDP GSO send arrives as three intact segments"
else
	_fail "UDP GSO rewrite failed"
fi
assert_delta rewritten "$before" 1 \
	"coherent partial-checksum GSO is rewritten once before segmentation"

before=$(field rewritten)
"$helper" burst 47021 47022 > "$fixtures/burst.log" 2>&1 &
traffic=$!
reader_ok=1
i=0
while [ "$i" -lt 48 ]; do
	cat "$endpoint" > "$actual" || reader_ok=0
	status_is_well_formed "$actual" || reader_ok=0
	i=$((i + 1))
done
wait "$traffic" || reader_ok=0
after=$(field rewritten)
if [ "$reader_ok" -eq 1 ] && [ "$after" -eq $((before + 257)) ]; then
	_ok "257 concurrent binary payloads are intact and rewritten once"
else
	_fail "concurrent rewrite epoch changed count from $before to $after"
fi
assert_status

"$helper" transition 47021 47022 > "$fixtures/unload-traffic.log" 2>&1 &
traffic=$!
sleep 1
if kill -0 "$traffic" 2>/dev/null; then
	_ok "controlled UDP traffic is active before teardown"
else
	_fail "controlled UDP traffic ended before teardown"
fi
exec 3< "$endpoint"
unload rootkitlings
wait "$traffic" || _fail "UDP delivery failed across hook removal"
assert_not_loaded
if cat <&3 >/dev/null 2>&1; then
	_fail "a held proc descriptor remained readable after removal"
else
	_ok "proc removal retired a held status descriptor"
fi
exec 3<&-

load rootkitlings.ko match_port=47021 replacement_port=47022
assert_loaded rootkitlings
assert_status
before=$(field rewritten)
if "$helper" redirect 47021 47022; then
	_ok "destination rewrite works after reload"
else
	_fail "destination rewrite failed after reload"
fi
assert_delta rewritten "$before" 1 "reload starts a fresh rewrite count"
unload rootkitlings
assert_not_loaded

summary
