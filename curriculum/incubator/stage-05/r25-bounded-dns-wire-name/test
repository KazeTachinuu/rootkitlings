#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r25-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

KDIR=${KDIR:-/lib/modules/$(uname -r)/build}
[[ -d $KDIR ]] || {
	printf '[x] kernel build directory not found: %s\n' "$KDIR" >&2
	exit 1
}
case $(uname -r) in
	7.2.*|7.2-*) ;;
	*) printf '[x] this lesson requires Linux 7.2.x\n' >&2; exit 1 ;;
esac
[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || {
	printf '[x] pinned kernel build is not configured for GCC\n' >&2
	exit 1
}
for command in gcc make nm; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

for script in test host-check success-check failure-check; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check"
fi

for tree in template solution; do
	cmp -s "$HERE/../r18-hostile-packet-lengths/solution/parser/ipv4.c" \
		"$HERE/$tree/parser/ipv4.c" || {
		printf '[x] %s parser differs from accepted L17\n' "$tree" >&2
		exit 1
	}
	cmp -s "$HERE/../r18-hostile-packet-lengths/solution/include/ipv4_parser.h" \
		"$HERE/$tree/include/ipv4_parser.h" || {
		printf '[x] %s parser API differs from accepted L17\n' "$tree" >&2
		exit 1
	}
done

mapfile -t changed_files < <(
	diff -qr "$HERE/template" "$HERE/solution" |
		sed -nE 's#^Files .*/template/(.*) and .*/solution/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == codec/dns_name.c ]] || {
	printf '[x] learner edit surface is %s, expected codec/dns_name.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2
	local log=$destination.log
	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "${source##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "${source##*/}" >&2
		exit 1
	fi
}

build_tree "$HERE/template" "$scratch/template"
build_tree "$HERE/solution" "$scratch/solution"
"$HERE/host-check" "$scratch/solution" \
	"$scratch/solution/rootkitlings.ko"

if "$HERE/host-check" "$scratch/template" \
	"$scratch/template/rootkitlings.ko" > "$scratch/template-host.log" 2>&1; then
	printf '[x] host checker accepted the unfinished codec\n' >&2
	exit 1
fi

expect_host_rejection()
{
	local directory=$1 label=$2
	if "$HERE/host-check" "$directory" "$directory/rootkitlings.ko" \
		> "$scratch/$label-host.log" 2>&1; then
		printf '[x] host checker accepted mutant: %s\n' "$label" >&2
		exit 1
	fi
}

build_mutant()
{
	local name=$1
	cp -a "$HERE/solution" "$scratch/$name"
	shift
	"$@" "$scratch/$name/codec/dns_name.c"
	local log=$scratch/$name.log
	if ! make -s -C "$KDIR" M="$scratch/$name" W=1 modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] mutant did not compile: %s\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] mutant build has warnings: %s\n' "$name" >&2
		exit 1
	fi
	expect_host_rejection "$scratch/$name" "$name"
}

mutate_compression()
{
	sed -i 's/return RK_DNS_NAME_UNSUPPORTED_COMPRESSION;/return RK_DNS_NAME_MALFORMED;/' "$1"
}
build_mutant compression-as-malformed mutate_compression

mutate_root_room()
{
	sed -i 's/(size_t)length + 2 >/(size_t)length + 1 >/' "$1"
}
build_mutant no-root-room mutate_root_room

mutate_binary_zero()
{
	sed -i '/if (!label->length || label->length > RK_DNS_LABEL_MAX)/i\
\t\tif (!label->data[0])\
\t\t\treturn RK_DNS_NAME_MALFORMED;' "$1"
}
build_mutant rejects-binary-zero mutate_binary_zero

mutate_early_destination()
{
	sed -i 's/candidate\[length++\]/wire[length++]/g; s/candidate + length/wire + length/g' "$1"
}
build_mutant writes-before-commit mutate_early_destination

run_guest()
{
	local check=$1 module=$2 label=$3 output
	shift 3
	if ! output=$("$HERE/../../../../vm/boot" --check \
		"$check" "$module" "$@" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest rejected %s\n' "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
	grep -Fq '[+] PASSED' <<< "$output" || {
		printf '[x] guest did not pass %s\n' "$label" >&2
		exit 1
	}
}

run_guest "$HERE/success-check" "$scratch/solution/rootkitlings.ko" solution
run_guest "$HERE/failure-check" "$scratch/template/rootkitlings.ko" template \
	--tool tools/module_load_test

"$HERE/../r18-hostile-packet-lengths/test"

printf '[+] R25 bounded DNS wire-name codec passed\n'
