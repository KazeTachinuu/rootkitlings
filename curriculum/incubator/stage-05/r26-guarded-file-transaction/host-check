#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1") || die "build directory not found"
module=$(realpath -e -- "$2") || die "module not found"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r26-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for relative in Kbuild core/main.c include/interface.h include/platform.h \
		include/transaction.h interface/proc.c persistence/platform.c \
		persistence/platform.o persistence/transaction.c \
		persistence/transaction.o; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done

gcc -std=c11 -Wall -Wextra -Werror -pedantic -O1 -g \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I"$build_dir/include" "$here/fixtures/host/transaction_test.c" \
	"$build_dir/persistence/transaction.c" -o "$scratch/transaction-test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
	"$scratch/transaction-test"

undefined=$(nm -u "$build_dir/persistence/transaction.o" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__SCT__WARN_trap|__fentry__|__fortify_panic|__ref_stack_chk_guard|\
		__stack_chk_fail|__x86_return_thunk|memcmp|memcpy|memset|\
		rk_platform_close|rk_platform_create_candidate|rk_platform_exchange|\
		rk_platform_open_sibling|rk_platform_open_target|rk_platform_read|\
		rk_platform_sync_directory|rk_platform_sync_file|\
		rk_platform_unlink_sibling|rk_platform_warn_preserved|\
		rk_platform_write) ;;
		*) die "transaction has unexpected dependency: $symbol" ;;
	esac
done <<< "$undefined"
if nm "$build_dir/persistence/transaction.o" |
	grep -Eq '[[:space:]][bBdD][[:space:]]'; then
	die "transaction must not own mutable or persistent object state"
fi
for symbol in security_path_rename security_path_unlink vfs_rename vfs_unlink; do
	nm -u "$build_dir/persistence/platform.o" |
		awk '{ print $NF }' | grep -qx "$symbol" ||
		die "platform is missing required VFS dependency: $symbol"
done

printf '[+] guarded transaction structure and behavior are valid\n'
