#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Local IPv4 Netfilter observer"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-netfilter
actual=$fixtures/actual
expected=$fixtures/expected
mkdir -p "$fixtures"
helper=netfilter_udp_test

callbacks()
{
	sed -n 's/^callbacks=//p' "$endpoint"
}

write_expected()
{
	count=$1
	printf 'state=registered\nfamily=ipv4\nhook=local-out\npriority=-2147483648\nnamespace=init_net\nverdict=accept\ncallbacks=%s\n' \
		"$count" > "$expected"
}

assert_status()
{
	label=$1
	if ! cat "$endpoint" > "$actual"; then
		_fail "$label could not read status"
		return
	fi
	count=$(sed -n 's/^callbacks=//p' "$actual")
	case "$count" in
		''|*[!0-9]*) _fail "$label returned a nonnumeric callback count"; return ;;
	esac
	write_expected "$count"
	if cmp -s "$expected" "$actual"; then
		_ok "$label returns the exact seven-line status"
	else
		_fail "$label returned malformed or invented status fields"
	fi
}

assert_unchanged()
{
	before=$1
	label=$2
	after=$(callbacks)
	if [ "$after" = "$before" ]; then
		_ok "$label does not cross the init_net IPv4 hook"
	else
		_fail "$label changed callbacks from $before to $after"
	fi
}

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings remains in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

assert_not_loaded
ifconfig lo 127.0.0.1 up
load rootkitlings.ko
assert_loaded rootkitlings
assert_exists "$endpoint"
if [ "$(stat -c '%a:%u:%g' "$endpoint")" = 400:0:0 ]; then
	_ok "$endpoint is read-only and owned by root"
else
	_fail "$endpoint has unexpected mode or ownership"
fi
assert_status "fresh load"
write_expected "$(callbacks)"
if proc_read_test "$endpoint" "$expected"; then
	_ok "small reads, EOF, seek, and rewind preserve one status snapshot"
else
	_fail "seq_file read behavior changed the status record"
fi

before=$(callbacks)
if ping -6 -q -c 1 -W 1 ::1 > /dev/null 2>&1; then
	_ok "IPv6 loopback positive control completed"
else
	_fail "IPv6 loopback positive control failed"
fi
assert_unchanged "$before" "IPv6 loopback traffic"

before=$(callbacks)
if busybox unshare -n sh -c \
	'ifconfig lo 127.0.0.1 up && ping -4 -q -c 1 -W 1 127.0.0.1' \
	> /dev/null 2>&1; then
	_ok "child network namespace IPv4 positive control completed"
else
	_fail "child network namespace positive control failed"
fi
assert_unchanged "$before" "child network namespace IPv4 traffic"

before=$(callbacks)
"$helper" 257 > "$fixtures/udp-concurrent.log" 2>&1 &
traffic=$!
reader_ok=1
i=0
while [ "$i" -lt 48 ]; do
	cat "$endpoint" > "$actual" || reader_ok=0
	count=$(sed -n 's/^callbacks=//p' "$actual")
	case "$count" in
		''|*[!0-9]*) reader_ok=0 ;;
	esac
	if [ "$(sed -n '1,6p' "$actual")" != "$(printf 'state=registered\nfamily=ipv4\nhook=local-out\npriority=-2147483648\nnamespace=init_net\nverdict=accept')" ]; then
		reader_ok=0
	fi
	i=$((i + 1))
done
wait "$traffic" || reader_ok=0
after=$(callbacks)
if [ "$reader_ok" -eq 1 ] && [ "$after" -eq $((before + 257)) ]; then
	_ok "257 concurrent UDP payloads are intact and counted exactly once"
else
	_fail "concurrent UDP epoch changed callbacks from $before to $after"
fi

ping -4 -q -c 200 -i 0.01 -W 1 127.0.0.1 > /dev/null 2>&1 &
traffic=$!
sleep 1
if kill -0 "$traffic" 2> /dev/null; then
	_ok "IPv4 traffic is active before observer teardown"
else
	_fail "IPv4 traffic ended before observer teardown"
fi
exec 3< "$endpoint"
unload rootkitlings
wait "$traffic" || _fail "IPv4 traffic failed across observer unload"
assert_not_loaded
if cat <&3 > /dev/null 2>&1; then
	_fail "a held proc descriptor remained readable after removal"
else
	_ok "proc removal retired a held status descriptor"
fi
exec 3<&-

load rootkitlings.ko
assert_loaded rootkitlings
assert_status "reload"
before=$(callbacks)
if "$helper" 1 > "$fixtures/udp-reload.log" 2>&1; then
	_ok "one controlled UDP payload is intact after reload"
else
	_fail "controlled UDP delivery failed after reload"
fi
after=$(callbacks)
if [ "$after" -eq $((before + 1)) ]; then
	_ok "reloaded observer counts one fresh traversal exactly once"
else
	_fail "reload epoch changed callbacks from $before to $after"
fi
unload rootkitlings
assert_not_loaded

summary
