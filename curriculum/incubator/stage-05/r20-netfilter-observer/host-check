#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

for relative in Kbuild core/main.c include/rootkit.h interface/proc.c \
		instrumentation/netfilter_observer.c \
		instrumentation/netfilter_observer.o; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done
[[ -f $module && ! -L $module ]] || die "module must be a regular file"

for relative in Kbuild core/main.c include/rootkit.h interface/proc.c; do
	cmp -s "$here/solution/$relative" "$build_dir/$relative" ||
		die "supplied file was changed: $relative"
done

# This check enforces the lesson's edit and observation boundaries only. The
# compiled fixture below is the oracle for callback and lifecycle semantics.
python3 - "$build_dir/instrumentation/netfilter_observer.c" \
	"$here/template/instrumentation/netfilter_observer.c" <<'PY'
import re
import sys

submitted_path, template_path = sys.argv[1:]
names = (
    "rk_observe_local_ipv4",
    "rk_netfilter_start",
    "rk_netfilter_stop",
    "rk_netfilter_snapshot",
)


def fail(message):
    print(f"[x] {message}", file=sys.stderr)
    raise SystemExit(1)


def strip_comments(text):
    return re.sub(r"/\*.*?\*/|//[^\n]*", "", text, flags=re.S)


def function_span(text, name):
    match = re.search(r"\b" + re.escape(name) + r"\s*\([^;]*?\)\s*\{", text, re.S)
    if not match:
        fail(f"could not find {name}")
    opening = text.find("{", match.start())
    depth = 0
    for index in range(opening, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return match.start(), opening, index + 1
    fail(f"could not find the end of {name}")


def without_functions(text):
    for start, _opening, end in sorted(
        (function_span(text, name) for name in names), reverse=True
    ):
        text = text[:start] + text[end:]
    return re.sub(r"\s+", "", text)


submitted = strip_comments(open(submitted_path, encoding="utf-8").read())
template = strip_comments(open(template_path, encoding="utf-8").read())
if without_functions(submitted) != without_functions(template):
    fail("only the four observer functions may change")

start, opening, end = function_span(submitted, "rk_observe_local_ipv4")
header = submitted[start:opening]
parameters = header[header.find("(") + 1 : header.rfind(")")].split(",")
parameter_names = []
for parameter in parameters:
    match = re.search(r"([A-Za-z_]\w*)\s*$", parameter)
    if not match:
        fail("could not parse callback parameters")
    parameter_names.append(match.group(1))
body = submitted[opening + 1:end - 1]
for parameter in parameter_names[1:]:
    body = re.sub(rf"\(void\)\s*{re.escape(parameter)}\s*;", "", body)
    if re.search(rf"\b{re.escape(parameter)}\b", body):
        fail("callback must not inspect or pass packet and hook-state arguments")

for forbidden in (
    "printk", "pr_info", "pr_debug", "kmalloc", "kzalloc",
    "schedule_work", "queue_work", "msleep", "udelay", "NF_DROP",
    "NF_STOLEN", "rk_parse_ipv4", "skb_header_pointer", "skb_copy_bits",
):
    if forbidden in submitted:
        fail(f"observer contains out-of-scope operation: {forbidden}")
PY

object=$build_dir/instrumentation/netfilter_observer.o
undefined=$(nm -u "$object" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__fentry__|__x86_return_thunk|init_net|nf_register_net_hook|\
		nf_unregister_net_hook|synchronize_rcu) ;;
		*) die "observer has out-of-scope external dependency: $symbol" ;;
	esac
done <<< "$undefined"

fixture=$here/fixtures/host/netfilter_observer_test.c
includes=$here/fixtures/host/include
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r20-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
for point in 0 1; do
	binary=$scratch/netfilter-observer-$point
	if ! gcc -std=c11 -Wall -Wextra -Werror -pedantic \
			-fsanitize=address,undefined -fno-omit-frame-pointer \
			-I"$includes" -DROOTKITLINGS_FAIL_POINT="$point" \
			"$build_dir/instrumentation/netfilter_observer.c" "$fixture" \
			-o "$binary" > "$binary.log" 2>&1; then
		cat "$binary.log" >&2
		die "Netfilter observer behavior fixture did not compile"
	fi
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
		UBSAN_OPTIONS=halt_on_error=1 "$binary" ||
		die "Netfilter observer behavior failed at injection point $point"
done

printf '[+] Netfilter observer behavior verified\n'
