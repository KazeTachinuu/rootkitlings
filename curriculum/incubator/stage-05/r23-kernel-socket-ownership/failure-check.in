#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "@LABEL@"

fixtures=/tmp/rootkitlings-socket-failure
tcp_fixture=$fixtures/tcp_fixture
module_loader=$fixtures/module_load_params
needs_listener=@NEEDS_LISTENER@
mkdir -p "$fixtures"

sed -n '/^__ROOTKITLINGS_TCP_FIXTURE__$/,/^__ROOTKITLINGS_MODULE_LOADER__$/p' /check |
	sed '1d;$d' | busybox base64 -d | busybox gzip -d > "$tcp_fixture"
sed -n '/^__ROOTKITLINGS_MODULE_LOADER__$/,$p' /check |
	sed '1d' | busybox base64 -d | busybox gzip -d > "$module_loader"
chmod 0755 "$tcp_fixture" "$module_loader"
ifconfig lo 127.0.0.1 up

wait_for_file()
{
	path=$1
	index=0
	while [ ! -s "$path" ] && [ "$index" -lt 300 ]; do
		sleep 0.01
		index=$((index + 1))
	done
	[ -s "$path" ]
}

attempt=1
while [ "$attempt" -le 2 ]; do
	directory=$fixtures/attempt-$attempt
	mkdir -p "$directory"
	if [ "$needs_listener" -eq 1 ]; then
		"$tcp_fixture" serve "$directory" > "$directory/log" 2>&1 &
		fixture_pid=$!
		wait_for_file "$directory/ready" || _fail "attempt $attempt fixture was not ready"
		port=$(cat "$directory/primary_port")
	else
		"$tcp_fixture" unused "$directory/port"
		port=$(cat "$directory/port")
		fixture_pid=
	fi

	if "$module_loader" /rootkitlings/rootkitlings.ko @EXPECTED_ERRNO@ \
			"peer_port=$port"; then
		_ok "attempt $attempt returned errno @EXPECTED_ERRNO@"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "attempt $attempt left a loaded module"
	else
		_ok "attempt $attempt left no loaded module"
	fi

	if [ "$needs_listener" -eq 1 ]; then
		if wait_for_file "$directory/eof"; then
			_ok "attempt $attempt released the connected socket"
		else
			_fail "attempt $attempt left the peer connected"
			kill "$fixture_pid" 2>/dev/null || true
		fi
		wait "$fixture_pid" || _fail "attempt $attempt fixture failed"
	fi
	attempt=$((attempt + 1))
done

summary
