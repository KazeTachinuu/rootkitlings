#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "Kernel TCP socket ownership"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-socket
helper=$fixtures/tcp_fixture
expected=$fixtures/expected
actual=$fixtures/actual
fixture_pid=

cleanup()
{
	if [ -d /sys/module/rootkitlings ]; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	if [ -n "$fixture_pid" ]; then
		kill "$fixture_pid" 2>/dev/null || true
		wait "$fixture_pid" 2>/dev/null || true
	fi
}
trap cleanup EXIT

mkdir -p "$fixtures"
sed -n '/^__ROOTKITLINGS_TCP_FIXTURE__$/,$p' /check |
	sed '1d' | busybox base64 -d | busybox gzip -d > "$helper"
chmod 0755 "$helper"

wait_for_file()
{
	path=$1
	index=0
	while [ ! -s "$path" ] && [ "$index" -lt 300 ]; do
		sleep 0.01
		index=$((index + 1))
	done
	[ -s "$path" ]
}

start_fixture()
{
	directory=$1
	rm -rf "$directory"
	mkdir -p "$directory"
	"$helper" serve "$directory" > "$directory/log" 2>&1 &
	fixture_pid=$!
	if wait_for_file "$directory/ready"; then
		_ok "loopback fixture is listening"
	else
		_fail "loopback fixture did not become ready"
	fi
}

has_established_tuple()
{
	local_port_hex=$(printf '%04X' "$1")
	peer_port_hex=$(printf '%04X' "$2")
	busybox awk -v local="0100007F:$local_port_hex" \
		-v peer="0100007F:$peer_port_hex" \
		'$2 == local && $3 == peer && $4 == "01" { found = 1 }
		 END { exit !found }' /proc/net/tcp
}

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings remains in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

write_expected()
{
	local_port=$1
	peer_port=$2
	printf 'state=owned\nnamespace=init_net\nfamily=ipv4\ntype=stream\nprotocol=tcp\nconnect_flags=0\nconnect_result=0\nlocal_address=127.0.0.1\nlocal_port=%s\npeer_address=127.0.0.1\npeer_port=%s\n' \
		"$local_port" "$peer_port" > "$expected"
}

assert_not_loaded
ifconfig lo 127.0.0.1 up
start_fixture "$fixtures/first"
peer_port=$(cat "$fixtures/first/primary_port")

# The single-quoted program expands its parameters inside the child shell.
# shellcheck disable=SC2016
if busybox unshare -n sh -c '
	ifconfig lo 127.0.0.1 up || exit 20
	peer_port=$1
	insmod /rootkitlings/rootkitlings.ko peer_port="$peer_port" || exit 21
	local_port=$(sed -n "s/^local_port=//p" /proc/rootkitlings)
	local_hex=$(printf "%04X" "$local_port")
	peer_hex=$(printf "%04X" "$peer_port")
	if grep -q "0100007F:$local_hex 0100007F:$peer_hex 01 " /proc/net/tcp; then
		exit 22
	fi
' child-net "$peer_port"; then
	_ok "loading from a child network namespace still uses init_net"
else
	_fail "child-namespace load or namespace isolation failed"
fi

assert_loaded rootkitlings
assert_exists "$endpoint"
if [ "$(stat -c '%a:%u:%g' "$endpoint")" = 400:0:0 ]; then
	_ok "$endpoint is read-only and owned by root"
else
	_fail "$endpoint has unexpected mode or ownership"
fi
if wait_for_file "$fixtures/first/accepted"; then
	_ok "the supplied loopback listener accepted the kernel connection"
else
	_fail "the loopback listener did not accept the kernel connection"
fi

local_port=$(sed -n 's/^local_port=//p' "$endpoint")
case "$local_port" in
	''|0|*[!0-9]*) _fail "status returned an invalid local port" ;;
	*) _ok "status returned a nonzero numeric local port" ;;
esac
write_expected "$local_port" "$peer_port"
if cat "$endpoint" > "$actual" && cmp -s "$expected" "$actual"; then
	_ok "status contains exactly the captured socket evidence"
else
	_fail "status differs from the captured socket evidence"
fi
if proc_read_test "$endpoint" "$expected"; then
	_ok "small reads, EOF, seek, and rewind preserve one snapshot"
else
	_fail "proc read behavior changed the socket record"
fi

if has_established_tuple "$local_port" "$peer_port"; then
	_ok "the exact captured client tuple is established in init_net"
else
	_fail "the captured client tuple is absent from init_net"
fi
unrelated_local=$(cat "$fixtures/first/unrelated_local_port")
unrelated_peer=$(cat "$fixtures/first/unrelated_peer_port")
if has_established_tuple "$unrelated_local" "$unrelated_peer"; then
	_ok "an unrelated loopback connection remains established"
else
	_fail "the unrelated control connection is absent"
fi

snapshot_reader()
{
	worker=$1
	worker_actual=$fixtures/reader-$worker
	printf 'ready\n' > "$fixtures/reader-ready-$worker"
	while [ ! -e "$fixtures/readers-go" ]; do
		sleep 0.01
	done
	index=0
	while [ "$index" -lt 24 ]; do
		cat "$endpoint" > "$worker_actual" || return 1
		cmp -s "$expected" "$worker_actual" || return 1
		index=$((index + 1))
	done
}

reader_pids=
worker=0
while [ "$worker" -lt 8 ]; do
	snapshot_reader "$worker" &
	reader_pids="$reader_pids $!"
	worker=$((worker + 1))
done
worker=0
while [ "$worker" -lt 8 ]; do
	wait_for_file "$fixtures/reader-ready-$worker" ||
		_fail "reader $worker did not reach the concurrency gate"
	worker=$((worker + 1))
done
touch "$fixtures/readers-go"
reader_ok=1
for reader_pid in $reader_pids; do
	wait "$reader_pid" || reader_ok=0
done
if [ "$reader_ok" -eq 1 ]; then
	_ok "eight overlapping readers each returned 24 consistent snapshots"
else
	_fail "a concurrent snapshot was inconsistent"
fi

if proc_read_test "$endpoint" "$expected" rootkitlings; then
	_ok "a held proc descriptor is retired during unload"
else
	_fail "held-descriptor unload behavior changed"
fi
if wait_for_file "$fixtures/first/eof"; then
	_ok "the peer observed EOF promptly after shutdown and release"
else
	_fail "the peer did not observe EOF after unload"
fi
wait "$fixture_pid" || _fail "the loopback fixture failed"
fixture_pid=
assert_not_loaded
if has_established_tuple "$local_port" "$peer_port"; then
	_fail "the released client tuple remains established"
else
	_ok "the released client tuple is no longer established"
fi

start_fixture "$fixtures/second"
peer_port=$(cat "$fixtures/second/primary_port")
load rootkitlings.ko "peer_port=$peer_port"
if wait_for_file "$fixtures/second/accepted"; then
	_ok "reload created a fresh connection"
else
	_fail "reload did not connect"
fi
local_port=$(sed -n 's/^local_port=//p' "$endpoint")
write_expected "$local_port" "$peer_port"
if cmp -s "$expected" "$endpoint" &&
		has_established_tuple "$local_port" "$peer_port"; then
	_ok "reload reports a fresh established tuple"
else
	_fail "reload evidence is incomplete"
fi
unload rootkitlings
if wait_for_file "$fixtures/second/eof"; then
	_ok "reload peer observed EOF after unload"
else
	_fail "reload peer did not observe EOF"
fi
wait "$fixture_pid" || _fail "the reload fixture failed"
fixture_pid=
assert_not_loaded

summary
