#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r23-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

KDIR=${KDIR:-/lib/modules/$(uname -r)/build}
[[ -d $KDIR ]] || {
	printf '[x] kernel build directory not found: %s\n' "$KDIR" >&2
	exit 1
}
case $(uname -r) in
	7.2.*|7.2-*) ;;
	*) printf '[x] this lesson requires Linux 7.2.x\n' >&2; exit 1 ;;
esac
[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
for option in NET NET_NS INET PROC_FS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] this lesson requires CONFIG_%s=y\n' "$option" >&2
		exit 1
	}
done
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || {
	printf '[x] pinned kernel build is not configured for GCC\n' >&2
	exit 1
}
for command in base64 gcc gzip nm python3; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

symvers=$KDIR/Module.symvers
for symbol in sock_create_kern kernel_connect kernel_getsockname \
		kernel_getpeername kernel_sock_shutdown sock_release; do
	awk -v symbol="$symbol" '$2 == symbol && $4 == "EXPORT_SYMBOL" { found = 1 }
		 END { exit !found }' "$symvers" || {
		printf '[x] pinned kernel does not export %s\n' "$symbol" >&2
		exit 1
	}
done

for script in test host-check success-check failure-check.in validation-check; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check.in" \
		"$HERE/validation-check"
fi

mapfile -t changed_files < <(
	diff -qr "$HERE/template" "$HERE/solution" |
		sed -nE 's#^Files .*/template/(.*) and .*/solution/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == network/socket_owner.c ]] || {
	printf '[x] learner edit surface is %s, expected network/socket_owner.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2 point=${3:-0}
	local log=$destination.log
	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
			ROOTKITLINGS_FAIL_POINT="$point" modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "${source##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "${source##*/}" >&2
		exit 1
	fi
}

build_tree "$HERE/template" "$scratch/template"
build_tree "$HERE/solution" "$scratch/solution"
build_tree "$HERE/solution" "$scratch/after-create" 1
build_tree "$HERE/solution" "$scratch/after-capture" 2
build_tree "$HERE/solution" "$scratch/proc-failure" 3
"$HERE/host-check" "$scratch/solution" "$scratch/solution/rootkitlings.ko"

if "$HERE/host-check" "$scratch/template" \
		"$scratch/template/rootkitlings.ko" > "$scratch/template-host.log" 2>&1; then
	printf '[x] host checker accepted the unfinished socket owner\n' >&2
	exit 1
fi

equivalent=$scratch/equivalent
cp -a "$HERE/solution" "$equivalent"
python3 - "$equivalent/network/socket_owner.c" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
for old, new in (
    ("owner", "holder"),
    ("config", "settings"),
    ("requested", "request"),
    ("status", "view"),
    ("local", "bound"),
    ("error", "result"),
):
    text = re.sub(rf"\b{old}\b", new, text)
text = text.replace("if (!holder || !settings)",
                    "if (holder == NULL || settings == NULL)")
path.write_text(text, encoding="utf-8")
PY
make -s -C "$KDIR" M="$equivalent" W=1 modules > "$equivalent.log" 2>&1 || {
	cat "$equivalent.log" >&2
	printf '[x] equivalent implementation build failed\n' >&2
	exit 1
}
if grep -q 'warning:' "$equivalent.log"; then
	cat "$equivalent.log" >&2
	printf '[x] equivalent implementation build has warnings\n' >&2
	exit 1
fi
"$HERE/host-check" "$equivalent" "$equivalent/rootkitlings.ko"

expect_rejection()
{
	local directory=$1 label=$2
	if "$HERE/host-check" "$directory" "$directory/rootkitlings.ko" \
			> "$scratch/host-$label.log" 2>&1; then
		printf '[x] host checker accepted %s\n' "$label" >&2
		exit 1
	fi
}

wrong_namespace=$scratch/wrong-namespace
cp -a "$scratch/solution" "$wrong_namespace"
sed -i 's/config->net == \&init_net/config->net != NULL/' \
	"$wrong_namespace/network/socket_owner.c"
expect_rejection "$wrong_namespace" caller-network-namespace

nonblocking=$scratch/nonblocking
cp -a "$scratch/solution" "$nonblocking"
sed -i 's/config->connect_flags == 0/config->connect_flags == MSG_DONTWAIT/' \
	"$nonblocking/network/socket_owner.c"
expect_rejection "$nonblocking" nonblocking-connect

wrong_repeat_error=$scratch/wrong-repeat-error
cp -a "$scratch/solution" "$wrong_repeat_error"
sed -i '0,/error = -EBUSY;/s//error = -EINVAL;/' \
	"$wrong_repeat_error/network/socket_owner.c"
expect_rejection "$wrong_repeat_error" wrong-repeat-error

leaked_create=$scratch/leaked-create
cp -a "$scratch/solution" "$leaked_create"
python3 - "$leaked_create/network/socket_owner.c" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
s = p.read_text(encoding="utf-8")
s = s.replace("if (ROOTKITLINGS_FAIL_POINT == RK_FAIL_AFTER_CREATE) {\n"
              "\t\terror = -ECANCELED;\n\t\tgoto release;\n\t}",
              "if (ROOTKITLINGS_FAIL_POINT == RK_FAIL_AFTER_CREATE) {\n"
              "\t\terror = -ECANCELED;\n\t\tgoto unlock;\n\t}")
p.write_text(s, encoding="utf-8")
PY
expect_rejection "$leaked_create" leaked-after-create

no_shutdown=$scratch/no-shutdown
cp -a "$scratch/solution" "$no_shutdown"
sed -i '0,/kernel_sock_shutdown(socket, SHUT_RDWR)/s//sock_release(socket)/' \
	"$no_shutdown/network/socket_owner.c"
expect_rejection "$no_shutdown" missing-post-connect-shutdown

conditional_release=$scratch/conditional-release
cp -a "$scratch/solution" "$conditional_release"
sed -i '0,/(void)kernel_sock_shutdown(socket, SHUT_RDWR);/s//if (!kernel_sock_shutdown(socket, SHUT_RDWR))/' \
	"$conditional_release/network/socket_owner.c"
expect_rejection "$conditional_release" shutdown-dependent-release

early_publish=$scratch/early-publish
cp -a "$scratch/solution" "$early_publish"
sed -i '/error = kernel_connect/i\
\tWRITE_ONCE(owner->socket, socket);' \
	"$early_publish/network/socket_owner.c"
expect_rejection "$early_publish" early-publication

hardcoded_endpoint=$scratch/hardcoded-endpoint
cp -a "$scratch/solution" "$hardcoded_endpoint"
sed -i 's/owner->local_port = ntohs(local.sin_port);/owner->local_port = 12345;/' \
	"$hardcoded_endpoint/network/socket_owner.c"
expect_rejection "$hardcoded_endpoint" hardcoded-endpoint

unlocked_snapshot=$scratch/unlocked-snapshot
cp -a "$scratch/solution" "$unlocked_snapshot"
sed -i '/mutex_lock(\&owner->lock);/,/status->owned/ { /mutex_lock(\&owner->lock);/d; }' \
	"$unlocked_snapshot/network/socket_owner.c"
expect_rejection "$unlocked_snapshot" unlocked-snapshot

cp -a "$HERE/solution" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 \
		ROOTKITLINGS_FAIL_POINT=99 modules > "$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

gcc -std=c11 -Wall -Wextra -Werror -pedantic -static \
	-o "$scratch/tcp_fixture" "$HERE/fixtures/host/tcp_fixture.c"
gcc -std=c11 -Wall -Wextra -Werror -pedantic -static \
	-o "$scratch/module_load_params" "$HERE/fixtures/host/module_load_params.c"

append_helpers()
{
	local script=$1
	{
		printf '\n__ROOTKITLINGS_TCP_FIXTURE__\n'
		gzip -c "$scratch/tcp_fixture" | base64 -w 76
		printf '\n__ROOTKITLINGS_MODULE_LOADER__\n'
		gzip -c "$scratch/module_load_params" | base64 -w 76
	} >> "$script"
	chmod 0755 "$script"
}

cp "$HERE/success-check" "$scratch/success-check"
printf '\n__ROOTKITLINGS_TCP_FIXTURE__\n' >> "$scratch/success-check"
gzip -c "$scratch/tcp_fixture" | base64 -w 76 >> "$scratch/success-check"
chmod 0755 "$scratch/success-check"

sed -e 's/@LABEL@/Rollback after socket creation/g' \
	-e 's/@EXPECTED_ERRNO@/125/g' -e 's/@NEEDS_LISTENER@/0/g' \
	"$HERE/failure-check.in" > "$scratch/after-create-check"
append_helpers "$scratch/after-create-check"
sed -e 's/@LABEL@/Rollback after connected endpoint capture/g' \
	-e 's/@EXPECTED_ERRNO@/125/g' -e 's/@NEEDS_LISTENER@/1/g' \
	"$HERE/failure-check.in" > "$scratch/after-capture-check"
append_helpers "$scratch/after-capture-check"
sed -e 's/@LABEL@/Proc publication rollback/g' \
	-e 's/@EXPECTED_ERRNO@/12/g' -e 's/@NEEDS_LISTENER@/1/g' \
	"$HERE/failure-check.in" > "$scratch/proc-failure-check"
append_helpers "$scratch/proc-failure-check"
cp "$HERE/validation-check" "$scratch/validation-check"
append_helpers "$scratch/validation-check"

run_guest()
{
	local check_script=$1 module=$2 output
	if ! output=$("$HERE/../../../../vm/boot" --check "$check_script" \
			--tool tools/module_load_test --tool tools/proc_read_test \
			"$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest did not complete\n' >&2
		exit 1
	fi
	printf '%s\n' "$output"
	grep -Fq '[+] PASSED' <<< "$output" || {
		printf '[x] guest checks did not pass\n' >&2
		exit 1
	}
}

run_guest "$scratch/after-create-check" \
	"$scratch/after-create/rootkitlings.ko"
run_guest "$scratch/after-capture-check" \
	"$scratch/after-capture/rootkitlings.ko"
run_guest "$scratch/proc-failure-check" \
	"$scratch/proc-failure/rootkitlings.ko"
run_guest "$scratch/validation-check" \
	"$scratch/solution/rootkitlings.ko"
run_guest "$scratch/success-check" "$scratch/solution/rootkitlings.ko"
