#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

for relative in Kbuild core/main.c include/rootkit.h interface/proc.c \
		network/socket_owner.c network/socket_owner.o; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done
[[ -f $module && ! -L $module ]] || die "module must be a regular file"

for relative in Kbuild core/main.c include/rootkit.h interface/proc.c; do
	cmp -s "$here/solution/$relative" "$build_dir/$relative" ||
		die "supplied file was changed: $relative"
done

# These are lesson scope boundaries, not semantic proofs. The behavior fixture
# below proves the required ownership and rollback behavior.
compact=$(sed -E '/^[[:space:]]*\/\//d' "$build_dir/network/socket_owner.c" |
	tr -d '[:space:]')
for forbidden in kernel_sendmsg kernel_recvmsg sock_sendmsg sock_recvmsg \
		kernel_bind kernel_listen kernel_accept SOCK_RAW MSG_DONTWAIT \
		O_NONBLOCK nf_register register_kprobe queue_work schedule_work \
		kthread timer_setup msleep; do
	[[ $compact != *"$forbidden"* ]] ||
		die "socket owner contains out-of-scope operation: $forbidden"
done

object=$build_dir/network/socket_owner.o
for forbidden in kernel_sendmsg kernel_recvmsg kernel_bind kernel_listen \
		kernel_accept nf_register_net_hook register_kprobe; do
	if nm -u "$object" | awk -v symbol="$forbidden" \
			'$2 == symbol { found = 1 } END { exit !found }'; then
		die "compiled socket owner references out-of-scope symbol: $forbidden"
	fi
done

fixture=$here/fixtures/host/socket_owner_test.c
includes=$here/fixtures/host/include
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r23-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
for point in 0 1 2; do
	binary=$scratch/socket-owner-$point
	if ! gcc -std=c11 -Wall -Wextra -Werror -pedantic \
			-fsanitize=address,undefined -fno-omit-frame-pointer \
			-I"$includes" -DROOTKITLINGS_FAIL_POINT="$point" \
			"$build_dir/network/socket_owner.c" "$fixture" \
			-o "$binary" > "$binary.log" 2>&1; then
		cat "$binary.log" >&2
		die "socket ownership behavior fixture did not compile"
	fi
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
		UBSAN_OPTIONS=halt_on_error=1 "$binary" ||
		die "socket ownership behavior failed at injection point $point"
done

printf '[+] socket ownership behavior verified\n'
