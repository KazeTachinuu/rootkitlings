#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) ||
	die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

for relative in Kbuild main.c include/ipv4_parser.h include/skb_access.h \
	parser/ipv4.c access/skb_access.c access/skb_access.o; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done
[[ -f $module && ! -L $module ]] || die "module must be a regular file"

for relative in Kbuild main.c include/ipv4_parser.h include/skb_access.h \
	parser/ipv4.c; do
	cmp -s "$here/solution/$relative" "$build_dir/$relative" ||
		die "supplied file was changed: $relative"
done

source=$build_dir/access/skb_access.c
for required in skb_network_offset skb_headroom skb_frags_readable \
	skb_header_pointer_careful INT_MIN S64_MAX copy_offset; do
	rg -q "${required}" "$source" || die "missing required operation: $required"
done

if rg -q 'skb[[:space:]]*->[[:space:]]*data([^_[:alnum:]]|$)' "$source"; then
	die "do not read skb->data directly"
fi
if rg -q '\b(kmalloc|kzalloc|kcalloc|vmalloc|skb_linearize|__skb_linearize|pskb_may_pull|skb_pull|__skb_pull)[[:space:]]*\(' "$source"; then
	die "the adapter must not allocate, linearize, or pull"
fi
if rg -q '#[[:space:]]*(define|undef)[[:space:]]+(skb_|RK_)' "$source"; then
	die "do not replace the supplied API or skb helpers with macros"
fi

nm "$build_dir/access/skb_access.o" |
	grep -Eq '[[:space:]]T[[:space:]]rk_skb_read_network$' ||
	die "access object does not define rk_skb_read_network"
nm "$module" |
	grep -Eq '[[:space:]][Tt][[:space:]]rk_skb_read_network$' ||
	die "module does not contain rk_skb_read_network"

printf '[+] safe sk_buff access verified\n'
