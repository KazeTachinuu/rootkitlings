#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Safe sk_buff access"

assert_absent /sys/module/rootkitlings
load rootkitlings.ko
assert_loaded rootkitlings
if dmesg | grep -q 'rootkitlings: skb access self-tests passed:'; then
	_ok "kernel self-tests covered real sk_buff layouts"
else
	_fail "kernel self-test completion was not logged"
fi
unload rootkitlings
assert_absent /sys/module/rootkitlings

summary
