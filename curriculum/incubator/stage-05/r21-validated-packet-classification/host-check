#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r21-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for relative in Kbuild access/skb_access.c core/main.c \
		include/ipv4_parser.h include/rootkit.h include/skb_access.h \
		include/udp_classifier.h instrumentation/netfilter_observer.c \
		interface/proc.c parser/ipv4.c tests/selftest.c \
		classifier/udp.c classifier/udp.o; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done

for relative in Kbuild access/skb_access.c core/main.c \
		include/ipv4_parser.h include/rootkit.h include/skb_access.h \
		include/udp_classifier.h instrumentation/netfilter_observer.c \
		interface/proc.c parser/ipv4.c tests/selftest.c; do
	cmp -s "$here/solution/$relative" "$build_dir/$relative" ||
		die "supplied file was changed: $relative"
done

gcc -std=c11 -Wall -Wextra -Werror -pedantic -O1 -g \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I"$build_dir/include" \
	"$here/fixtures/host/classifier_test.c" \
	"$build_dir/classifier/udp.c" "$build_dir/parser/ipv4.c" \
	-o "$scratch/classifier_test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
	"$scratch/classifier_test"

undefined=$(nm -u "$build_dir/classifier/udp.o" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__fentry__|__x86_return_thunk) ;;
		*) die "classifier has unexpected external dependency: $symbol" ;;
	esac
done <<< "$undefined"

if nm "$build_dir/classifier/udp.o" |
	grep -Eq '[[:space:]][bBcCdDgGsS][[:space:]]'; then
	die "classifier must not own mutable object state"
fi

printf '[+] classifier structure and bounded behavior are valid\n'
