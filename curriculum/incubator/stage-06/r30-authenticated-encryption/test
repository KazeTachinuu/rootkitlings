#!/usr/bin/bash
set -Eeuo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r30-test.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT
kdir=${KDIR:-/lib/modules/$(uname -r)/build}
[[ -d $kdir ]] || { printf '[x] kernel build directory not found\n' >&2; exit 1; }
[[ $(uname -r) == 7.2.* || $(uname -r) == 7.2-* ]] || { printf '[x] Linux 7.2.x required\n' >&2; exit 1; }
grep -Eq '^CONFIG_CRYPTO_GCM=[ym]$' "$kdir/.config" || { printf '[x] CONFIG_CRYPTO_GCM required\n' >&2; exit 1; }
grep -Eq '^CONFIG_CRYPTO_AES=[ym]$' "$kdir/.config" || { printf '[x] CONFIG_CRYPTO_AES required\n' >&2; exit 1; }
generated=$(find "$here" -type f \( -name '*.o' -o -name '*.ko' -o -name '*.mod' -o -name '*.mod.c' -o -name Module.symvers -o -name modules.order -o -name '.*.cmd' \) -print -quit)
[[ -z $generated ]] || { printf '[x] generated artifact in lesson: %s\n' "$generated" >&2; exit 1; }
mapfile -t changed < <(diff -qr "$here/template" "$here/solution" | sed -nE 's#^Files .*/template/(.*) and .*/solution/.* differ$#\1#p')
[[ ${#changed[@]} == 1 && ${changed[0]} == crypto/aead.c ]] || { printf '[x] learner edit boundary is not one file\n' >&2; exit 1; }

build(){ local src=$1 dst=$2 point=${3:-0}; cp -a "$src" "$dst"; make -s -C "$kdir" M="$dst" W=1 ROOTKITLINGS_FAIL_POINT="$point" modules >"$dst.log" 2>&1 || { cat "$dst.log"; exit 1; }; ! grep -q 'warning:' "$dst.log" || { cat "$dst.log"; exit 1; }; }
build "$here/solution" "$tmp/solution"
build "$here/template" "$tmp/template"
for point in 1 2 3; do build "$here/solution" "$tmp/fail-$point" "$point"; done
"$here/host-check" "$tmp/solution" "$tmp/solution/rootkitlings.ko"
if "$here/host-check" "$tmp/template" "$tmp/template/rootkitlings.ko" >/dev/null 2>&1; then printf '[x] template accepted\n' >&2; exit 1; fi
cp -a "$here/solution" "$tmp/alternate-src"; cp "$here/fixtures/alternate/aead.c" "$tmp/alternate-src/crypto/aead.c"; build "$tmp/alternate-src" "$tmp/alternate"; "$here/host-check" "$tmp/alternate" "$tmp/alternate/rootkitlings.ko"

mutant(){ local name=$1 old=$2 new=$3 dir="$tmp/mutant-$1"; cp -a "$here/solution" "$dir"; sed -i "s@$old@$new@" "$dir/crypto/aead.c"; build "$dir" "$tmp/built-$name"; if "$here/host-check" "$tmp/built-$name" "$tmp/built-$name/rootkitlings.ko" >/dev/null 2>&1; then printf '[x] mutant accepted: %s\n' "$name" >&2; exit 1; fi; }
mutant no-aad 'ops->set_ad(request, (unsigned int)aad_length);' 'ops->set_ad(request, 0);'
mutant wrong-open-length 'ops->set_crypt(request, \&sg, (unsigned int)input_length, iv);' 'ops->set_crypt(request, \&sg, (unsigned int)(input_length - (decrypt ? RK_AEAD_TAG_LENGTH : 0)), iv);'
mutant publish-on-failure 'if (error)' 'if (false \&\& error)'
mutant no-iv-check 'ops->iv_size(tfm) != RK_AEAD_NONCE_LENGTH' 'false'
mutant no-auth-check 'ops->auth_size(tfm) != RK_AEAD_TAG_LENGTH' 'false'
mutant skip-wait 'error = ops->wait_request(error, \&wait);' 'error = error;'

guest(){ local check=$1 module=$2 label=$3 out; out=$("$here/../../../../vm/boot" --cap aes-gcm --check "$check" "$module" --tool tools/module_load_test 2>&1) || { printf '%s\n[x] guest rejected %s\n' "$out" "$label" >&2; exit 1; }; printf '%s\n' "$out"; grep -Fq '[+] PASSED' <<<"$out"; }
guest "$here/success-check" "$tmp/solution/rootkitlings.ko" solution
guest "$here/success-check" "$tmp/alternate/rootkitlings.ko" alternate
for point in 1 2 3; do sed -e "s/@LABEL@/R30 fail point $point/g" -e "s/@ERRNO@/$(case $point in 1) echo 12;;2) echo 129;;3) echo 5;;esac)/g" "$here/failure-check.in" >"$tmp/check-$point"; guest "$tmp/check-$point" "$tmp/fail-$point/rootkitlings.ko" "fail-$point"; done
if git -C "$here" ls-files --error-unmatch '../r29-authenticated-replay-safe-message/test' >/dev/null 2>&1 &&
	git -C "$here" diff --quiet -- '../r29-authenticated-replay-safe-message' &&
	git -C "$here" diff --cached --quiet -- '../r29-authenticated-replay-safe-message'; then
	"$here/../r29-authenticated-replay-safe-message/test"
else
	printf '[*] R29 regression deferred: lesson is still being changed\n'
fi
printf '[+] R30 authenticated encryption passed\n'
