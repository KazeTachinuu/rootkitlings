#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh
begin "AES-256-GCM authenticated encryption"
assert_absent /sys/module/rootkitlings
attempt=1
while [ "$attempt" -le 2 ]; do
	load rootkitlings.ko
	assert_loaded rootkitlings
	if dmesg | grep -q 'rootkitlings: aes-256-gcm nist vector and tamper gate passed'; then
		_ok "NIST bytes and tamper rejection passed"
	else
		_fail "AES-GCM self-test completion is missing"
	fi
	unload rootkitlings
	assert_absent /sys/module/rootkitlings
	attempt=$((attempt+1))
done
summary
