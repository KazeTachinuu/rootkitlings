#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh
begin "AES-256-GCM authenticated encryption"
assert_absent /sys/module/rootkitlings
attempt=1
while [ "$attempt" -le 2 ]; do
	load rootkitlings.ko
	assert_loaded rootkitlings
	_ok "module initialization completed its AES-GCM self-test"
	unload rootkitlings
	assert_absent /sys/module/rootkitlings
	attempt=$((attempt+1))
done
summary
