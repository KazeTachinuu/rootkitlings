#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected=${1:-22}
label=${2:-Rejected unfinished authenticated DNS signal}
begin "$label"
assert_absent /sys/module/rootkitlings
if module_load_test /rootkitlings/rootkitlings.ko "$expected"; then
	_ok "module load returned expected errno $expected"
else
	_fail "module load did not return expected errno $expected"
fi
assert_absent /sys/module/rootkitlings
summary
