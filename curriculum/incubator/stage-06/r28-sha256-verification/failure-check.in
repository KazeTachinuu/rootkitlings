#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected=${1:-@ERRNO@}
label=${2:-@LABEL@}
begin "$label"

attempt=1
while [ "$attempt" -le 2 ]; do
	if module_load_test /rootkitlings/rootkitlings.ko "$expected"; then
		_ok "attempt $attempt returned errno $expected"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rootkitlings
	attempt=$((attempt + 1))
done

summary
