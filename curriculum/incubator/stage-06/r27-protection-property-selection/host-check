#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r27-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for relative in Kbuild core/main.c include/protection.h include/selftest.h \
		protection/properties.c tests/selftest.c; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing regular file: $relative"
done

for relative in Kbuild core/main.c include/protection.h include/selftest.h \
		tests/selftest.c; do
	cmp -s "$here/solution/$relative" "$build_dir/$relative" ||
		die "supplied file was changed: $relative"
done

directive_count=0
while IFS= read -r directive; do
	directive_count=$((directive_count + 1))
	[[ $directive =~ ^[[:space:]]*#[[:space:]]*include[[:space:]]*\"protection\.h\"[[:space:]]*$ ]] ||
		die "learner file may only include protection.h; conditional compilation is not allowed"
done < <(grep -E '(#|%:|\?\?=)' "$build_dir/protection/properties.c" || true)
(( directive_count == 1 )) ||
	die "learner file must include protection.h exactly once"

gcc -std=c11 -Wall -Wextra -Werror -pedantic -O1 -g \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	-I"$build_dir/include" "$here/fixtures/host/properties_test.c" \
	"$build_dir/protection/properties.c" -o "$scratch/properties-test"
ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
	"$scratch/properties-test"

strings -a "$module" > "$scratch/module.strings"
if grep -Fq 'rk-runtime-plaintext-visible' "$scratch/module.strings"; then
	die "runtime demonstration plaintext is embedded in the module file"
fi

undefined=$(nm -u "$build_dir/protection/properties.o" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__SCT__WARN_trap|__fentry__|__fortify_panic|\
		__ref_stack_chk_guard|__stack_chk_fail|__x86_return_thunk|\
		memcpy|memset) ;;
		*) die "learner object has unexpected external dependency: $symbol" ;;
	esac
done <<< "$undefined"

if nm "$build_dir/protection/properties.o" |
	grep -Eq '[[:space:]][bBdD][[:space:]]'; then
	die "learner file must not own mutable or persistent object state"
fi
for symbol in rk_xor_repeat rk_choose_protection; do
	nm "$build_dir/protection/properties.o" |
		grep -Eq "[[:space:]]T[[:space:]]${symbol}$" ||
		die "learner object does not define $symbol"
done

printf '[+] protection selection and XOR behavior are valid\n'
