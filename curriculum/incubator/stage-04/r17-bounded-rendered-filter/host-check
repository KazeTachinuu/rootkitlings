#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 3 )) || die "usage: ${0##*/} SUCCESS_DIR SUCCESS_ARTIFACT MISSING_DIR"
success_dir=$(realpath -e -- "$1" 2>/dev/null) || die "success directory not found: $1"
success_artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"
missing_dir=$(realpath -e -- "$3" 2>/dev/null) || die "missing directory not found: $3"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$here/../../../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r17-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $success_artifact && ! -L $success_artifact ]] ||
	die "success artifact is not a regular file"

supplied=(
	Kbuild
	core/main.c
	include/rootkit.h
	instrumentation/read_filter.c
	interface/proc.c
)
for path in "${supplied[@]}"; do
	[[ -f $success_dir/$path && ! -L $success_dir/$path ]] ||
		die "missing supplied file: $path"
done

mapfile -t source_paths < <(
	cd "$success_dir"
	find core include instrumentation interface -type f \
		\( -name '*.c' -o -name '*.h' \) -printf '%p\n' | sort
	printf 'Kbuild\n'
)
expected_paths=(
	core/main.c
	include/rootkit.h
	instrumentation/read_filter.c
	instrumentation/replace.c
	interface/proc.c
	Kbuild
)
[[ ${source_paths[*]} == "${expected_paths[*]}" ]] ||
	die "source tree contains an unexpected or missing source file"

learner=$success_dir/instrumentation/replace.c
[[ -f $learner && ! -L $learner ]] || die "missing learner file"
grep -Eq 'rk_replace_equal[[:space:]]*\(' "$learner" ||
	die "rk_replace_equal is missing"
if grep -Eq '\b(strlen|strstr|strnstr|strcpy|strncpy|strcat|strncat|sprintf|snprintf|krealloc|kmalloc|kzalloc|kfree)[[:space:]]*\(' \
	"$learner"; then
	die "replacement must be bounded byte processing without allocation"
fi
for command in gcc timeout nm objdump strings; do
	command -v "$command" >/dev/null || die "$command is required"
done
gcc -DRK_STANDALONE_HELPER -std=c11 -Wall -Wextra -Werror -pedantic \
	-fsanitize=address,undefined -fno-omit-frame-pointer \
	"$learner" "$root/tools/read_result_test.c" -o "$scratch/helper"
ASAN_OPTIONS=detect_leaks=1:abort_on_error=1 timeout 15 "$scratch/helper" \
	> "$scratch/helper.log" 2>&1 || {
		cat "$scratch/helper.log" >&2
		die "bounded replacement fixtures failed"
	}
grep -Fqx '[+] bounded equal-width replacement verified' \
	"$scratch/helper.log" || die "helper test did not finish"

for directory in "$success_dir" "$missing_dir"; do
	for object in instrumentation/read_filter.o instrumentation/replace.o; do
		[[ -f $directory/$object && ! -L $directory/$object ]] ||
			die "build is missing $object"
	done
done

while read -r symbol; do
	case $symbol in
		__fentry__|__ref_stack_chk_guard|__stack_chk_fail|\
		__x86_return_thunk|atomic_long_*|copy_from_user_nofault|\
		copy_to_user_nofault|filp_open|fput|igrab|iput|\
		register_kretprobe|unregister_kretprobe|rk_replace_equal) ;;
		*) die "read filter has unexpected dependency: $symbol" ;;
	esac
done < <(nm -u "$success_dir/instrumentation/read_filter.o" | awk '{ print $NF }')

for specification in \
	'copy_from_user_nofault 1' \
	'copy_to_user_nofault 1' \
	'filp_open 1' \
	'fput 1' \
	'igrab 1' \
	'iput 1' \
	'register_kretprobe 1' \
	'unregister_kretprobe 1' \
	'rk_replace_equal 1'; do
	read -r symbol count <<< "$specification"
	[[ $(objdump -r "$success_dir/instrumentation/read_filter.o" |
		grep -Ec "[[:space:]]${symbol}([+-]|$)") -eq $count ]] ||
		die "read filter must call $symbol exactly $count time(s)"
done

strings "$success_dir/instrumentation/read_filter.o" | grep -Fqx vfs_read ||
	die "success probe does not target vfs_read"
if strings "$success_dir/instrumentation/read_filter.o" |
	grep -Fqx '__rootkitlings_missing_kretprobe_target_7_2__'; then
	die "success object contains the missing target"
fi
strings "$missing_dir/instrumentation/read_filter.o" |
	grep -Fqx '__rootkitlings_missing_kretprobe_target_7_2__' ||
	die "missing-target variant did not compile its target"

printf '[+] bounded read-result implementation verified\n'
