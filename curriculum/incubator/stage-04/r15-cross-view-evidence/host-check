#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 3 )) || die "usage: ${0##*/} SUCCESS_DIR SUCCESS_ARTIFACT MISSING_DIR"
success_dir=$(realpath -e -- "$1" 2>/dev/null) || die "success directory not found: $1"
success_artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"
missing_dir=$(realpath -e -- "$3" 2>/dev/null) || die "missing-symbol directory not found: $3"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r15-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $success_artifact && ! -L $success_artifact ]] ||
	die "success artifact must be a regular file"
[[ $success_artifact == "$success_dir/rootkitlings.ko" ]] ||
	die "success artifact must belong to the success build"

for relative in Kbuild core/main.c core/state.c include/rootkit.h \
	instrumentation/probes.c core/main.o core/state.o; do
	[[ -f $success_dir/$relative && ! -L $success_dir/$relative ]] ||
		die "success build is missing regular file: $relative"
done
for relative in interface/proc.c interface/proc.o instrumentation/probes.o; do
	[[ -f $success_dir/$relative && ! -L $success_dir/$relative ]] ||
		die "success build is missing regular file: $relative"
done
[[ -f $missing_dir/instrumentation/probes.o &&
	! -L $missing_dir/instrumentation/probes.o ]] ||
	die "missing-symbol build lacks instrumentation/probes.o"

gcc -std=c11 -Wall -Wextra -Werror -Wno-unused-parameter \
	-DROOTKITLINGS_FAIL_POINT=0 \
	-I "$here/fixtures/host/include" -I "$success_dir/include" \
	-I "$success_dir" "$here/fixtures/host/proc_test.c" \
	-o "$scratch/proc-test"
"$scratch/proc-test"
gcc -std=c11 -Wall -Wextra -Werror -Wno-unused-parameter \
	-DROOTKITLINGS_FAIL_POINT=0 \
	-I "$here/fixtures/host/include" -I "$success_dir/include" \
	-I "$success_dir" "$here/fixtures/host/probe_test.c" \
	-o "$scratch/probe-test"
"$scratch/probe-test"

proc_undefined=$(nm -u "$success_dir/interface/proc.o" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__check_object_size|__fentry__|__ref_stack_chk_guard|__stack_chk_fail|\
		__x86_return_thunk|_copy_from_user|memcmp|proc_create_data|\
		proc_remove|rk_probe_name|rk_state_actions_enabled|rk_state_filename_rmdir_seen|\
		rk_state_is_active|rk_state_set_actions_enabled|rk_state_vfs_mkdir_seen|\
		seq_lseek|seq_open|seq_printf|seq_read|seq_release|validate_usercopy_range) ;;
		*) die "proc renderer has forbidden dependency: $symbol" ;;
	esac
done <<< "$proc_undefined"

for specification in \
	'rk_probe_name 1' \
	'seq_printf 2' \
	'seq_open 1' \
	'seq_release 1'; do
	read -r symbol expected <<< "$specification"
	actual=$(objdump -r "$success_dir/interface/proc.o" |
		grep -Ec "[[:space:]]${symbol}([+-]|$)" || true)
	[[ $actual -eq $expected ]] ||
		die "proc renderer must reference $symbol exactly $expected time(s)"
done

for target in vfs_mkdir filename_rmdir; do
	[[ $(strings "$success_artifact" | grep -Fxc "$target") -eq 1 ]] ||
		die "$target must have one identity in the canonical catalog"
done
for object in "$success_dir/instrumentation/probes.o" \
	"$missing_dir/instrumentation/probes.o"; do
	[[ $(objdump -r "$object" | grep -Ec '[[:space:]]register_kprobes([+-]|$)') -eq 1 ]] ||
		die "probe catalog must be batch-registered exactly once"
	[[ $(objdump -r "$object" | grep -Ec '[[:space:]]unregister_kprobes([+-]|$)') -eq 1 ]] ||
		die "probe catalog must be batch-unregistered exactly once"
done

main_relocations=$(objdump -r "$success_dir/core/main.o")
for specification in \
	'rk_state_create 1' \
	'rk_probes_start 1' \
	'rk_proc_publish 1' \
	'rk_proc_unpublish 1' \
	'rk_probes_stop 2' \
	'rk_state_destroy 2'; do
	read -r symbol expected <<< "$specification"
	actual=$(grep -Ec "[[:space:]]${symbol}([+-]|$)" <<< "$main_relocations" || true)
	[[ $actual -eq $expected ]] ||
		die "module lifecycle must reference $symbol exactly $expected time(s)"
done

if grep -Fxq '__rootkitlings_missing_kprobe_target_7_2__' \
	< <(strings "$success_artifact"); then
	die "success artifact contains the negative-control target"
fi
grep -Fxq '__rootkitlings_missing_kprobe_target_7_2__' \
	< <(strings "$missing_dir/rootkitlings.ko") ||
	die "missing-symbol artifact lacks the negative-control target"

printf '[+] behavioral item suppression, canonical identity, and lifecycle verified\n'
