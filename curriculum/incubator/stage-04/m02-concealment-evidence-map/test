#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../../scripts/lesson-env"
ROOT=$ROOTKITLINGS_ROOT
M01=$HERE/../../stage-03/m01-authorized-actions-telemetry
M00=$HERE/../../stage-02/m00-controlled-resident-core
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-m02.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || { printf '[x] M02 requires x86_64\n' >&2; exit 1; }
for option in X86_64 KPROBES KRETPROBES KRETPROBE_ON_RETHOOK \
	KPROBES_ON_FTRACE KALLSYMS KALLSYMS_ALL DEBUG_FS \
	ARCH_HAS_SYSCALL_WRAPPER MODULES MODULE_UNLOAD MULTIUSER USER_NS PID_NS \
	CRYPTO_LIB_UTILS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] M02 requires CONFIG_%s=y\n' "$option" >&2; exit 1;
	}
done
grep -Eqx '(CONFIG_PREEMPT_RT=n|# CONFIG_PREEMPT_RT is not set)' \
	"$KDIR/.config" || {
	printf '[x] M02 requires CONFIG_PREEMPT_RT=n\n' >&2; exit 1;
}

mapfile -t additions < <(cd "$HERE/additions" && find . -type f | sort)
expected_additions=(./include/dirent_filter.h \
	./instrumentation/dirent_filter.c \
	./instrumentation/getdents_probe.c ./interface/evidence.c)
[[ ${additions[*]} == "${expected_additions[*]}" ]] || {
	printf '[x] sparse additions differ\nexpected: %s\nactual: %s\n' \
		"${expected_additions[*]}" "${additions[*]}" >&2; exit 1;
}
mapfile -t overlay < <(cd "$HERE/solution-overlay" && find . -type f | sort)
expected_overlay=(./Kbuild ./core/main.c ./execution/worker.c \
	./include/rootkit.h ./instrumentation/getdents_probe.c \
	./interface/evidence.c)
[[ ${overlay[*]} == "${expected_overlay[*]}" ]] || {
	printf '[x] sparse solution overlay differs\nexpected: %s\nactual: %s\n' \
		"${expected_overlay[*]}" "${overlay[*]}" >&2; exit 1;
}
while IFS= read -r addition; do
	relative=${addition#"$HERE/additions/"}
	[[ ! -e $M00/solution/$relative &&
		! -e $M01/additions/$relative &&
		! -e $M01/solution-overlay/$relative ]] || {
		printf '[x] addition replaces inherited path: %s\n' "$relative" >&2
		exit 1
	}
	if [[ -e $HERE/solution-overlay/$relative ]] &&
		cmp -s "$addition" "$HERE/solution-overlay/$relative"; then
		printf '[x] solution overlay duplicates unchanged addition: %s\n' \
			"$relative" >&2
		exit 1
	fi
done < <(find "$HERE/additions" -type f | sort)

for script in test host-check success-check failure-check.in; do
	bash -n "$HERE/$script"
done
bash -n "$M01/success-check" "$M01/action-failure-check.in"
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check.in" \
		"$M01/success-check" "$M01/action-failure-check.in"
fi
make -s -C "$ROOT" -B vm/tools/getdents64_test vm/tools/event_stream_test \
	vm/tools/cred_trigger_test vm/tools/module_load_test vm/tools/status_field_test \
	vm/tools/proc_write_test vm/tools/proc_read_test vm/tools/rmdir_telemetry_test

compose_tree()
{
	local directory=$1
	mkdir -p "$directory"
	cp -a "$M00/solution/." "$directory/"
	cp -a "$M01/additions/." "$directory/"
	cp -a "$M01/solution-overlay/." "$directory/"
	cp -a "$HERE/additions/." "$directory/"
}

build_tree()
{
	local directory=$1 point=${2:-0}
	local log=$directory.log
	if ! make -s -C "$KDIR" M="$directory" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules >"$log" 2>&1; then
		cat "$log" >&2; printf '[x] build failed: %s\n' "${directory##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2; printf '[x] build warns: %s\n' "${directory##*/}" >&2
		exit 1
	fi
}

compose_tree "$scratch/starter"
build_tree "$scratch/starter"
if "$HERE/host-check" "$scratch/starter" \
		"$scratch/starter/rootkitlings.ko" >/dev/null 2>&1; then
	printf '[x] host checker accepted the unfinished cumulative starter\n' >&2
	exit 1
fi

build_variant()
{
	local name=$1 point=$2 directory
	directory=$scratch/$name
	compose_tree "$directory"
	cp -a "$HERE/solution-overlay/." "$directory/"
	build_tree "$directory" "$point"
}

build_variant success 0
for point in {1..11}; do build_variant "failure-$point" "$point"; done
"$HERE/host-check" "$scratch/success" "$scratch/success/rootkitlings.ko"

# A learner's valid M01 snapshot is the provider, not canonical M01 bytes.
compose_tree "$scratch/alternate-baseline"
printf '\n/* Equivalent inherited M01 implementation. */\n' >> \
	"$scratch/alternate-baseline/core/state.c"
cp -a "$HERE/solution-overlay/." "$scratch/alternate-baseline/"
build_tree "$scratch/alternate-baseline"
"$HERE/host-check" "$scratch/alternate-baseline" \
	"$scratch/alternate-baseline/rootkitlings.ko"

# Re-run M01's structural checks against the inherited source and built objects.
m01_view=$scratch/m01-view
mkdir -p "$m01_view"/{control,core,execution,include,instrumentation,interface,privilege}
for file in Kbuild include/rootkit.h core/main.c core/state.c interface/proc.c \
	execution/scheduler.c control/authorization.c privilege/credentials.c \
	instrumentation/return_probe.c instrumentation/events.c; do
	cp "$scratch/success/$file" "$m01_view/$file"
done
cp "$M00/solution/execution/worker.c" "$m01_view/execution/worker.c"
for object in rootkitlings.ko core/main.o core/state.o interface/proc.o \
	execution/worker.o execution/scheduler.o control/authorization.o \
	privilege/credentials.o instrumentation/return_probe.o \
	instrumentation/events.o; do
	cp "$scratch/success/$object" "$m01_view/$object"
done
"$M01/host-check" "$m01_view" "$m01_view/rootkitlings.ko"

changed_worker_loop=$scratch/changed-worker-loop
cp -a "$scratch/success" "$changed_worker_loop"
sed -i 's/"rkling_core"/"wrong_core"/' \
	"$changed_worker_loop/execution/worker.c"
build_tree "$changed_worker_loop"

changed_evidence_ops=$scratch/changed-evidence-ops
cp -a "$scratch/success" "$changed_evidence_ops"
sed -i 's/\.proc_lseek = seq_lseek/\.proc_lseek = noop_llseek/' \
	"$changed_evidence_ops/interface/evidence.c"
build_tree "$changed_evidence_ops"

compose_tree "$scratch/unknown"
cp -a "$HERE/solution-overlay/." "$scratch/unknown/"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 \
	ROOTKITLINGS_FAIL_POINT=99 modules >"$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure point compiled\n' >&2; exit 1
fi

run_guest()
{
	local check=$1 module=$2 output
	shift 2
	if ! output=$("$ROOT/vm/boot" --check "$check" --tool vm/tools/run_as \
		"$@" "$module" 2>&1); then
		printf '%s\n' "$output" >&2; exit 1
	fi
	printf '%s\n' "$output"
	grep -Fq '[+] PASSED' <<< "$output" || exit 1
}

reject_guest()
{
	local check=$1 module=$2 label=$3 output
	shift 3
	if output=$("$ROOT/vm/boot" --check "$check" --tool vm/tools/run_as \
		"$@" "$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] guest accepted mutant: %s\n' "$label" >&2
		exit 1
	fi
	printf '[+] rejected mutant: %s\n' "$label"
}

declare -a labels=(unused Preflight Allocation 'Control publication' Worker \
	'Authorization startup' 'Missing rmdir target' 'Events publication' \
	unused unused 'Missing iterate_dir target' 'Evidence publication')
declare -a errnos=(0 125 12 12 4 4 2 12 0 0 2 12)
for point in 1 2 3 4 5 6 7 10 11; do
	sed -e "s/@LABEL@/${labels[$point]}/g" \
		-e "s/@EXPECTED_ERRNO@/${errnos[$point]}/g" \
		-e "s/@EXPECT_ALLOCATION@/$((point >= 3 ? 1 : 0))/g" \
		"$HERE/failure-check.in" > "$scratch/check-$point"
	chmod 0755 "$scratch/check-$point"
	run_guest "$scratch/check-$point" \
		"$scratch/failure-$point/rootkitlings.ko" \
		--tool vm/tools/module_load_test
done
for specification in '8 12 Credential preparation' '9 125 Credential cancellation'; do
	read -r point expected label_rest <<< "$specification"
	sed -e "s/@LABEL@/$label_rest/g" -e "s/@EXPECTED_ERRNO@/$expected/g" \
		"$M01/action-failure-check.in" > "$scratch/action-$point"
	chmod 0755 "$scratch/action-$point"
	run_guest "$scratch/action-$point" \
		"$scratch/failure-$point/rootkitlings.ko" \
		--tool vm/tools/cred_trigger_test
done

run_guest "$HERE/success-check" "$scratch/success/rootkitlings.ko" \
	--tool vm/tools/getdents64_test --tool vm/tools/status_field_test \
	--tool vm/tools/proc_write_test --tool vm/tools/proc_read_test
reject_guest "$HERE/success-check" "$changed_worker_loop/rootkitlings.ko" \
	changed-worker-loop --tool vm/tools/getdents64_test \
	--tool vm/tools/status_field_test --tool vm/tools/proc_write_test \
	--tool vm/tools/proc_read_test
reject_guest "$HERE/success-check" "$changed_evidence_ops/rootkitlings.ko" \
	changed-evidence-ops --tool vm/tools/getdents64_test \
	--tool vm/tools/status_field_test --tool vm/tools/proc_write_test \
	--tool vm/tools/proc_read_test
run_guest "$M01/success-check" "$scratch/success/rootkitlings.ko" \
	--tool vm/tools/event_stream_test --tool vm/tools/status_field_test \
	--tool vm/tools/proc_write_test --tool vm/tools/proc_read_test \
	--tool vm/tools/cred_trigger_test --tool vm/tools/rmdir_telemetry_test

printf '[+] omit the resident worker and map the affected view milestone passed\n'
