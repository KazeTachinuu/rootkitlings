#!/bin/sh
# shellcheck source=/dev/null
. /lib/check.sh

begin "Record authorized actions and rmdir results"

control=/proc/rootkitlings
events=/proc/rootkitlings_events
selected=/tmp/rootkitlings-rmdir-watch
fixtures=/tmp/rootkitlings-m01
mkdir -p "$fixtures/root"
chmod 0755 "$fixtures" "$fixtures/root"
: > "$fixtures/empty"
printf enable > "$fixtures/enable"
printf 'enable\n' > "$fixtures/enable-lf"
printf disable > "$fixtures/disable"
printf 'disable\n' > "$fixtures/disable-lf"
printf run > "$fixtures/run"
printf 'run\n' > "$fixtures/run-lf"
printf '\n' > "$fixtures/lone-lf"
printf 'ena\nble' > "$fixtures/interior-lf"
printf 'enable\n\n' > "$fixtures/double-lf"
printf 'run\000' > "$fixtures/run-nul"
printf ru > "$fixtures/run-prefix"
printf runner > "$fixtures/run-suffix"
printf xrun > "$fixtures/run-prefixed"
printf root > "$fixtures/root-only"
printf 'root ' > "$fixtures/root-space"
printf 00000000000000000000000000000000 > "$fixtures/token-only"
printf 'root 0000000000000000000000000000000' > "$fixtures/root-short"
printf 'root 000000000000000000000000000000000' > "$fixtures/root-long"
printf 'root AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' > "$fixtures/root-uppercase"
printf 'root 0000000000000000000000000000000g' > "$fixtures/root-nonhex"
printf ' root 00000000000000000000000000000000' > "$fixtures/root-leading-space"
printf 'root  00000000000000000000000000000000' > "$fixtures/root-double-space"
printf 'root 0x000000000000000000000000000000' > "$fixtures/root-prefix"
printf 'root 00000000000000000000000000000000 ' > "$fixtures/root-trailing-space"
printf 'root 00000000000000000000000000000000\r\n' > "$fixtures/root-crlf"
printf 'root 00000000000000000000000000000000\n\n' > "$fixtures/root-double-lf"
printf 'root 000000000000000\0000000000000000' > "$fixtures/root-nul"
printf 'root 0000000000000000000000000000000000' > "$fixtures/root-oversized"
registry=/sys/kernel/debug/kprobes/list

probe_count()
{
	awk '$2 == "r" { split($3,n,"+"); if (n[1] == "__x64_sys_rmdir") c++ }
		END { print c + 0 }' "$registry"
}

assert_status_shape()
{
	cat "$control" > "$fixtures/status"
	if awk '
		NR==1 { ok=$0=="active=1" }
		NR==2 { ok=ok && $0~/^actions=(enabled|disabled)$/ }
		NR==3 { ok=ok && $0~/^timer_fires=[0-9]+$/ }
		NR==4 { ok=ok && $0~/^worker_runs=[0-9]+$/ }
		NR==5 { ok=ok && $0~/^reader_tid=[1-9][0-9]*$/ }
		NR==6 { ok=ok && $0~/^reader_comm="([^"\\]|\\.)*"$/ }
		NR==7 { ok=ok && $0~/^uids=[0-9]+ [0-9]+ [0-9]+ [0-9]+$/ }
		NR==8 { ok=ok && $0~/^gids=[0-9]+ [0-9]+ [0-9]+ [0-9]+$/ }
		NR==9 { ok=ok && $0~/^cap_userns=(initial|nested)$/ }
		NR==10 { ok=ok && $0~/^cap_permitted=[0-9a-f]{16}$/ }
		NR==11 { ok=ok && $0~/^cap_effective=[0-9a-f]{16}$/ }
		NR==12 { ok=ok && $0~/^completed_actions=[0-9]+$/ }
		NR==13 { ok=ok && $0~/^token=[0-9a-f]{32}$/ && $0!="token=00000000000000000000000000000000" }
		END { exit !(ok && NR==13) }' "$fixtures/status"; then
		_ok "$1 returns the exact cumulative status record"
	else
		_fail "$1 returned malformed cumulative status"
	fi
}

read_token()
{
	sed -n 's/^token=//p' "$control"
}

assert_control_unchanged()
{
	expected_token=$1
	expected_events=$2
	label=$3
	actual_token=$(read_token)
	actual_retained=$(sed -n 's/^retained=//p' "$events")
	actual_overwritten=$(sed -n 's/^overwritten=//p' "$events")
	if test "$actual_token" = "$expected_token" &&
	   test "$actual_retained:$actual_overwritten" = "$expected_events"; then
		_ok "$label preserves authorization and event state"
	else
		_fail "$label changed authorization or event state"
	fi
}

expect_rejected_write()
{
	fixture=$1
	errno=$2
	label=$3
	token_before=$(read_token)
	events_before=$(sed -n 's/^retained=//p' "$events"):$(
		sed -n 's/^overwritten=//p' "$events")
	if chpst -u 65534:65534 proc_write_test errno "$control" \
		"$fixtures/$fixture" "$errno" >/dev/null; then
		_ok "$label returns errno $errno"
	else
		_fail "$label returned the wrong error"
	fi
	assert_control_unchanged "$token_before" "$events_before" "$label"
}

settle_worker_runs()
{
	settle_attempt=1
	while test "$settle_attempt" -le 3; do
		settled_runs=$(status_field_test read "$control" worker_runs)
		if status_field_test unchanged "$control" worker_runs \
			"$settled_runs" 300 >/dev/null 2>&1; then
			return 0
		fi
		settle_attempt=$((settle_attempt + 1))
	done
	return 1
}

cleanup()
{
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	rm -rf "$fixtures" "$selected" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

assert_empty_ring()
{
	if cat "$events" > "$fixtures/events" &&
	   cmp -s "$fixtures/events" "$fixtures/empty-events"; then
		_ok "$1 has an empty event ring"
	else
		_fail "$1 did not reset the event ring"
	fi
}

assert_ring()
{
	retained=$1
	overwrite_count=$2
	first=$3
	last=$4
	label=$5
	if cat "$events" > "$fixtures/events" && awk \
		-v retained="$retained" -v overwritten="$overwrite_count" \
		-v first="$first" -v last="$last" '
		NR == 1 { good = $0 == "event_capacity=16" }
		NR == 2 { good = good && $0 == "retained=" retained }
		NR == 3 { good = good && $0 == "overwritten=" overwritten }
		NR == 4 { good = good && $0 == "return_capacity=16" }
		NR == 5 { good = good && $0 ~ /^returns_missed=[0-9]+$/ }
		NR > 5 {
			if ($1 !~ /^sequence=[0-9]+$/) good = 0
			split($1, value, "=")
			if (value[2] != first + NR - 6) good = 0
			if ($2 != "kind=rmdir" && $2 != "kind=credential-change") good = 0
			if ($3 !~ /^tid=[1-9][0-9]*$/) good = 0
			if ($2 == "kind=rmdir" && $4 !~ /^result=(success|failure)$/) good = 0
			if ($2 == "kind=credential-change" && NF != 3) good = 0
		}
		END { exit !(good && NR == retained + 5 &&
			(retained == 0 || first + retained - 1 == last)) }
	' "$fixtures/events"; then
		_ok "$label retains the expected contiguous sequence window"
	else
		_fail "$label returned a malformed ring snapshot"
		cat "$fixtures/events" >&2
	fi
}

printf 'event_capacity=16\nretained=0\noverwritten=0\nreturn_capacity=16\nreturns_missed=0\n' \
	> "$fixtures/empty-events"

load rootkitlings.ko
assert_loaded rootkitlings
assert_exists "$control"
assert_exists "$events"
if test "$(stat -c '%a:%u:%g' "$control")" = 622:0:0 &&
	   test "$(stat -c '%a:%u:%g' "$events")" = 400:0:0; then
	_ok "control and observation endpoints have distinct access modes"
else
	_fail "procfs endpoint ownership or mode is wrong"
fi
assert_empty_ring "initial load"
assert_status_shape "initial load"
if chpst -u 65534:65534 cat "$control" >/dev/null 2>&1; then
	_fail "an unprivileged task read the bearer token"
else
	_ok "an unprivileged task cannot read the bearer token"
fi
probe_before=$(( $(probe_count) - 1 ))
if test "$(probe_count)" -eq $((probe_before + 1)); then
	_ok "load registers one rmdir return probe"
else
	_fail "return probe registry delta is wrong"
fi
initial_runs=$(sed -n 's/^worker_runs=//p' "$control")
initial_fires=$(sed -n 's/^timer_fires=//p' "$control")
expect_rejected_write run 13 "disabled run"
expect_rejected_write run-lf 13 "disabled newline-terminated run"
disabled_token=$(read_token)
printf 'root %s' "$disabled_token" > "$fixtures/root-current"
expect_rejected_write root-current 13 "disabled current token"
if status_field_test advance "$control" timer_fires "$initial_fires" 1200 >/dev/null &&
	status_field_test unchanged "$control" worker_runs "$initial_runs" 200 >/dev/null; then
	_ok "disabled timer fires without completing worker work"
else
	_fail "disabled timer or worker accounting is wrong"
fi
mkdir "$selected"
rmdir "$selected" || _fail "disabled selected rmdir changed a successful call"
rmdir "$selected" 2>/dev/null || true
assert_empty_ring "disabled selected rmdir"
for malformed in empty lone-lf interior-lf double-lf run-nul run-prefix \
	run-suffix run-prefixed root-only root-space token-only root-short \
	root-long root-uppercase root-nonhex root-leading-space root-double-space \
	root-prefix root-trailing-space root-crlf root-double-lf root-nul \
	root-oversized; do
	expect_rejected_write "$malformed" 22 "$malformed command"
done
if proc_write_test fault "$control" "$fixtures/root-current" 14 >/dev/null; then
	_ok "partial user copy returns EFAULT"
else
	_fail "partial user copy returned the wrong error"
fi
assert_control_unchanged "$disabled_token" 0:0 "partial user copy"
if proc_write_test fault "$control" "$fixtures/root-oversized" 22 >/dev/null; then
	_ok "oversized input is rejected before user access"
else
	_fail "oversized input touched userspace"
fi
assert_control_unchanged "$disabled_token" 0:0 "oversized input"
if proc_write_test offset "$control" "$fixtures/root-current" 1 22 >/dev/null; then
	_ok "nonzero write offset returns EINVAL"
else
	_fail "nonzero write offset returned the wrong error"
fi
assert_control_unchanged "$disabled_token" 0:0 "nonzero write offset"
if chpst -u 65534:65534 proc_write_test write "$control" \
	"$fixtures/enable-lf" >/dev/null; then
	_ok "unprivileged newline-terminated enable succeeds"
else
	_fail "unprivileged newline-terminated enable failed"
fi
if chpst -u 65534:65534 proc_write_test write "$control" \
	"$fixtures/disable-lf" >/dev/null; then
	_ok "unprivileged newline-terminated disable succeeds"
else
	_fail "unprivileged newline-terminated disable failed"
fi
assert_control_unchanged "$disabled_token" 0:0 "switch round trip"
printf enable > "$control"
mkdir /tmp/rootkitlings-rmdir-watch-extra
rmdir /tmp/rootkitlings-rmdir-watch-extra
if rmdir /tmp/rootkitlings-rmdir-other 2>/dev/null; then
	_fail "unrelated missing path unexpectedly succeeded"
else
	_ok "unrelated path keeps its normal failure result"
fi
rmdir_telemetry_test invalid || _fail "invalid pointer handling failed"
rmdir_telemetry_test boundary || _fail "unterminated boundary handling failed"
assert_empty_ring "unmatched and invalid paths"
if event_stream_test snapshot "$events"; then
	_ok "first read, buffered EOF, and rewind follow seq_file snapshot semantics"
else
	_fail "event snapshot semantics are incorrect"
fi
assert_ring 3 0 1 3 "snapshot exercise"
cat "$events" > "$fixtures/held-events"
if proc_read_test "$events" "$fixtures/held-events" rootkitlings; then
	_ok "a held events descriptor is safe across unload"
else
	_fail "held events descriptor teardown failed"
fi
assert_absent "$control"
assert_absent "$events"
if test "$(probe_count)" -eq "$probe_before"; then
	_ok "unload removes the return probe"
else
	_fail "unload left the return probe registered"
fi

load rootkitlings.ko
assert_empty_ring "immediate reload"
assert_status_shape "immediate reload"
printf enable > "$control"
token=$(sed -n 's/^token=//p' "$control")
wrong=00000000000000000000000000000000
if test "$wrong" = "$token"; then
	wrong=11111111111111111111111111111111
fi
if chpst -u 65534:65534 cred_trigger_test token-unchanged "$control" \
	"$wrong" 13 >/dev/null; then
	_ok "a well-formed wrong token returns EACCES"
else
	_fail "wrong-token handling changed its caller or returned the wrong error"
fi
assert_control_unchanged "$token" 0:0 "wrong token"
if event_stream_test credential-race "$control" "$events" "$token"; then
	_ok "one raced token changes its writer and records that writer's TID"
else
	_fail "credential race admission or TID attribution is wrong"
fi
assert_ring 1 0 1 1 "one authorized action"
replacement=$(read_token)
if test "$replacement" != "$token"; then
	_ok "the successful action rotates its token"
else
	_fail "the successful action retained its token"
fi
if chpst -u 65534:65534 cred_trigger_test token-unchanged "$control" \
	"$token" 13 >/dev/null; then
	_ok "the consumed token is rejected as stale"
else
	_fail "stale-token replay handling is incorrect"
fi
assert_control_unchanged "$replacement" 1:0 "stale token replay"

i=1
while test "$i" -le 14; do
	rmdir "$selected" 2>/dev/null || true
	i=$((i + 1))
done
assert_ring 15 0 1 15 "fifteen events"
rmdir "$selected" 2>/dev/null || true
assert_ring 16 0 1 16 "full ring"
rmdir "$selected" 2>/dev/null || true
assert_ring 16 1 2 17 "first overwrite"
i=1
while test "$i" -le 16; do
	rmdir "$selected" 2>/dev/null || true
	i=$((i + 1))
done
assert_ring 16 17 18 33 "more than twice capacity"

token=$(read_token)
if chpst -u 65534:65534 cred_trigger_test token-thread-scope "$control" \
	"$token" >/dev/null; then
	_ok "an authorized action changes its writer but not an existing sibling"
else
	_fail "credential replacement escaped the writing thread"
fi
assert_ring 16 18 19 34 "thread-scoped authorized action"
token=$(read_token)
if chpst -u 65534:65534 cred_trigger_test token-replace "$control" \
	"$token" "$fixtures/root" >/dev/null; then
	_ok "a final newline authorizes one same-caller credential change"
else
	_fail "newline-terminated credential action failed"
fi
assert_ring 16 19 20 35 "newline-terminated authorized action"

token=$(sed -n 's/^token=//p' "$control")
event_stream_test credential-race "$control" "$events" "$token" &
race_pid=$!
i=1
mixed_pids=
while test "$i" -le 8; do
	(rmdir "$selected" 2>/dev/null || true) &
	mixed_pids="$mixed_pids $!"
	i=$((i + 1))
done
mixed_ok=1
wait "$race_pid" || mixed_ok=0
for pid in $mixed_pids; do
	wait "$pid" || mixed_ok=0
done
if test "$mixed_ok" -eq 1; then
	_ok "credential and Kretprobe producers completed concurrently"
else
	_fail "a mixed producer failed"
fi
assert_ring 16 28 29 44 "mixed concurrent producers"
if grep -q 'kind=credential-change' "$fixtures/events" &&
	   grep -q 'kind=rmdir' "$fixtures/events"; then
	_ok "the retained mixed window contains both typed event kinds"
else
	_fail "the mixed window lost a producer kind"
fi

if test "$(sed -n 's/^returns_missed=//p' "$events")" = 0; then
	_ok "bounded workload misses no return instances"
else
	_fail "Kretprobe reports missed returns"
fi
if rmdir_telemetry_test concurrent; then
	_ok "selected and unrelated concurrent rmdir calls keep their results"
else
	_fail "concurrent rmdir return correlation failed"
fi
assert_ring 16 92 93 108 "concurrent return correlation"
if test "$(sed -n 's/^returns_missed=//p' "$events")" = 0; then
	_ok "the concurrent return workload fits the instance pool"
else
	_fail "the concurrent return workload missed an instance"
fi

printf disable > "$control"
if settle_worker_runs; then
	_ok "worker activity settles while actions are disabled"
else
	_fail "worker activity did not settle"
fi
before_runs=$settled_runs
before_fires=$(status_field_test read "$control" timer_fires)
printf enable > "$control"
pids=
writer=1
while test "$writer" -le 4; do
	(
		i=0
		while test "$i" -lt 64; do
			proc_write_test outcome "$control" "$fixtures/run" || exit 1
			i=$((i + 1))
		done
	) > "$fixtures/run-outcomes-$writer" &
	pids="$pids $!"
	writer=$((writer + 1))
done
writers_ok=1
for pid in $pids; do
	wait "$pid" || writers_ok=0
done
if test "$writers_ok" -eq 1 &&
	! grep -h -Ev '^(ok|11)$' "$fixtures"/run-outcomes-* \
		> "$fixtures/bad-run-outcomes"; then
	_ok "concurrent run requests return only success or EAGAIN"
else
	_fail "a concurrent run request returned an invalid outcome"
fi
ok_count=0
again_count=0
for outcome_file in "$fixtures"/run-outcomes-*; do
	count=$(grep -c '^ok$' "$outcome_file" 2>/dev/null || true)
	ok_count=$((ok_count + count))
	count=$(grep -c '^11$' "$outcome_file" 2>/dev/null || true)
	again_count=$((again_count + count))
done
if test $((ok_count + again_count)) -eq 256 &&
	   test "$ok_count" -gt 0 && test "$again_count" -gt 0; then
	_ok "the shared capacity-one slot admits work and returns EAGAIN when full"
else
	_fail "capacity-one outcomes: success=$ok_count EAGAIN=$again_count"
fi
printf disable > "$control"
if settle_worker_runs; then
	after_runs=$settled_runs
	after_fires=$(status_field_test read "$control" timer_fires)
	worker_delta=$((after_runs - before_runs))
	timer_delta=$((after_fires - before_fires))
	maximum=$((ok_count + timer_delta))
	if test "$worker_delta" -ge 0 && test "$worker_delta" -le "$maximum"; then
		_ok "only admitted worker requests can increment worker_runs"
	else
		_fail "worker delta $worker_delta exceeds $maximum admitted requests"
	fi
else
	_fail "worker activity did not settle after concurrent requests"
fi
expect_rejected_write run 13 "run after disable"

rmdir_telemetry_test stress 2 &
stress_pid=$!
if proc_write_test unload "$control" "$fixtures/run" rootkitlings >/dev/null; then
	_ok "a held control descriptor rejects work after unload"
else
	_fail "held control descriptor teardown failed"
fi
if wait "$stress_pid"; then
	_ok "rmdir workload remains valid across unload"
else
	_fail "rmdir workload failed across unload"
fi
assert_absent "$control"
assert_absent "$events"
load rootkitlings.ko
assert_empty_ring "second reload"
if test "$(sed -n 's/^completed_actions=//p' "$control")" = 0 &&
	   test "$(sed -n 's/^worker_runs=//p' "$control")" = 0; then
	_ok "action counters reset on reload"
else
	_fail "an action counter survived reload"
fi
printf enable > "$control"
rmdir "$selected" 2>/dev/null || true
assert_ring 1 0 1 1 "post-reload first event"
unload rootkitlings

summary
