#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR MODULE"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
module=$(realpath -e -- "$2" 2>/dev/null) || die "module not found: $2"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r16-host.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ -f $module && ! -L $module ]] || die "module must be a regular file"
for relative in Kbuild core/main.c core/state.c include/rootkit.h \
	include/dirent_filter.h instrumentation/probes.c \
	instrumentation/getdents_probe.c interface/proc.c interface/hidden_proc.c; do
	[[ -f $build_dir/$relative && ! -L $build_dir/$relative ]] ||
		die "build is missing supplied file: $relative"
done

source=$build_dir/instrumentation/dirent_filter.c
object=$build_dir/instrumentation/dirent_filter.o
[[ -f $source && ! -L $source ]] || die "learner filter source is missing"
[[ -f $object && ! -L $object ]] || die "learner filter object is missing"

gcc -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined \
	-fno-omit-frame-pointer \
	-I "$here/fixtures/host/include" -I "$build_dir/include" \
	"$source" "$here/fixtures/host/filter_test.c" -o "$scratch/filter-test"
ASAN_OPTIONS=detect_leaks=1 "$scratch/filter-test"

undefined=$(nm -u "$object" | awk '{ print $NF }')
while read -r symbol; do
	[[ -n $symbol ]] || continue
	case $symbol in
		__fentry__|__ref_stack_chk_guard|__stack_chk_fail|__x86_return_thunk|\
		memchr|memcmp|memcpy|memmove|strlen) ;;
		*) die "pure filter has forbidden dependency: $symbol" ;;
	esac
done <<< "$undefined"

if grep -Eq '\b(kmalloc|kzalloc|kfree|copy_(from|to)_user|fdget|register_kretprobe|READ_ONCE|WRITE_ONCE)[[:space:]]*\(' \
	"$source"; then
	die "the learner helper must stay pure"
fi
if grep -Eq '(strncmp|strncasecmp|strcasecmp|strstr)[[:space:]]*\(' "$source"; then
	die "the target comparison must use exact length and bytes"
fi

for symbol in register_kprobe unregister_kprobe register_kretprobe \
	unregister_kretprobe copy_from_user_nofault copy_to_user_nofault kfree; do
	grep -Fxq "$symbol" < <(nm -u "$build_dir/instrumentation/getdents_probe.o" |
		awk '{ print $NF }') || die "getdents integration lacks $symbol"
done
nm -u "$build_dir/instrumentation/getdents_probe.o" |
	grep -Eq '[[:space:]](__kmalloc_noprof|kmalloc)$' ||
	die "getdents integration lacks bounded scratch allocation"
[[ $(strings "$module" | grep -Fxc 'iterate_dir') -eq 1 ]] ||
	die "module must contain one iterate_dir target identity"
[[ $(strings "$module" | grep -Fxc 'filldir64') -eq 1 ]] ||
	die "module must contain one native filldir64 identity"
grep -Fxq 'rootkitlings_hidden' < <(strings "$module") ||
	die "module lacks the controlled directory target"

printf '[+] pure filter, supplied integration, and sanitizer corpus verified\n'
