#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Publication rollback"

kmem_trace_setup

cleanup()
{
	kmem_trace_disable
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	kmem_trace_restore
}
trap cleanup EXIT INT TERM

check_attempt()
{
	attempt=$1
	kmem_trace_start

	if module_load_test /rootkitlings/rootkitlings.ko 12; then
		_ok "attempt $attempt returned numeric ENOMEM"
	else
		_fail "attempt $attempt did not return ENOMEM"
	fi

	kmem_trace_stop

	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi

	assert_one_loader_allocation_freed \
		"attempt $attempt freed module state during rollback"
}

check_attempt 1
check_attempt 2

summary
