#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Preflight rejection"

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

assert_not_loaded
for attempt in 1 2; do
	if module_load_test /rootkitlings/rootkitlings.ko 125; then
		_ok "attempt $attempt returned numeric ECANCELED"
	else
		_fail "attempt $attempt did not return ECANCELED"
	fi
	assert_not_loaded
done

summary
