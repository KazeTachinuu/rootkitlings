#!/usr/bin/env python3
"""Validate the R01 lab contract, then probe the isolated guest."""

from __future__ import annotations

from pathlib import Path
import subprocess
import sys
import tomllib


HERE = Path(__file__).resolve().parent
ROOT = next(parent for parent in HERE.parents if (parent / "course.toml").is_file())
REQUIRED_TEXT = (
    "lab_id", "owner", "authorization_reference", "permitted_guest",
    "cleanup_evidence",
)
EXPECTED_CONTAINMENT = {
    "disposable": True,
    "network": "none",
    "host_filesystem": "not-mounted",
    "production_data": False,
}


def reject(message: str) -> None:
    raise SystemExit(f"[x] {message}")


def main() -> int:
    if len(sys.argv) != 2:
        reject(f"usage: {Path(sys.argv[0]).name} LAB_MANIFEST")
    manifest = Path(sys.argv[1])
    if not manifest.is_file() or manifest.is_symlink():
        reject(f"manifest is not a regular file: {manifest}")
    try:
        data = tomllib.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, tomllib.TOMLDecodeError) as exc:
        reject(f"cannot read manifest: {exc}")
    expected = {*REQUIRED_TEXT, "schema_version", "prohibited_targets", "stop_conditions", "containment"}
    if set(data) != expected:
        reject(f"manifest fields differ: expected {sorted(expected)}")
    if data["schema_version"] != 1 or isinstance(data["schema_version"], bool):
        reject("schema_version must be integer 1")
    for field in REQUIRED_TEXT:
        value = data[field]
        if not isinstance(value, str) or not value.strip() or "TODO" in value.upper():
            reject(f"complete {field} without placeholder text")
    for field in ("prohibited_targets", "stop_conditions"):
        values = data[field]
        if not isinstance(values, list) or len(values) < 2 or any(
            not isinstance(value, str) or not value.strip() or "TODO" in value.upper()
            for value in values
        ):
            reject(f"{field} must contain at least two completed entries")
    if data["containment"] != EXPECTED_CONTAINMENT:
        reject(f"containment must remain exactly {EXPECTED_CONTAINMENT}")
    print("[+] manifest declares authorization, stop conditions, and cleanup evidence", flush=True)
    command = [str(ROOT / "vm/boot"), "--check", str(HERE / "guest-check")]
    try:
        completed = subprocess.run(command, cwd=ROOT, timeout=45, check=False)
    except subprocess.TimeoutExpired:
        reject("isolated guest did not stop within 45 seconds")
    if completed.returncode:
        reject(f"isolated guest check failed with status {completed.returncode}")
    print("[+] disposable guest stopped; temporary guest state was removed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
