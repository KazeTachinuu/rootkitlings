#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 1 )) || die "usage: ${0##*/} WORKER_SOURCE"
source_path=$(realpath -e -- "$1" 2>/dev/null) || die "worker source not found: $1"
[[ -f $source_path && ! -L $source_path ]] || die "worker source must be a regular file"

for tool in cc timeout; do
	command -v "$tool" >/dev/null || die "$tool is required"
done

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
fixture=$here/../fixtures/worker
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-worker-check.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

build_and_run()
{
	local name=$1 fail_point=$2 executable
	executable=$scratch/$name
	cc -std=gnu11 -Wall -Wextra -Werror -Wno-unused-function -Wno-unused-parameter \
		-I"$fixture/include" \
		-DROOTKITLINGS_FAIL_POINT="$fail_point" \
		-DWORKER_SOURCE="\"$source_path\"" \
		"$fixture/worker_harness.c" -o "$executable"
	timeout 5 "$executable"
}

build_and_run normal 0
build_and_run failed-start 4

printf '[+] capacity-one worker behavior passed the deterministic host harness\n'
