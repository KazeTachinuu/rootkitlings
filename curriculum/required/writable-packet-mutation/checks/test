#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../../scripts/lesson-env"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-r22-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || {
	printf '[x] this lesson requires x86_64\n' >&2
	exit 1
}
for option in NET INET NETFILTER PROC_FS; do
	grep -qx "CONFIG_$option=y" "$KDIR/.config" || {
		printf '[x] this lesson requires CONFIG_%s=y\n' "$option" >&2
		exit 1
	}
done
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || {
	printf '[x] pinned kernel build is not configured for GCC\n' >&2
	exit 1
}
for command in gcc make nm perl; do
	command -v "$command" >/dev/null || {
		printf '[x] %s is required\n' "$command" >&2
		exit 1
	}
done

for script in test host-check success-check failure-check.in; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check.in"
fi

mapfile -t changed_files < <(
	cd "$HERE/../solution"
	find . -type f -printf '%P\n' | sort
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner-edited file, found %d\n' \
		"${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == mutation/udp_redirect.c ]] || {
	printf '[x] learner edit surface is %s, expected mutation/udp_redirect.c\n' \
		"${changed_files[0]}" >&2
	exit 1
}

build_tree()
{
	local source=$1 destination=$2 point=${3:-0}
	local log=$destination.log
	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 \
		ROOTKITLINGS_FAIL_POINT="$point" modules > "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] %s build failed\n' "${source##*/}" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] %s build has warnings\n' "${source##*/}" >&2
		exit 1
	fi
}

starter=$scratch/starter-source
solution=$scratch/solution-source
cp -a "$HERE/../../validated-packet-classification/solution" "$starter"
cp -a "$HERE/../starter/." "$starter/"
cp -a "$starter" "$solution"
cp -a "$HERE/../solution/." "$solution/"

build_tree "$starter" "$scratch/starter"
build_tree "$solution" "$scratch/solution"
build_tree "$solution" "$scratch/register-failure" 1
build_tree "$solution" "$scratch/proc-failure" 2
"$HERE/host-check" "$scratch/solution" \
	"$scratch/solution/rootkitlings.ko"

if "$HERE/host-check" "$scratch/starter" \
	"$scratch/starter/rootkitlings.ko" > "$scratch/template-host.log" 2>&1; then
	printf '[x] host checker accepted the unfinished mutator\n' >&2
	exit 1
fi

build_mutant()
{
	local name=$1 expression=$2 replacement=$3
	cp -a "$solution" "$scratch/$name"
	perl -0pi -e "s~$expression~$replacement~" \
		"$scratch/$name/mutation/udp_redirect.c"
	if cmp -s "$solution/mutation/udp_redirect.c" \
		"$scratch/$name/mutation/udp_redirect.c"; then
		printf '[x] mutant transformation did not apply: %s\n' "$name" >&2
		exit 1
	fi
	local log=$scratch/$name.log
	if ! make -s -C "$KDIR" M="$scratch/$name" W=1 modules \
		> "$log" 2>&1; then
		cat "$log" >&2
		printf '[x] mutant did not compile: %s\n' "$name" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		printf '[x] mutant build has warnings: %s\n' "$name" >&2
		exit 1
	fi
	if "$HERE/host-check" "$scratch/$name" \
		"$scratch/$name/rootkitlings.ko" > \
		"$scratch/$name-host.log" 2>&1; then
		printf '[x] host checker accepted mutant: %s\n' "$name" >&2
		exit 1
	fi
}

build_mutant skip-writable \
	'if \(rk_skb_make_writable\(skb, writable_length\)\)' \
	'if (false && rk_skb_make_writable(skb, writable_length))'
build_mutant synthesize-partial-zero \
	'if \(udp->check\) \{' \
	'if (udp->check || skb->ip_summed == CHECKSUM_PARTIAL) {'
build_mutant preserve-complete \
	'skb_checksum_complete_unset\(skb\);' '(void)skb;'
build_mutant trust-stale-source \
	'udp->source != before.source \|\| udp->dest != before.dest \|\|\n\t    udp->len != before.len \|\| ntohs\(udp->source\) != view->source_port \|\|' \
	'udp->dest != before.dest ||\n\t    udp->len != before.len ||'
build_mutant trust-stale-length \
	'udp->len != before.len \|\| ntohs\(udp->source\) != view->source_port \|\|\n\t    ntohs\(udp->dest\) != view->destination_port \|\|\n\t    ntohs\(udp->len\) != view->datagram_length' \
	'ntohs(udp->source) != view->source_port ||\n\t    ntohs(udp->dest) != view->destination_port'
build_mutant keep-hash \
	'skb_clear_hash\(skb\);' '(void)skb;'
build_mutant accept-conntrack \
	'if \(skb_nfct\(skb\) \|\| secpath_exists\(skb\)\)' \
	'if (false && (skb_nfct(skb) || secpath_exists(skb)))'
build_mutant omit-datagram-width \
	' \|\|\n\t    view->datagram_length > UINT_MAX' ''
build_mutant omit-int-offset-bound \
	'udp_offset > INT_MAX \|\| ' ''
build_mutant short-writable-prefix \
	'writable_length = udp_offset \+ sizeof\(struct udphdr\);' \
	'writable_length = udp_offset + sizeof(struct udphdr) - 1;'
build_mutant accept-xfrm \
	'secpath_exists\(skb\)' 'false'
build_mutant accept-incoherent-gso \
	'if \(skb_is_gso\(skb\) && skb->ip_summed != CHECKSUM_PARTIAL\)' \
	'if (false && skb_is_gso(skb))'
build_mutant wrong-checksum-domain \
	'replacement, false\);' 'replacement, true);'
build_mutant omit-mangled-zero \
	'if \(!udp->check\)\n\t\t\tudp->check = CSUM_MANGLED_0;' \
	'if (!udp->check)\n\t\t\t(void)udp;'
build_mutant trust-stale-destination \
	'udp->dest != before.dest \|\|\n\t    udp->len != before.len \|\| ntohs\(udp->source\) != view->source_port \|\|\n\t    ntohs\(udp->dest\) != view->destination_port \|\|' \
	'udp->len != before.len || ntohs(udp->source) != view->source_port ||'

equivalent=$scratch/equivalent
cp -a "$solution" "$equivalent"
perl -0pi -e 's~if \(udp->check\) \{\n(.*?)\n\t\} else \{\n\t\tskb_checksum_complete_unset\(skb\);\n\t\}~if (!udp->check) {\n\t\tskb_checksum_complete_unset(skb);\n\t} else {\n$1\n\t}~s' \
	"$equivalent/mutation/udp_redirect.c"
perl -0pi -e 's~if \(udp->source != before.source \|\| udp->dest != before.dest \|\|\n\t    udp->len != before.len \|\|~if (__builtin_memcmp(udp, \&before, offsetof(struct udphdr, check)) ||~' \
	"$equivalent/mutation/udp_redirect.c"
build_tree "$equivalent" "$scratch/equivalent-build"
"$HERE/host-check" "$scratch/equivalent-build" \
	"$scratch/equivalent-build/rootkitlings.ko"

cp -a "$solution" "$scratch/unknown"
if make -s -C "$KDIR" M="$scratch/unknown" W=1 \
	ROOTKITLINGS_FAIL_POINT=99 modules > "$scratch/unknown.log" 2>&1; then
	printf '[x] unknown failure-point value compiled successfully\n' >&2
	exit 1
fi

sed -e 's/@EXPECTED_ERRNO@/22/g' \
	-e 's/@LABEL@/Unfinished mutator rejection/g' \
	"$HERE/failure-check.in" > "$scratch/template-failure-check"
sed -e 's/@EXPECTED_ERRNO@/97/g' \
	-e 's/@LABEL@/Netfilter registration failure rollback/g' \
	"$HERE/failure-check.in" > "$scratch/register-failure-check"
sed -e 's/@EXPECTED_ERRNO@/12/g' \
	-e 's/@LABEL@/Proc publication failure rollback/g' \
	"$HERE/failure-check.in" > "$scratch/proc-failure-check"
chmod 0755 "$scratch/"*failure-check

run_guest()
{
	local check_script=$1 module=$2 label=$3 output
	shift 3
	if ! output=$("$HERE/../../../../vm/boot" --check "$check_script" \
		"$@" "$module" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] disposable guest rejected %s\n' "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
	grep -Fq '[+] PASSED' <<< "$output" || {
		printf '[x] guest did not pass %s\n' "$label" >&2
		exit 1
	}
}

run_guest "$HERE/success-check" "$scratch/solution/rootkitlings.ko" \
	solution --tool vm/tools/proc_read_test --tool vm/tools/packet_mutation_test
run_guest "$scratch/template-failure-check" \
	"$scratch/starter/rootkitlings.ko" template --tool vm/tools/module_load_test
run_guest "$scratch/register-failure-check" \
	"$scratch/register-failure/rootkitlings.ko" registration-failure \
	--tool vm/tools/module_load_test
run_guest "$scratch/proc-failure-check" \
	"$scratch/proc-failure/rootkitlings.ko" proc-failure \
	--tool vm/tools/module_load_test

printf '[+] R22 writable packet mutation passed\n'
