#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Bounded DNS wire name"

assert_absent /sys/module/rootkitlings
attempt=1
while [ "$attempt" -le 2 ]; do
	load rootkitlings.ko
	assert_loaded rootkitlings
	if dmesg | grep -q 'rootkitlings: dns name codec self-tests passed: 1183 assertions'; then
		_ok "kernel self-test completion is recorded"
	else
		_fail "kernel self-test completion is missing"
	fi
	unload rootkitlings
	assert_absent /sys/module/rootkitlings
	attempt=$((attempt + 1))
done

summary
