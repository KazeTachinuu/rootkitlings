#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

begin "Worker creation failure"

kmem_trace_setup

cleanup()
{
	kmem_trace_disable
	if test -d /sys/module/rootkitlings; then
		rmmod rootkitlings 2>/dev/null || true
	fi
	kmem_trace_restore
}
trap cleanup EXIT INT TERM

worker_count()
{
	count=0
	for comm in /proc/[0-9]*/comm; do
		[ -r "$comm" ] || continue
		[ "$(cat "$comm")" = rkling_event ] && count=$((count + 1))
	done
	printf '%s\n' "$count"
}

for attempt in 1 2; do
	kmem_trace_start

	if module_load_test /rootkitlings/rootkitlings.ko 4; then
		_ok "attempt $attempt returned numeric EINTR"
	else
		_fail "attempt $attempt did not return EINTR"
	fi

	kmem_trace_stop

	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
	if [ "$(worker_count)" -eq 0 ]; then
		_ok "attempt $attempt leaves no worker task"
	else
		_fail "attempt $attempt left rkling_event running"
	fi

	assert_one_loader_allocation_freed \
		"attempt $attempt freed its one state allocation"
done

summary
