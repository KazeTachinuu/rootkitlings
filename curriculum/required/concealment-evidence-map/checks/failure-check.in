#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
expect_allocation=${3:-@EXPECT_ALLOCATION@}
begin "$label"

probe_count()
{
	kind=$1
	target=$2
	awk -v kind="$kind" -v target="$target" '
		$2 == kind { split($3, name, "+"); if (name[1] == target) count++ }
		END { print count + 0 }
	' /sys/kernel/debug/kprobes/list
}

rmdir_before=$(probe_count r __x64_sys_rmdir)
filldir_before=$(probe_count k filldir64)
iterate_before=$(probe_count r iterate_dir)
kmem_trace_setup

for attempt in 1 2; do
	kmem_trace_start
	if module_load_test /rootkitlings/rootkitlings.ko "$expected_errno"; then
		_ok "attempt $attempt returns errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong result"
	fi
	kmem_trace_stop
	assert_absent /sys/module/rootkitlings
	assert_absent /proc/rootkitlings
	assert_absent /proc/rootkitlings_events
	assert_absent /proc/rootkitlings_evidence
	if test "$(probe_count r __x64_sys_rmdir)" -eq "$rmdir_before" &&
	   test "$(probe_count k filldir64)" -eq "$filldir_before" &&
	   test "$(probe_count r iterate_dir)" -eq "$iterate_before"; then
		_ok "attempt $attempt restores every probe count"
	else
		_fail "attempt $attempt left a probe registered"
	fi
	worker=0
	for comm in /proc/[0-9]*/comm; do
		test -r "$comm" || continue
		test "$(cat "$comm")" = rkling_core && worker=$((worker + 1))
	done
	if test "$worker" -eq 0; then
		_ok "attempt $attempt leaves no worker"
	else
		_fail "attempt $attempt left a worker"
	fi
	if test "$expect_allocation" -eq 1; then
		assert_one_loader_allocation_freed \
			"attempt $attempt frees its state allocation"
	fi
done

kmem_trace_disable
kmem_trace_restore

summary
