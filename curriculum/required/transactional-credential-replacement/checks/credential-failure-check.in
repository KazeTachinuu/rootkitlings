#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
begin "$label"

endpoint=/proc/rootkitlings
fixtures=/tmp/rootkitlings-credential-failure
mkdir -p "$fixtures"
printf 'enable' > "$fixtures/enable"

assert_not_loaded()
{
	assert_absent /sys/module/rootkitlings
	assert_absent "$endpoint"
	if grep -q '^rootkitlings ' /proc/modules; then
		_fail "rootkitlings appears in /proc/modules"
	else
		_ok "rootkitlings is absent from /proc/modules"
	fi
}

assert_not_loaded
attempt=1
while [ "$attempt" -le 2 ]; do
	load rootkitlings.ko
	assert_loaded rootkitlings
	assert_exists "$endpoint"
	if proc_write_test write "$endpoint" "$fixtures/enable" > /dev/null; then
		_ok "attempt $attempt enabled the action"
	else
		_fail "attempt $attempt could not enable the action"
	fi
	i=0
	while [ "$i" -lt 16 ]; do
		if ! run_as 65534 65534 cred_trigger_test unchanged \
			"$endpoint" root "$expected_errno" > /dev/null; then
			_fail "attempt $attempt rejection $i changed credentials or returned the wrong errno"
			break
		fi
		i=$((i + 1))
	done
	if [ "$i" -eq 16 ]; then
		_ok "attempt $attempt rejected 16 actions without changing their writers"
	fi
	unload rootkitlings
	assert_not_loaded
	attempt=$((attempt + 1))
done

summary
