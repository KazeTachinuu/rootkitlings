#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Non-matching mkdir produces no intercept log"

load rklings.ko

# mkdir without the rklings. prefix should be ignored by the hook.
mkdir /tmp/normaldir 2>/dev/null

log=$(dmesg)
case "$log" in
    *"intercepted mkdir"*)
        _fail "dmesg contains 'intercepted mkdir' for non-matching path"
        ;;
    *)
        _ok "no intercept log for non-matching mkdir"
        ;;
esac

# The non-matching mkdir should still succeed (hook returns -ENOENT
# only when the prefix matches; otherwise it passes through).
# Actually, looking at the solution: the handler always returns -ENOENT.
# The hook header only calls the user handler for every mkdir, and the
# user handler returns -ENOENT for both matching and non-matching.
# But the hook intercepts the return value only when intercepted=true,
# which is always set. So non-matching mkdir also fails.
# However, the key test is: no log message for non-matching paths.

# Clean up.
rm -rf /tmp/normaldir 2>/dev/null
unload rklings

summary
