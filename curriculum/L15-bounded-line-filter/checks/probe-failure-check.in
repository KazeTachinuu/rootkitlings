#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

expected_errno=${1:-@EXPECTED_ERRNO@}
label=${2:-@LABEL@}
begin "$label"

target=/tmp/rklings-read-target
endpoint=/proc/rklings
registry=/sys/kernel/debug/kprobes/list
printf 'SECRET\n' > "$target"

probe_count()
{
	awk '$2 == "r" { split($3, name, "+"); if (name[1] == "vfs_read") count++ }
		END { print count + 0 }' "$registry"
}

before=$(probe_count)
attempt=1
while [ "$attempt" -le 2 ]; do
	if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko "$expected_errno"; then
		_ok "attempt $attempt returned errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rklings
	assert_absent "$endpoint"
	if grep -q '^rklings ' /proc/modules; then
		_fail "attempt $attempt left rklings in /proc/modules"
	else
		_ok "attempt $attempt leaves no loaded module"
	fi
	if [ "$(probe_count)" -eq "$before" ]; then
		_ok "attempt $attempt leaves no return probe"
	else
		_fail "attempt $attempt leaked a return probe"
	fi
	attempt=$((attempt + 1))
done

summary
