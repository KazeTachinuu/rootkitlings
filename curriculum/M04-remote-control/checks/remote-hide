#!/bin/sh
# Check: HIDE FILE command hides a file over the protocol connection.
# M04 uses length-prefixed frames (4-byte big-endian length + payload).
# The module connects to peer_address:peer_port on init, then reads
# framed commands and sends framed responses.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Remote HIDE FILE command"

ifconfig lo 127.0.0.1 up 2>/dev/null

RESP=/tmp/rk_remote_hide_resp.bin
rm -f "$RESP"

# Build a length-prefixed frame for "HIDE FILE secret.txt"
# Frame: 4 bytes big-endian length + payload
CMD="HIDE FILE secret.txt"
CMD_LEN=$(printf '%s' "$CMD" | wc -c)

# Create the framed command using printf with hex bytes for the length
# CMD_LEN should fit in one byte for our test commands
{
    printf '\x00\x00\x00'
    printf "\\$(printf '%03o' "$CMD_LEN")"
    printf '%s' "$CMD"
} > /tmp/rk_cmd_frame.bin

# Start a listener that sends the framed command and captures response
{
    cat /tmp/rk_cmd_frame.bin
    sleep 2
} | nc -l -p 4444 > "$RESP" 2>&1 &
NC_PID=$!
sleep 0.3

# Load module: it connects to us and enters command loop
load rklings.ko "$@"
sleep 1

# Kill listener
kill "$NC_PID" 2>/dev/null
wait "$NC_PID" 2>/dev/null

# Check that we got a response
if [ -s "$RESP" ]; then
    _ok "received response from agent"
    # The response should be a framed "HIDE FILE OK"
    # Skip first 4 bytes (length prefix) and check payload
    resp_text=$(dd if="$RESP" bs=1 skip=4 2>/dev/null)
    case "$resp_text" in
        *"HIDE FILE OK"*)
            _ok "agent responded with HIDE FILE OK"
            ;;
        *"OK"*|*"hidden"*)
            _ok "agent acknowledged hide command"
            ;;
        *)
            _fail "unexpected response: $(xxd "$RESP" | head -3)"
            ;;
    esac
else
    _fail "no response received from agent"
fi

# Cleanup
rm -f "$RESP" /tmp/rk_cmd_frame.bin

unload rklings
assert_absent /sys/module/rklings

summary
