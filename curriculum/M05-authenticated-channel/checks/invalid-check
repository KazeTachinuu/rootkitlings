#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Reject invalid key"

test_port=9999
good_key="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
bad_key="ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
fixture_dir=$(mktemp -d)

ifconfig lo 127.0.0.1 up

secure_agent_fixture serve "$fixture_dir" "$test_port" 127.0.0.1 "$bad_key" &
fixture_pid=$!

timeout=30
elapsed=0
while [ ! -f "$fixture_dir/ready" ] && [ "$elapsed" -lt "$timeout" ]; do
	sleep 0.1
	elapsed=$((elapsed + 1))
done
if [ ! -f "$fixture_dir/ready" ]; then
	_fail "fixture did not become ready"
	kill "$fixture_pid" 2>/dev/null; wait "$fixture_pid" 2>/dev/null
	summary
fi

load rklings.ko peer_address=127.0.0.1 peer_port="$test_port" \
	retry_base_ms=25 retry_max_ms=200 control_key="$good_key"

sleep 3

if ! wait "$fixture_pid" 2>/dev/null; then
	_ok "fixture rejected agent with wrong key"
else
	_fail "fixture accepted agent with wrong key"
fi

if lsmod | grep -q rklings; then
	_ok "module survived key mismatch"
else
	_fail "module crashed after key mismatch"
fi

unload rklings

if dmesg | grep -Eqi '(BUG:|WARNING:|Oops:|KASAN:|UBSAN:|hung task)'; then
	_fail "kernel log contains a fault report"
else
	_ok "kernel log is clean"
fi

rm -rf "$fixture_dir"
summary
