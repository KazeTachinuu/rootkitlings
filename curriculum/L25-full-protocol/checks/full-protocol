#!/bin/sh
# Check: full protocol, all commands over AES-256-GCM encrypted channel.
# Uses secure_agent_fixture in full serve mode.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Full protocol: all commands wired to encrypted channel"

ifconfig lo 127.0.0.1 up 2>/dev/null

KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
MARKER_DIR=/tmp/rk_fixture_l25
rm -rf "$MARKER_DIR"
mkdir -p "$MARKER_DIR"

printf 'rootkitlings download test\n' > /tmp/rktest.txt

secure_agent_fixture serve "$MARKER_DIR" 4444 127.0.0.1 "$KEY" &
FIXTURE_PID=$!

while [ ! -f "$MARKER_DIR/ready" ]; do sleep 0.1; done
_ok "fixture listening"

load rklings.ko control_key="$KEY" peer_address=127.0.0.1 peer_port=4444 shell_timeout_ms=3000

_hdr "Protocol tests"

i=0; while [ ! -f "$MARKER_DIR/replay_rejected" ] && [ "$i" -lt 150 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/replay_rejected" ]; then
    _ok "HIDE/UNHIDE, LIST enumeration, replay rejection"
else
    _fail "replay rejection phase timed out"
fi

i=0; while [ ! -f "$MARKER_DIR/tamper_rejected" ] && [ "$i" -lt 150 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/tamper_rejected" ]; then
    _ok "STATUS, tamper rejection"
else
    _fail "tamper rejection phase timed out"
fi

_hdr "SHELL lifecycle"

i=0; while [ ! -f "$MARKER_DIR/root_shell_complete" ] && [ "$i" -lt 200 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/root_shell_complete" ]; then
    _ok "root shell via ticket-based reverse connect"
else
    _fail "root shell timed out"
fi

i=0; while [ ! -f "$MARKER_DIR/quit_complete" ] && [ "$i" -lt 100 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/quit_complete" ]; then
    _ok "QUIT closes session cleanly"
else
    _fail "QUIT timed out"
fi

_hdr "Security: replay and tamper on shell"

i=0; while [ ! -f "$MARKER_DIR/shell_replay_rejected" ] && [ "$i" -lt 150 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/shell_replay_rejected" ]; then
    _ok "replayed SHELL command rejected"
else
    _fail "shell replay rejection timed out"
fi

i=0; while [ ! -f "$MARKER_DIR/shell_tamper_rejected" ] && [ "$i" -lt 150 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/shell_tamper_rejected" ]; then
    _ok "tampered SHELL command rejected"
else
    _fail "shell tamper rejection timed out"
fi

_hdr "Shell edge cases"

i=0; while [ ! -f "$MARKER_DIR/shell_refused" ] && [ "$i" -lt 100 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/shell_refused" ]; then
    _ok "SHELL to closed port reports refused"
else
    _fail "shell refused timed out"
fi

i=0; while [ ! -f "$MARKER_DIR/shell_timeout" ] && [ "$i" -lt 300 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/shell_timeout" ]; then
    _ok "shell inactivity timeout fires"
else
    _fail "shell timeout timed out"
fi

_hdr "Completion"

i=0; while [ ! -f "$MARKER_DIR/eof" ] && [ "$i" -lt 100 ]; do
    sleep 0.1; i=$((i + 1))
done
if [ -f "$MARKER_DIR/eof" ]; then
    _ok "all fixture phases complete"
else
    _fail "fixture did not complete"
fi

wait "$FIXTURE_PID" 2>/dev/null
fixture_rc=$?
if [ "$fixture_rc" -eq 0 ]; then
    _ok "fixture exited cleanly"
else
    _fail "fixture exited with code $fixture_rc"
fi

rm -f /tmp/rktest.txt
rm -rf "$MARKER_DIR"

unload rklings
assert_absent /sys/module/rklings

summary
