#!/usr/bin/bash
set -Eeuo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$HERE/../../../scripts/lesson-env"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/rootkitlings-guarded-file-transaction-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

[[ $(uname -m) == x86_64 ]] || { printf '[x] x86_64 required\n' >&2; exit 1; }
grep -qx 'CONFIG_CC_IS_GCC=y' "$KDIR/.config" || exit 1

for script in test host-check success-check failure-check; do
	bash -n "$HERE/$script"
done
if command -v shellcheck >/dev/null; then
	shellcheck -x -s bash "$HERE/test" "$HERE/host-check"
	shellcheck -x -s sh "$HERE/success-check" "$HERE/failure-check"
fi

mapfile -t generated_files < <(
	find "$HERE" -type f \( -name '*.o' -o -name '*.ko' -o \
		-name '*.mod' -o -name '*.mod.c' -o -name '.*.cmd' -o \
		-name Module.symvers -o -name modules.order \) -print
)
(( ${#generated_files[@]} == 0 )) || {
	printf '[x] generated build artifact in milestone source: %s\n' \
		"${generated_files[0]}" >&2
	exit 1
}

mapfile -t changed_files < <(
	diff -qr "$HERE/../starter" "$HERE/../solution" |
		sed -nE 's#^Files .*/starter/(.*) and .*/solution/.* differ$#\1#p'
)
(( ${#changed_files[@]} == 1 )) || {
	printf '[x] expected one learner file, found %d\n' "${#changed_files[@]}" >&2
	exit 1
}
[[ ${changed_files[0]} == staging/transaction.c ]] || exit 1

build_tree()
{
	local source=$1 destination=$2
	local log=$destination.log
	cp -a "$source" "$destination"
	if ! make -s -C "$KDIR" M="$destination" W=1 modules > "$log" 2>&1; then
		cat "$log" >&2
		exit 1
	fi
	if grep -q 'warning:' "$log"; then
		cat "$log" >&2
		exit 1
	fi
}

build_tree "$HERE/../starter" "$scratch/starter"
build_tree "$HERE/../solution" "$scratch/solution"
"$HERE/host-check" "$scratch/solution" "$scratch/solution/rootkitlings.ko"
if "$HERE/host-check" "$scratch/starter" "$scratch/starter/rootkitlings.ko" \
	> "$scratch/starter-host.log" 2>&1; then
	printf '[x] host checker accepted unfinished transaction\n' >&2
	exit 1
fi

build_mutant()
{
	local name=$1 mutator=$2
	local directory=$scratch/$name log=$scratch/$name.log
	cp -a "$HERE/../solution" "$directory"
	"$mutator" "$directory/staging/transaction.c"
	make -s -C "$KDIR" M="$directory" W=1 modules > "$log" 2>&1 || {
		cat "$log" >&2
		exit 1
	}
	if "$HERE/host-check" "$directory" "$directory/rootkitlings.ko" \
		> "$scratch/$name-host.log" 2>&1; then
		printf '[x] checker accepted mutant: %s\n' "$name" >&2
		exit 1
	fi
}

mutate_size() { sed -i 's/object->length > RK_FILE_MAX/object->length >= RK_FILE_MAX/' "$1"; }
mutate_identity() { sed -i 's/current->identity != snapshot->retained.identity/false/' "$1"; }
mutate_links() {
	sed -i 's/current->links != snapshot->retained.links/false/; s/object->links != 1/false/' "$1"
}
mutate_mode() {
	sed -i 's/current->mode != snapshot->retained.mode/false/; s/(object->mode & 0170000) != 0100000/false/; s/(object->mode & 07777) != 0600/false/' "$1"
}
mutate_owner() {
	sed -i 's/current->uid != snapshot->retained.uid/false/; s/current->gid != snapshot->retained.gid/false/; s/object->uid != 0/false/; s/object->gid != 0/false/' "$1"
}
mutate_content() {
	sed -i 's/return memcmp(bytes, snapshot->bytes, snapshot->length) ? -ESTALE : 0;/return 0;/' "$1"
}
mutate_candidate_sync() {
	sed -i 's/error = rk_platform_sync_file(&transaction->candidate.retained);/error = 0;/' "$1"
}
mutate_directory_sync() {
	sed -i 's/error = rk_platform_sync_directory(RK_STEP_SYNC_APPLY);/error = 0;/' "$1"
}
mutate_short_write() { sed -i '/transaction->candidate.length = position;/i\
\t\tposition = sizeof(rk_intended);' "$1"; }
mutate_late_exchange() {
	sed -i '/transaction->exchanged = true;/d; /transaction->state = RK_TRANSACTION_APPLIED;/i\
\ttransaction->exchanged = true;' "$1"
}

build_mutant rejects-256 mutate_size
build_mutant ignores-identity mutate_identity
build_mutant ignores-link-count mutate_links
build_mutant ignores-mode mutate_mode
build_mutant ignores-owner mutate_owner
build_mutant ignores-content mutate_content
build_mutant skips-candidate-sync mutate_candidate_sync
build_mutant skips-directory-sync mutate_directory_sync
build_mutant assumes-complete-write mutate_short_write
build_mutant records-exchange-late mutate_late_exchange

cp -a "$HERE/../solution" "$scratch/alternate"
cp "$HERE/../fixtures/alternate/transaction.c" \
	"$scratch/alternate/staging/transaction.c"
build_tree "$scratch/alternate" "$scratch/alternate-build"
"$HERE/host-check" "$scratch/alternate-build" \
	"$scratch/alternate-build/rootkitlings.ko"

run_guest()
{
	local check=$1 module=$2 label=$3 output
	shift 3
	if ! output=$("$HERE/../../../vm/boot" --check "$check" "$module" "$@" 2>&1); then
		printf '%s\n' "$output" >&2
		printf '[x] guest rejected %s\n' "$label" >&2
		exit 1
	fi
	printf '%s\n' "$output"
}

run_guest "$HERE/success-check" "$scratch/solution/rootkitlings.ko" solution \
	--tool vm/tools/module_load_test --tool vm/tools/module_load_params
run_guest "$HERE/success-check" \
	"$scratch/alternate-build/rootkitlings.ko" alternate \
	--tool vm/tools/module_load_test --tool vm/tools/module_load_params
run_guest "$HERE/failure-check" "$scratch/starter/rootkitlings.ko" starter \
	--tool vm/tools/module_load_test

printf '[+] guarded-file-transaction passed\n'
