#!/bin/sh
# Check: Encrypted agent communication over AES-256-GCM envelope.
# The module connects to 127.0.0.1:4444, sends an encrypted HELLO,
# then enters an echo loop (encrypted recv, encrypted send).
# We verify the connection carries non-plaintext (encrypted) data.
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Encrypted agent channel"

ifconfig lo 127.0.0.1 up 2>/dev/null

RAWFILE=/tmp/rk_secure_raw.bin
rm -f "$RAWFILE"

# Start a raw listener to capture whatever the module sends.
# The module sends length-prefixed encrypted frames.
nc -l -p 4444 > "$RAWFILE" 2>&1 &
NC_PID=$!
sleep 0.3

# Load with the test key
load rklings.ko "$@"

# Give the agent time to connect and send HELLO
sleep 2

# Kill listener to capture what we got
kill "$NC_PID" 2>/dev/null
wait "$NC_PID" 2>/dev/null

# Verify we received data
if [ -s "$RAWFILE" ]; then
    _ok "received data from agent"
else
    _fail "no data received from agent"
    rm -f "$RAWFILE"
    unload rklings
    summary
fi

# Verify the data is NOT plaintext "HELLO" (it should be encrypted)
rawsize=$(wc -c < "$RAWFILE")
if [ "$rawsize" -lt 4 ]; then
    _fail "received data too small ($rawsize bytes)"
else
    _ok "received $rawsize bytes of data"
fi

# Check that the raw data does not contain plaintext HELLO
if grep -q 'HELLO' "$RAWFILE" 2>/dev/null; then
    _fail "data contains plaintext HELLO (not encrypted)"
else
    _ok "data does not contain plaintext HELLO (encrypted)"
fi

# The encrypted envelope should be larger than plaintext due to
# header (18 bytes) + GCM tag (16 bytes) + frame length prefix (2 bytes)
if [ "$rawsize" -gt 20 ]; then
    _ok "data size ($rawsize) consistent with encrypted envelope"
else
    _fail "data size ($rawsize) too small for encrypted envelope"
fi

# Check for non-ASCII bytes (encrypted data should have high entropy)
nonascii=$(od -A n -t x1 "$RAWFILE" | tr ' ' '\n' | grep -c '[89a-f][0-9a-f]' 2>/dev/null || echo 0)
if [ "$nonascii" -gt 0 ]; then
    _ok "data contains high-entropy bytes (encrypted)"
else
    _ok "data entropy check completed"
fi

# Cleanup
rm -f "$RAWFILE"

unload rklings
assert_absent /sys/module/rklings

summary
