#!/bin/sh
# shellcheck source=/dev/null
. "${RKLINGS_LIB:-/vm/checks/lib.sh}"

begin "Kernel socket configuration and connect errors"

fixtures=/tmp/rklings-socket-validation
mkdir -p "$fixtures"

ifconfig lo 127.0.0.1 up

attempt=1
while [ "$attempt" -le 2 ]; do
	if module_load_test ${RKLINGS_DIR:-/rklings}/rklings.ko 22; then
		_ok "zero-port attempt $attempt returned EINVAL"
	else
		_fail "zero-port attempt $attempt returned the wrong error"
	fi
	socket_owner_fixture unused "$fixtures/unused-$attempt"
	port=$(cat "$fixtures/unused-$attempt")
	if load_errno ${RKLINGS_DIR:-/rklings}/rklings.ko 111 \
			"peer_port=$port"; then
		_ok "refused-connect attempt $attempt returned ECONNREFUSED"
	else
		_fail "refused-connect attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rklings
	assert_absent /proc/rklings
	attempt=$((attempt + 1))
done

summary
