#!/bin/sh
# shellcheck source=/dev/null
. /vm/checks/lib.sh

expected_errno=${1:?expected errno argument is required}
label=${2:?check label argument is required}
needs_listener=${3:?listener flag argument is required}

begin "$label"

fixtures=/tmp/rklings-socket-failure
mkdir -p "$fixtures"

ifconfig lo 127.0.0.1 up

wait_for_file()
{
	path=$1
	index=0
	while [ ! -s "$path" ] && [ "$index" -lt 300 ]; do
		sleep 0.01
		index=$((index + 1))
	done
	[ -s "$path" ]
}

attempt=1
while [ "$attempt" -le 2 ]; do
	directory=$fixtures/attempt-$attempt
	mkdir -p "$directory"
	if [ "$needs_listener" -eq 1 ]; then
		socket_owner_fixture serve "$directory" > "$directory/log" 2>&1 &
		fixture_pid=$!
		wait_for_file "$directory/ready" || _fail "attempt $attempt fixture was not ready"
		port=$(cat "$directory/primary_port")
	else
		socket_owner_fixture unused "$directory/port"
		port=$(cat "$directory/port")
		fixture_pid=
	fi

	if load_errno /rklings/rklings.ko "$expected_errno" \
			"peer_port=$port"; then
		_ok "attempt $attempt returned errno $expected_errno"
	else
		_fail "attempt $attempt returned the wrong error"
	fi
	assert_absent /sys/module/rklings
	assert_absent /proc/rklings
	if grep -q '^rklings ' /proc/modules; then
		_fail "attempt $attempt left a loaded module"
	else
		_ok "attempt $attempt left no loaded module"
	fi

	if [ "$needs_listener" -eq 1 ]; then
		if wait_for_file "$directory/eof"; then
			_ok "attempt $attempt released the connected socket"
		else
			_fail "attempt $attempt left the peer connected"
			kill "$fixture_pid" 2>/dev/null || true
		fi
		wait "$fixture_pid" || _fail "attempt $attempt fixture failed"
	fi
	attempt=$((attempt + 1))
done

summary
