#!/usr/bin/bash
set -Eeuo pipefail

die() { printf '[x] %s\n' "$*" >&2; exit 1; }

(( $# == 2 )) || die "usage: ${0##*/} BUILD_DIR ARTIFACT_PATH"
build_dir=$(realpath -e -- "$1" 2>/dev/null) || die "build directory not found: $1"
artifact=$(realpath -e -- "$2" 2>/dev/null) || die "artifact not found: $2"

[[ -d $build_dir && ! -L $build_dir ]] || die "build directory must be a real directory"
[[ -f $artifact && ! -L $artifact ]] || die "artifact must be a regular file"
[[ $artifact == "$build_dir/rklings.ko" ]] ||
	die "expected artifact at: $build_dir/rklings.ko"

for path in core/main.o core/state.o interface/proc.o include/rootkit.h; do
	[[ -f $build_dir/$path && ! -L $build_dir/$path ]] ||
		die "build output is missing regular file: $path"
done

command -v modinfo >/dev/null || die "modinfo is required"
command -v nm >/dev/null || die "nm is required"
[[ $(modinfo -F license "$artifact") == GPL ]] || die "module license must be GPL"
[[ $(modinfo -F description "$artifact") == 'Rklings kernel module' ]] ||
	die "module description must be: Rklings kernel module"

for symbol in rk_state_create rk_state_is_active rk_state_actions_enabled \
	rk_state_set_actions_enabled rk_state_destroy; do
	nm "$build_dir/core/state.o" | grep -Eq "[[:space:]]T[[:space:]]+$symbol$" ||
		die "core/state.o must define $symbol"
done

proc_undefined=$(nm -u "$build_dir/interface/proc.o")
for symbol in proc_create_data proc_remove rk_state_is_active \
	rk_state_actions_enabled rk_state_set_actions_enabled seq_printf seq_read seq_lseek \
	single_open single_release; do
	grep -Eq "[[:space:]]$symbol$" <<< "$proc_undefined" ||
		die "interface/proc.o has no $symbol dependency"
done
grep -Eq '[[:space:]](_copy_from_user|copy_from_user)$' <<< "$proc_undefined" ||
	die "interface/proc.o has no copy_from_user dependency"
if grep -Eq '[[:space:]]proc_create_single_data$' <<< "$proc_undefined"; then
	die "use proc_create_data with explicit proc_ops"
fi

for object in core/main.o interface/proc.o; do
	undefined=$(nm -u "$build_dir/$object")
	if grep -Eq '[[:space:]](__kmalloc|__kmalloc_cache_noprof|kmalloc_noprof|kfree|kvfree|vfree)$' \
		<<< "$undefined"; then
		die "$object must not allocate or free module state"
	fi
done

state_undefined=$(nm -u "$build_dir/core/state.o")
if grep -Eq '[[:space:]]mutex_(lock|unlock)' <<< "$state_undefined" ||
	grep -Eq '[[:space:]]mutex_(lock|unlock)' <<< "$proc_undefined"; then
	die "one independent scalar switch does not need a mutex"
fi

printf '[+] switch ABI, dependencies, and forbidden operations verified\n'
