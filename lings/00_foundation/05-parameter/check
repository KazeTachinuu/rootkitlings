#!/bin/sh
. /lib/check.sh

begin "05-parameter"

load hello.ko
assert_loaded hello
assert_param hello name "world"
assert_log "name=world"
unload hello

begin "05-parameter load-time arg"

load hello.ko name=phantom
assert_loaded hello
assert_param hello name "phantom"
assert_log "name=phantom"

write_param hello name "specter"
assert_param hello name "specter"

unload hello

summary
