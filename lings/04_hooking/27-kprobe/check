#!/bin/sh
. /lib/check.sh

begin "27-kprobe"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_probe

# Snapshot counter, trigger opens, verify it grew
before=$(cat /proc/rk_probe | tr -dc '0-9')

# Each cat opens a file, which fires do_sys_openat2
cat /dev/null > /dev/null
cat /dev/null > /dev/null
cat /dev/null > /dev/null

after=$(cat /proc/rk_probe | tr -dc '0-9')
if [ "$after" -gt "$before" ]; then
    _ok "kprobe fires on open: $before -> $after"
else
    _fail "counter did not increase: $before -> $after"
fi

# Verify it keeps counting (not a one-shot)
cat /dev/null > /dev/null
final=$(cat /proc/rk_probe | tr -dc '0-9')
if [ "$final" -gt "$after" ]; then
    _ok "counter keeps incrementing: $after -> $final"
else
    _fail "counter stopped incrementing: $after -> $final"
fi

unload hello
assert_absent /proc/rk_probe

summary
