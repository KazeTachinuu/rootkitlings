#!/bin/sh
. /lib/check.sh

begin "29-tracefs"

mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

load hello.ko
assert_loaded hello
assert_exists /proc/rk_tracer

# Must create a debugfs directory
if [ -d /sys/kernel/debug/rk_tracer ]; then
    _ok "debugfs directory exists"
else
    _fail "debugfs directory /sys/kernel/debug/rk_tracer/ not found"
fi

# Must create a state file inside
if [ -f /sys/kernel/debug/rk_tracer/state ]; then
    _ok "debugfs state file exists"
else
    _fail "debugfs state file not found"
fi

# Reading state file should return access count
state=$(cat /sys/kernel/debug/rk_tracer/state)
case "$state" in
    *accesses=*)
        _ok "state file returns access count"
        ;;
    *)
        _fail "state file missing accesses= field"
        ;;
esac

# Access count must increment on each read
first=$(cat /sys/kernel/debug/rk_tracer/state | sed -n 's/^accesses=//p')
second=$(cat /sys/kernel/debug/rk_tracer/state | sed -n 's/^accesses=//p')
if [ "$second" -gt "$first" ] 2>/dev/null; then
    _ok "access counter increments ($first -> $second)"
else
    _fail "access counter not incrementing ($first -> $second)"
fi

assert_contains /proc/rk_tracer "debugfs_dir=rk_tracer"
unload hello
assert_absent /proc/rk_tracer

# Debugfs entries must be cleaned up
if [ -d /sys/kernel/debug/rk_tracer ]; then
    _fail "debugfs directory not cleaned up"
else
    _ok "debugfs directory cleaned up"
fi

summary
