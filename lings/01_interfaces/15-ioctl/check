#!/bin/sh
. /lib/check.sh

begin "15-ioctl"

load hello.ko
assert_loaded hello
assert_exists /dev/rk_ioctl

# Verify it's a character device, not a regular file
if [ -c /dev/rk_ioctl ]; then
    _ok "/dev/rk_ioctl is a character device"
else
    _fail "/dev/rk_ioctl is not a character device"
fi

# Test default message (device should return something on first read)
initial=$(cat /dev/rk_ioctl)
if [ -n "$initial" ]; then
    _ok "default message: $initial"
else
    _ok "default message empty (valid)"
fi

# Test set/get via the write interface
printf 'phantom' > /dev/rk_ioctl
assert_read /dev/rk_ioctl "phantom"

# Test overwrite with different length
printf 'specter' > /dev/rk_ioctl
assert_read /dev/rk_ioctl "specter"

# Test empty-ish write (single char)
printf 'x' > /dev/rk_ioctl
assert_read /dev/rk_ioctl "x"

unload hello
assert_absent /dev/rk_ioctl

summary
