#!/bin/sh
. /lib/check.sh

begin "11-errptr"

load hello.ko
assert_loaded hello

# /proc/rk_errptr should be a directory (proc_mkdir), not a file
if [ -d /proc/rk_errptr ]; then
    _ok "/proc/rk_errptr is a directory"
else
    _fail "/proc/rk_errptr is not a directory (expected proc_mkdir)"
fi

# /proc/rk_errptr/status is a file inside that directory
assert_exists /proc/rk_errptr/status
# Status file must return non-empty content
content=$(cat /proc/rk_errptr/status)
if [ -n "$content" ]; then
    _ok "/proc/rk_errptr/status returned: $content"
else
    _fail "/proc/rk_errptr/status returned empty"
fi

unload hello

# Both the file and directory must be cleaned up
assert_absent /proc/rk_errptr/status
assert_absent /proc/rk_errptr

summary
