#!/bin/sh
. /lib/check.sh

begin "53-xor-obfuscation"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_xor

# Read default state: must have plain, cipher, and decrypt fields
assert_contains /proc/rk_xor "plain="
assert_contains /proc/rk_xor "cipher="
assert_contains /proc/rk_xor "decrypt="

# Default round-trip: decrypt must equal plain
proc_data=$(cat /proc/rk_xor)
plain=$(printf '%s\n' "$proc_data" | sed -n 's/^plain=//p')
decrypt=$(printf '%s\n' "$proc_data" | sed -n 's/^decrypt=//p')
if [ -n "$plain" ] && [ "$plain" = "$decrypt" ]; then
    _ok "round-trip: decrypt matches plain ($plain)"
else
    _fail "round-trip failed: plain=$plain decrypt=$decrypt"
fi

# Write new plaintext and verify round-trip
printf '%s' "test123" > /proc/rk_xor
proc_data=$(cat /proc/rk_xor)
plain2=$(printf '%s\n' "$proc_data" | sed -n 's/^plain=//p')
decrypt2=$(printf '%s\n' "$proc_data" | sed -n 's/^decrypt=//p')
if [ "$plain2" = "test123" ] && [ "$decrypt2" = "test123" ]; then
    _ok "round-trip with new input: test123"
else
    _fail "round-trip with new input: plain=$plain2 decrypt=$decrypt2"
fi

unload hello
assert_absent /proc/rk_xor

summary
