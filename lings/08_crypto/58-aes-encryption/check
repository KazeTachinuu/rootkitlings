#!/bin/sh
. /lib/check.sh

begin "58-aes-encryption"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_aes

assert_contains /proc/rk_aes "algo=aes-cbc"
assert_contains /proc/rk_aes "status=ok"

# Verify the NIST SP 800-38A AES-128-CBC known-answer vector.
proc_data=$(cat /proc/rk_aes)
plain=$(printf '%s\n' "$proc_data" | sed -n 's/^plain=//p')
cipher=$(printf '%s\n' "$proc_data" | sed -n 's/^cipher=//p')
if [ "$plain" = "6bc1bee22e409f96e93d7e117393172a" ]; then
    _ok "known plaintext loaded"
else
    _fail "wrong known plaintext: '$plain'"
fi
if [ "$cipher" = "7649abac8119b246cee98e9b12e9197d" ]; then
    _ok "AES-CBC known-answer vector matched"
else
    _fail "wrong ciphertext: '$cipher'"
fi

# Verify round-trip: decrypt(encrypt(plain)) == plain
assert_contains /proc/rk_aes "known_answer=yes"
assert_contains /proc/rk_aes "match=yes"

unload hello
assert_absent /proc/rk_aes

summary
