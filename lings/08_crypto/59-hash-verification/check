#!/bin/sh
. /lib/check.sh

begin "55-hash-verification"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_hash

assert_contains /proc/rk_hash "algo=sha256"
assert_contains /proc/rk_hash "status=ok"

# SHA-256 hash must be exactly 64 hex characters
hash=$(cat /proc/rk_hash | sed -n 's/^hash=\([0-9a-f]*\)$/\1/p')
hash_len=$(printf '%s' "$hash" | wc -c)
if [ "$hash_len" -eq 64 ]; then
    _ok "hash is 64 hex chars"
else
    _fail "hash length $hash_len, expected 64"
fi

# Verify hash changes when input changes (write new data, re-read)
printf '%s' "changed" > /proc/rk_hash 2>/dev/null
hash2=$(cat /proc/rk_hash | sed -n 's/^hash=\([0-9a-f]*\)$/\1/p')
if [ -n "$hash2" ] && [ "$hash2" != "$hash" ]; then
    _ok "hash changed with different input"
else
    _fail "hash did not change on new input (before=$hash after=$hash2)"
fi

unload hello
assert_absent /proc/rk_hash

summary
