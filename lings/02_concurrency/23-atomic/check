#!/bin/sh
. /lib/check.sh

begin "23-atomic"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_atomic

# Observe the worker state instead of guessing a scheduler delay.
i=0
while [ "$i" -lt 20 ]; do
    grep -q '^running=0$' /proc/rk_atomic && break
    sleep 0.1
    i=$((i + 1))
done

# Verify exact count: 2 threads * 10000 iterations = 20000
count=$(cat /proc/rk_atomic | sed -n 's/^count=\([0-9]*\).*/\1/p')
if [ "$count" -eq 20000 ] 2>/dev/null; then
    _ok "atomic count = $count (exact)"
else
    _fail "expected count=20000, got $count"
fi

# Threads should have finished (running=0)
assert_contains /proc/rk_atomic "running=0"

unload hello
assert_absent /proc/rk_atomic

summary
