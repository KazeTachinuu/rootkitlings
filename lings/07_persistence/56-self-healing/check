#!/bin/sh
. /lib/check.sh

begin "56-self-healing"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_watchdog

assert_contains /proc/rk_watchdog "watchdog=active"
assert_contains /proc/rk_watchdog "heals=0"

# Kill the proc entry via the write interface
printf 'kill' > /proc/rk_watchdog

# Poll the effect with a bounded timeout instead of sleeping past it.
i=0
while [ "$i" -lt 30 ]; do
    if [ -e /proc/rk_watchdog ] &&
       heals=$(sed -n 's/^heals=//p' /proc/rk_watchdog) &&
       [ "${heals:-0}" -gt 0 ] 2>/dev/null; then
        break
    fi
    sleep 0.1
    i=$((i + 1))
done

# By now: killed + recreated
if [ -e /proc/rk_watchdog ]; then
    _ok "watchdog recreated /proc/rk_watchdog"
else
    _fail "watchdog did not recreate /proc/rk_watchdog"
    unload hello
    summary
fi

# Heal counter must have incremented
heals=$(sed -n 's/^heals=//p' /proc/rk_watchdog)
if [ "$heals" -gt 0 ] 2>/dev/null; then
    _ok "heal counter = $heals"
else
    _fail "heal counter not incremented ($heals)"
fi

unload hello

summary
