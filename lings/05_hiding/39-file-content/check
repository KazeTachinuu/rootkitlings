#!/bin/sh
. /lib/check.sh

begin "39-file-content"

# Create a target file with known content
printf 'This has SECRET data and another SECRET here\n' > /tmp/rk_target

load hello.ko
assert_loaded hello
assert_exists /proc/rk_content

# Read the target file via read() syscall (not sendfile)
# BusyBox cat uses sendfile which bypasses sys_read hooks
content=$(dd if=/tmp/rk_target bs=4096 count=1 2>/dev/null)
case "$content" in
    *SECRET*)
        _fail "SECRET not redacted: $content"
        ;;
    *XXXXXX*)
        _ok "SECRET replaced with XXXXXX"
        ;;
    *)
        _fail "unexpected content: $content"
        ;;
esac

# Verify the original structure is preserved (only SECRET changed)
case "$content" in
    *"XXXXXX data"*)
        _ok "surrounding text preserved"
        ;;
    *)
        _fail "surrounding text corrupted: $content"
        ;;
esac

# Check redaction counter
assert_contains /proc/rk_content "redactions="
count=$(cat /proc/rk_content | sed -n 's/^redactions=//p')
if [ "$count" -gt 0 ] 2>/dev/null; then
    _ok "redaction counter = $count"
else
    _fail "redaction counter not incremented ($count)"
fi

unload hello
assert_absent /proc/rk_content

# After unload, file should read normally again
content_after=$(cat /tmp/rk_target)
case "$content_after" in
    *SECRET*)
        _ok "original content readable after unload"
        ;;
    *)
        _ok "file content after unload: $content_after"
        ;;
esac

rm -f /tmp/rk_target

summary
