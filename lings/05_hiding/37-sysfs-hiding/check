#!/bin/sh
. /lib/check.sh

begin "37-sysfs-hiding"

load hello.ko
assert_exists /proc/rk_sysfs

# Module should be hidden from lsmod
if lsmod | grep -q hello; then
    _fail "module visible in lsmod"
else
    _ok "module hidden from lsmod"
fi

# Module should also be hidden from sysfs
assert_absent /sys/module/hello

# Procfs still works
assert_read /proc/rk_sysfs "hidden"

# Cannot rmmod a fully hidden module via busybox (expected)
# The module's cleanup runs only at shutdown

summary
