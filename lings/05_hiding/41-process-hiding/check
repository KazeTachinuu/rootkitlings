#!/bin/sh
. /lib/check.sh

begin "41-process-hiding"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_ghost

# Read the hidden PID
pid=$(cat /proc/rk_ghost | tr -dc '0-9')

if [ -z "$pid" ] || [ "$pid" -eq 0 ]; then
    _fail "/proc/rk_ghost: no valid PID"
else
    _ok "hidden PID: $pid"
fi

# The process should be running
if [ -d "/proc/$pid" ]; then
    _ok "/proc/$pid exists (direct access works)"
else
    _fail "/proc/$pid missing"
fi

# But ps should not show it
# shellcheck disable=SC2009 # Exact ps output is the behavior under test.
if ps -e 2>/dev/null | grep -q "^ *$pid "; then
    _fail "PID $pid visible in ps"
else
    _ok "PID $pid hidden from ps"
fi

unload hello
assert_absent /proc/rk_ghost

summary
