#!/bin/sh
. /lib/check.sh

begin "25-kernel-random"

load hello.ko
assert_loaded hello
assert_exists /proc/rk_entropy

# Must contain both fields
assert_contains /proc/rk_entropy "session="
assert_contains /proc/rk_entropy "token="

# Session ID must not be all zeros
session=$(cat /proc/rk_entropy | sed -n 's/^session=\([0-9a-f]*\)$/\1/p')
if [ "$session" = "00000000" ] || [ -z "$session" ]; then
    _fail "session is zero or missing"
else
    _ok "session=$session (non-zero)"
fi

# Token must be 32 hex chars (16 bytes)
token=$(cat /proc/rk_entropy | sed -n 's/^token=\([0-9a-f]*\)$/\1/p')
token_len=$(printf '%s' "$token" | wc -c)
if [ "$token_len" -eq 32 ]; then
    _ok "token is 32 hex chars"
else
    _fail "token length $token_len, expected 32"
fi

# Reload and verify values change (proves randomness)
unload hello
load hello.ko
session2=$(cat /proc/rk_entropy | sed -n 's/^session=\([0-9a-f]*\)$/\1/p')
if [ "$session" != "$session2" ]; then
    _ok "session changed on reload (random)"
else
    _fail "session identical after reload (not random)"
fi

unload hello
assert_absent /proc/rk_entropy

summary
