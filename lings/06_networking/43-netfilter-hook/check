#!/bin/sh
. /lib/check.sh

begin "43-netfilter-hook"

ifconfig lo 127.0.0.1 up 2>/dev/null

load hello.ko
assert_loaded hello
assert_exists /proc/rk_nfhook

# Counter should start at 0 (or very low, no traffic yet)
before=$(cat /proc/rk_nfhook | tr -dc '0-9')

# Generate traffic via loopback
ping -c 3 127.0.0.1 >/dev/null 2>&1

# Counter must have grown
assert_gt /proc/rk_nfhook "$before"

unload hello
assert_absent /proc/rk_nfhook

summary
