#!/bin/sh
. /lib/check.sh

begin "44-packet-sniffer"

ifconfig lo 127.0.0.1 up 2>/dev/null

load hello.ko
assert_loaded hello
assert_exists /proc/rk_sniffer

# Counters should start at 0
assert_contains /proc/rk_sniffer "tcp=0"
assert_contains /proc/rk_sniffer "udp=0"

# Generate TCP traffic
nc -l -p 19999 -s 127.0.0.1 &
NC_PID=$!
sleep 1
echo "test" | nc -w 1 127.0.0.1 19999 2>/dev/null || true
kill $NC_PID 2>/dev/null; wait $NC_PID 2>/dev/null

tcp=$(cat /proc/rk_sniffer | sed -n 's/^tcp=\([0-9]*\)$/\1/p')
if [ "$tcp" -gt 0 ] 2>/dev/null; then
    _ok "TCP counter incremented (tcp=$tcp)"
else
    _fail "TCP counter did not increment (tcp=$tcp)"
fi

# Generate UDP traffic
echo "test" | nc -u -w 1 127.0.0.1 19998 2>/dev/null || true

udp=$(cat /proc/rk_sniffer | sed -n 's/^udp=\([0-9]*\)$/\1/p')
if [ "$udp" -gt 0 ] 2>/dev/null; then
    _ok "UDP counter incremented (udp=$udp)"
else
    _fail "UDP counter did not increment (udp=$udp)"
fi

unload hello
assert_absent /proc/rk_sniffer

summary
