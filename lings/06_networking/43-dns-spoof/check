#!/bin/sh
. /lib/check.sh

begin "43-dns-spoof"

ifconfig lo 127.0.0.1 up 2>/dev/null

load hello.ko
assert_loaded hello
assert_exists /proc/rk_spoofer

# Start a listener on port 5300 (the redirect target)
nc -l -u -p 5300 -s 127.0.0.1 > /tmp/dns_recv &
NC_PID=$!
sleep 1

# Send a UDP packet to port 53 (DNS port)
# The module should redirect it to port 5300
printf 'dns-test-query' | nc -u -w 1 127.0.0.1 53 2>/dev/null || true
sleep 1

# Check if the redirected packet arrived at 5300
kill $NC_PID 2>/dev/null; wait $NC_PID 2>/dev/null
recv=$(cat /tmp/dns_recv 2>/dev/null)
if [ -n "$recv" ]; then
    _ok "DNS packet redirected to port 5300 (got: $recv)"
else
    _fail "no packet received on port 5300"
fi

# Spoof counter should have incremented
spoofed=$(cat /proc/rk_spoofer | sed -n 's/^spoofed=//p')
if [ "$spoofed" -gt 0 ] 2>/dev/null; then
    _ok "spoof counter = $spoofed"
else
    _fail "spoof counter not incremented ($spoofed)"
fi

assert_contains /proc/rk_spoofer "redirect_port=5300"

unload hello
assert_absent /proc/rk_spoofer

rm -f /tmp/dns_recv

summary
